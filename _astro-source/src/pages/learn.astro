---
import BaseLayout from '../layouts/BaseLayout.astro';

const catalog = await import('../../public/dashboard-data/ai-learning-catalog.json');
const concepts = catalog.default.concepts;
const guides = catalog.default.guides;
const stackRadar = catalog.default.stack_radar;

const conceptLinks = [
  { label: 'AI agents', id: 'agent' },
  { label: 'LLMs', id: 'llm' },
  { label: 'VLMs', id: 'vlm' },
  { label: 'Tool calling', id: 'tool-calling' },
  { label: 'LangChain', id: 'langchain' },
  { label: 'RAG', id: 'rag' },
  { label: 'RBAC', id: 'rbac' },
  { label: 'Audit logs', id: 'audit-log' },
  { label: 'Observability', id: 'observability' },
  { label: 'AML', id: 'aml' },
  { label: 'False positives', id: 'false-positive' },
  { label: 'EVM', id: 'evm' },
  { label: 'Kubernetes', id: 'kubernetes' },
  { label: 'Docker', id: 'docker' },
];
---
<BaseLayout title="Learn AI Systems" description="Plain-English concepts behind the Bionic Banker lab stack: AI agents, LLMs, VLMs, RAG, LangChain, RBAC, AML, observability, and deployment basics.">
  <div class="page-header">
    <div class="page-label">Learning Layer</div>
    <h1 class="page-title">Learn the System</h1>
    <p class="page-sub">Plain-English notes behind the lab cards. No hype. Just what the concept means, why it matters, and where it shows up in the work.</p>
  </div>

  <div class="articles-wrap">
    <div class="article-card" style="margin-bottom: 1.25rem;">
      <div class="article-tags">
        <span class="tag-pill tag-green">Start here</span>
      </div>
      <h3>The rule</h3>
      <p>The best way to learn AI is to build one small loop, make the output visible, and add a check so the system cannot only clap for itself.</p>
      <p>This page is the glossary behind the lab pages. If a card says tool calling, RAG, RBAC, AML, false positive, or observability, this page explains the idea without making you read the whole archive.</p>
      <div class="concept-jump-list">
        {conceptLinks.map((item) => (
          <a href={`#${item.id}`}>{item.label}</a>
        ))}
        <a href="/wallet-risk">Open Wallet Risk Lab</a>
        <a href="/projects">Open experiments</a>
        <a href="/reports">Engineering reports</a>
        <a href="/gaps">Modern questions</a>
      </div>
    </div>

    <section class="stack-radar-panel">
      <div class="section-label">AI Stack Map</div>
      <div class="radar-head">
        <div>
          <h2>What the lab keeps returning to</h2>
          <p>AI work is not only prompting. It is retrieval, evals, traces, permission checks, deployment, and enough context that another person can inspect the path.</p>
        </div>
        <a href="/proof-tour">Walk the lab -></a>
      </div>
      <div class="radar-grid">
        {stackRadar.map((item, index) => (
          <article class="radar-card" id={item.id}>
            <div class="radar-index">{String(index + 1).padStart(2, '0')}</div>
            <h3>{item.layer}</h3>
            <p><strong>Why it matters now:</strong> {item.why_2026_teams_care}</p>
            <p><strong>Learn here:</strong> {item.learn_here}</p>
            <p><strong>Reader question:</strong> {item.reader_question}</p>
            <a href={item.linked_surface}>Follow this layer -></a>
          </article>
        ))}
      </div>
    </section>

    <section class="guide-grid">
      {guides.map((guide) => (
        <article class="article-card animate-on-scroll">
          <div class="article-tags">
            <span class="tag-pill tag-green">Guide</span>
          </div>
          <h3>{guide.title}</h3>
          <ol class="tight-list">
            {guide.items.map((item) => (
              <li>{item}</li>
            ))}
          </ol>
        </article>
      ))}
    </section>

    <section class="concept-grid">
      {concepts.map((concept) => (
        <article class="article-card animate-on-scroll concept-card" id={concept.id}>
          <div class="article-tags">
            <span class="tag-pill tag-green">Concept</span>
          </div>
          <h3>{concept.term}</h3>
          <p><strong>Meaning:</strong> {concept.plain_definition}</p>
          <p><strong>Why it matters:</strong> {concept.why_it_matters}</p>
          <p><strong>Shows up in:</strong> {concept.used_in.join(' / ')}</p>
          <div class="card-footer">
            <a class="read-more" href="/projects">Back to experiments -></a>
            <a class="read-more" href="/reports">View report -></a>
            <a class="read-more" href="/gaps">View questions -></a>
          </div>
        </article>
      ))}
    </section>
  </div>

  <style>
    .concept-jump-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
      margin-top: 1.2rem;
    }

    .concept-jump-list a {
      border: 1px solid rgba(31, 160, 104, 0.35);
      border-radius: 999px;
      color: #e4e4ec;
      padding: 0.5rem 0.75rem;
      text-decoration: none;
      font-size: 0.92rem;
      background: rgba(31, 160, 104, 0.08);
    }

    .guide-grid,
    .concept-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1rem;
      margin-bottom: 1.25rem;
    }

    .tight-list {
      margin: 0;
      padding-left: 1.2rem;
      color: var(--text-2);
      line-height: 1.7;
    }

    .concept-card {
      scroll-margin-top: 96px;
    }

    .stack-radar-panel {
      border: 1px solid rgba(31, 160, 104, 0.22);
      background: rgba(255, 255, 255, 0.035);
      border-radius: 8px;
      padding: 1.35rem;
      margin-bottom: 1.25rem;
    }

    .radar-head {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      align-items: end;
      margin-bottom: 1rem;
    }

    .radar-head h2 {
      margin: 0.25rem 0 0.5rem;
      font-size: clamp(1.35rem, 2.5vw, 2.2rem);
      letter-spacing: 0;
    }

    .radar-head p {
      color: var(--text-2);
      line-height: 1.7;
      margin: 0;
      max-width: 760px;
    }

    .radar-head a,
    .radar-card a {
      color: #1fa068;
      text-decoration: none;
      font-family: var(--mono);
      font-size: 0.9rem;
      flex-shrink: 0;
    }

    .radar-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 0.85rem;
    }

    .radar-card {
      border: 1px solid rgba(228, 228, 236, 0.12);
      border-radius: 8px;
      background:
        linear-gradient(145deg, rgba(31, 160, 104, 0.08), transparent 42%),
        rgba(2, 2, 4, 0.46);
      padding: 1rem;
      min-width: 0;
    }

    .radar-index {
      color: #1fa068;
      font-family: var(--mono);
      font-size: 0.78rem;
      margin-bottom: 0.75rem;
    }

    .radar-card h3 {
      margin: 0 0 0.7rem;
      font-size: 1.1rem;
      letter-spacing: 0;
    }

    .radar-card p {
      color: var(--text-2);
      line-height: 1.65;
      margin: 0 0 0.75rem;
    }

    @media (max-width: 640px) {
      .radar-head {
        align-items: flex-start;
        flex-direction: column;
      }
    }
  </style>
</BaseLayout>
