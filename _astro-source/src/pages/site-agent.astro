---
import BaseLayout from '../layouts/BaseLayout.astro';

const proofCatalog = await import('../../public/dashboard-data/public-proof-catalog.json');
const learningCatalog = await import('../../public/dashboard-data/ai-learning-catalog.json');
const gapCatalog = await import('../../public/dashboard-data/market-gap-catalog.json');
const reportCatalog = await import('../../public/dashboard-data/engineering-report-catalog.json');
const siteBrain = await import('../../public/dashboard-data/site-brain.json');

const projects = proofCatalog.default.projects;
const concepts = learningCatalog.default.concepts;
const questions = gapCatalog.default.modern_questions;
const metrics = reportCatalog.default.summary_metrics;
const brain = siteBrain.default;

const quickPrompts = brain.quick_prompts;
const sourceTiles = brain.entry_points.map((entry) => ({
  ...entry,
  body: entry.id === 'projects'
    ? `${projects.length} experiments with sources, notes, and clear limits.`
    : entry.id === 'reports'
      ? `${metrics.length} field-note metrics, benchmark bars, and signal maps.`
      : entry.id === 'learn'
        ? `${concepts.length} plain-language concepts for AI agents, RAG, RBAC, observability, wallet risk, and deployment.`
        : entry.id === 'questions'
          ? `${questions.length} modern AI questions mapped to answers, examples, and routes.`
          : entry.body
}));

const uxStats = [
  { value: projects.length, label: 'experiments' },
  { value: metrics.length, label: 'report metrics' },
  { value: concepts.length, label: 'AI concepts' },
  { value: questions.length, label: 'questions' }
];
---
<BaseLayout title="Ask the Lab" description="Ask Bionic Banker questions about Himanshu, AI finance experiments, wallet-risk work, field notes, learning notes, and live signal pages.">
  <main class="ask-shell">
    <section class="ask-hero">
      <div class="hero-copy">
        <div class="route-kicker">Bionic Banker site guide</div>
        <h1>Ask the Lab where to go.</h1>
        <p>This page is a small guide for the lab. Ask about Himanshu, wallet risk, agents, field notes, AI terms, live signals, or experiments. The answer points you to the right room.</p>
        <div class="hero-actions-mini" aria-label="Fast routes">
          <a href="/proof-tour/">Enter the lab</a>
          <a href="/reports/">See reports</a>
          <a href="/projects/">Open projects</a>
        </div>
      </div>
      <aside class="guide-panel" aria-label="Site guide status">
        <div class="panel-topline">
          <span>Guide mode</span>
          <strong>Find your route</strong>
        </div>
        <p>Answers come from visible pages, experiment cards, field notes, learning notes, and signal pages. The goal is simple: help the next click make sense.</p>
        <div class="stat-strip">
          {uxStats.map((stat) => (
            <div>
              <strong>{stat.value}</strong>
              <span>{stat.label}</span>
            </div>
          ))}
        </div>
      </aside>
    </section>

    <section class="ask-console" data-site-agent>
      <div class="console-head">
        <div>
          <span>Ask the lab</span>
          <h2>Type one question. Get a route.</h2>
        </div>
        <p>Works in the browser from the visible site map. No account, no form, no wait.</p>
      </div>
      <div class="prompt-row">
        <input id="site-question" type="text" placeholder="Try: show me wallet risk, explain agents, where are the charts..." autocomplete="off" />
        <button id="site-ask" type="button" aria-label="Ask Bionic Banker">Ask</button>
      </div>
      <div class="prompt-chips" aria-label="Suggested questions">
        {quickPrompts.map((prompt) => (
          <button type="button" data-prompt={prompt}>{prompt}</button>
        ))}
      </div>
      <article class="answer-card" id="site-answer">
        <div class="answer-meta">
          <span>Try a question</span>
          <small>Source: site map</small>
        </div>
        <h2>What can I inspect first?</h2>
        <p>Start with the Lab Tour if you want the shortest path through the work. Use Field Notes for numbers, Experiments for what runs, Learn for concepts, and Live Signals for moving rows.</p>
        <div class="answer-links">
          <a href="/proof-tour/">Open Lab Tour</a>
          <a href="/reports/">Open Field Notes</a>
          <a href="/projects/">Open Experiments</a>
        </div>
      </article>
    </section>

    <section class="source-panel">
        <div class="panel-head">
        <span>Route map</span>
        <h2>{sourceTiles.length} routes, one question box.</h2>
      </div>
      <div class="source-grid">
        {sourceTiles.map((tile) => (
          <a href={tile.href} class="source-tile">
            <div class="tile-top">
              <span>{tile.step}</span>
              <small>{tile.meta}</small>
            </div>
            <h3>{tile.label}</h3>
            <p>{tile.body}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="source-panel">
      <div class="panel-head">
        <span>How it behaves</span>
        <h2>Useful AI pages show where the answer came from.</h2>
      </div>
      <div class="pattern-grid">
        <article>
          <h3>Source-linked answers</h3>
          <p>People trust an AI interface more when claims point to the page or source behind them.</p>
          <a href="https://www.925studios.co/blog/ai-product-interface-examples-trust-2026" target="_blank" rel="noopener">Reference</a>
        </article>
        <article>
          <h3>Trust and control</h3>
          <p>Agent interfaces should make limits clear and keep the user in control of the next click.</p>
          <a href="https://www.weforum.org/stories/2026/02/how-to-design-for-trust-in-the-age-of-ai-agents/" target="_blank" rel="noopener">Reference</a>
        </article>
        <article>
          <h3>Inspectable systems</h3>
          <p>Current research keeps returning to the same idea: useful agents need visible behavior, accountability, and inspectable outputs.</p>
          <a href="https://research.ibm.com/publications/trust-cua-trustworthy-computer-using-generalist-agents-for-intelligent-user-interfaces" target="_blank" rel="noopener">Reference</a>
        </article>
      </div>
    </section>
  </main>

  <script id="site-brain-data" type="application/json" set:html={JSON.stringify(brain)}></script>
  <script is:inline>
  (function() {
    var input = document.getElementById('site-question');
    var askButton = document.getElementById('site-ask');
    var answer = document.getElementById('site-answer');
    if (!input || !askButton || !answer) return;

    var brainNode = document.getElementById('site-brain-data');
    var siteBrain = {};
    try {
      siteBrain = JSON.parse((brainNode && brainNode.textContent) || '{}');
    } catch (error) {
      siteBrain = {};
    }
    var routes = siteBrain.answer_routes || [];

    function render(result) {
      var linkHtml = result.links.map(function(link) {
        return '<a href="' + link[1] + '">' + link[0] + '</a>';
      }).join('');
      var followups = (result.followups || []).map(function(prompt) {
        return '<button type="button" data-followup="' + prompt + '">' + prompt + '</button>';
      }).join('');
      answer.innerHTML = '<div class="answer-meta"><span>' + result.label + '</span><small>Source: ' + result.source + '</small></div><h2>' + result.title + '</h2><p>' + result.body + '</p><div class="answer-links">' + linkHtml + '</div>' + (followups ? '<div class="followup-row">' + followups + '</div>' : '');
      answer.querySelectorAll('[data-followup]').forEach(function(button) {
        button.addEventListener('click', function() {
          input.value = button.getAttribute('data-followup') || '';
          ask(input.value);
        });
      });
    }

    function ask(question) {
      var q = (question || '').toLowerCase();
      var result = routes.find(function(route) {
        return route.keys.some(function(key) { return q.indexOf(key) >= 0; });
      }) || siteBrain.fallback_route;
      render(result);
      answer.classList.remove('answer-flash');
      window.requestAnimationFrame(function() { answer.classList.add('answer-flash'); });
    }

    askButton.addEventListener('click', function() { ask(input.value); });
    input.addEventListener('keydown', function(event) {
      if (event.key === 'Enter') ask(input.value);
    });
    document.querySelectorAll('[data-prompt]').forEach(function(button) {
      button.addEventListener('click', function() {
        input.value = button.getAttribute('data-prompt') || '';
        ask(input.value);
      });
    });
  })();
  </script>

  <style is:global>
    .ask-shell { max-width: var(--max); margin: 0 auto; padding: 3.5rem 2rem 4rem; display: grid; gap: 1rem; }
    .ask-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, 0.42fr); gap: 1rem; align-items: stretch; min-height: 360px; }
    .hero-copy, .guide-panel, .ask-console, .source-panel { border: 1px solid rgba(31, 160, 104, 0.22); border-radius: 8px; background: rgba(255, 255, 255, 0.035); }
    .hero-copy { padding: clamp(1.35rem, 4vw, 2.4rem); display: grid; align-content: end; background: radial-gradient(circle at 80% 15%, rgba(31, 160, 104, 0.16), transparent 34%), linear-gradient(145deg, rgba(255,255,255,0.035), rgba(2,2,4,0.35)); position: relative; overflow: hidden; }
    .hero-copy::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(31,160,104,0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(31,160,104,0.08) 1px, transparent 1px); background-size: 42px 42px; opacity: 0.22; mask-image: linear-gradient(135deg, black, transparent 70%); pointer-events: none; }
    .hero-copy > * { position: relative; }
    .route-kicker, .panel-topline span, .answer-card span, .panel-head span, .console-head span, .tile-top span, .tile-top small { color: #1fa068; font-family: var(--mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; }
    .ask-hero h1 { max-width: 820px; margin: 0.35rem 0 0.75rem; font-size: clamp(2.6rem, 7vw, 6.4rem); line-height: 0.92; letter-spacing: 0; }
    .ask-hero p, .guide-panel p, .answer-card p, .source-tile p, .pattern-grid p, .console-head p { color: var(--text-2); line-height: 1.7; margin: 0; }
    .hero-copy p { max-width: 720px; font-size: clamp(0.95rem, 1.6vw, 1.12rem); }
    .hero-actions-mini { display: flex; flex-wrap: wrap; gap: 0.65rem; margin-top: 1.25rem; }
    .hero-actions-mini a { border: 1px solid rgba(31,160,104,0.32); border-radius: 8px; color: var(--text); font-family: var(--mono); font-size: 0.78rem; padding: 0.65rem 0.8rem; min-height: 44px; display: inline-flex; align-items: center; background: rgba(2,2,4,0.36); }
    .guide-panel { display: grid; gap: 1rem; align-content: space-between; padding: 1.15rem; background: linear-gradient(180deg, rgba(31,160,104,0.13), rgba(2,2,4,0.36)); }
    .panel-topline { display: grid; gap: 0.4rem; }
    .panel-topline strong { font-size: 1.45rem; line-height: 1.2; }
    .stat-strip { display: grid; gap: 0.6rem; }
    .stat-strip div { border-top: 1px solid rgba(228,228,236,0.12); padding-top: 0.7rem; display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
    .stat-strip strong { color: var(--accent); font-size: 1.8rem; line-height: 1; }
    .stat-strip span { color: var(--text-3); font-family: var(--mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; }
    .ask-console, .source-panel { padding: 1.15rem; }
    .console-head { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 0.9rem; }
    .console-head h2 { margin: 0.25rem 0 0; letter-spacing: 0; font-size: clamp(1.25rem, 3vw, 2rem); }
    .console-head p { max-width: 300px; font-size: 0.84rem; }
    .prompt-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.7rem; }
    .prompt-row input { width: 100%; border: 1px solid rgba(228, 228, 236, 0.16); border-radius: 8px; background: rgba(2, 2, 4, 0.72); color: var(--text); font: inherit; padding: 1rem 1rem; min-width: 0; box-shadow: inset 0 0 0 1px rgba(255,255,255,0.015); }
    .prompt-row input:focus { outline: none; border-color: rgba(31,160,104,0.64); box-shadow: 0 0 0 3px rgba(31,160,104,0.12); }
    .prompt-row button, .prompt-chips button, .followup-row button { border: 1px solid rgba(31, 160, 104, 0.35); border-radius: 8px; background: rgba(31, 160, 104, 0.12); color: var(--text); cursor: pointer; font-family: var(--mono); min-height: 44px; padding: 0.75rem 1rem; transition: border-color 0.18s, transform 0.18s, background 0.18s; }
    .prompt-row button:hover, .prompt-chips button:hover, .followup-row button:hover { border-color: rgba(31,160,104,0.72); background: rgba(31,160,104,0.18); transform: translateY(-1px); }
    .prompt-chips { display: flex; flex-wrap: wrap; gap: 0.55rem; margin: 0.85rem 0; }
    .prompt-chips button { font-size: 0.78rem; padding: 0.6rem 0.75rem; }
    .answer-card { border: 1px solid rgba(228, 228, 236, 0.12); border-radius: 8px; background: rgba(2, 2, 4, 0.5); padding: 1rem; min-height: 200px; position: relative; overflow: hidden; }
    .answer-card::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--accent); opacity: 0.72; }
    .answer-card > * { position: relative; }
    .answer-card h2, .panel-head h2 { margin: 0.35rem 0 0.55rem; font-size: clamp(1.35rem, 3vw, 2.1rem); letter-spacing: 0; }
    .answer-meta { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
    .answer-meta small { color: var(--text-3); font-family: var(--mono); font-size: 0.7rem; }
    .answer-flash { animation: answerFlash 0.45s ease; }
    @keyframes answerFlash { 0% { border-color: rgba(31,160,104,0.75); transform: translateY(-1px); } 100% { border-color: rgba(228,228,236,0.12); transform: translateY(0); } }
    .answer-links, .source-grid, .pattern-grid { display: grid; gap: 0.85rem; }
    .answer-links { grid-template-columns: repeat(auto-fit, minmax(150px, max-content)); margin-top: 1rem; }
    .answer-links a, .source-tile, .pattern-grid a { color: #1fa068; text-decoration: none; font-family: var(--mono); font-size: 0.86rem; }
    .answer-links a { border: 1px solid rgba(31,160,104,0.28); border-radius: 8px; padding: 0.6rem 0.7rem; background: rgba(31,160,104,0.08); }
    .followup-row { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-top: 0.85rem; padding-top: 0.85rem; border-top: 1px solid rgba(228,228,236,0.1); }
    .followup-row button { color: var(--text-2); font-size: 0.72rem; padding: 0.6rem 0.75rem; background: rgba(255,255,255,0.035); }
    .source-grid, .pattern-grid { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
    .source-tile, .pattern-grid article { border: 1px solid rgba(228, 228, 236, 0.12); border-radius: 8px; background: rgba(2, 2, 4, 0.42); padding: 1rem; min-width: 0; transition: transform 0.18s, border-color 0.18s, background 0.18s; }
    .source-tile:hover, .pattern-grid article:hover { transform: translateY(-2px); border-color: rgba(31,160,104,0.36); background: rgba(31,160,104,0.06); }
    .tile-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.7rem; }
    .tile-top span { color: var(--text-3); }
    .tile-top small { color: var(--accent); }
    .source-tile h3, .pattern-grid h3 { margin: 0 0 0.5rem; color: var(--text); letter-spacing: 0; font-size: 1.05rem; }
    .pattern-grid a { display: inline-block; margin-top: 0.8rem; }
    .panel-head { margin-bottom: 1rem; }
    .nav-links a { min-width: 44px; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; }
    @media (max-width: 840px) { .ask-hero, .prompt-row { grid-template-columns: 1fr; } .ask-hero { min-height: auto; } .console-head { align-items: start; flex-direction: column; } .console-head p { max-width: none; } }
    @media (max-width: 640px) { .ask-shell { padding: 2.5rem 1rem 3rem; } .hero-actions-mini a, .answer-links a { width: 100%; } .answer-links { grid-template-columns: 1fr; } .prompt-row button { width: 100%; } }
  </style>
</BaseLayout>
