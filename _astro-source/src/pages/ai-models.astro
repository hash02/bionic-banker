---
import BaseLayout from '../layouts/BaseLayout.astro';

const definitionArticles = [
  {
    title: 'What Is an AI Model?',
    href: '/blog/what-is-an-ai-model/',
    summary: 'The basic idea: learned patterns, inputs, outputs, and the workflow around the model.'
  },
  {
    title: 'What Does Open Weight Mean in AI?',
    href: '/blog/what-does-open-weight-mean-ai/',
    summary: 'Model weights, open weight vs open source, and why the license matters before the hype.'
  },
];

const modelArticles = [
  {
    title: 'Claude Fable 5: What It Is, What It Does, and Why Finance Should Watch It',
    href: '/blog/claude-fable-5-finance-guide/',
    label: 'Claude',
    summary: 'Launch date, specs, pricing, benchmarks, long-running agents, and finance/crypto use cases.'
  },
];

const techniqueArticles = [
  {
    title: 'AI Model Benchmark Cost: The Missing Column',
    href: '/blog/ai-model-benchmark-cost/',
    label: 'Benchmarks',
    summary: 'How to read model leaderboards through cost, task fit, and finance-style tradeoffs instead of headline scores.'
  }
];

const simpleDefinitions = [
  {
    term: 'AI model',
    definition: 'A system trained to turn an input into an output: text, code, classification, summary, image, score, or action suggestion.',
    financeUse: 'Useful for drafting, search, triage, classification, explanation, and review support.'
  },
  {
    term: 'Large language model',
    definition: 'An AI model trained to predict and generate language. It can write, summarize, translate, reason over text, and call tools when connected to them.',
    financeUse: 'Useful for policies, notes, research, customer-message drafts, and analyst support when sources stay visible.'
  },
  {
    term: 'Context window',
    definition: 'The amount of information a model can read at once. A larger context window helps with long documents, but it does not guarantee accuracy.',
    financeUse: 'Useful for long PDFs, audit trails, contracts, policy manuals, and multi-source reviews.'
  },
  {
    term: 'Open weight',
    definition: 'A model where the learned weights are available for people to download or run under a license. It is not automatically open source.',
    financeUse: 'Useful when privacy, control, cost, or local deployment matters, but the license and security model still need review.'
  },
  {
    term: 'Inference',
    definition: 'The moment a trained model is used to produce an output from a new input.',
    financeUse: 'Useful to separate model training from day-to-day use, pricing, latency, and review controls.'
  },
  {
    term: 'Benchmark',
    definition: 'A test used to compare models. Benchmarks are helpful, but they rarely tell the full story for a real workflow.',
    financeUse: 'Use benchmarks with cost, latency, source handling, privacy, and human-review requirements.'
  },
];

const modelFamilies = [
  {
    name: 'Claude',
    owner: 'Anthropic',
    bestFor: 'Long-form analysis, writing, coding help, policy reasoning, and careful summaries.',
    verify: 'Check model ID, pricing, context limits, source handling, and tool permissions.'
  },
  {
    name: 'GPT',
    owner: 'OpenAI',
    bestFor: 'General reasoning, tool-using apps, multimodal workflows, product prototypes, and broad task coverage.',
    verify: 'Check current model availability, API pricing, data controls, and output-review needs.'
  },
  {
    name: 'Gemini',
    owner: 'Google',
    bestFor: 'Multimodal work, long-context research, document review, and Google ecosystem workflows.',
    verify: 'Check current model version, context behavior, file handling, and source trace quality.'
  },
  {
    name: 'Llama',
    owner: 'Meta',
    bestFor: 'Open-weight experimentation, local deployment, controlled environments, and custom workflows.',
    verify: 'Check license, hardware needs, quality tradeoffs, and whether local operation is actually required.'
  },
  {
    name: 'Qwen / DeepSeek / Mistral',
    owner: 'Open and commercial model labs',
    bestFor: 'Cost-sensitive automation, coding, local experiments, multilingual work, and model routing tests.',
    verify: 'Check license, hosting route, privacy posture, task fit, and current benchmark evidence.'
  },
  {
    name: 'Perplexity / answer engines',
    owner: 'Search-answer platforms',
    bestFor: 'Source discovery, quick research, current-event orientation, and finding documents to inspect.',
    verify: 'Open the cited sources. Treat the answer as a starting point, not proof.'
  },
];

const comparisonRules = [
  { label: 'Task fit', text: 'What job is the model doing: search, draft, code, classify, extract, summarize, or review?' },
  { label: 'Evidence', text: 'Can the reader see which source was used, what was inferred, and what remains uncertain?' },
  { label: 'Cost', text: 'What does the task cost at real volume, including retries, long context, and review time?' },
  { label: 'Privacy', text: 'Can the workflow safely handle documents, customer data, logs, or regulated context?' },
  { label: 'Boundary', text: 'What decision is the model not allowed to make?' },
  { label: 'Review', text: 'Who checks the output before it affects money, customers, compliance, or reputation?' },
];

const financeUseCases = [
  'Summarize policy documents and flag sections for human review.',
  'Draft AML or fraud investigation notes from structured evidence.',
  'Compare public sources before writing a market or regulation brief.',
  'Classify support or compliance messages into review queues.',
  'Generate code or tests for internal tools where a developer verifies the result.',
  'Create evidence packets: claim, source, model output, boundary, and next review step.',
];
---
<BaseLayout
  title="AI Models"
  description="Simple Bionic Banker guides to AI models, model families, benchmarks, costs, and how to use them in finance workflows with evidence and human review."
>
  <div class="page-header ai-models-hero">
    <div class="page-label">AI Models</div>
    <h1>AI models for finance, explained simply.</h1>
    <p class="page-sub">A clear hub for model vocabulary, model families, benchmarks, and practical finance workflows. The goal is not hype. The goal is to know what a model can do, what it cannot decide, and what evidence a person should check.</p>
    <div class="model-hero-actions">
      <a href="#definitions">Start with definitions</a>
      <a href="#families">Compare model families</a>
      <a href="#finance-use">Finance use cases</a>
      <a href="/blog/ai-model-benchmark-cost/">Read benchmark cost</a>
    </div>
  </div>

  <main class="models-wrap">
    <section class="model-intro-card control-map-card">
      <span class="section-label">How to read models</span>
      <h2>Use a model as part of a control map.</h2>
      <p>An AI model is not a decision-maker by default. In finance work, the safer pattern is: source → model output → evidence check → boundary → human review.</p>
      <div class="control-flow" aria-label="AI model control flow">
        <div><span>01</span><strong>Source</strong><em>document, row, message, record</em></div>
        <div><span>02</span><strong>Model</strong><em>summary, score, draft, extraction</em></div>
        <div><span>03</span><strong>Evidence</strong><em>what supports the output</em></div>
        <div><span>04</span><strong>Boundary</strong><em>what it cannot decide</em></div>
        <div><span>05</span><strong>Review</strong><em>person checks before action</em></div>
      </div>
    </section>

    <section class="model-section" id="definitions">
      <div class="section-headline">
        <span class="section-label">Simple definitions</span>
        <h2>Definitions before opinions.</h2>
        <p>Start here before comparing vendors, benchmarks, or model rankings.</p>
      </div>
      <div class="definition-grid">
        {simpleDefinitions.map((item) => (
          <article class="definition-card">
            <h3>{item.term}</h3>
            <p>{item.definition}</p>
            <div><strong>Finance use</strong><span>{item.financeUse}</span></div>
          </article>
        ))}
      </div>
    </section>

    <section class="model-section" id="families">
      <div class="section-headline">
        <span class="section-label">Model families</span>
        <h2>Different models fit different jobs.</h2>
        <p>Do not pick a model because it is famous. Pick it because the task, evidence requirement, privacy posture, and review workflow fit.</p>
      </div>
      <div class="family-table" role="table" aria-label="AI model families">
        <div class="family-row family-head" role="row">
          <strong>Family</strong><strong>Known for</strong><strong>Check before use</strong>
        </div>
        {modelFamilies.map((item) => (
          <div class="family-row" role="row">
            <div><span>{item.owner}</span><strong>{item.name}</strong></div>
            <p>{item.bestFor}</p>
            <p>{item.verify}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="model-section" id="compare">
      <div class="section-headline">
        <span class="section-label">Comparison rule</span>
        <h2>Compare models like a workflow, not a scoreboard.</h2>
      </div>
      <div class="rule-grid">
        {comparisonRules.map((item) => (
          <article>
            <span>{item.label}</span>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="model-section" id="finance-use">
      <div class="section-headline">
        <span class="section-label">Finance workflows</span>
        <h2>Where models can help without taking authority.</h2>
      </div>
      <div class="use-panel">
        <ul>
          {financeUseCases.map((item) => <li>{item}</li>)}
        </ul>
        <div class="boundary-callout">
          <strong>Boundary</strong>
          <p>AI model output can support research, drafting, triage, coding, and review. It should not approve trades, file compliance decisions, move funds, accuse customers, or replace professional judgment.</p>
        </div>
      </div>
    </section>

    <section class="model-section" id="guides">
      <div class="section-headline">
        <span class="section-label">Guides</span>
        <h2>Read the existing model guides.</h2>
      </div>
      <div class="model-card-grid">
        {definitionArticles.map((item) => (
          <a class="model-card" href={item.href}>
            <span>Definition</span>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
          </a>
        ))}
        {modelArticles.map((item) => (
          <a class="model-card" href={item.href}>
            <span>{item.label}</span>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
          </a>
        ))}
        {techniqueArticles.map((item) => (
          <a class="model-card" href={item.href}>
            <span>{item.label}</span>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
          </a>
        ))}
      </div>
    </section>
  </main>

  <style>
    .ai-models-hero { padding-bottom: 1rem; }
    .model-hero-actions { display: flex; flex-wrap: wrap; gap: 0.65rem; justify-content: center; margin-top: 1.25rem; }
    .model-hero-actions a {
      border: 1px solid rgba(31,160,104,0.3); border-radius: 999px; color: #e4e4ec;
      padding: 0.55rem 0.85rem; background: rgba(31,160,104,0.08); font-size: 0.9rem;
    }
    .models-wrap { width: min(1180px, calc(100% - 32px)); margin: 0 auto 4rem; }
    .model-intro-card {
      border: 1px solid rgba(31,160,104,0.18); background: rgba(31,160,104,0.045);
      border-radius: 16px; padding: 1.25rem; margin-bottom: 1.5rem;
    }
    .model-intro-card h2, .section-headline h2 { margin: 0.25rem 0 0.65rem; font-size: clamp(1.45rem, 2.6vw, 2.2rem); letter-spacing: 0; }
    .model-intro-card p, .section-headline p { color: var(--text-2); line-height: 1.7; margin: 0.4rem 0; }
    .model-section { margin-bottom: 2.3rem; }
    .section-headline { margin-bottom: 1rem; max-width: 820px; }
    .model-card-grid, .definition-grid, .rule-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(245px, 1fr)); gap: 0.9rem; }
    .model-card, .definition-card, .rule-grid article {
      min-height: 190px; display: flex; flex-direction: column; gap: 0.55rem;
      border: 1px solid rgba(255,255,255,0.08); border-top-color: rgba(31,160,104,0.28);
      border-radius: 14px; padding: 1rem; background: rgba(255,255,255,0.035); color: inherit;
      transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
    }
    .model-card:hover { transform: translateY(-2px); border-color: rgba(31,160,104,0.38); background: rgba(31,160,104,0.065); }
    .model-card span, .section-label, .definition-card div strong, .rule-grid span, .family-row span, .control-flow span { color: var(--accent, #1fa068); font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; }
    .model-card h3, .definition-card h3 { margin: 0; font-size: 1.08rem; }
    .model-card p, .definition-card p, .rule-grid p, .family-row p { color: var(--text-2); line-height: 1.55; margin: 0; }
    .definition-card div { margin-top: auto; border-top: 1px solid rgba(255,255,255,0.08); padding-top: 0.7rem; display: grid; gap: 0.35rem; }
    .definition-card div span { color: var(--text-2); line-height: 1.5; }
    .control-flow { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.65rem; margin-top: 1rem; }
    .control-flow div { border: 1px solid rgba(31,160,104,0.18); background: rgba(0,0,0,0.20); border-radius: 12px; padding: 0.85rem; display: grid; gap: 0.25rem; }
    .control-flow strong { color: #f4f4f4; }
    .control-flow em { color: var(--text-2); font-style: normal; font-size: 0.86rem; line-height: 1.4; }
    .family-table { border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; overflow: hidden; background: rgba(255,255,255,0.03); }
    .family-row { display: grid; grid-template-columns: 0.8fr 1.35fr 1.35fr; gap: 1rem; padding: 1rem; border-bottom: 1px solid rgba(255,255,255,0.07); align-items: start; }
    .family-row:last-child { border-bottom: 0; }
    .family-row div { display: grid; gap: 0.25rem; }
    .family-row div strong { font-size: 1.05rem; }
    .family-head { background: rgba(31,160,104,0.10); color: #e9fff4; font-family: var(--mono); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.12em; }
    .use-panel { display: grid; grid-template-columns: minmax(0,1.3fr) minmax(260px,0.7fr); gap: 1rem; align-items: stretch; }
    .use-panel ul { margin: 0; padding: 1.1rem 1.3rem; border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; background: rgba(255,255,255,0.035); color: var(--text-2); line-height: 1.65; }
    .use-panel li { margin: 0.35rem 0 0.35rem 1rem; }
    .boundary-callout { border: 1px solid rgba(31,160,104,0.25); border-radius: 16px; background: rgba(31,160,104,0.07); padding: 1rem; }
    .boundary-callout strong { color: var(--accent, #1fa068); font-family: var(--mono); text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.75rem; }
    .boundary-callout p { color: var(--text-2); line-height: 1.6; }
    @media (max-width: 820px) {
      .control-flow, .family-row, .use-panel { grid-template-columns: 1fr; }
      .family-head { display: none; }
    }
  </style>
</BaseLayout>
