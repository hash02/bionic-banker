---
import BaseLayout from '../layouts/BaseLayout.astro';

const notes = [
  {
    title: 'Mixer-heavy routing',
    signal: 'High attention',
    pattern: 'Repeated mixer contact and delayed consolidation',
    note: 'This row is trying very hard to look quiet. The route is the interesting part, not the amount.',
    read: 'Repeated mixer contact can make a wallet worth a second look, especially when the timing and later consolidation look coordinated.',
  },
  {
    title: 'Fast bridge movement',
    signal: 'High attention',
    pattern: 'Bridge flow followed by quick movement through other contracts',
    note: 'The funds did not sit still long enough to get comfortable. Bridge, hop, move again. That tempo is the signal.',
    read: 'Fast movement after bridge activity can matter when it appears with other routing signals. The important part is the sequence.',
  },
  {
    title: 'Repeated timing',
    signal: 'Medium attention',
    pattern: 'Similar amounts, similar spacing, similar destination behavior',
    note: 'Once is a transaction. Repeated spacing starts to look like a rhythm.',
    read: 'Repeated timing becomes useful when it lines up with repeated amounts, related addresses, or shared consolidation points.',
  },
  {
    title: 'False positive watch',
    signal: 'Always visible',
    pattern: 'A rule fires, but the surrounding context may explain it',
    note: 'A flag is not a verdict. Sometimes it is just the system asking for another look.',
    read: 'False positives matter because noise burns human attention. A good system shows why it paused and what would make the row less concerning.',
  },
];
---
<BaseLayout title="Wallet Risk Notes" description="A field-note gallery showing how wallet-risk patterns can be explained with rules, scores, and a plain-language voice layer.">
  <main class="roast-shell">
    <section class="roast-hero">
      <span>Wallet risk notes</span>
      <h1>Wallet Risk Notes</h1>
      <p>Some transaction patterns are hard to read cold. A score helps. A rule list helps. But the useful layer is usually the sentence that explains why the row made the system pause.</p>
      <div class="hero-actions">
        <a href="/wallet-risk/">Open Wallet Risk Assessment</a>
        <a href="/blog/roast-gallery/">Read the field note</a>
        <a href="/reports/">Open numbers</a>
      </div>
    </section>

    <section class="stats-strip" aria-label="Wallet risk note summary">
      <article>
        <strong>190</strong>
        <span>sample rows reviewed</span>
      </article>
      <article>
        <strong>28</strong>
        <span>mapped abilities</span>
      </article>
      <article>
        <strong>23</strong>
        <span>direct functions</span>
      </article>
      <article>
        <strong>4</strong>
        <span>pattern families</span>
      </article>
    </section>

    <section class="note-grid">
      {notes.map((item) => (
        <article class="note-card">
          <div class="note-head">
            <span>{item.signal}</span>
            <h2>{item.title}</h2>
            <p>{item.pattern}</p>
          </div>
          <blockquote>{item.note}</blockquote>
          <div class="read-box">
            <span>What the engine is reading</span>
            <p>{item.read}</p>
          </div>
        </article>
      ))}
    </section>

    <section class="limit-panel">
      <div>
        <span>Boundary</span>
        <h2>A note is not a verdict.</h2>
        <p>A score is a sorting tool. A rule hit is a reason to inspect context. A sample row is not evidence of wrongdoing, and this page is not legal advice or filing software.</p>
      </div>
      <div>
        <span>Cleaner route</span>
        <h2>Start with the assessment view.</h2>
        <p>The Wallet Risk Assessment is the safer front door for this idea. It shows the rules, score, sample row, limits, and voice layer in one place.</p>
      </div>
    </section>
  </main>

  <style>
    .roast-shell {
      width: 100%;
      max-width: var(--max);
      margin: 0 auto;
      padding: 3.5rem 2rem 4rem;
      overflow-x: hidden;
    }

    .roast-shell,
    .roast-shell * {
      box-sizing: border-box;
    }

    .roast-hero,
    .stats-strip,
    .note-card,
    .limit-panel {
      border: 1px solid rgba(228, 228, 236, 0.12);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.035);
      max-width: 100%;
      min-width: 0;
    }

    .roast-hero {
      padding: clamp(1.25rem, 3vw, 2rem);
      margin-bottom: 1rem;
    }

    .roast-hero span,
    .note-head span,
    .read-box span,
    .limit-panel span {
      display: block;
      color: #1fa068;
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 0.45rem;
    }

    .roast-hero h1 {
      font-size: clamp(2.3rem, 6vw, 5rem);
      line-height: 0.98;
      letter-spacing: 0;
      margin: 0 0 1rem;
    }

    .roast-hero p,
    .note-head p,
    .read-box p,
    .limit-panel p {
      color: var(--text-2);
      line-height: 1.7;
      margin: 0;
      overflow-wrap: anywhere;
    }

    .roast-hero p {
      max-width: 780px;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.7rem;
      margin-top: 1.35rem;
    }

    .hero-actions a {
      border: 1px solid rgba(31, 160, 104, 0.35);
      border-radius: 999px;
      color: var(--text);
      max-width: 100%;
      padding: 0.62rem 0.85rem;
      text-decoration: none;
      background: rgba(31, 160, 104, 0.08);
      overflow-wrap: anywhere;
    }

    .stats-strip {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.75rem;
      padding: 1rem;
      margin-bottom: 1rem;
    }

    .stats-strip article {
      border: 1px solid rgba(228, 228, 236, 0.1);
      border-radius: 8px;
      background: rgba(2, 2, 4, 0.35);
      padding: 0.9rem;
      min-width: 0;
    }

    .stats-strip strong {
      display: block;
      color: var(--text);
      font-size: clamp(1.6rem, 4vw, 2.7rem);
      line-height: 1;
      margin-bottom: 0.35rem;
    }

    .stats-strip span {
      color: var(--text-3);
      line-height: 1.45;
      font-size: 0.8rem;
    }

    .note-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1rem;
    }

    .note-card {
      padding: 1rem;
      min-width: 0;
    }

    .note-head h2,
    .limit-panel h2 {
      margin: 0 0 0.55rem;
      letter-spacing: 0;
    }

    blockquote {
      border-left: 3px solid #1fa068;
      margin: 1rem 0;
      padding: 0.2rem 0 0.2rem 1rem;
      color: var(--text);
      line-height: 1.65;
      font-size: 1.02rem;
    }

    .read-box {
      border: 1px solid rgba(31, 160, 104, 0.2);
      border-radius: 8px;
      background: rgba(31, 160, 104, 0.055);
      padding: 0.85rem;
    }

    .limit-panel {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      padding: 1rem;
      margin-top: 1rem;
    }

    .limit-panel > div {
      border: 1px solid rgba(228, 228, 236, 0.1);
      border-radius: 8px;
      background: rgba(2, 2, 4, 0.32);
      padding: 1rem;
    }

    @media (max-width: 760px) {
      .roast-shell {
        max-width: 100vw;
        padding: 2.5rem 1rem 3rem;
      }

      .stats-strip,
      .limit-panel {
        grid-template-columns: 1fr;
      }

      .roast-hero h1 {
        font-size: 2.2rem;
        line-height: 1.08;
        overflow-wrap: anywhere;
      }

      .hero-actions {
        align-items: flex-start;
        flex-direction: column;
      }
    }
  </style>
</BaseLayout>
