---
import BaseLayout from '../layouts/BaseLayout.astro';

const signalCatalog = await import('../../public/dashboard-data/intelligence-signal-catalog.json');
const heartbeatSnapshot = await import('../../public/dashboard-data/heartbeat.json');

const lanes = signalCatalog.default.signal_lanes;
const tickets = signalCatalog.default.ticket_rows;
const feeds = signalCatalog.default.external_feeds;
const heartbeat = heartbeatSnapshot.default;
const status = heartbeat.status || {};
const lastPrediction = status.last_prediction || {};
const predictionValue = lastPrediction.value || {};
const recentRows = (heartbeat.recent || []).slice(-8).reverse();
const leadRow = recentRows[0] || {};
const generatedAt = heartbeat.generated_at || signalCatalog.default.generated_at;
const accuracy = typeof status.accuracy_last_100 === 'number'
  ? `${Math.round(status.accuracy_last_100 * 100)}%`
  : 'n/a';
const confidence = typeof predictionValue.confidence === 'number'
  ? `${(predictionValue.confidence * 100).toFixed(1)}%`
  : 'n/a';

const formatTime = (iso) => {
  if (!iso) return 'n/a';
  try {
    const d = new Date(iso);
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) + ' at ' +
      d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: false });
  } catch { return iso.slice(0, 16); }
};

const resultClass = (row) => {
  if (row.scored_prior?.correct === true) return 'result-hit';
  if (row.scored_prior?.correct === false) return 'result-miss';
  return 'result-pending';
};

const resultLabel = (row) => {
  if (row.scored_prior?.correct === true) return 'hit';
  if (row.scored_prior?.correct === false) return 'miss';
  return 'pending';
};

const signalRoutes = [
  {
    eyebrow: 'Start',
    title: 'Read the latest signal',
    text: 'A small row that says what moved, when it moved, and where the line is.',
    href: '#recent-rows'
  },
  {
    eyebrow: 'Watch',
    title: 'Check the public market row',
    text: 'BTC, ETH, and SOL prices refresh in the browser when the public API answers.',
    href: '#market-row'
  },
  {
    eyebrow: 'Follow',
    title: 'View the review map',
    text: 'If the numbers feel too raw, the risk and evidence overview turns them into a slower walk.',
    href: '/risk-evidence-overview/'
  }
];
---
<BaseLayout title="Signals" description="Market, risk, and agent signal board from Bionic Banker. Research only, not trading advice.">
  <div class="page-header">
    <div class="page-label">Signal Board</div>
    <h1 class="page-title">Signals</h1>
    <p class="page-sub">Some ideas only make sense when you watch them move. This page collects market rows, risk reads, agent heartbeat data, and the limits around each signal. It is a research board, not a trading board.</p>
  </div>

  <main class="intel-shell">
    <section class="alive-console">
      <div class="console-copy">
        <span class="section-label">Right Now</span>
        <h2>What moved recently</h2>
        <p>Market rows refresh when the public source answers. Saved signal rows show the last read, when it happened, why it was recorded, and what it cannot decide.</p>
        <div class="console-actions">
          <a href="/risk-evidence-overview/" class="action-btn primary">Open Risk & Evidence Overview</a>
          <a href="/gaps/" class="action-btn secondary">Open Questions</a>
        </div>
      </div>
      <div class="terminal-bar">
        <div class="tbar-metric">
          <span class="tbar-label">Signal Rows</span>
          <strong class="tbar-value">{status.predictions_made || 'n/a'}</strong>
          <span class="tbar-sub">total logged</span>
        </div>
        <div class="tbar-divider"></div>
        <div class="tbar-metric">
          <span class="tbar-label">Last 100</span>
          <strong class="tbar-value tbar-accent">{accuracy}</strong>
          <span class="tbar-sub">accuracy</span>
        </div>
        <div class="tbar-divider"></div>
        <div class="tbar-metric">
          <span class="tbar-label">Last Read</span>
          <strong class="tbar-value">{predictionValue.direction || 'n/a'}</strong>
          <span class="tbar-sub">{confidence} confidence</span>
        </div>
        <div class="tbar-divider"></div>
        <div class="tbar-metric">
          <span class="tbar-label">Status</span>
          <strong class="tbar-value tbar-accent">
            <span class="pulse-dot" aria-hidden="true" style="display:inline-block;margin-right:0.3rem;"></span>
            {status.mode || 'LIVE'}
          </strong>
          <span class="tbar-sub">{generatedAt ? generatedAt.slice(0, 10) : 'snapshot'}</span>
        </div>
      </div>
      <p class="snapshot-note" style="margin-top:0.75rem;">For research only. Not investment advice, not trading performance, not a recommendation, and not a claim that the next row can be predicted.</p>
    </section>

    <section class="market-strip" id="market-row" data-feeds={JSON.stringify(feeds)}>
      <div class="strip-head">
        <span class="section-label">Market Row</span>
        <div class="market-controls">
          <span id="market-countdown" class="market-countdown">Refreshes in 60s</span>
          <button class="refresh-btn" type="button" data-refresh-market>Refresh</button>
        </div>
      </div>
      <div class="market-grid" data-market-grid>
        {feeds.map((feed) => (
          <article class="market-card" data-asset-card={feed.coingecko_id}>
            <span>{feed.symbol}</span>
            <strong data-price>loading</strong>
            <small data-change>loading</small>
          </article>
        ))}
      </div>
      <p class="feed-note" data-feed-note>Prices load when the public market API answers. The rest of this page is a saved snapshot.</p>
    </section>

    <div id="btc-spark-data" data-prices={JSON.stringify(recentRows.map(r => typeof r.price_now === 'number' ? r.price_now : null))} data-labels={JSON.stringify(recentRows.map(r => formatTime(r.iso)))} style="display:none"></div>
    <div class="spark-wrap">
      <canvas id="btc-spark"></canvas>
      <p class="spark-note">BTC price across last {recentRows.length} snapshot rows. From research snapshots, not live trading.</p>
    </div>

    <section class="reason-panel" aria-label="How to read the latest signal">
      <div class="reason-copy">
        <span class="section-label">Source Trail</span>
        <h2>Why the row says that</h2>
        <p>A signal is useful only when it shows where it came from, why it moved, and what it is not saying. This is the small trail behind the latest saved row.</p>
      </div>
      <div class="reason-steps">
        <article>
          <span>Source</span>
          <strong>Saved signal row</strong>
          <p>{leadRow.iso ? formatTime(leadRow.iso) : 'Waiting for the next snapshot.'}</p>
        </article>
        <article>
          <span>Reason</span>
          <strong>{leadRow.prediction?.direction || predictionValue.direction || 'No direction yet'}</strong>
          <p>{typeof leadRow.prediction?.confidence === 'number' ? `${(leadRow.prediction.confidence * 100).toFixed(1)}% confidence on this saved read.` : 'Confidence appears only when the row carries it.'}</p>
        </article>
        <article>
          <span>Age</span>
          <strong>{generatedAt ? 'Snapshot saved' : 'Waiting'}</strong>
          <p>{generatedAt || 'The next saved row will add a timestamp here.'}</p>
        </article>
        <article>
          <span>Limit</span>
          <strong>Research note</strong>
          <p>Not advice, not a trade, not a fund result, and not a promise that the next row will agree.</p>
        </article>
      </div>
    </section>

    <section class="recent-panel" id="recent-rows">
      <div class="panel-head">
        <div>
          <span class="section-label">Signal Rows</span>
          <h2>Recent reads</h2>
        </div>
        <a href="/dashboard-data/heartbeat.json" target="_blank" rel="noopener">Open snapshot</a>
      </div>
      <div class="recent-table">
        <div class="recent-row recent-head">
          <span>When</span>
          <span>Signal</span>
          <span>Price</span>
          <span>Result</span>
        </div>
        {recentRows.map((row) => (
          <div class="recent-row">
            <span class="row-time">{formatTime(row.iso)}</span>
            <span>{row.prediction?.direction || 'n/a'} <span class="row-conf">({typeof row.prediction?.confidence === 'number' ? `${(row.prediction.confidence * 100).toFixed(1)}%` : 'n/a'})</span></span>
            <span>{typeof row.price_now === 'number' ? `$${Math.round(row.price_now).toLocaleString('en-US')}` : 'n/a'}</span>
            <span class={resultClass(row)}>{resultLabel(row)}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="reason-panel" aria-label="Signal operating rule">
      <div class="reason-copy">
        <span class="section-label">Operating Rule</span>
        <h2>Signals are prompts for judgment</h2>
        <p>A useful signal should create a better question, not a blind action. The board is allowed to observe, compare, and explain. It is not allowed to recommend a trade or hide uncertainty.</p>
      </div>
      <div class="reason-steps">
        <article><span>Observe</span><strong>What changed</strong><p>Market price, heartbeat state, confidence, or a source row.</p></article>
        <article><span>Explain</span><strong>Why it matters</strong><p>Connect the row to risk, workflow design, or a learning note.</p></article>
        <article><span>Bound</span><strong>What it cannot do</strong><p>No advice, no autonomous action, no performance claim.</p></article>
        <article><span>Package</span><strong>What comes next</strong><p>Turn useful patterns into an app improvement, field note, or checker.</p></article>
      </div>
    </section>

    <section class="lane-grid">
      {lanes.map((lane) => (
        <article class="lane-card" id={lane.id}>
          <span>{lane.label}</span>
          <h3>{lane.question}</h3>
          <p class="lane-meta">{lane.public_source} / {lane.display_mode}</p>
        </article>
      ))}
    </section>

    <section class="ticket-panel">
      <div class="panel-head">
        <div>
          <span class="section-label">Open Loops</span>
          <h2>Where to go next</h2>
        </div>
        <a href="/reports/">Field Notes</a>
      </div>
      <div class="ticket-list">
        {tickets.map((ticket) => (
          <article class="ticket-row">
            <div class="ticket-meta">
              <span class={`ticket-status status-${ticket.status}`}>{ticket.status}</span>
              <strong class="ticket-lane">{ticket.lane}</strong>
            </div>
            <p class="ticket-question">{ticket.question}</p>
            <div class="ticket-foot">
              <small>{ticket.public_note}</small>
              <a href={ticket.link}>Open</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="signal-route-grid" aria-label="Navigate the signal board">
      {signalRoutes.map((route) => (
        <a class="signal-route-card" href={route.href}>
          <span>{route.eyebrow}</span>
          <strong>{route.title}</strong>
          <p>{route.text}</p>
        </a>
      ))}
    </section>
  </main>

  <script>
    const strip = document.querySelector('.market-strip');
    const feedNote = document.querySelector('[data-feed-note]');
    const refreshButton = document.querySelector('[data-refresh-market]');
    const countdownEl = document.getElementById('market-countdown');
    let secondsLeft = 60;

    function formatPrice(value) {
      if (typeof value !== 'number') return 'n/a';
      return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: value > 100 ? 0 : 2 }).format(value);
    }

    function formatChange(value) {
      if (typeof value !== 'number') return '24h change n/a';
      const sign = value > 0 ? '+' : '';
      return `${sign}${value.toFixed(2)}% 24h`;
    }

    async function refreshMarket() {
      if (!strip) return;
      const feeds = JSON.parse(strip.dataset.feeds || '[]');
      const ids = feeds.map((feed) => feed.coingecko_id).join(',');
      if (!ids) return;

      if (feedNote) feedNote.textContent = 'Refreshing public market row...';

      try {
        const response = await fetch(`https://api.coingecko.com/api/v3/simple/price?ids=${ids}&vs_currencies=usd&include_24hr_change=true`, {
          headers: { accept: 'application/json' }
        });
        if (!response.ok) throw new Error('market fetch failed');
        const data = await response.json();

        feeds.forEach((feed) => {
          const card = document.querySelector(`[data-asset-card="${feed.coingecko_id}"]`);
          if (!card) return;
          const price = card.querySelector('[data-price]');
          const change = card.querySelector('[data-change]');
          const row = data[feed.coingecko_id] || {};
          if (price) price.textContent = formatPrice(row.usd);
          if (change) change.textContent = formatChange(row.usd_24h_change);
        });

        if (feedNote) feedNote.textContent = `Market row refreshed ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}.`;
      } catch (error) {
        if (feedNote) feedNote.textContent = 'Market refresh is unavailable right now. The saved rows are still visible.';
      }
    }

    function updateCountdown() {
      if (countdownEl) countdownEl.textContent = `Refreshes in ${secondsLeft}s`;
    }

    function resetCountdown() {
      secondsLeft = 60;
      updateCountdown();
    }

    function tickMarketCountdown() {
      secondsLeft -= 1;
      updateCountdown();
      if (secondsLeft <= 0) {
        resetCountdown();
        refreshMarket();
      }
    }

    refreshButton?.addEventListener('click', () => {
      resetCountdown();
      refreshMarket();
    });
    updateCountdown();
    refreshMarket();
    window.setInterval(tickMarketCountdown, 1000);

    // BTC Sparkline
    (function loadSparkline() {
      const sparkDataEl = document.getElementById('btc-spark-data');
      if (!sparkDataEl) return;
      const prices = JSON.parse(sparkDataEl.dataset.prices || '[]');
      const labels = JSON.parse(sparkDataEl.dataset.labels || '[]');
      if (!prices.filter(Boolean).length) return;

      function initChart() {
        const canvas = document.getElementById('btc-spark');
        if (!canvas || !window.Chart) return;
        requestAnimationFrame(() => {
          const wrap = canvas.parentElement;
          const w = wrap ? wrap.clientWidth : 600;
          canvas.width = w;
          canvas.height = 90;
          new window.Chart(canvas, {
            type: 'line',
            data: {
              labels,
              datasets: [{
                data: prices,
                borderColor: '#1fa068',
                borderWidth: 2,
                pointRadius: 3,
                pointHoverRadius: 5,
                pointBackgroundColor: '#1fa068',
                fill: true,
                backgroundColor: 'rgba(31, 160, 104, 0.09)',
                tension: 0.38,
              }]
            },
            options: {
              responsive: false,
              maintainAspectRatio: false,
              plugins: {
                legend: { display: false },
                tooltip: { callbacks: { label: (c) => `$${Math.round(c.parsed.y).toLocaleString('en-US')}` } }
              },
              scales: { x: { display: false }, y: { display: false } }
            }
          });
          canvas.style.width = '100%';
          canvas.style.height = '90px';
        });
      }

      if (window.Chart) {
        initChart();
      } else {
        const s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js';
        s.onload = initChart;
        document.head.appendChild(s);
      }
    })();
  </script>

  <style>
    .intel-shell {
      max-width: var(--max);
      margin: 0 auto;
      padding: 0 2rem 3rem;
      display: grid;
      gap: 2rem;
    }

    .alive-console,
    .market-strip,
    .ticket-panel,
    .recent-panel,
    .reason-panel,
    .signal-route-card {
      border: 1px solid rgba(31, 160, 104, 0.22);
      background: rgba(255, 255, 255, 0.035);
      border-radius: 8px;
      padding: 1.35rem;
    }

    .alive-console {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .console-copy h2,
    .panel-head h2 {
      margin: 0.25rem 0 0.75rem;
      font-size: clamp(1.4rem, 2.5vw, 2.25rem);
      letter-spacing: 0;
    }

    .console-copy p,
    .snapshot-note,
    .feed-note,
    .lane-card p,
    .ticket-row p,
    .ticket-row small {
      color: var(--text-2);
      line-height: 1.65;
      margin: 0;
    }

    .console-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
      margin-top: 1rem;
    }

    .action-btn,
    .refresh-btn,
    .panel-head a,
    .ticket-row a {
      font-family: var(--mono);
      font-size: 0.76rem;
      font-weight: 600;
      border-radius: 6px;
      text-decoration: none;
    }

    .action-btn {
      padding: 0.55rem 1rem;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .action-btn.primary,
    .refresh-btn {
      background: var(--accent);
      color: #fff;
      border: 1px solid var(--accent);
    }

    .action-btn.secondary {
      color: var(--accent);
      border: 1px solid var(--accent-border);
    }

    .heartbeat-card {
      background: rgba(2, 2, 4, 0.55);
      border: 1px solid rgba(228, 228, 236, 0.12);
      border-radius: 8px;
      padding: 1rem;
      display: grid;
      gap: 1rem;
    }

    .heartbeat-top {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      flex-wrap: wrap;
      font-family: var(--mono);
      color: var(--text);
    }

    .heartbeat-top small {
      color: var(--text-3);
      margin-left: auto;
    }

    .pulse-dot {
      width: 0.72rem;
      height: 0.72rem;
      border-radius: 999px;
      background: var(--accent);
      box-shadow: 0 0 18px rgba(31, 160, 104, 0.45);
      animation: pulseBlink 1.4s ease-in-out infinite;
    }

    .heartbeat-metrics,
    .market-grid,
    .lane-grid,
    .signal-route-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 0.85rem;
    }

    .signal-route-card {
      display: grid;
      gap: 0.55rem;
      min-height: 100%;
      padding: 1rem;
      text-decoration: none;
      transition: border-color 160ms ease, transform 160ms ease;
    }

    .signal-route-card:hover,
    .signal-route-card:focus-visible {
      border-color: rgba(31, 160, 104, 0.62);
      transform: translateY(-1px);
    }

    .signal-route-card span {
      color: var(--accent);
      font-family: var(--mono);
      font-size: 0.68rem;
      text-transform: uppercase;
    }

    .signal-route-card strong {
      color: var(--text);
      font-size: 1rem;
      line-height: 1.3;
    }

    .signal-route-card p {
      color: var(--text-2);
      line-height: 1.55;
      margin: 0;
    }

    .reason-panel {
      display: grid;
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
      gap: 1rem;
      align-items: stretch;
    }

    .reason-copy h2 {
      margin: 0.25rem 0 0.65rem;
      font-size: clamp(1.35rem, 2.2vw, 2rem);
      letter-spacing: 0;
    }

    .reason-copy p {
      color: var(--text-2);
      line-height: 1.65;
      margin: 0;
    }

    .reason-steps {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .reason-steps article {
      border: 1px solid rgba(228, 228, 236, 0.12);
      background: rgba(2, 2, 4, 0.42);
      border-radius: 8px;
      padding: 0.9rem;
      min-width: 0;
    }

    .reason-steps span {
      display: block;
      color: var(--accent);
      font-family: var(--mono);
      font-size: 0.68rem;
      text-transform: uppercase;
      margin-bottom: 0.35rem;
    }

    .reason-steps strong {
      display: block;
      color: var(--text);
      font-size: 0.95rem;
      line-height: 1.3;
      margin-bottom: 0.35rem;
    }

    .reason-steps p {
      color: var(--text-2);
      font-size: 0.8rem;
      line-height: 1.5;
      margin: 0;
    }

    .heartbeat-metrics div,
    .market-card,
    .lane-card {
      border: 1px solid rgba(228, 228, 236, 0.12);
      background: rgba(2, 2, 4, 0.42);
      border-radius: 8px;
      padding: 0.9rem;
      min-width: 0;
    }

    .heartbeat-metrics span,
    .market-card span,
    .lane-card span {
      display: block;
      color: var(--text-3);
      font-family: var(--mono);
      font-size: 0.68rem;
      text-transform: uppercase;
      margin-bottom: 0.35rem;
    }

    .heartbeat-metrics strong,
    .market-card strong {
      color: var(--accent);
      font-size: 1.35rem;
      line-height: 1.1;
    }

    .strip-head,
    .panel-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .refresh-btn {
      padding: 0.45rem 0.8rem;
      cursor: pointer;
      min-height: 44px;
    }

    .market-controls {
      display: inline-flex;
      align-items: center;
      gap: 0.65rem;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .market-countdown {
      font-size: 0.72rem;
      font-family: var(--mono);
      color: var(--text-3);
      min-width: 92px;
    }

    .market-card small {
      display: block;
      color: var(--text-2);
      margin-top: 0.4rem;
      font-family: var(--mono);
      font-size: 0.7rem;
    }

    .feed-note {
      margin-top: 0.9rem;
      font-size: 0.82rem;
    }

    .lane-card {
      display: grid;
      gap: 0.6rem;
    }

    .lane-card h3 {
      margin: 0;
      font-size: 1.05rem;
      line-height: 1.35;
    }

    .lane-meta {
      color: var(--text-3);
      font-size: 0.76rem;
      font-family: var(--mono);
      margin: 0;
      line-height: 1.4;
    }

    .panel-head a,
    .ticket-row a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      color: var(--accent);
      white-space: nowrap;
    }

    .ticket-list {
      display: grid;
      gap: 0.75rem;
    }

    .ticket-row {
      display: grid;
      gap: 0.55rem;
      border: 1px solid rgba(228, 228, 236, 0.12);
      background: rgba(2, 2, 4, 0.42);
      border-radius: 8px;
      padding: 1rem 1.1rem;
    }

    .ticket-meta {
      display: flex;
      align-items: center;
      gap: 0.55rem;
    }

    .ticket-lane {
      color: var(--text);
      font-size: 0.9rem;
    }

    .ticket-question {
      color: var(--text);
      font-size: 0.95rem;
      line-height: 1.5;
      margin: 0;
    }

    .ticket-foot {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }

    .ticket-status {
      width: max-content;
      border: 1px solid rgba(31, 160, 104, 0.38);
      color: var(--accent);
      border-radius: 999px;
      padding: 0.15rem 0.45rem;
      font-family: var(--mono);
      font-size: 0.66rem;
      text-transform: uppercase;
    }

    .recent-table {
      display: grid;
      gap: 0.45rem;
    }

    .recent-row {
      display: grid;
      grid-template-columns: minmax(140px, 1.2fr) minmax(130px, 1fr) minmax(100px, 0.7fr) minmax(72px, 0.45fr);
      gap: 0.8rem;
      border: 1px solid rgba(228, 228, 236, 0.1);
      border-radius: 8px;
      padding: 0.75rem 1rem;
      color: var(--text-2);
      font-size: 0.83rem;
      font-family: var(--mono);
    }

    .recent-head {
      color: var(--accent);
      font-size: 0.68rem;
      text-transform: uppercase;
      border-color: transparent;
      background: transparent;
      padding-left: 1rem;
    }

    .row-time {
      color: var(--text);
    }

    .row-conf {
      color: var(--text-3);
      font-size: 0.77rem;
    }

    .result-hit { color: var(--accent); font-weight: 600; }
    .result-miss { color: #e05555; }
    .result-pending { color: var(--text-3); }

    .terminal-bar {
      position: relative;
      display: flex;
      align-items: center;
      gap: 0;
      background: #031008;
      border: 1px solid rgba(31, 160, 104, 0.22);
      border-radius: 10px;
      padding: 1.75rem 1.5rem 1.25rem;
      flex-wrap: wrap;
    }

    .terminal-bar::before {
      content: "live signal feed";
      position: absolute;
      top: 0.65rem;
      left: 1.5rem;
      color: #1fa068;
      font-family: var(--mono, monospace);
      font-size: 0.58rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .tbar-metric {
      flex: 1;
      min-width: 120px;
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      padding: 0.25rem 1rem;
      opacity: 0;
      transform: translateY(6px);
      animation: feedRowIn 420ms ease forwards;
    }

    .tbar-metric:nth-of-type(1) { animation-delay: 80ms; }
    .tbar-metric:nth-of-type(3) { animation-delay: 180ms; }
    .tbar-metric:nth-of-type(5) { animation-delay: 280ms; }
    .tbar-metric:nth-of-type(7) { animation-delay: 380ms; }

    .tbar-divider {
      width: 1px;
      height: 2.5rem;
      background: rgba(31, 160, 104, 0.15);
      flex-shrink: 0;
    }

    .tbar-label {
      font-family: var(--mono, monospace);
      font-size: 0.6rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--text-3, var(--text-3));
    }

    .tbar-value {
      font-family: var(--mono, monospace);
      font-size: 1.45rem;
      font-weight: 700;
      color: var(--text, var(--text));
      line-height: 1.1;
      letter-spacing: -0.02em;
    }

    .tbar-accent {
      color: #1fa068;
    }

    .tbar-sub {
      font-family: var(--mono, monospace);
      font-size: 0.62rem;
      color: var(--text-3, var(--text-3));
    }

    .tbar-metric:last-child .tbar-sub::after {
      content: "";
      display: inline-block;
      width: 0.42rem;
      height: 0.9em;
      margin-left: 0.35rem;
      vertical-align: -0.08em;
      background: #1fa068;
      animation: cursorBlink 1s steps(2, start) infinite;
    }

    @keyframes feedRowIn {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes cursorBlink {
      50% { opacity: 0; }
    }

    @keyframes pulseBlink {
      0%, 100% {
        opacity: 1;
        box-shadow: 0 0 18px rgba(31, 160, 104, 0.45);
      }
      50% {
        opacity: 0.45;
        box-shadow: 0 0 8px rgba(31, 160, 104, 0.28);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .pulse-dot,
      .tbar-metric,
      .tbar-metric:last-child .tbar-sub::after {
        animation: none;
      }

      .tbar-metric {
        opacity: 1;
        transform: none;
      }
    }

    .spark-wrap {
      background: #010302;
      border: 1px solid rgba(31, 160, 104, 0.22);
      border-radius: 8px;
      padding: 1rem 1.1rem 0.6rem;
      position: relative;
      overflow: hidden;
    }

    .spark-wrap canvas {
      display: block;
      width: 100% !important;
      height: 90px !important;
      max-width: 100%;
    }

    .spark-note {
      color: var(--text-3);
      font-size: 0.72rem;
      font-family: var(--mono);
      margin: 0.45rem 0 0;
      line-height: 1.4;
    }

    @media (max-width: 640px) {
      .terminal-bar { gap: 1rem; padding: 1rem; }
      .tbar-divider { display: none; }
      .tbar-metric { min-width: calc(50% - 0.5rem); padding: 0; }
      .tbar-value { font-size: 1.2rem; }
    }

    @media (max-width: 860px) {
      .alive-console,
      .reason-panel,
      .ticket-row,
      .recent-row {
        grid-template-columns: 1fr;
      }

      .heartbeat-top small {
        margin-left: 0;
      }

      .reason-steps {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .intel-shell {
        padding: 0 1.25rem 2rem;
      }

      .strip-head,
      .panel-head {
        flex-direction: column;
      }
    }
  </style>
</BaseLayout>
