---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Risk Evidence and Risk Profiles';
const description = 'Plain-English entry point for wallet risk profiles, fraud triage, AML notes, and evidence-backed finance AI examples.';
---

<BaseLayout title={title} description={description} canonical="https://bionicbanker.tech/risk-evidence/">
  <main class="page-wrap">
    <section class="hero-section compact">
      <p class="eyebrow">Risk evidence</p>
      <h1>Risk Evidence and Risk Profiles</h1>
      <p class="lede">
        Start here when you want a non-technical explanation of a finance or crypto risk event.
        Each profile separates the signal, the evidence, the limits, and the reader-checkable records before it draws a conclusion.
      </p>
      <div class="hero-actions">
        <a class="btn primary" href="/risk-evidence-overview/">Start with the overview</a>
        <a class="btn secondary" href="/wallet-risk/">See a wallet risk example</a>
      </div>
    </section>

    <section class="content-grid three-up" aria-label="Risk profile entry points">
      <article class="panel-card">
        <p class="card-label">1. Wallet risk</p>
        <h2>Transaction patterns in normal language</h2>
        <p>Follow a suspicious wallet pattern from signal to reason to reader-friendly explanation.</p>
        <a href="/wallet-risk/">Open wallet risk →</a>
      </article>
      <article class="panel-card">
        <p class="card-label">2. Fraud triage</p>
        <h2>Case notes before conclusions</h2>
        <p>Review how evidence, limits, and human-readable triage notes fit together.</p>
        <a href="/fraud-alert-triage/">Open fraud triage →</a>
      </article>
      <article class="panel-card">
        <p class="card-label">3. Full overview</p>
        <h2>Risk Profiles hub</h2>
        <p>Use the full overview for linked projects, public proof records, and related AI finance questions.</p>
        <a href="/risk-evidence-overview/">Open overview →</a>
      </article>
    </section>
  </main>
</BaseLayout>
