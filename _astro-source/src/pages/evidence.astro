---
import BaseLayout from '../layouts/BaseLayout.astro';

const catalog = await import('../../public/dashboard-data/source-catalog.json');
const data = catalog.default;
const projects = data.projects ?? [];
const generatedDate = new Date(data.generated_at).toISOString().slice(0, 10);
const sourceCount = projects.reduce((sum, project) => sum + (project.sources?.length ?? 0), 0);
const boundaryCount = projects.reduce((sum, project) => sum + (project.limits?.length ?? 0), 0);
const numberCount = projects.reduce((sum, project) => sum + (project.numbers?.length ?? 0), 0);
const flagshipOrder = ['aml-engine-roaster', 'aml-status-evidence', 'fraud-alert-triage', 'agent-chess', 'agent-framework-proof-v2'];
const orderedProjects = [
  ...flagshipOrder.map((id) => projects.find((project) => project.id === id)).filter(Boolean),
  ...projects.filter((project) => !flagshipOrder.includes(project.id)),
];
---
<BaseLayout title="Source Catalog" description="Rendered public source catalog for Bionic Banker catalog sections, sources, numbers, and boundaries.">
  <main class="page-shell systems-wrap">
    <section class="page-hero">
      <span class="eyebrow">PUBLIC SOURCE CATALOG</span>
      <h1 class="page-title">Source trails, not raw JSON first.</h1>
      <p class="page-sub">A rendered reader-facing catalog of the public catalog sections behind Bionic Banker. Raw data is still available, but the primary path explains what each lane shows, what supports it, and what remains bounded.</p>
      <div class="page-metric-row" aria-label="Source catalog metrics">
        <div><strong>{projects.length}</strong><span>catalog sections</span></div>
        <div><strong>{sourceCount}</strong><span>catalog source trails</span></div>
        <div><strong>{numberCount}</strong><span>catalog number notes</span></div>
        <div><strong>{boundaryCount}</strong><span>catalog boundaries</span></div>
      </div>
    </section>

    <section class="systems-audit-panel representation-strip" aria-label="How to read the source catalog">
      <div>
        <span class="systems-audit-label">READER PATH</span>
        <strong>Start with the flagship catalog sections.</strong>
        <p>Wallet Risk, AML Status, Fraud Alert Triage, and Agent Chess show the main pattern: assess a financial object, preserve the source trail, explain the limit, and keep authority with a human reader.</p>
      </div>
      <div>
        <span class="systems-audit-label">BOUNDARY</span>
        <strong>Public records are not production authority.</strong>
        <p>This catalog does not claim autonomous compliance approval, filing authority, trade execution, wallet control, or guaranteed fraud detection.</p>
      </div>
      <div>
        <span class="systems-audit-label">RAW DATA</span>
        <strong>Raw JSON is secondary.</strong>
        <p>Use the rendered page first. Open the raw JSON only when you want to inspect the source record behind the page.</p>
      </div>
      <div>
        <span class="systems-audit-label">READING METHOD</span>
        <strong>Signal, source, record, gap, question, limit.</strong>
        <p>Each catalog section should help the reader see what was observed, what supports it, what is missing, and what remains a human decision.</p>
      </div>
    </section>

    <section class="articles-grid" aria-label="Source sections">
      {orderedProjects.map((project) => (
        <article class="article-card" id={project.id}>
          <span>{project.status?.label ?? 'Source section'}</span>
          <h2>{project.name}</h2>
          <p>{project.what_it_is}</p>
          <div class="system-proof-grid">
            <div><span>Sources</span><strong>{project.sources?.length ?? 0}</strong></div>
            <div><span>Numbers</span><strong>{project.numbers?.length ?? 0}</strong></div>
            <div><span>Boundaries</span><strong>{project.limits?.length ?? 0}</strong></div>
          </div>
          {project.numbers?.length ? (
            <ul class="system-list">
              {project.numbers.slice(0, 3).map((number) => <li>{number}</li>)}
            </ul>
          ) : null}
          {project.limits?.length ? (
            <div class="systems-audit-panel">
              <div>
                <span class="systems-audit-label">BOUNDARY</span>
                <p>{project.limits[0]}</p>
              </div>
            </div>
          ) : null}
          <div class="system-link-cloud" aria-label={`Source links for ${project.name}`}>
            {project.sources?.slice(0, 4).map((source) => source.url ? <a href={source.url}>{source.label}</a> : <span>{source.label}</span>)}
          </div>
        </article>
      ))}
    </section>

    <section class="systems-audit-panel" aria-label="Catalog source trail">
      <div>
        <span class="systems-audit-label">GENERATED</span>
        <strong>{generatedDate}</strong>
        <p>Metrics on this page are computed from the public source catalog record.</p>
      </div>
      <div>
        <span class="systems-audit-label">SOURCE RECORD</span>
        <strong>Raw JSON available for inspection</strong>
        <p><a href="/dashboard-data/source-catalog.json">View source catalog JSON</a></p>
      </div>
    </section>
  </main>
</BaseLayout>
