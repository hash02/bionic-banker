---
import BaseLayout from '../layouts/BaseLayout.astro';

const systems = [
  ['Wallet Risk Assessment', '/wallet-risk', 'Risk judgment', 'Score, rule explanation, and plain-language note for sample wallet-risk rows.'],
  ['AML Status', '/aml-status-evidence', 'Auditability', 'Source trail, checks, visible claims, and explicit clear limits.'],
  ['Fraud Alert Triage Workflow', '/fraud-alert-triage', 'Alert operations', 'Synthetic signals converted into a system record, case note, and human next step.'],
  ['Agent Workflow Case Review', '/agent-prototype-sprint', 'Workflow packaging', 'One messy finance-risk workflow converted into a case record, review summary, and human review step.'],
  ['Agent Chess / Agent Workflow', '/risk-evidence-overview#agent-chess-showcase', 'Agent operations', 'Turn-taking, state preservation, review gates, and public records without outside-action power.'],
  ['Site Health / Health Board', '/proof/site-health', 'Self-checking records', 'Metric contracts, link checks, JSON-framing checks, mobile QA, and public status.'],
  ['Context Engine Map', '/blog/context-engine-missing-layer/', 'Source-led retrieval', 'A public note and diagram for turning raw sources into agent plans, AML questions, wallet-watch reports, and human next steps.'],
];

const sourceMap = [
  ['System cards', '12', 'Rendered systems a reader can inspect.'],
  ['Catalog sections', '8', 'Catalog-backed sections with sources and boundaries.'],
  ['Source links', '21', 'Public-safe sources linked from the source catalog.'],
  ['Named limits', '36', 'Explicit limits that prevent overclaiming.'],
  ['Articles / notes', '46', 'Writing that supports the finance, AI, and agent-system context.'],
];

const stack = [
  'Astro static site with committed static output',
  'GitHub repositories for code, issues, and public change history',
  'Hermes Agent for local agent runs, scheduled checks, and tool use',
  'Codex, Claude Code, and OpenCode-style coding agents tested as builders and reviewers',
  'Ollama-style local models for low-cost local reasoning tests',
  'SQLite ledgers and queues for small-system records',
  'Node.js QA checks for copy, links, metrics, and page framing',
  'Mobile QA gate for layout regressions',
];

const visualAnchors = [
  ['Hermes Agent', 'Local agent operating layer', 'Good future visual: agent console, scheduled run, tool-call trace, or mission-control card.'],
  ['Claude Code / Codex / OpenCode', 'Builder and reviewer lane', 'Good future visual: code review diff, test gate, reviewer lane, or build trace.'],
  ['Ollama / local models', 'Local model route', 'Good future visual: small GPU node, local model card, cost cap, or routing decision.'],
  ['SQLite', 'Record and queue layer', 'Good future visual: ledger row, message queue, run history, or recovery record.'],
  ['GitHub', 'Public change history', 'Good future visual: commit trail, issue map, release note, or validator check.'],
  ['OpenClaw / agent security research', 'External risk reference', 'Good future visual: skill supply-chain diagram, trust boundary, or malicious-skill case note.'],
  ['Context engine', 'Source and judgment layer', 'Good current visual: raw sources, context checks, compressed outputs, and clear limits.'],
];

const questions = [
  'Which finance-risk workflow should be made more inspectable first?',
  'Where should AI draft a note while a human keeps final approval?',
  'Which review record would help a reader without hiding the source?',
  'What public summary would show judgment without exposing private data?',
  'Which limit matters most: wallet control, filing power, deployment power, or data privacy?',
];
---
<BaseLayout title="System Map" description="A compact Bionic Banker system map: what the work is, what runs, what supports it, and what the systems cannot do.">
  <main class="pack-shell">
    <section class="pack-hero">
      <div class="pack-kicker">Bionic Banker System Map</div>
      <h1>A simple map of AI-assisted finance risk work.</h1>
      <p>Use this when you want the shortest serious read: what Bionic Banker is, what runs, what records support it, what stays private, and what to check next.</p>
      <div class="pack-actions">
        <a href="/start-here">Start Here</a>
        <a href="/world-map">World Map</a>
        <a href="/projects">Systems</a>
        <a href="/evidence">Source Catalog</a>
      </div>
    </section>

    <section class="pack-section thesis-card">
      <span>Positioning</span>
      <h2>AI agents for finance risk. Simple records first, human control always.</h2>
      <p>Bionic Banker connects wallet-risk review, fraud and AML case work, agent workflows, and public writing. The rule is simple: show what happened, show what was checked, and keep the final decision with a person.</p>
    </section>

    <section class="pack-section">
      <span>Flagship systems</span>
      <h2>Six missions, one map.</h2>
      <div class="system-table">
        {systems.map(([name, href, signal, detail]) => (
          <a href={href} class="system-row">
            <strong>{name}</strong>
            <em>{signal}</em>
            <p>{detail}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="pack-section">
      <span>Record map</span>
      <h2>The public record map is counted and limited.</h2>
      <div class="metric-grid">
        {sourceMap.map(([label, value, detail]) => (
          <article>
            <strong>{value}</strong>
            <span>{label}</span>
            <p>{detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="pack-section">
      <span>Context engine layer</span>
      <h2>The useful agent layer sits between raw sources and action.</h2>
      <p>A context engine checks source, conflict, permission, pattern, missing context, and limit before it hands a smaller record to an agent or human. That is the same shape used for Public Wallet Watch: public source trail, movement record, AML review question, missing context, and clear limit.</p>
      <p><a href="/blog/context-engine-missing-layer/">Read the context-engine note</a></p>
      <img class="context-map-img" src="/assets/context-engine-map.svg" alt="Context engine map showing raw sources, checks, and bounded outputs" loading="lazy" />
    </section>

    <section class="pack-section split">
      <div>
        <span>Technical stack</span>
        <h2>Built from simple pieces a reader can recognize.</h2>
        <ul>{stack.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div class="boundary-card">
        <span>What it cannot do</span>
        <h2>What stays outside the system.</h2>
        <ul>
          <li>No live wallet, trade, transfer, or fund power.</li>
          <li>No SAR filing, KYC approval, enforcement, or final compliance decision.</li>
          <li>No private prompts, secrets, raw logs, customer data, or employer data.</li>
          <li>No guarantee that synthetic samples reflect production performance.</li>
        </ul>
      </div>
    </section>


    <section class="pack-section">
      <span>Visual stack anchors</span>
      <h2>Named tools are useful when they clarify the system.</h2>
      <p>Some names should stay private. Some names make the record easier to understand. These are public-safe anchors that can support future diagrams, screenshots, or tool imagery without turning the site into a vendor pitch.</p>
      <div class="anchor-grid">
        {visualAnchors.map(([name, role, visual]) => (
          <article>
            <strong>{name}</strong>
            <span>{role}</span>
            <p>{visual}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="pack-section">
      <span>Questions for the reader</span>
      <h2>The useful conversation starts with one workflow at a time.</h2>
      <div class="question-grid">
        {questions.map((question) => <article>{question}</article>)}
      </div>
      <div class="pack-footer-cta">
        <strong>Best next click:</strong>
        <a href="/world-map">Open the world map</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .pack-shell { max-width: 1160px; margin: 0 auto; padding: 6rem 1.25rem 4rem; color: var(--text); }
  .pack-hero, .pack-section { border: 1px solid rgba(31,160,104,.16); background: rgba(3,16,8,.92); border-radius: 28px; padding: clamp(1.4rem, 3vw, 3rem); margin-bottom: 1.25rem; }
  .pack-kicker, .pack-section > span, .boundary-card span { color: #1fa068; text-transform: uppercase; letter-spacing: .16em; font-size: .78rem; font-weight: 900; }
  .pack-hero h1 { font-size: clamp(2.2rem, 5.6vw, 4.8rem); line-height: .96; margin: .75rem 0 1rem; max-width: 940px; }
  .pack-hero p, .pack-section p, .pack-section li { color: #b0b0b8; line-height: 1.7; }
  .pack-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.2rem; }
  .pack-actions a, .pack-footer-cta a { text-decoration: none; border-radius: 999px; padding: .78rem 1rem; border: 1px solid rgba(31,160,104,.24); color: var(--text); font-weight: 800; }
  .pack-actions a:first-child { background: #1fa068; color: #010302; border: 0; }
  .system-table { display: grid; gap: .8rem; margin-top: 1rem; }
  .system-row { display: grid; grid-template-columns: minmax(190px,.8fr) minmax(120px,.45fr) minmax(0,1.4fr); gap: 1rem; align-items: center; padding: 1rem; border: 1px solid rgba(31,160,104,.16); border-radius: 18px; color: inherit; text-decoration: none; background: rgba(31,160,104,.055); }
  .system-row em { color: #1fa068; font-style: normal; font-weight: 800; }
  .system-row p { margin: 0; }
  .metric-grid, .question-grid, .anchor-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: .9rem; margin-top: 1rem; }
  .metric-grid article, .question-grid article, .anchor-grid article, .boundary-card { border: 1px solid rgba(31,160,104,.16); border-radius: 18px; padding: 1rem; background: rgba(31,160,104,.055); }
  .anchor-grid strong { display: block; color: #f4f7f1; margin-bottom: .35rem; }
  .anchor-grid span { color: #1fa068; font-weight: 900; font-size: .9rem; }
  .metric-grid strong { display: block; font-size: 2rem; color: #1fa068; }
  .context-map-img { width: 100%; margin-top: 1rem; border-radius: 22px; border: 1px solid rgba(31,160,104,.18); background: #020604; }
  .metric-grid span { display: block; font-weight: 900; margin: .35rem 0; }
  .split { display: grid; grid-template-columns: minmax(0,1fr) minmax(280px,.9fr); gap: 1rem; }
  .pack-footer-cta { margin-top: 1.2rem; display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
  @media (max-width: 760px) { .system-row, .split { grid-template-columns: 1fr; } .pack-shell { padding-top: 4.5rem; } }
</style>
