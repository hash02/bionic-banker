---
import BaseLayout from '../layouts/BaseLayout.astro';

const systems = [
  ['Wallet Risk Assessment', '/wallet-risk', 'Risk judgment', 'Score, rule explanation, and plain-language note for sample wallet-risk rows.'],
  ['AML Status Evidence', '/aml-status-evidence', 'Auditability', 'Artifact provenance, checks, visible claims, and explicit authority boundaries.'],
  ['Fraud Alert Triage Workflow', '/fraud-alert-triage', 'Alert operations', 'Synthetic signals converted into a field packet, reviewer case note, and human next step.'],
  ['Agent Chess / Agent Workflow', '/risk-evidence-overview#agent-chess-showcase', 'Agent operations', 'Turn-taking, state preservation, review gates, and public artifacts without live authority.'],
  ['Site Health / Health Board', '/proof/site-health', 'Self-checking evidence', 'Metric contracts, link checks, JSON-framing checks, mobile QA, and public status.'],
];

const evidenceMap = [
  ['System cards', '11', 'Rendered systems a reviewer can inspect.'],
  ['Evidence map lanes', '8', 'Catalog-backed evidence lanes with sources and boundaries.'],
  ['Evidence sources', '21', 'Public-safe sources linked from the evidence catalog.'],
  ['Named boundaries', '36', 'Explicit limits that prevent overclaiming.'],
  ['Articles / notes', '45', 'Writing that supports the finance, AI, and agent-system context.'],
];

const stack = [
  'Astro static site with committed static output',
  'Public-safe JSON artifacts for evidence and site health',
  'Deterministic Node.js QA checks for copy, links, metrics, and route framing',
  'Mobile QA gate for layout regressions',
  'GitHub-hosted source and cache-aware live verification',
];

const questions = [
  'Which finance-risk workflow should be made more inspectable first?',
  'Where should AI draft evidence while a human keeps final authority?',
  'Which review packet would reduce analyst friction without hiding the source trail?',
  'What public-safe artifact would prove judgment without exposing private data?',
  'Which system boundary matters most: wallet authority, filing authority, deployment authority, or data privacy?',
];
---
<BaseLayout title="Field Pack" description="A compact Bionic Banker field pack: missions, evidence map, system stack, boundaries, and questions for Hash.">
  <main class="pack-shell">
    <section class="pack-hero">
      <div class="pack-kicker">Bionic Banker Field Pack</div>
      <h1>A compact field pack for AI-assisted finance risk missions.</h1>
      <p>Use this when you want the shortest serious read: what Bionic Banker is, which missions matter, what evidence exists, what stays bounded, and what to ask next.</p>
      <div class="pack-actions">
        <a href="/start-here">Start Quest</a>
        <a href="/projects">Systems</a>
        <a href="/evidence">Evidence Catalog</a>
      </div>
    </section>

    <section class="pack-section thesis-card">
      <span>Positioning</span>
      <h2>AI agents for finance risk. Evidence first, human reviewed.</h2>
      <p>Bionic Banker sits between RegTech field packaging, wallet-risk intelligence, fraud/AML workflow design, and human-gated agent operations. The difference is simple: show the field packet and the authority boundary instead of pretending the agent owns the decision.</p>
    </section>

    <section class="pack-section">
      <span>Flagship systems</span>
      <h2>Five missions, one map.</h2>
      <div class="system-table">
        {systems.map(([name, href, signal, detail]) => (
          <a href={href} class="system-row">
            <strong>{name}</strong>
            <em>{signal}</em>
            <p>{detail}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="pack-section">
      <span>Evidence map</span>
      <h2>The public evidence map is counted and bounded.</h2>
      <div class="metric-grid">
        {evidenceMap.map(([label, value, detail]) => (
          <article>
            <strong>{value}</strong>
            <span>{label}</span>
            <p>{detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="pack-section split">
      <div>
        <span>Technical stack</span>
        <h2>Built like a map someone can inspect, not just a portfolio page.</h2>
        <ul>{stack.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div class="boundary-card">
        <span>Trust boundary</span>
        <h2>What stays outside the game.</h2>
        <ul>
          <li>No live wallet, trade, transfer, or fund authority.</li>
          <li>No SAR filing, KYC approval, enforcement, or final compliance decision.</li>
          <li>No private prompts, secrets, raw logs, customer data, or employer data.</li>
          <li>No guarantee that synthetic samples reflect production performance.</li>
        </ul>
      </div>
    </section>

    <section class="pack-section">
      <span>Questions for Hash</span>
      <h2>The useful conversation starts with workflow boundaries.</h2>
      <div class="question-grid">
        {questions.map((question) => <article>{question}</article>)}
      </div>
      <div class="pack-footer-cta">
        <strong>Best next click:</strong>
        <a href="/start-here">Open the 90-second mission map</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .pack-shell { max-width: 1160px; margin: 0 auto; padding: 6rem 1.25rem 4rem; color: #e4e4ec; }
  .pack-hero, .pack-section { border: 1px solid rgba(255,255,255,.12); background: rgba(10,10,14,.96); border-radius: 28px; padding: clamp(1.4rem, 3vw, 3rem); margin-bottom: 1.25rem; }
  .pack-kicker, .pack-section > span, .boundary-card span { color: #1fa068; text-transform: uppercase; letter-spacing: .16em; font-size: .78rem; font-weight: 900; }
  .pack-hero h1 { font-size: clamp(2.2rem, 5.6vw, 4.8rem); line-height: .96; margin: .75rem 0 1rem; max-width: 940px; }
  .pack-hero p, .pack-section p, .pack-section li { color: #b0b0b8; line-height: 1.7; }
  .pack-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.2rem; }
  .pack-actions a, .pack-footer-cta a { text-decoration: none; border-radius: 999px; padding: .78rem 1rem; border: 1px solid rgba(255,255,255,.18); color: #e4e4ec; font-weight: 800; }
  .pack-actions a:first-child { background: #1fa068; color: #071018; border: 0; }
  .system-table { display: grid; gap: .8rem; margin-top: 1rem; }
  .system-row { display: grid; grid-template-columns: minmax(190px,.8fr) minmax(120px,.45fr) minmax(0,1.4fr); gap: 1rem; align-items: center; padding: 1rem; border: 1px solid rgba(255,255,255,.12); border-radius: 18px; color: inherit; text-decoration: none; background: rgba(255,255,255,.04); }
  .system-row em { color: #1fa068; font-style: normal; font-weight: 800; }
  .system-row p { margin: 0; }
  .metric-grid, .question-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: .9rem; margin-top: 1rem; }
  .metric-grid article, .question-grid article, .boundary-card { border: 1px solid rgba(255,255,255,.12); border-radius: 18px; padding: 1rem; background: rgba(255,255,255,.045); }
  .metric-grid strong { display: block; font-size: 2rem; color: #1fa068; }
  .metric-grid span { display: block; font-weight: 900; margin: .35rem 0; }
  .split { display: grid; grid-template-columns: minmax(0,1fr) minmax(280px,.9fr); gap: 1rem; }
  .pack-footer-cta { margin-top: 1.2rem; display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
  @media (max-width: 760px) { .system-row, .split { grid-template-columns: 1fr; } .pack-shell { padding-top: 4.5rem; } }
</style>
