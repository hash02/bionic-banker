---
import BaseLayout from '../layouts/BaseLayout.astro';
import ParticleHero from '../components/ParticleHero.astro';
import { getCollection } from 'astro:content';
const proofCatalog = await import('../../public/dashboard-data/public-proof-catalog.json');
const gapCatalog = await import('../../public/dashboard-data/market-gap-catalog.json');
const heartbeatData = await import('../../public/dashboard-data/heartbeat.json');
const contextSignals = await import('../../public/dashboard-data/context-signals.json');
const reportCatalog = await import('../../public/dashboard-data/engineering-report-catalog.json');

// GET ARTICLE COUNT - computed, never hardcoded again
const allPosts = await getCollection('blog');
const articleCount = allPosts.length;
const proofCount = proofCatalog.default.projects.length;
const questionCount = gapCatalog.default.modern_questions.length;
const contextCards = contextSignals.default.cards ?? [];
const contextSources = contextSignals.default.sources ?? [];
const reportMetrics = reportCatalog.default.summary_metrics ?? [];
const benchmarkMetrics = reportCatalog.default.benchmark_metrics ?? [];
const featuredPosts = allPosts.filter(p => p.data.featured);
const sortedPosts = allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const latestPost = sortedPosts[0];
const featuredArticle = featuredPosts[0] || sortedPosts[0];
const gridPosts = sortedPosts.filter(p => p.id !== featuredArticle.id).slice(0, 3);

// Heartbeat snapshot - used as instant fallback before client-side refresh
const hb = heartbeatData.default;
const snapshotPrice = hb?.status?.last_prediction?.price_now;
const snapshotPriceStr = typeof snapshotPrice === 'number'
  ? `$${Math.round(snapshotPrice).toLocaleString('en-US')}`
  : null;
const snapshotTime = (() => {
  const iso = hb?.generated_at;
  if (!iso) return null;
  try {
    const d = new Date(iso);
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) + ' · ' +
      d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: false });
  } catch { return null; }
})();

const movingRows = [
  {
    id: 'market',
    label: 'Market',
    title: snapshotPriceStr ? `BTC · ${snapshotPriceStr}` : 'BTC on watch',
    detail: 'Price updates from a public API when available. Snapshot from the public heartbeat as fallback.',
    source: 'Live · CoinGecko',
    href: '/signals',
    livePrice: true
  },
  {
    id: 'wallets',
    label: 'Wallets',
    title: 'Wallet Risk is open',
    detail: 'Score, rule, plain note, and the limit of what the row is claiming.',
    source: 'Risk notes',
    href: '/wallet-risk',
    livePrice: false
  },
  {
    id: 'writing',
    label: 'Articles',
    title: latestPost.data.title,
    detail: latestPost.data.description,
    source: latestPost.data.readTime,
    href: `/blog/${latestPost.data.slug || latestPost.id}`,
    livePrice: false
  }
];

const metricByLabel = (label) => reportMetrics.find((metric) => metric.label === label);
const proofSnapshot = [
  {
    label: 'Catalog sections',
    value: proofCount,
    unit: 'catalog sections',
    source: 'public evidence map',
  },
  {
    label: 'Articles',
    value: articleCount,
    unit: 'notes',
    source: 'content collection',
  },
  {
    label: 'Number notes',
    value: metricByLabel('Number notes')?.value ?? 0,
    unit: 'measured rows',
    source: 'reports',
  },
  {
    label: 'Limits named',
    value: metricByLabel('Limits named')?.value ?? 0,
    unit: 'boundaries',
    source: 'reports',
  },
];
const benchmarkSnapshot = benchmarkMetrics.slice(0, 4);
const visibleSections = proofCatalog.default.projects.slice(0, 4).map((project) => ({
  name: project.name,
  numbers: project.numbers?.slice(0, 2) ?? [],
  sourceCount: project.sources?.length ?? 0,
  limitCount: project.limits?.length ?? 0,
}));
const heartbeatSnapshot = [
  {
    label: 'Heartbeat',
    value: hb?.status?.mode ?? 'n/a',
    detail: `${(hb?.status?.predictions_made ?? 0).toLocaleString('en-US')} predictions logged`,
  },
  {
    label: 'Last 100',
    value: typeof hb?.status?.accuracy_last_100 === 'number'
      ? `${Math.round(hb.status.accuracy_last_100 * 100)}%`
      : 'n/a',
    detail: 'BTC direction accuracy snapshot',
  },
  {
    label: 'Last price',
    value: snapshotPriceStr ?? 'n/a',
    detail: snapshotTime ? `snapshot ${snapshotTime}` : 'public heartbeat snapshot',
  },
];

const heroRoutes = [
  {
    label: 'Wallet Risk',
    title: 'Wallet Risk Assessment',
    detail: 'Reader-ready score, rationale, and limitation for sample wallet screening rows.',
    href: '/wallet-risk',
  },
  {
    label: 'AML Status',
    title: 'AML Status',
    detail: 'Source trail, checks, and clear limits for human review.',
    href: '/aml-status-evidence',
  },
  {
    label: 'Fraud Triage',
    title: 'Fraud Alert Workflow',
    detail: 'Synthetic alert signals assembled into a clear case packet.',
    href: '/fraud-alert-triage',
  },
  {
    label: 'Agents',
    title: 'Agent Chess board',
    detail: 'Move, review, gate, record orchestration without exposing prompt content or outside-action power.',
    href: '/risk-evidence-overview#agent-chess-showcase',
  },
];

const heroSystemChecks = [
  'Evidence-first workflow',
  'No wallet or trade power',
  'Human review required',
  'No autonomous compliance decisions',
];

const marketPositioningCards = [
  {
    label: 'Category',
    title: 'AI-assisted finance risk workflows',
    body: 'Closest market neighbors are Unit21, Chainalysis/TRM, LangGraph-style agent control, and agent infrastructure teams. Bionic Banker stays public and careful.',
  },
  {
    label: 'Differentiator',
    title: 'Evidence packets you can inspect',
    body: 'The core pattern is signal intake to risk reasoning to source trail to case note to human decision limit, not a black-box compliance answer.',
  },
  {
    label: 'Clear limits',
    title: 'Agents prepare. Humans decide',
    body: 'The site does not claim filing, trading, wallet, enforcement, or final compliance power. It shows review notes and guardrails.',
  },
];

const readerEntryCards = [
  {
    role: 'Recruiter',
    href: '/start-here',
    prompt: '90-second visitor guide',
    body: 'Follow the strongest reading path: risk judgment, AML status, fraud triage, agent workflow, and site QA.',
  },
  {
    role: 'Collaborator',
    href: '/proof-pack',
    prompt: 'Proof pack',
    body: 'Open the short map: systems, evidence, limits, and the questions worth asking.',
  },
  {
    role: 'Technical reader',
    href: '/proof/site-health',
    prompt: 'System health board',
    body: 'Check the tests that keep the public map honest.',
  },
];

const flagshipSystems = [
  {
    label: 'Interactive Web App',
    title: 'Wallet Risk Assessment',
    href: '/wallet-risk',
    status: 'Visible interface',
    outcome: 'Turns wallet-risk signals into a review score, rationale, and limitation so a human can inspect the row instead of trusting a black box.',
    skills: ['Risk UX', 'Review notes', 'Clear-limit language'],
  },
  {
    label: 'Evidence App',
    title: 'AML Status',
    href: '/aml-status-evidence',
    status: 'Audit view',
    outcome: 'Packages AML-related status, source trail, checks, and clear limits into a public-safe page without granting approval, filing, wallet, or trade power.',
    skills: ['AML status', 'Audit trail', 'Human review'],
  },
  {
    label: 'Agent Ops Surface',
    title: 'Agent Chess',
    href: '/risk-evidence-overview#agent-chess-showcase',
    status: 'Human-reviewed workflow',
    outcome: 'Shows how agents can move, review, recover state, and publish bounded records while external actions remain behind explicit human review.',
    skills: ['Agent orchestration', 'Review gates', 'Operational memory'],
  },
  {
    label: 'Synthetic Fraud Workflow',
    title: 'Fraud Alert Triage Workflow',
    href: '/fraud-alert-triage',
    status: 'Review packet',
    outcome: 'Packages suspicious financial signals into source trail, rule explanation, case note, and explicit human review step.',
    skills: ['Fraud ops', 'Evidence packets', 'Human review'],
  },
];

const geoDescription = `Bionic Banker is a public evidence spine for AI-assisted finance risk workflows: wallet risk, AML status, fraud triage, and human reviewed agent systems.`;
---
<BaseLayout title="Home" description={geoDescription}>

  <!-- HERO -->
  <div class="hero-wrap">
    <div class="glow-orb glow-orb-1"></div>
    <div class="glow-orb glow-orb-2"></div>
    <ParticleHero />
    <div class="hero">
      <div class="hero-left">
        <div class="hero-eyebrow">AI / finance / the world ahead</div>
        <h1>AI, finance, and the world ahead.</h1>
        <p class="hero-sub">Bionic Banker follows how technology is changing money, risk, work, and the systems people trust.</p>
        <div class="hero-actions">
          <a href="/start-here" class="btn-primary">Start Quest</a>
          <a href="/proof-pack" class="btn-ghost">Proof Pack</a>
          <a href="/apps" class="btn-ghost">Apps</a>
        </div>
        <div class="hero-signal-row" aria-label="Signals on the table">
          {movingRows.map(row => (
            <a href={row.href} class="hero-signal-pill">
              <span>{row.label}</span>
              <strong>{row.title}</strong>
            </a>
          ))}
        </div>
        <nav class="hero-mobile-route-strip" aria-label="Mobile evidence routes">
          <a href="/start-here">Start Here</a>
          <a href="/proof-pack">Proof Pack</a>
          <a href="/signals">Signals</a>
          <a href="/apps">Apps</a>
          <a href="/wallet-risk">Wallet Risk</a>
          <a href="/fraud-alert-triage">Fraud Triage</a>
          <a href="/aml-status-evidence">AML Status</a>
        </nav>
      </div>

      <div class="hero-right">
        <div class="hero-card-label">Operating view</div>
        <section class="hero-os-panel" aria-label="Bionic Banker operating-system routes">
          <div class="hero-os-topline">
            <span>Market position</span>
            <strong>AI-assisted risk workflows</strong>
          </div>
          <div class="hero-os-title">Signal becomes evidence. Evidence becomes a decision.</div>
          <p>Closest to agentic fraud/AML ops and wallet intelligence. Framed as public evidence, not production system.</p>
          <div class="hero-os-metrics">
            {proofSnapshot.slice(0, 3).map((item) => (
              <div>
                <strong>{item.value}</strong>
                <span>{item.label}</span>
              </div>
            ))}
          </div>
          <div class="hero-route-stack">
            {heroRoutes.map((route) => (
              <a href={route.href} class="hero-route-card">
                <span>{route.label}</span>
                <strong>{route.title}</strong>
                <small>{route.detail}</small>
              </a>
            ))}
          </div>
          <div class="hero-boundary-row">
            {heroSystemChecks.map((check) => <span>{check}</span>)}
          </div>
        </section>
      </div>
    </div>
  </div>


  <div class="content-wrap recruiter-front-door-wrap">
    <section class="recruiter-front-door section-divide animate-on-scroll" aria-label="Recruiter and collaborator starting points">
      <div class="section-header">
        <div>
          <div class="section-label-text">Start Here</div>
          <div class="section-title-text">Mission map for a 90-second visit</div>
        </div>
        <a href="/start-here" class="view-all">Open mission map</a>
      </div>
      <p class="section-orient">If you are reviewing this for a role, collaboration, investment, executive scan, or learning path, start with the map. Each stop shows a task, the evidence behind it, and the human limit.</p>
      <div class="reader-entry-grid" aria-label="Reader-specific entry points">
        {readerEntryCards.map((card) => (
          <a href={card.href} class="reader-entry-card">
            <span>{card.role}</span>
            <strong>{card.prompt}</strong>
            <p>{card.body}</p>
          </a>
        ))}
      </div>
      <div class="flagship-system-grid">
        {flagshipSystems.map((system) => (
          <a href={system.href} class="flagship-system-card">
            <div class="flagship-card-top">
              <span>{system.label}</span>
              <strong>{system.status}</strong>
            </div>
            <h3>{system.title}</h3>
            <p>{system.outcome}</p>
            <div class="flagship-skill-row">
              {system.skills.map((skill) => <span>{skill}</span>)}
            </div>
            <div class="flagship-card-footer">Enter system</div>
          </a>
        ))}
      </div>
      <div class="operator-positioning-strip">
        <strong>Positioning:</strong>
        <span>Founder/operator proof map for AI-assisted finance risk: wallet risk, AML status, fraud triage, and human reviewed agent systems.</span>
      </div>
    </section>
  </div>

  <div class="content-wrap market-positioning-wrap">
    <section class="proof-route-section section-alt animate-on-scroll" aria-label="Market positioning intelligence">
      <div class="section-header">
        <div>
          <div class="section-label-text">Market Positioning Intelligence</div>
          <div class="section-title-text">What category this belongs to</div>
        </div>
        <a href="/signals" class="view-all">Open signals</a>
      </div>
      <p class="section-orient">The benchmark points to one clear path: AI agents can help with finance-risk work when they preserve evidence, show reasoning, and leave final decisions with people. The public surface now separates public system cards from catalog sections so readers do not confuse project count with evidence structure.</p>
      <div class="proof-route-grid">
        {marketPositioningCards.map((card) => (
          <article class="article-card">
            <div class="article-tags"><span class="tag-pill tag-green">{card.label}</span></div>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))}
      </div>
    </section>
  </div>

  <div class="content-wrap proof-data-wrap">
    <section class="proof-data-section section-divide animate-on-scroll">
      <div class="section-header">
        <div>
          <div class="section-label-text">Evidence Snapshot</div>
          <div class="section-title-text">The data on the table</div>
        </div>
      </div>
      <p class="section-orient">A compact read of the public surface: what exists, how many evidence rows sit behind it, and which live signal is moving now.</p>

      <div class="proof-stat-grid">
        {proofSnapshot.map((item) => (
          <article class="proof-stat-card">
            <span>{item.label}</span>
            <strong>{item.value}</strong>
            <small>{item.unit}</small>
            <em>{item.source}</em>
          </article>
        ))}
      </div>

      <div class="proof-data-grid">
        <section class="proof-panel">
          <div class="proof-panel-head">
            <span>Benchmarks</span>
            <strong>{benchmarkSnapshot.length} measured rows</strong>
          </div>
          <div class="proof-metric-list">
            {benchmarkSnapshot.map((metric) => (
              <div class="proof-metric-row">
                <span>{metric.label}</span>
                <strong>{metric.value} {metric.unit}</strong>
              </div>
            ))}
          </div>
        </section>

        <section class="proof-panel">
          <div class="proof-panel-head">
            <span>Visible Sections</span>
            <strong>{visibleSections.length} shown here</strong>
          </div>
          <div class="proof-lane-list">
            {visibleSections.map((section) => (
              <article>
                <h3>{section.name}</h3>
                <p>{section.numbers[0] ?? 'Evidence row available in catalog.'}</p>
                {section.numbers[1] && <p>{section.numbers[1]}</p>}
                <div>{section.sourceCount} sources / {section.limitCount} limits</div>
              </article>
            ))}
          </div>
        </section>

        <section class="proof-panel">
          <div class="proof-panel-head">
            <span>Live Row</span>
            <strong>{heartbeatData.default.generated_at}</strong>
          </div>
          <div class="proof-heartbeat-list">
            {heartbeatSnapshot.map((item) => (
              <div>
                <span>{item.label}</span>
                <strong>{item.value}</strong>
                <small>{item.detail}</small>
              </div>
            ))}
          </div>
        </section>
      </div>
    </section>
  </div>

  <div class="content-wrap context-wrap">
    <section class="context-signal-section section-alt animate-on-scroll">
      <div class="section-header">
        <div>
          <div class="section-label-text">Context Signals</div>
          <div class="section-title-text">Numbers that explain why this work matters</div>
        </div>
        <a href="/reports" class="view-all">View reports</a>
      </div>
      <p class="section-orient">Three numbers that show why building in this space right now is not a hobby. It is a bet on timing.</p>
      <div class="context-signal-grid">
        {contextCards.map(card => (
          <article class="context-signal-card">
            <div class="context-card-top">
              <span class="context-label">{card.label}</span>
              {card.source_url && <a href={card.source_url} class="context-source" target={card.source_url.startsWith('http') ? '_blank' : undefined} rel={card.source_url.startsWith('http') ? 'noopener noreferrer' : undefined}>Source</a>}
            </div>
            <h3>{card.title}</h3>
            <div class="context-value-row">
              <strong>{card.value}</strong>
              <span>{card.unit}</span>
            </div>
            <p>{card.detail}</p>
            <div class="context-bars" aria-hidden="true">
              {card.series.map(point => (
                <span class="context-bar" style={`--h:${point.pct}%`}>
                  <i>{point.year}</i>
                </span>
              ))}
            </div>
            <div class="context-credit">{card.source}</div>
          </article>
        ))}
      </div>
      <p class="context-note">
        External context uses public Our World in Data chart data with source links. Bionic Banker is responsible for this page and interpretation.
        {contextSources[0]?.url && <a href={contextSources[0].url} target="_blank" rel="noopener noreferrer"> API notes</a>}.
      </p>
    </section>
  </div>

  <!-- ARTICLES -->
  <div class="content-wrap" id="articles">
    <section class="moving-now-section section-divide animate-on-scroll">
      <div class="section-header">
        <div>
          <div class="section-label-text">Moving Now</div>
          <div class="section-title-text">A few signals on the table</div>
        </div>
        <a href="/intelligence" class="view-all">Open risk signals</a>
      </div>
      <p class="section-orient">A live market price, a wallet risk snapshot, and the latest piece of writing, refreshed automatically.</p>
      <div class="moving-now-grid">
        {movingRows.map(row => (
          <a href={row.href} class="moving-now-card" data-moving-id={row.id}>
            <div class="moving-now-top">
              <span class="mn-label">{row.label}</span>
              {row.livePrice && <span class="mn-live-badge" data-live-dot>live</span>}
              <span class="mn-source">{row.source}</span>
            </div>
            <h3 data-moving-title>{row.title}</h3>
            {row.livePrice && (
              <div class="mn-price-row">
                <span class="mn-price" data-live-price>{snapshotPriceStr ?? '-'}</span>
                <span class="mn-change" data-live-change></span>
              </div>
            )}
            <p>{row.detail}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="proof-route-section section-alt animate-on-scroll">
      <div class="section-header">
        <div>
          <div class="section-label-text">Systems</div>
          <div class="section-title-text">Pick where to start</div>
        </div>
        <a href="/projects" class="view-all">Open systems</a>
      </div>
      <p class="section-orient">Six entry points into the work. Pick whichever fits where you are right now.</p>
      <div class="proof-route-grid">
        <a href="/risk-evidence-overview" class="article-card">
          <div class="article-tags"><span class="tag-pill tag-green">Tour</span></div>
          <h3>Open the risk and evidence overview</h3>
          <p>AML stories, agent loops, signals, and what is moving.</p>
          <div class="card-footer"><span class="read-more">Start walking</span></div>
        </a>
        <a href="/projects" class="article-card">
          <div class="article-tags"><span class="tag-pill tag-green">Systems</span></div>
          <h3>Things that run</h3>
          <p>AML engines, wallet risk, and agent workflows. All shipped.</p>
          <div class="card-footer"><span class="read-more">Open systems</span></div>
        </a>
        <a href="/fraud-alert-triage" class="article-card">
          <div class="article-tags"><span class="tag-pill tag-green">Fraud Ops</span></div>
          <h3>Fraud alert triage workflow</h3>
          <p>Synthetic signals assembled into an evidence packet, case note, and human review step.</p>
          <div class="card-footer"><span class="read-more">Inspect workflow</span></div>
        </a>
        <a href="/reports" class="article-card">
          <div class="article-tags"><span class="tag-pill tag-green">Reports</span></div>
          <h3>Numbers with context</h3>
          <p>Charts, benchmarks, and limits. Measured, not guessed.</p>
          <div class="card-footer"><span class="read-more">Read reports</span></div>
        </a>
        <a href="/gaps" class="article-card">
          <div class="article-tags"><span class="tag-pill tag-green">Questions</span></div>
          <h3>Questions I keep asking</h3>
          <p>Open problems worth answering. No answers yet.</p>
          <div class="card-footer"><span class="read-more">Open questions</span></div>
        </a>
        <a href="/learn" class="article-card">
          <div class="article-tags"><span class="tag-pill tag-green">Knowledge Base</span></div>
          <h3>Concepts without fog</h3>
          <p>RAG, agents, AML, embeddings. Less fog, more signal.</p>
          <div class="card-footer"><span class="read-more">Learn the terms</span></div>
        </a>
      </div>
      <div style="text-align:center;margin:2rem 0 0.5rem;">
        <a href="/risk-evidence-overview" class="btn-primary">Open the Risk & Evidence Overview</a>
      </div>
    </section>

    <div class="section-header section-divide">
      <div>
        <div class="section-label-text">Articles</div>
        <div class="section-title-text">Articles</div>
      </div>
      <a href="/articles" class="view-all">View all {articleCount} →</a>
    </div>

    <p class="section-orient">A living notebook on AML detection, blockchain infrastructure, AI agents, Canadian finance, and the practical work of learning by building.</p>
    <div class="mag-grid animate-on-scroll">
      <div class="mag-featured">
        <a href={`/blog/${featuredArticle.data.slug || featuredArticle.id}`} class="article-card-featured">
          {featuredArticle.data.image && (
            <div class="featured-thumb">
              <img src={featuredArticle.data.image} alt={featuredArticle.data.title} loading="lazy" />
            </div>
          )}
          <div class="featured-badge">★ Featured</div>
          <div class="article-tags">
            {featuredArticle.data.tags.map(tag => (
              <span class="tag-pill">{tag}</span>
            ))}
          </div>
          <h3>{featuredArticle.data.title}</h3>
          <p>{featuredArticle.data.description}</p>
          <div class="featured-footer">
            <div class="featured-stats">
              <span class="featured-stat"><strong>{featuredArticle.data.readTime}</strong> read</span>
            </div>
            <span class="read-more">Full story →</span>
          </div>
        </a>
      </div>

      {gridPosts.map(post => (
        <a href={`/blog/${post.data.slug || post.id}`} class="article-card">
          {post.data.image && (
            <div class="card-thumb">
              <img src={post.data.image} alt={post.data.title} loading="lazy" />
            </div>
          )}
          <div class="article-tags">
            {post.data.tags.map(tag => (
              <span class="tag-pill">{tag}</span>
            ))}
          </div>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
          <div class="card-footer">
            <span class="read-more">Read →</span>
            <span class="read-time">{post.data.readTime}</span>
          </div>
        </a>
      ))}
    </div>
    <div style="text-align:center;margin:2rem 0 1rem;">
      <a href="/articles" class="btn-primary">Read all {articleCount} articles</a>
    </div>

    <!-- BOTTOM SPLIT -->
    <div class="bottom-split animate-on-scroll">
      <div>
        <div class="section-header" style="margin-bottom:0.75rem;">
          <div>
            <div class="section-label-text">Personal Notes</div>
            <div class="section-title-text">Thoughts</div>
          </div>
        </div>
        <a href="/blog/the-anchor" class="thoughts-card">
          <div class="article-tags">
