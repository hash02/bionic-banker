---
import BaseLayout from '../layouts/BaseLayout.astro';
import ParticleHero from '../components/ParticleHero.astro';
import { getCollection } from 'astro:content';
const proofCatalog = await import('../../public/dashboard-data/public-proof-catalog.json');
const gapCatalog = await import('../../public/dashboard-data/market-gap-catalog.json');
const heartbeatData = await import('../../public/dashboard-data/heartbeat.json');
const contextSignals = await import('../../public/dashboard-data/context-signals.json');

// GET ARTICLE COUNT - computed, never hardcoded again
const allPosts = await getCollection('blog');
const articleCount = allPosts.length;
const proofCount = proofCatalog.default.projects.length;
const questionCount = gapCatalog.default.modern_questions.length;
const contextCards = contextSignals.default.cards ?? [];
const contextSources = contextSignals.default.sources ?? [];
const featuredPosts = allPosts.filter(p => p.data.featured);
const sortedPosts = allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const latestPost = sortedPosts[0];
const featuredArticle = featuredPosts[0] || sortedPosts[0];
const gridPosts = sortedPosts.filter(p => p.id !== featuredArticle.id).slice(0, 3);

// Heartbeat snapshot - used as instant fallback before client-side refresh
const hb = heartbeatData.default;
const snapshotPrice = hb?.status?.last_prediction?.price_now;
const snapshotPriceStr = typeof snapshotPrice === 'number'
  ? `$${Math.round(snapshotPrice).toLocaleString('en-US')}`
  : null;
const snapshotTime = (() => {
  const iso = hb?.generated_at;
  if (!iso) return null;
  try {
    const d = new Date(iso);
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) + ' · ' +
      d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: false });
  } catch { return null; }
})();

const movingRows = [
  {
    id: 'market',
    label: 'Market',
    title: snapshotPriceStr ? `BTC · ${snapshotPriceStr}` : 'BTC on watch',
    detail: 'Price updates from a public API when available. Snapshot from the lab heartbeat as fallback.',
    source: 'Live · CoinGecko',
    href: '/intelligence',
    livePrice: true
  },
  {
    id: 'wallets',
    label: 'Wallets',
    title: 'Wallet Risk Lab is open',
    detail: 'Score, rule, plain note, and the limit of what the row is claiming.',
    source: 'Risk notes',
    href: '/wallet-risk',
    livePrice: false
  },
  {
    id: 'writing',
    label: 'Writing',
    title: latestPost.data.title,
    detail: latestPost.data.description,
    source: latestPost.data.readTime,
    href: `/blog/${latestPost.data.slug || latestPost.id}`,
    livePrice: false
  }
];

const geoDescription = `Bionic Banker is a public finance and AI lab. ${articleCount} articles on AML detection, blockchain agents, wallet risk, and financial systems - with live signals, field-tested experiments, and notes from someone building inside finance.`;
---
<BaseLayout title="Home" description={geoDescription}>

  <!-- HERO -->
  <div class="hero-wrap">
    <div class="glow-orb glow-orb-1"></div>
    <div class="glow-orb glow-orb-2"></div>
    <ParticleHero />
    <div class="hero">
      <div class="hero-left">
        <div class="hero-eyebrow">Finance / AI / Systems</div>
        <h1>Most risk tools give you a number. No reason. No limit. I built the alternative.</h1>
        <p class="hero-sub">An AML engine with 28 detection rules. A wallet risk scorer that explains itself in plain language. Agent systems that coordinate in real time. Built by someone working inside finance, all running in public.</p>
        <div class="hero-actions">
          <a href="/gaps" class="btn-primary">Start with Questions -></a>
          <a href="/proof-tour" class="btn-ghost">Enter the Lab</a>
          <a href="/intelligence" class="btn-ghost">Watch Live Signals</a>
        </div>
        <div class="hero-signal-row" aria-label="Signals on the table">
          {movingRows.map(row => (
            <a href={row.href} class="hero-signal-pill">
              <span>{row.label}</span>
              <strong>{row.title}</strong>
            </a>
          ))}
        </div>
        <div class="hero-stats-row">
          <div class="hstat"><span class="hstat-n">{articleCount}</span><span class="hstat-l">Articles</span></div>
          <div class="hstat"><span class="hstat-n">{proofCount}</span><span class="hstat-l">Experiments</span></div>
          <div class="hstat"><span class="hstat-n">{questionCount}</span><span class="hstat-l">Questions</span></div>
        </div>
      </div>

      <div class="hero-right">
        <div class="hero-card-label">Latest</div>
        <a href={`/blog/${latestPost.data.slug || latestPost.id}`} class="hero-article-card">
          <div class="hcard-tag">{(latestPost.data.featured ? 'Featured · ' : '') + latestPost.data.tags.join(' · ')}</div>
          <div class="hcard-title">{latestPost.data.title}</div>
          <div class="hcard-desc">{latestPost.data.description}</div>
          <div class="hcard-footer">
            <span class="hcard-read">Read the full story →</span>
            <span class="hcard-time">{latestPost.data.readTime}</span>
          </div>
        </a>
        <div class="hero-mini-stack">
          {sortedPosts.slice(1, 4).map(post => (
            <a href={`/blog/${post.data.slug || post.id}`} class="hero-mini-card">
              <div class="mini-dot"></div>
              <div class="mini-title">{post.data.title}</div>
              <span class="mini-time">{post.data.readTime}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- PROOF STRIP -->
  <div class="proof-strip">
    <div class="proof-strip-inner">
      <div class="ps-item">
        <strong class="ps-n">{hb?.status?.predictions_made ? hb.status.predictions_made.toLocaleString() : '3,100+'}</strong>
        <span class="ps-l">signal rows logged</span>
      </div>
      <div class="ps-div"></div>
      <div class="ps-item">
        <strong class="ps-n">{articleCount}</strong>
        <span class="ps-l">articles published</span>
      </div>
      <div class="ps-div"></div>
      <div class="ps-item">
        <strong class="ps-n">28</strong>
        <span class="ps-l">AML detection rules</span>
      </div>
      <div class="ps-div"></div>
      <div class="ps-item">
        <strong class="ps-n">12+</strong>
        <span class="ps-l">weeks running live</span>
      </div>
    </div>
  </div>

  <div class="content-wrap context-wrap">
    <section class="context-signal-section animate-on-scroll">
      <div class="section-header">
        <div>
          <div class="section-label-text">Context Signals</div>
          <div class="section-title-text">Numbers that explain why this lab matters</div>
        </div>
        <a href="/reports" class="view-all">Open field notes -></a>
      </div>
      <div class="context-signal-grid">
        {contextCards.map(card => (
          <article class="context-signal-card">
            <div class="context-card-top">
              <span class="context-label">{card.label}</span>
              {card.source_url && <a href={card.source_url} class="context-source" target={card.source_url.startsWith('http') ? '_blank' : undefined} rel={card.source_url.startsWith('http') ? 'noopener noreferrer' : undefined}>Source</a>}
            </div>
            <h3>{card.title}</h3>
            <div class="context-value-row">
              <strong>{card.value}</strong>
              <span>{card.unit}</span>
            </div>
            <p>{card.detail}</p>
            <div class="context-bars" aria-hidden="true">
              {card.series.map(point => (
                <span class="context-bar" style={`--h:${point.pct}%`}>
                  <i>{point.year}</i>
                </span>
              ))}
            </div>
            <div class="context-credit">{card.source}</div>
          </article>
        ))}
      </div>
      <p class="context-note">
        External context uses public Our World in Data chart data with source links. Bionic Banker is responsible for this page and interpretation.
        {contextSources[0]?.url && <a href={contextSources[0].url} target="_blank" rel="noopener noreferrer"> API notes</a>}.
      </p>
    </section>
  </div>

  <!-- ARTICLES -->
  <div class="content-wrap" id="articles">
    <section class="moving-now-section animate-on-scroll">
      <div class="section-header">
        <div>
          <div class="section-label-text">Moving Now</div>
          <div class="section-title-text">A few signals on the table</div>
        </div>
        <a href="/intelligence" class="view-all">Open live signals -></a>
      </div>
      <div class="moving-now-grid">
        {movingRows.map(row => (
          <a href={row.href} class="moving-now-card" data-moving-id={row.id}>
            <div class="moving-now-top">
              <span class="mn-label">{row.label}</span>
              {row.livePrice && <span class="mn-live-badge" data-live-dot>live</span>}
              <span class="mn-source">{row.source}</span>
            </div>
            <h3 data-moving-title>{row.title}</h3>
            {row.livePrice && (
              <div class="mn-price-row">
                <span class="mn-price" data-live-price>{snapshotPriceStr ?? '-'}</span>
                <span class="mn-change" data-live-change></span>
              </div>
            )}
            <p>{row.detail}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="proof-route-section animate-on-scroll">
      <div class="section-header">
        <div>
          <div class="section-label-text">The Lab</div>
          <div class="section-title-text">Pick a door</div>
        </div>
        <a href="/proof-tour" class="view-all">Walk the lab -></a>
      </div>
      <div class="proof-route-grid">
        <a href="/proof-tour" class="article-card">
          <div class="article-tags"><span class="tag-pill tag-green">Tour</span></div>
          <h3>Walk the lab</h3>
          <p>A quick path through the pieces already moving: AML stories, agent loops, live signals, charts, and the questions underneath them.</p>
          <div class="card-footer"><span class="read-more">Start walking -></span></div>
        </a>
        <a href="/projects" class="article-card">
          <div class="article-tags"><span class="tag-pill tag-green">Experiments</span></div>
          <h3>Things that run</h3>
          <p>AML engines, wallet risk notes, agent workflows, observability sketches, and technical stories from the build floor.</p>
          <div class="card-footer"><span class="read-more">Open experiments -></span></div>
        </a>
        <a href="/reports" class="article-card">
          <div class="article-tags"><span class="tag-pill tag-green">Field Notes</span></div>
          <h3>Numbers with context</h3>
          <p>Charts, counts, limits, benchmark notes, and the parts of the system that are easier to understand when they are measured.</p>
          <div class="card-footer"><span class="read-more">Read field notes -></span></div>
        </a>
        <a href="/gaps" class="article-card">
          <div class="article-tags"><span class="tag-pill tag-green">Questions</span></div>
          <h3>Questions I keep asking</h3>
          <p>How do two AI parts talk to each other? When does a signal become useful? How do you explain risk without hiding behind jargon?</p>
          <div class="card-footer"><span class="read-more">Open questions -></span></div>
        </a>
        <a href="/learn" class="article-card">
          <div class="article-tags"><span class="tag-pill tag-green">Learn</span></div>
          <h3>Concepts without fog</h3>
          <p>RAG, agents, RBAC, observability, embeddings, AML, deployment. The words sound bigger than they are. Start simple.</p>
          <div class="card-footer"><span class="read-more">Learn the terms -></span></div>
        </a>
        <a href="/site-agent" class="article-card">
          <div class="article-tags"><span class="tag-pill tag-green">Ask</span></div>
          <h3>Ask the lab</h3>
          <p>Type what you are curious about and get pointed to the right corner: AML, agents, charts, learning notes, or live signal rows.</p>
          <div class="card-footer"><span class="read-more">Ask a question -></span></div>
        </a>
      </div>
    </section>

    <div class="section-header">
      <div>
        <div class="section-label-text">Writings</div>
        <div class="section-title-text">Articles</div>
      </div>
      <a href="/articles" class="view-all">View all {articleCount} →</a>
    </div>

    <div class="mag-grid animate-on-scroll">
      <div class="mag-featured">
        <a href={`/blog/${featuredArticle.data.slug || featuredArticle.id}`} class="article-card-featured">
          {featuredArticle.data.image && (
            <div class="featured-thumb">
              <img src={featuredArticle.data.image} alt={featuredArticle.data.title} loading="lazy" />
            </div>
          )}
          <div class="featured-badge">★ Featured</div>
          <div class="article-tags">
            {featuredArticle.data.tags.map(tag => (
              <span class="tag-pill">{tag}</span>
            ))}
          </div>
          <h3>{featuredArticle.data.title}</h3>
          <p>{featuredArticle.data.description}</p>
          <div class="featured-footer">
            <div class="featured-stats">
              <span class="featured-stat"><strong>{featuredArticle.data.readTime}</strong> read</span>
            </div>
            <span class="read-more">Full story →</span>
          </div>
        </a>
      </div>

      {gridPosts.map(post => (
        <a href={`/blog/${post.data.slug || post.id}`} class="article-card">
          {post.data.image && (
            <div class="card-thumb">
              <img src={post.data.image} alt={post.data.title} loading="lazy" />
            </div>
          )}
          <div class="article-tags">
            {post.data.tags.map(tag => (
              <span class="tag-pill">{tag}</span>
            ))}
          </div>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
          <div class="card-footer">
            <span class="read-more">Read →</span>
            <span class="read-time">{post.data.readTime}</span>
          </div>
        </a>
      ))}
    </div>

    <!-- BOTTOM SPLIT -->
    <div class="bottom-split animate-on-scroll">
      <div>
        <div class="section-header" style="margin-bottom:0.75rem;">
          <div>
            <div class="section-label-text">Personal Writing</div>
            <div class="section-title-text">Thoughts</div>
          </div>
        </div>
        <a href="/blog/the-anchor" class="thoughts-card">
          <div class="article-tags">
            <span class="tag-pill">Thoughts</span>
            <span class="tag-pill">AI</span>
          </div>
          <h3>The Anchor Problem</h3>
          <p>I went looking for a template for life. Found a return mechanism instead. Then realized I'd built the exact same structure into my AI systems - without ever consciously making the connection.</p>
          <div class="tc-footer">
            <span class="read-more">Read →</span>
            <span class="read-time">6 min · March 2026</span>
          </div>
        </a>
      </div>

      <div id="about">
        <div class="section-header" style="margin-bottom:0.75rem;">
          <div>
            <div class="section-label-text">Who</div>
            <div class="section-title-text">About</div>
          </div>
        </div>
        <div class="about-col">
          <div>
            <div class="about-name">Himanshu</div>
            <div class="about-role">Finance / Blockchain / Builder</div>
            <p class="about-bio">Computer engineer. Financial advisor. Builder. I work inside banking and build systems around the things it cannot easily explain: fraud patterns, risk signals, agent coordination, and the gap between what financial tools report and what they actually see.</p>
            <p class="about-bio">This lab is the result. An AML engine with 28 detection rules. A wallet risk scorer that explains its own output in plain language. Agent systems that coordinate in real time. All running in public, all open to inspect.</p>
          </div>
          <div class="about-stat-row">
            <div class="astat"><div class="astat-n">{articleCount}</div><div class="astat-l">Articles</div></div>
            <div class="astat"><div class="astat-n">{proofCount}</div><div class="astat-l">Experiments</div></div>
            <div class="astat"><div class="astat-n">5+</div><div class="astat-l">Years</div></div>
            <div class="astat"><div class="astat-n">∞</div><div class="astat-l">Questions</div></div>
          </div>
        </div>
      </div>
    </div>

    <!-- NEWSLETTER + TELEGRAM -->
    <div class="newsletter-strip animate-on-scroll" id="newsletter-inline">
      <div class="nl-text">
        <h3>Stay in the loop</h3>
        <p>Finance, blockchain, AI - one piece at a time.<br>No fluff, no schedule, just when it's worth saying.</p>
      </div>
      <div class="telegram-cta-wrap">
        <a href="https://t.me/BionicBanker" class="telegram-cta" target="_blank" rel="noopener">
          Join the Telegram &rarr;
        </a>
      </div>
    </div>
  </div>

  <script>
    (function () {
      const card = document.querySelector('[data-moving-id="market"]');
      if (!card) return;
      const priceEl = card.querySelector('[data-live-price]');
      const changeEl = card.querySelector('[data-live-change]');
      const titleEl = card.querySelector('[data-moving-title]');

      async function refresh() {
        try {
          const res = await fetch(
            'https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd&include_24hr_change=true',
            { headers: { accept: 'application/json' } }
          );
          if (!res.ok) return;
          const d = await res.json();
          const price = d?.bitcoin?.usd;
          const change = d?.bitcoin?.usd_24h_change;
          if (typeof price === 'number') {
            const fmt = '$' + Math.round(price).toLocaleString('en-US');
            if (priceEl) priceEl.textContent = fmt;
            if (titleEl) titleEl.textContent = 'BTC · ' + fmt;
          }
          if (typeof change === 'number' && changeEl) {
            const sign = change >= 0 ? '+' : '';
            changeEl.textContent = sign + change.toFixed(2) + '% 24h';
            changeEl.style.color = change >= 0 ? 'var(--accent)' : '#e05555';
          }
        } catch (_) {}
      }

      refresh();
      window.setInterval(refresh, 120000);
    })();
  </script>

  <style>
    .context-wrap {
      padding-top: 0;
      padding-bottom: 0.5rem;
    }
    .context-signal-section {
      border-top: 1px solid var(--b1);
      border-bottom: 1px solid var(--b1);
      padding: 2rem 0 2.2rem;
    }
    .context-signal-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
    .context-signal-card {
      background: rgba(31,160,104,0.035);
      border: 1px solid var(--b1);
      border-radius: var(--radius);
      padding: 1.15rem;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .context-card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }
    .context-label,
    .context-source,
    .context-credit {
      font-family: var(--mono);
      font-size: 0.62rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .context-label { color: var(--accent); }
    .context-source { color: var(--text-3); transition: color 0.2s; }
    .context-source:hover { color: var(--accent); }
    .context-signal-card h3 {
      font-size: 1rem;
      line-height: 1.25;
      color: var(--text);
    }
    .context-value-row {
      display: flex;
      align-items: baseline;
      gap: 0.55rem;
      flex-wrap: wrap;
    }
    .context-value-row strong {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-size: clamp(2rem, 4vw, 3rem);
      line-height: 1;
      color: var(--accent);
    }
    .context-value-row span {
      color: var(--text-3);
      font-family: var(--mono);
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .context-signal-card p {
      color: var(--text-2);
      font-size: 0.82rem;
      line-height: 1.6;
    }
    .context-bars {
      display: flex;
      align-items: end;
      gap: 0.32rem;
      min-height: 86px;
      padding-top: 0.25rem;
      border-top: 1px solid var(--b1);
    }
    .context-bar {
      position: relative;
      flex: 1;
      min-width: 0;
      height: max(8px, var(--h));
      background: rgba(31,160,104,0.2);
      border: 1px solid rgba(31,160,104,0.26);
      border-radius: 4px 4px 0 0;
    }
    .context-bar i {
      position: absolute;
      left: 50%;
      bottom: -1.25rem;
      transform: translateX(-50%);
      font-style: normal;
      color: var(--text-4);
      font-family: var(--mono);
      font-size: 0.52rem;
    }
    .context-credit {
      color: var(--text-4);
      letter-spacing: 0.03em;
      text-transform: none;
      line-height: 1.4;
      margin-top: 0.65rem;
    }
    .context-note {
      margin-top: 1rem;
      color: var(--text-3);
      font-size: 0.72rem;
      line-height: 1.55;
    }
    .context-note a {
      color: var(--accent);
      font-family: var(--mono);
      font-size: 0.68rem;
    }
    @media (max-width: 900px) {
      .context-signal-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 640px) {
      .context-signal-section { padding: 1.4rem 0 1.8rem; }
      .context-signal-card { padding: 1rem; }
      .context-bars { min-height: 74px; gap: 0.22rem; }
      .context-bar i { display: none; }
    }
    .mn-label { color: var(--text-3); font-family: var(--mono); font-size: 0.68rem; text-transform: uppercase; }
    .mn-source { color: var(--text-3); font-family: var(--mono); font-size: 0.68rem; margin-left: auto; }
    .mn-live-badge {
      font-family: var(--mono);
      font-size: 0.62rem;
      text-transform: uppercase;
      color: var(--accent);
      border: 1px solid rgba(31, 160, 104, 0.4);
      border-radius: 999px;
      padding: 0.1rem 0.4rem;
      animation: pulse-opacity 2.4s ease-in-out infinite;
    }
    @keyframes pulse-opacity {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.45; }
    }
    .mn-price-row {
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
      margin: 0.1rem 0 0.3rem;
    }
    .mn-price {
      font-size: 1.55rem;
      font-weight: 700;
      color: var(--text);
      font-family: var(--mono);
      line-height: 1;
    }
    .mn-change {
      font-family: var(--mono);
      font-size: 0.78rem;
    }
  </style>

  <!-- CONTACT -->
  <div class="contact-section animate-on-scroll" id="contact">
    <div class="section-header" style="margin-bottom:1.5rem;">
      <div>
        <div class="section-label-text">Get in touch</div>
        <div class="section-title-text">Contact</div>
      </div>
    </div>
    <form class="contact-form" action="https://formspree.io/f/xdaljypn" method="POST">
      <input type="text" name="_gotcha" style="display:none !important" tabindex="-1" autocomplete="off" aria-hidden="true">
      <div class="form-group">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" placeholder="Your name" required />
      </div>
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="your@email.com" required />
      </div>
      <div class="form-group">
        <label for="message">Message</label>
        <textarea id="message" name="message" placeholder="What's on your mind?" required></textarea>
      </div>
      <button type="submit" class="btn-primary" style="width:fit-content;">Send →</button>
