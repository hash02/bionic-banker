---
import BaseLayout from '../layouts/BaseLayout.astro';
import ParticleHero from '../components/ParticleHero.astro';
import { getCollection } from 'astro:content';

// GET ARTICLE COUNT — computed, never hardcoded again
const allPosts = await getCollection('blog');
const articleCount = allPosts.length;
const featuredPosts = allPosts.filter(p => p.data.featured);
const sortedPosts = allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const latestPost = sortedPosts[0];
---
<BaseLayout title="Home">

  <!-- HERO -->
  <div class="hero-wrap">
    <div class="glow-orb glow-orb-1"></div>
    <div class="glow-orb glow-orb-2"></div>
    <ParticleHero />
    <div class="hero">
      <div class="hero-left">
        <div class="hero-eyebrow">Finance · Code · Both</div>
        <h1>Inside Finance.<br><em>Building</em> Its Future.</h1>
        <p class="hero-sub">I work inside financial systems and build on top of them. Two sides of the same thing — the industry access, the code, the questions I can't stop asking.</p>
        <div class="hero-actions">
          <a href="#newsletter" class="btn-primary">Subscribe →</a>
          <a href="/articles" class="btn-ghost">Read Articles</a>
        </div>
        <div class="hero-stats-row">
          <div class="hstat"><span class="hstat-n">{articleCount}</span><span class="hstat-l">Articles</span></div>
          <div class="hstat"><span class="hstat-n">3</span><span class="hstat-l">Live Projects</span></div>
          <div class="hstat"><span class="hstat-n">5+</span><span class="hstat-l">Years Building</span></div>
        </div>
      </div>

      <div class="hero-right">
        <div class="hero-card-label">Latest</div>
        <a href="/blog/agent-replacement" class="hero-article-card">
          <div class="hcard-tag">Featured · AI · Agents · Future of Work</div>
          <div class="hcard-title">The Agent Wake-Up Call — Why Your Experience Alone Won't Save You</div>
          <div class="hcard-desc">AI agent frameworks are hitting adoption numbers that took Linux 30 years to build. In weeks. Here's what I see coming from inside finance.</div>
          <div class="hcard-footer">
            <span class="hcard-read">Read the full story →</span>
            <span class="hcard-time">8 min</span>
          </div>
        </a>
        <div class="hero-mini-stack">
          <a href="/blog/agent-evolution" class="hero-mini-card">
            <div class="mini-dot"></div>
            <div class="mini-title">How My AI Agent Went From Broken to Autonomous in 30 Days</div>
            <span class="mini-time">7 min</span>
          </a>
          <a href="/blog/aml-engine" class="hero-mini-card">
            <div class="mini-dot"></div>
            <div class="mini-title">I Built a Blockchain AML Engine From Scratch</div>
            <span class="mini-time">12 min</span>
          </a>
          <a href="/blog/syos" class="hero-mini-card">
            <div class="mini-dot"></div>
            <div class="mini-title">SYOS — Making an LLM Think About Its Own Thinking</div>
            <span class="mini-time">9 min</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- ARTICLES -->
  <div class="content-wrap" id="articles">
    <div class="section-header">
      <div>
        <div class="section-label-text">Deep Dives</div>
        <div class="section-title-text">Articles</div>
      </div>
      <a href="/articles" class="view-all">View all {articleCount} →</a>
    </div>

    <div class="mag-grid animate-on-scroll">
      <div class="mag-featured">
        <a href="/blog/aml-engine" class="article-card-featured">
          <div class="featured-badge">★ Featured</div>
          <div class="article-tags">
            <span class="tag-pill tag-red">AML</span>
            <span class="tag-pill tag-blue">Blockchain</span>
            <span class="tag-pill tag-purple">AI</span>
          </div>
          <h3>I Built a Blockchain AML Engine From Scratch — Here's What I Found</h3>
          <p>94.9% detection rate. 22 rules. Real Etherscan data. Caught Tornado Cash, Ronin, Lazarus Group, Wormhole, and Nomad. Then added an AI layer that thinks for itself.</p>
          <div class="featured-footer">
            <div class="featured-stats">
              <span class="featured-stat"><strong>94.9%</strong> accuracy</span>
              <span class="featured-stat"><strong>12 min</strong> read</span>
            </div>
            <div style="display:flex;align-items:center;gap:0.6rem;">
              <span class="read-more">Full story →</span>
              <a href="https://aml-detection-engine-ewxnmkbekcg8scjjes7caa.streamlit.app/" target="_blank" onclick="event.stopPropagation();" class="demo-badge">↗ Live Demo</a>
            </div>
          </div>
        </a>
      </div>

      <a href="/blog/syos" class="article-card">
        <div class="article-tags">
          <span class="tag-pill tag-purple">AI</span>
          <span class="tag-pill tag-purple">SYOS</span>
        </div>
        <h3>SYOS — What Happens When You Try to Make an LLM Think About Its Own Thinking</h3>
        <p>No code written. No fine-tuning. Just questions — and somewhere in those months, a reasoning system started evolving on its own.</p>
        <div class="card-footer">
          <span class="read-more">Read →</span>
          <span class="read-time">9 min</span>
        </div>
      </a>

      <a href="/blog/nexus-agent" class="article-card">
        <div class="article-tags">
          <span class="tag-pill tag-purple">AI</span>
          <span class="tag-pill tag-red">Agents</span>
          <span class="tag-pill tag-blue">Blockchain</span>
        </div>
        <h3>I Built 3 AI Agents. Here's What Broke Each Time.</h3>
        <p>Three versions. Three different failures. Memory creates bias, fallback creates blindness, and adversarial architecture creates honesty.</p>
        <div class="card-footer">
          <span class="read-more">Read →</span>
          <span class="read-time">7 min</span>
        </div>
      </a>

      <a href="/blog/physics-of-ai" class="article-card">
        <div class="article-tags">
          <span class="tag-pill tag-purple">AI</span>
          <span class="tag-pill tag-cyan">Physics</span>
          <span class="tag-pill tag-amber">Nobel Prize</span>
        </div>
        <h3>The Physics of AI — Why the 2024 Nobel Prize Changes Everything</h3>
        <p>Neural networks don't think. They roll downhill. The same equation behind spin glass physics is identical to the math training GPT-4.</p>
        <div class="card-footer">
          <span class="read-more">Read →</span>
          <span class="read-time">8 min</span>
        </div>
      </a>
    </div>

    <!-- BOTTOM SPLIT -->
    <div class="bottom-split animate-on-scroll">
      <div>
        <div class="section-header" style="margin-bottom:0.75rem;">
          <div>
            <div class="section-label-text">Personal Writing</div>
            <div class="section-title-text">Thoughts</div>
          </div>
        </div>
        <a href="/blog/the-anchor" class="thoughts-card">
          <div class="article-tags">
            <span class="tag-pill tag-rose">Thoughts</span>
            <span class="tag-pill tag-purple">AI</span>
          </div>
          <h3>The Anchor Problem</h3>
          <p>I went looking for a template for life. Found a return mechanism instead. Then realized I'd built the exact same structure into my AI systems — without ever consciously making the connection.</p>
          <div class="tc-footer">
            <span class="read-more">Read →</span>
            <span class="read-time">6 min · March 2026</span>
          </div>
        </a>
      </div>

      <div id="about">
        <div class="section-header" style="margin-bottom:0.75rem;">
          <div>
            <div class="section-label-text">Who</div>
            <div class="section-title-text">About</div>
          </div>
        </div>
        <div class="about-col">
          <div>
            <div class="about-name">HASH</div>
            <div class="about-role">Finance · Blockchain · Builder</div>
            <p class="about-bio">I work inside financial systems and build on what I see from the inside. Computer engineer exploring what happens when finance meets code at the edge.</p>
          </div>
          <div class="about-stat-row">
            <div class="astat"><div class="astat-n">{articleCount}</div><div class="astat-l">Articles</div></div>
            <div class="astat"><div class="astat-n">3</div><div class="astat-l">Projects</div></div>
            <div class="astat"><div class="astat-n">5+</div><div class="astat-l">Years</div></div>
            <div class="astat"><div class="astat-n">∞</div><div class="astat-l">Questions</div></div>
          </div>
        </div>
      </div>
    </div>

    <!-- NEWSLETTER + TELEGRAM -->
    <div class="newsletter-strip animate-on-scroll" id="newsletter-inline">
      <div class="nl-text">
        <h3>Stay in the loop</h3>
        <p>Finance, blockchain, AI — one piece at a time.<br>No fluff, no schedule, just when it's worth saying.</p>
      </div>
      <div class="telegram-cta-wrap">
        <a href="https://t.me/BionicBanker" class="telegram-cta" target="_blank" rel="noopener">
          Join the Telegram &rarr;
        </a>
      </div>
    </div>
  </div>

  <!-- CONTACT -->
  <div class="contact-section animate-on-scroll" id="contact">
    <div class="section-header" style="margin-bottom:1.5rem;">
      <div>
        <div class="section-label-text">Get in touch</div>
        <div class="section-title-text">Contact</div>
      </div>
    </div>
    <form class="contact-form" action="https://formspree.io/f/xdaljypn" method="POST">
      <div class="form-group">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" placeholder="Your name" required />
      </div>
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="your@email.com" required />
      </div>
      <div class="form-group">
        <label for="message">Message</label>
        <textarea id="message" name="message" placeholder="What's on your mind?" required></textarea>
      </div>
      <button type="submit" class="btn-primary" style="width:fit-content;">Send →</button>
    </form>
  </div>
</BaseLayout>
