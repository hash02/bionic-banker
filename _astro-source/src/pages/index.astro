---
import BaseLayout from '../layouts/BaseLayout.astro';
import ParticleHero from '../components/ParticleHero.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const articleCount = sortedPosts.length;

const slugOf = (post) => post.data.slug || post.id;
const hrefOf = (post) => `/blog/${slugOf(post)}/`;
const hasAny = (post, terms) => {
  const text = `${slugOf(post)} ${post.data.title} ${post.data.description} ${(post.data.tags ?? []).join(' ')}`.toLowerCase();
  return terms.some((term) => text.includes(term));
};

const aiPosts = sortedPosts.filter((post) => hasAny(post, ['ai model', 'claude', 'gemini', 'open weight', 'llm', 'agent', 'artificial intelligence'])).slice(0, 6);
const financePosts = sortedPosts.filter((post) => hasAny(post, ['finance', 'bank', 'aml', 'kyc', 'fraud', 'risk', 'advisor'])).slice(0, 6);
const cryptoPosts = sortedPosts.filter((post) => hasAny(post, ['crypto', 'wallet', 'blockchain', 'token', 'stablecoin', 'defi'])).slice(0, 6);
const latestPosts = sortedPosts.slice(0, 8);

const featured = aiPosts[0] ?? sortedPosts[0];
const stackGroups = [
  {
    accent: 'blue',
    label: 'The Foundation',
    count: '3 paths',
    items: [
      { icon: 'AI', title: 'AI Models', text: 'Model explainers, agent control, prompt-injection literacy, and practical AI vocabulary.', href: '/ai-models/' },
      { icon: 'BB', title: 'Bionic Blog', text: 'Source-backed notes on AI, finance, crypto infrastructure, and risk boundaries.', href: '/articles/' },
      { icon: 'ID', title: 'AI Intelligence', text: 'Public desk notes for agent systems, model risk, and builder-facing direction.', href: '/ai-intelligence/' },
    ],
  },
  {
    accent: 'pink',
    label: 'The Control Layer',
    count: '4 rules',
    items: [
      { icon: 'SRC', title: 'Source trail first', text: 'Claims are useful only when the source, limit, and confidence boundary stay visible.', href: '/blog/ai-content-fails-when-it-has-nothing-to-prove/' },
      { icon: 'GATE', title: 'Gates before action', text: 'AI agents need labels, tool limits, approval checks, and logs before they touch real work.', href: '/blog/ai-agents-need-gates-not-vibes/' },
      { icon: 'RISK', title: 'Finance boundary', text: 'No trading, legal, tax, compliance, or payment authority is implied by a model answer.', href: '/projects/' },
      { icon: 'LOG', title: 'Audit record', text: 'The durable output is a trace: what was read, trusted, called, blocked, and reviewed.', href: '/ai-intelligence/' },
    ],
  },
  {
    accent: 'green',
    label: 'The Working Surfaces',
    count: 'latest',
    items: latestPosts.slice(0, 5).map((post) => ({
      icon: (post.data.category || 'Post').slice(0, 3).toUpperCase(),
      title: post.data.title,
      text: post.data.description,
      href: hrefOf(post),
    })),
  },
];
const quickSections = [
  {
    label: 'Blog',
    title: 'Read the latest guides',
    text: 'Source-backed notes on AI models, crypto, risk, and the systems changing finance.',
    href: '/articles/',
  },
  {
    label: 'AI Models',
    title: 'Understand models and tools',
    text: 'Model guides, AI concepts, comparisons, and practical use cases for builders.',
    href: '/ai-models/',
  },
  {
    label: 'AI Intelligence',
    title: 'Read the AI desk',
    text: 'Public notes on AI agents, finance, model risk, and practical project direction.',
    href: '/ai-intelligence/',
  },
  {
    label: 'Projects',
    title: 'Open the working demos',
    text: 'AML dashboard, payment-control checklist, wallet-risk review, and the proof links behind them.',
    href: '/projects/',
  },
];
---

<BaseLayout
  title="Home"
  description="Bionic Banker publishes AI finance, fintech, crypto, risk, and source-backed systems research."
>
  <main class="simple-home">
    <section class="simple-hero hero-system">
      <div class="hero-copy-block">
        <div class="eyebrow">Bionic Banker</div>
        <h1>AI finance, crypto, and risk intelligence.</h1>
        <p class="hero-copy">A minimal field guide for AI models, crypto infrastructure, risk signals, and source-backed finance systems. Clear writing, useful diagrams, and no trading hype.</p>
        <div class="hero-actions" aria-label="Primary reading paths">
          <a class="btn-primary" href="/articles/">Read the Blog</a>
          <a class="btn-ghost" href="/ai-models/">Explore AI Models</a>
          <a class="btn-ghost" href="/ai-intelligence/">AI Intelligence</a>
          <a class="btn-ghost" href="/projects/">Projects</a>
        </div>
        <div class="hero-stats" aria-label="Site summary">
          <div><strong>{articleCount}</strong><span>blog posts</span></div>
          <div><strong>4</strong><span>clear paths</span></div>
          <div><strong>Projects</strong><span>working demos</span></div>
        </div>
      </div>
      <aside class="hero-visual intelligence-stack" aria-label="Bionic intelligence stack">
        <ParticleHero />
        <div class="stack-perspective">
          <div class="stack-layer layer-output"><span>01</span><strong>AI output</strong><em>claim / summary / signal</em></div>
          <div class="stack-layer layer-source"><span>02</span><strong>Source trail</strong><em>documents + public records</em></div>
          <div class="stack-layer layer-risk"><span>03</span><strong>Risk boundary</strong><em>what it cannot decide</em></div>
          <div class="stack-layer layer-human"><span>04</span><strong>Human review</strong><em>approval before action</em></div>
          <div class="stack-layer layer-audit"><span>05</span><strong>Audit record</strong><em>evidence that survives</em></div>
        </div>
        <div class="stack-orbit orbit-ai">AI</div>
        <div class="stack-orbit orbit-crypto">Crypto</div>
        <div class="stack-orbit orbit-risk">Risk</div>
      </aside>
    </section>

    <section class="stack-console" aria-label="Bionic Banker operating stack">
      <aside class="console-explorer" aria-label="Site explorer">
        <div class="traffic-lights" aria-hidden="true"><span></span><span></span><span></span></div>
        <strong>BIONIC BANKER</strong>
        <nav>
          <a href="/articles/">▾ Blog</a>
          <a href="/ai-models/">▾ AI Models</a>
          <a href="/ai-intelligence/">▾ AI Intelligence</a>
          <a href="/projects/">▾ Projects</a>
          <a href="/about/">About</a>
        </nav>
        <div class="console-file">PUBLIC.md</div>
        <div class="console-file">CONTROL-MAP.svg</div>
        <div class="console-file">SOURCE-TRAIL.json</div>
      </aside>
      <div class="console-main">
        <div class="console-topbar"><span>bionic</span><span>public/control-stack</span></div>
        <div class="console-head">
          <div>
            <div class="eyebrow">Website map</div>
            <h2>AI finance is a control stack.</h2>
            <p>Start with the concept, check the source, read the boundary, then open the next record.</p>
          </div>
          <div class="console-badge">{articleCount} records</div>
        </div>
        {stackGroups.map((group) => (
          <section class={`console-group accent-${group.accent}`}>
            <header>
              <h3>{group.label}</h3>
              <span>{group.count}</span>
            </header>
            <div class="console-rows">
              {group.items.map((item) => (
                <a class="console-row" href={item.href}>
                  <span class="row-icon">{item.icon}</span>
                  <span class="row-copy"><strong>{item.title}</strong><em>{item.text}</em></span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="quick-grid" aria-label="Main website sections">
      {quickSections.map((section) => (
        <a class="quick-card" href={section.href}>
          <span>{section.label}</span>
          <h2>{section.title}</h2>
          <p>{section.text}</p>
          <em>Open →</em>
        </a>
      ))}
    </section>

    <section class="featured-strip" aria-label="Featured article">
      <div class="featured-copy">
        <div class="eyebrow">Featured</div>
        <h2>{featured.data.title}</h2>
        <p>{featured.data.description}</p>
        <a class="btn-primary" href={hrefOf(featured)}>Read this guide</a>
      </div>
      {featured.data.image && (
        <a class="featured-image" href={hrefOf(featured)}>
          <img src={featured.data.image} alt={featured.data.title} loading="eager" />
        </a>
      )}
    </section>

    <section class="content-section" id="latest">
      <div class="section-head">
        <div>
          <div class="eyebrow">Latest</div>
          <h2>Latest from the Blog</h2>
        </div>
        <a href="/articles/">View all →</a>
      </div>
      <div class="article-grid">
        {latestPosts.map((post) => (
          <a class="article-card" href={hrefOf(post)}>
            {post.data.image && <img src={post.data.image} alt={post.data.title} loading="lazy" />}
            <div class="card-body">
              <div class="tags">{(post.data.tags ?? []).slice(0, 3).map((tag) => <span>{tag}</span>)}</div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <small>{post.data.readTime}</small>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="plain-note">
      <h2>What this site is</h2>
      <p>Bionic Banker is a public learning site for AI, finance, crypto, and practical projects. It explains advanced topics with clear writing and useful visuals. It does not give trading, legal, tax, or investment advice.</p>
    </section>
  </main>

  <style>
    .simple-home {
      width: min(1180px, calc(100% - 2rem));
      margin: 0 auto;
      padding: 3.2rem 0 5rem;
    }

    .simple-hero {
      padding: clamp(3rem, 7vw, 6.5rem) 0 2.2rem;
      max-width: 940px;
    }

    .hero-system {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.65fr);
      align-items: center;
      gap: clamp(1.5rem, 4vw, 3.5rem);
      max-width: none;
    }

    .hero-copy-block {
      max-width: 940px;
    }

    .hero-visual {
      position: relative;
      min-height: clamp(360px, 48vw, 560px);
      border: 1px solid rgba(31,160,104,0.22);
      border-radius: 32px;
      overflow: hidden;
      background: radial-gradient(circle at 30% 25%, rgba(31,160,104,0.20), transparent 34%), radial-gradient(circle at 82% 70%, rgba(115,255,190,0.10), transparent 34%), linear-gradient(145deg, rgba(4,20,12,0.98), rgba(1,3,2,0.92));
      box-shadow: 0 30px 90px rgba(0,0,0,0.36);
    }

    .hero-visual #particle-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .orb {
      position: absolute;
      display: grid;
      place-items: center;
      border-radius: 999px;
      border: 1px solid rgba(137,255,198,0.34);
      background: rgba(3,16,9,0.72);
      color: #e9fff4;
      font-family: var(--mono);
      font-size: 0.78rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      box-shadow: inset 0 0 24px rgba(31,160,104,0.20), 0 0 28px rgba(31,160,104,0.12);
    }

    .orb-ai { width: 8.5rem; height: 8.5rem; top: 18%; left: 14%; }
    .orb-risk { width: 7.2rem; height: 7.2rem; top: 34%; right: 13%; }
    .orb-chain { width: 6.6rem; height: 6.6rem; bottom: 18%; left: 30%; }

    .hero-visual-card {
      position: absolute;
      left: 1.1rem;
      right: 1.1rem;
      bottom: 1.1rem;
      padding: 1rem;
      border: 1px solid rgba(31,160,104,0.25);
      border-radius: 22px;
      background: rgba(1,8,5,0.78);
      backdrop-filter: blur(14px);
    }

    .hero-visual-card span { display:block; color:#1fa068; font-family:var(--mono); font-size:0.72rem; letter-spacing:0.12em; text-transform:uppercase; margin-bottom:0.35rem; }
    .hero-visual-card strong { display:block; color:var(--text); font-size:1.05rem; }
    .hero-visual-card p { color:var(--text-2); margin:0.35rem 0 0; line-height:1.5; font-size:0.92rem; }

    .intelligence-stack {
      isolation: isolate;
      overflow: hidden;
      perspective: 1200px;
    }

    .intelligence-stack::before {
      content: '';
      position: absolute;
      inset: 10%;
      border-radius: 999px;
      background: radial-gradient(circle, rgba(81,255,174,0.18), transparent 62%);
      filter: blur(18px);
      z-index: 0;
    }

    .stack-perspective {
      position: absolute;
      inset: 12% 9% 12%;
      transform: rotateX(58deg) rotateZ(-32deg) translateY(10px);
      transform-style: preserve-3d;
      z-index: 2;
    }

    .stack-layer {
      position: absolute;
      left: 6%;
      right: 6%;
      min-height: 76px;
      padding: 0.92rem 1rem;
      border: 1px solid rgba(128,255,196,0.22);
      border-radius: 18px;
      background: linear-gradient(135deg, rgba(8,36,22,0.92), rgba(2,12,7,0.82));
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.06), 0 24px 70px rgba(0,0,0,0.36), 0 0 30px rgba(31,160,104,0.08);
      backdrop-filter: blur(14px);
    }

    .stack-layer span {
      color: rgba(137,255,198,0.68);
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.12em;
    }

    .stack-layer strong {
      display: block;
      margin-top: 0.22rem;
      color: #effff6;
      font-size: 1rem;
      letter-spacing: -0.02em;
    }

    .stack-layer em {
      display: block;
      margin-top: 0.2rem;
      color: rgba(216,255,233,0.62);
      font-family: var(--mono);
      font-size: 0.68rem;
      font-style: normal;
    }

    .layer-output { top: 0; transform: translateZ(96px); }
    .layer-source { top: 18%; transform: translateZ(72px); }
    .layer-risk { top: 36%; transform: translateZ(48px); border-color: rgba(255,206,92,0.24); }
    .layer-human { top: 54%; transform: translateZ(24px); }
    .layer-audit { top: 72%; transform: translateZ(0); }

    .stack-orbit {
      position: absolute;
      z-index: 3;
      display: grid;
      place-items: center;
      border: 1px solid rgba(137,255,198,0.28);
      border-radius: 999px;
      background: rgba(2,12,7,0.78);
      color: #dffff0;
      font-family: var(--mono);
      font-size: 0.68rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      box-shadow: inset 0 0 22px rgba(31,160,104,0.18), 0 0 34px rgba(31,160,104,0.14);
    }

    .orbit-ai { width: 64px; height: 64px; top: 10%; right: 13%; }
    .orbit-crypto { width: 78px; height: 78px; bottom: 14%; right: 9%; }
    .orbit-risk { width: 58px; height: 58px; bottom: 24%; left: 9%; }

    .eyebrow {
      color: #1fa068;
      font-family: var(--mono);
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      margin-bottom: 0.8rem;
    }

    .simple-hero h1 {
      margin: 0;
      color: var(--text);
      font-size: clamp(2.65rem, 7vw, 6.3rem);
      line-height: 0.95;
      letter-spacing: -0.07em;
      max-width: 980px;
    }

    .hero-copy {
      color: var(--text-2);
      font-size: clamp(1.05rem, 2vw, 1.35rem);
      line-height: 1.65;
      max-width: 790px;
      margin: 1.35rem 0 0;
    }

    .hero-actions,
    .section-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .hero-actions {
      justify-content: flex-start;
      margin-top: 1.5rem;
    }

    .btn-primary,
    .btn-ghost {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      padding: 0.8rem 1.1rem;
      font-weight: 700;
      text-decoration: none;
      border: 1px solid rgba(31,160,104,0.35);
    }

    .btn-primary {
      background: #1fa068;
      color: #03130d;
    }

    .btn-ghost {
      color: var(--text);
      background: rgba(255,255,255,0.04);
    }

    .hero-stats {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 1.8rem;
    }

    .hero-stats div {
      min-width: 130px;
      padding: 0.8rem 1rem;
      border: 1px solid rgba(31,160,104,0.18);
      border-radius: 18px;
      background: rgba(31,160,104,0.055);
    }

    .hero-stats strong {
      display: block;
      color: var(--text);
      font-size: 1.45rem;
    }

    .hero-stats span {
      color: var(--text-2);
      font-size: 0.82rem;
    }

    .stack-console {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      margin: 1.25rem 0 2.4rem;
      min-height: 0;
      border: 1px solid rgba(90, 180, 255, 0.16);
      border-radius: 30px;
      overflow: hidden;
      background:
        radial-gradient(circle at 88% 8%, rgba(87, 177, 255, 0.12), transparent 26%),
        radial-gradient(circle at 84% 42%, rgba(31,160,104,0.11), transparent 30%),
        linear-gradient(135deg, rgba(2, 15, 31, 0.96), rgba(1, 6, 12, 0.98) 55%, rgba(1, 3, 2, 0.98));
      box-shadow: 0 38px 120px rgba(0,0,0,0.42), inset 0 1px 0 rgba(255,255,255,0.045);
    }

    .stack-console::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(92, 185, 255, 0.075) 1px, transparent 1px),
        linear-gradient(90deg, rgba(92, 185, 255, 0.075) 1px, transparent 1px),
        linear-gradient(rgba(31,160,104,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(31,160,104,0.04) 1px, transparent 1px);
      background-size: 92px 92px, 92px 92px, 23px 23px, 23px 23px;
      mask-image: linear-gradient(180deg, rgba(0,0,0,0.92), rgba(0,0,0,0.55));
    }

    .stack-console::after {
      content: '';
      position: absolute;
      top: -90px;
      right: -70px;
      width: 310px;
      height: 310px;
      opacity: 0.18;
      background: repeating-conic-gradient(from 8deg, rgba(180,230,255,0.32) 0 8deg, transparent 8deg 24deg);
      border-radius: 999px;
      filter: blur(0.2px);
    }

    .console-explorer {
      display: none;
    }

    .traffic-lights { display: flex; gap: 0.42rem; margin-bottom: 1rem; }
    .traffic-lights span { width: 10px; height: 10px; border-radius: 999px; background: #ff5c7a; }
    .traffic-lights span:nth-child(2) { background: #f5c35b; }
    .traffic-lights span:nth-child(3) { background: #2ef29a; }

    .console-explorer strong {
      display: block;
      color: rgba(242,255,248,0.82);
      font-size: 0.72rem;
      letter-spacing: 0.13em;
      margin-bottom: 0.85rem;
      overflow-wrap: anywhere;
    }

    .console-explorer nav { display: grid; gap: 0.5rem; margin: 0.7rem 0 1.2rem; }
    .console-explorer a,
    .console-file {
      color: rgba(202,232,255,0.68);
      font-size: 0.75rem;
      line-height: 1.25;
    }
    .console-explorer a:hover { color: #7ac7ff; }
    .console-file { margin: 0.52rem 0 0 0.5rem; color: rgba(46,242,154,0.7); }

    .console-main {
      position: relative;
      z-index: 1;
      min-width: 0;
      padding: 0 1.35rem 1.35rem;
    }

    .console-topbar {
      display: flex;
      justify-content: flex-end;
      gap: 0.6rem;
      height: 38px;
      align-items: center;
      color: rgba(222,248,229,0.56);
      font-family: var(--mono);
      font-size: 0.7rem;
    }

    .console-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 1rem;
      align-items: start;
      padding: 0.75rem 0 1rem;
    }

    .console-head h2 {
      margin: 0;
      max-width: 720px;
      color: var(--text);
      font-size: clamp(2.05rem, 4.2vw, 3.65rem);
      line-height: 0.98;
      letter-spacing: -0.055em;
      text-wrap: balance;
    }

    .console-head p {
      max-width: 660px;
      margin: 0.9rem 0 0;
      color: rgba(222,248,229,0.82);
      font-size: 0.98rem;
      line-height: 1.5;
      font-weight: 650;
    }

    .console-badge {
      margin-top: 2.1rem;
      color: rgba(202,232,255,0.62);
      font-family: var(--mono);
      font-size: 0.82rem;
      white-space: nowrap;
    }

    .console-group {
      margin-top: 0.82rem;
    }

    .console-group header {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 0.9rem;
      border-bottom: 1px solid rgba(92,185,255,0.15);
      padding-bottom: 0.45rem;
    }

    .console-group header::before {
      content: '';
      width: 30px;
      height: 30px;
      border-radius: 9px;
      background: rgba(122,199,255,0.22);
      border: 1px solid rgba(122,199,255,0.32);
      box-shadow: 0 0 22px rgba(122,199,255,0.14);
    }

    .console-group h3 {
      margin: 0;
      color: #7ac7ff;
      font-family: var(--mono);
      font-size: clamp(0.98rem, 1.6vw, 1.28rem);
      letter-spacing: 0.03em;
      text-transform: uppercase;
    }

    .console-group header span {
      color: rgba(202,232,255,0.54);
      font-family: var(--mono);
      font-size: 0.82rem;
    }

    .accent-pink h3 { color: #ff82d8; }
    .accent-pink header::before { background: rgba(255,130,216,0.22); border-color: rgba(255,130,216,0.32); box-shadow: 0 0 22px rgba(255,130,216,0.14); }
    .accent-green h3 { color: #74f2ae; }
    .accent-green header::before { background: rgba(46,242,154,0.20); border-color: rgba(46,242,154,0.30); box-shadow: 0 0 22px rgba(46,242,154,0.14); }

    .console-rows { display: grid; }

    .console-row {
      display: grid;
      grid-template-columns: 48px minmax(0, 1fr);
      gap: 0.95rem;
      align-items: center;
      min-height: 68px;
      padding: 0.58rem 0;
      border-bottom: 1px solid rgba(92,185,255,0.075);
      color: inherit;
      text-decoration: none;
      transition: transform 0.18s ease, background 0.18s ease;
    }

    .console-row:hover {
      transform: translateX(4px);
      background: linear-gradient(90deg, rgba(31,160,104,0.06), transparent);
    }

    .row-icon {
      display: grid;
      place-items: center;
      width: 42px;
      height: 42px;
      border-radius: 12px;
