---
import BaseLayout from '../layouts/BaseLayout.astro';
import ParticleHero from '../components/ParticleHero.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const articleCount = sortedPosts.length;

const slugOf = (post) => post.data.slug || post.id;
const hrefOf = (post) => `/blog/${slugOf(post)}/`;
const hasAny = (post, terms) => {
  const text = `${slugOf(post)} ${post.data.title} ${post.data.description} ${(post.data.tags ?? []).join(' ')}`.toLowerCase();
  return terms.some((term) => text.includes(term));
};

const aiPosts = sortedPosts.filter((post) => hasAny(post, ['ai model', 'claude', 'gemini', 'open weight', 'llm', 'agent', 'artificial intelligence'])).slice(0, 6);
const financePosts = sortedPosts.filter((post) => hasAny(post, ['finance', 'bank', 'aml', 'kyc', 'fraud', 'risk', 'advisor'])).slice(0, 6);
const cryptoPosts = sortedPosts.filter((post) => hasAny(post, ['crypto', 'wallet', 'blockchain', 'token', 'stablecoin', 'defi'])).slice(0, 6);
const latestPosts = sortedPosts.slice(0, 8);

const featured = aiPosts[0] ?? sortedPosts[0];
const quickSections = [
  {
    label: 'Blog',
    title: 'Read the latest guides',
    text: 'Source-backed notes on AI models, crypto, risk, and the systems changing finance.',
    href: '/articles/',
  },
  {
    label: 'AI Models',
    title: 'Understand models and tools',
    text: 'Model guides, AI concepts, comparisons, and practical use cases for builders.',
    href: '/ai-models/',
  },
  {
    label: 'Risk',
    title: 'Read finance and crypto risk notes',
    text: 'Wallet risk, fraud triage, AML status, and explainable review workflows.',
    href: '/risk-evidence/',
  },
  {
    label: 'Signals',
    title: 'Market and source signals',
    text: 'Public signals, reports, and source trails without trading calls or hype.',
    href: '/signals/',
  },
];
---

<BaseLayout
  title="Home"
  description="Bionic Banker publishes AI finance, fintech, crypto, risk, and source-backed systems research."
>
  <main class="simple-home">
    <section class="simple-hero hero-system">
      <div class="hero-copy-block">
        <div class="eyebrow">Bionic Banker</div>
        <h1>AI finance, crypto, and risk intelligence.</h1>
        <p class="hero-copy">A minimal field guide for AI models, crypto infrastructure, risk signals, and source-backed finance systems. Clear writing, useful diagrams, and no trading hype.</p>
        <div class="hero-actions" aria-label="Primary reading paths">
          <a class="btn-primary" href="/articles/">Read the Blog</a>
          <a class="btn-ghost" href="/ai-models/">Explore AI Models</a>
          <a class="btn-ghost" href="/risk-evidence/">Risk</a>
          <a class="btn-ghost" href="/signals/">Signals</a>
        </div>
        <div class="hero-stats" aria-label="Site summary">
          <div><strong>{articleCount}</strong><span>blog posts</span></div>
          <div><strong>4</strong><span>clear paths</span></div>
          <div><strong>Signals</strong><span>verified rows</span></div>
        </div>
      </div>
      <aside class="hero-visual" aria-label="AI and crypto signal map">
        <ParticleHero />
        <div class="orb orb-ai">AI</div>
        <div class="orb orb-risk">Risk</div>
        <div class="orb orb-chain">Crypto</div>
        <div class="hero-visual-card">
          <span>Source trail</span>
          <strong>Signal → evidence → limit</strong>
          <p>Advanced topics need a clean map before they need more noise.</p>
        </div>
      </aside>
    </section>

    <section class="quick-grid" aria-label="Main website sections">
      {quickSections.map((section) => (
        <a class="quick-card" href={section.href}>
          <span>{section.label}</span>
          <h2>{section.title}</h2>
          <p>{section.text}</p>
          <em>Open →</em>
        </a>
      ))}
    </section>

    <section class="featured-strip" aria-label="Featured article">
      <div class="featured-copy">
        <div class="eyebrow">Start here</div>
        <h2>{featured.data.title}</h2>
        <p>{featured.data.description}</p>
        <a class="btn-primary" href={hrefOf(featured)}>Read this guide</a>
      </div>
      {featured.data.image && (
        <a class="featured-image" href={hrefOf(featured)}>
          <img src={featured.data.image} alt={featured.data.title} loading="eager" />
        </a>
      )}
    </section>

    <section class="content-section" id="latest">
      <div class="section-head">
        <div>
          <div class="eyebrow">Latest</div>
          <h2>Latest from the Blog</h2>
        </div>
        <a href="/articles/">View all →</a>
      </div>
      <div class="article-grid">
        {latestPosts.map((post) => (
          <a class="article-card" href={hrefOf(post)}>
            {post.data.image && <img src={post.data.image} alt={post.data.title} loading="lazy" />}
            <div class="card-body">
              <div class="tags">{(post.data.tags ?? []).slice(0, 3).map((tag) => <span>{tag}</span>)}</div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <small>{post.data.readTime}</small>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="content-section topic-section" id="topics">
      <div class="section-head">
        <div>
          <div class="eyebrow">Topics</div>
          <h2>Choose what you want to understand</h2>
        </div>
      </div>
      <div class="topic-columns">
        <div class="topic-column">
          <h3>AI Models</h3>
          <p>AI models, model weights, context windows, benchmarks, agents, and tools.</p>
          {aiPosts.slice(0, 4).map((post) => <a href={hrefOf(post)}>{post.data.title}</a>)}
          <a class="topic-more" href="/ai-models/">Open AI Models →</a>
        </div>
        <div class="topic-column">
          <h3>Risk</h3>
          <p>KYC, AML, fraud triage, advisor workflows, and risk evidence.</p>
          {financePosts.slice(0, 4).map((post) => <a href={hrefOf(post)}>{post.data.title}</a>)}
          <a class="topic-more" href="/risk-evidence/">Open Risk →</a>
        </div>
        <div class="topic-column">
          <h3>Crypto & Signals</h3>
          <p>Wallet risk, blockchain infrastructure, tokens, stablecoins, and public signals.</p>
          {cryptoPosts.slice(0, 4).map((post) => <a href={hrefOf(post)}>{post.data.title}</a>)}
          <a class="topic-more" href="/signals/">Open signals →</a>
        </div>
      </div>
    </section>

    <section class="plain-note">
      <h2>What this site is</h2>
      <p>Bionic Banker is a public learning and publishing site for AI, finance, crypto, and risk systems. It packages advanced topics with clear writing, source trails, and selective visual systems. It does not give trading, legal, tax, or investment advice.</p>
    </section>
  </main>

  <style>
    .simple-home {
      width: min(1180px, calc(100% - 2rem));
      margin: 0 auto;
      padding: 3.2rem 0 5rem;
    }

    .simple-hero {
      padding: clamp(3rem, 7vw, 6.5rem) 0 2.2rem;
      max-width: 940px;
    }

    .hero-system {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.65fr);
      align-items: center;
      gap: clamp(1.5rem, 4vw, 3.5rem);
      max-width: none;
    }

    .hero-copy-block {
      max-width: 940px;
    }

    .hero-visual {
      position: relative;
      min-height: clamp(360px, 48vw, 560px);
      border: 1px solid rgba(31,160,104,0.22);
      border-radius: 32px;
      overflow: hidden;
      background: radial-gradient(circle at 30% 25%, rgba(31,160,104,0.20), transparent 34%), radial-gradient(circle at 82% 70%, rgba(115,255,190,0.10), transparent 34%), linear-gradient(145deg, rgba(4,20,12,0.98), rgba(1,3,2,0.92));
      box-shadow: 0 30px 90px rgba(0,0,0,0.36);
    }

    .hero-visual #particle-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .orb {
      position: absolute;
      display: grid;
      place-items: center;
      border-radius: 999px;
      border: 1px solid rgba(137,255,198,0.34);
      background: rgba(3,16,9,0.72);
      color: #e9fff4;
      font-family: var(--mono);
      font-size: 0.78rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      box-shadow: inset 0 0 24px rgba(31,160,104,0.20), 0 0 28px rgba(31,160,104,0.12);
    }

    .orb-ai { width: 8.5rem; height: 8.5rem; top: 18%; left: 14%; }
    .orb-risk { width: 7.2rem; height: 7.2rem; top: 34%; right: 13%; }
    .orb-chain { width: 6.6rem; height: 6.6rem; bottom: 18%; left: 30%; }

    .hero-visual-card {
      position: absolute;
      left: 1.1rem;
      right: 1.1rem;
      bottom: 1.1rem;
      padding: 1rem;
      border: 1px solid rgba(31,160,104,0.25);
      border-radius: 22px;
      background: rgba(1,8,5,0.78);
      backdrop-filter: blur(14px);
    }

    .hero-visual-card span { display:block; color:#1fa068; font-family:var(--mono); font-size:0.72rem; letter-spacing:0.12em; text-transform:uppercase; margin-bottom:0.35rem; }
    .hero-visual-card strong { display:block; color:var(--text); font-size:1.05rem; }
    .hero-visual-card p { color:var(--text-2); margin:0.35rem 0 0; line-height:1.5; font-size:0.92rem; }

    .eyebrow {
      color: #1fa068;
      font-family: var(--mono);
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      margin-bottom: 0.8rem;
    }

    .simple-hero h1 {
      margin: 0;
      color: var(--text);
      font-size: clamp(2.65rem, 7vw, 6.3rem);
      line-height: 0.95;
      letter-spacing: -0.07em;
      max-width: 980px;
    }

    .hero-copy {
      color: var(--text-2);
      font-size: clamp(1.05rem, 2vw, 1.35rem);
      line-height: 1.65;
      max-width: 790px;
      margin: 1.35rem 0 0;
    }

    .hero-actions,
    .section-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .hero-actions {
      justify-content: flex-start;
      margin-top: 1.5rem;
    }

    .btn-primary,
    .btn-ghost {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      padding: 0.8rem 1.1rem;
      font-weight: 700;
      text-decoration: none;
      border: 1px solid rgba(31,160,104,0.35);
    }

    .btn-primary {
      background: #1fa068;
      color: #03130d;
    }

    .btn-ghost {
      color: var(--text);
      background: rgba(255,255,255,0.04);
    }

    .hero-stats {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 1.8rem;
    }

    .hero-stats div {
      min-width: 130px;
      padding: 0.8rem 1rem;
      border: 1px solid rgba(31,160,104,0.18);
      border-radius: 18px;
      background: rgba(31,160,104,0.055);
    }

    .hero-stats strong {
      display: block;
      color: var(--text);
      font-size: 1.45rem;
    }

    .hero-stats span {
      color: var(--text-2);
      font-size: 0.82rem;
    }

    .quick-grid,
    .article-grid,
    .topic-columns {
      display: grid;
      gap: 1rem;
    }

    .quick-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      margin: 1.5rem 0 3rem;
    }

    .quick-card,
    .article-card,
    .topic-column,
    .featured-strip,
    .plain-note {
      border: 1px solid rgba(31,160,104,0.18);
      border-radius: 24px;
      background: linear-gradient(135deg, rgba(31,160,104,0.08), rgba(255,255,255,0.025));
      text-decoration: none;
      color: inherit;
    }

    .quick-card {
      padding: 1.1rem;
      min-height: 210px;
      display: flex;
      flex-direction: column;
    }

    .quick-card span,
    .tags span {
      color: #1fa068;
      font-family: var(--mono);
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .quick-card h2,
    .content-section h2,
    .featured-copy h2,
    .plain-note h2 {
      color: var(--text);
      letter-spacing: -0.045em;
    }

    .quick-card h2 {
      font-size: 1.25rem;
      line-height: 1.1;
      margin: 0.7rem 0 0.45rem;
    }

    .quick-card p,
    .article-card p,
    .topic-column p,
    .featured-copy p,
    .plain-note p {
      color: var(--text-2);
      line-height: 1.6;
    }

    .quick-card em {
      margin-top: auto;
      color: #1fa068;
      font-style: normal;
      font-weight: 700;
    }

    .featured-strip {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
      gap: 1.2rem;
      padding: 1.25rem;
      margin: 0 0 3rem;
      align-items: center;
    }

    .featured-copy {
      padding: 0.75rem;
    }

    .featured-copy h2,
    .content-section h2,
    .plain-note h2 {
      font-size: clamp(1.8rem, 4vw, 3.2rem);
      line-height: 1;
      margin: 0;
    }

    .featured-image img,
    .article-card img {
      width: 100%;
      display: block;
      object-fit: cover;
      border-radius: 18px;
      border: 1px solid rgba(31,160,104,0.16);
      background: #050a08;
    }

    .featured-image img {
      aspect-ratio: 16 / 9;
    }

    .content-section {
      margin: 3.2rem 0;
    }

    .section-head {
      margin-bottom: 1rem;
    }

    .section-head a,
    .topic-column a {
      color: #1fa068;
      text-decoration: none;
      font-weight: 700;
    }

    .article-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .article-card {
      overflow: hidden;
      min-height: 100%;
    }

    .article-card img {
      aspect-ratio: 16 / 9;
      border-radius: 24px 24px 0 0;
      border: 0;
      border-bottom: 1px solid rgba(31,160,104,0.16);
    }

    .card-body {
      padding: 1rem;
    }

    .article-card h3 {
      color: var(--text);
      font-size: 1.05rem;
      line-height: 1.22;
      margin: 0.65rem 0 0.4rem;
      letter-spacing: -0.025em;
    }

    .article-card small {
      color: #1fa068;
      font-family: var(--mono);
    }

    .topic-columns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .topic-column {
      padding: 1.25rem;
    }

    .topic-column h3 {
      color: var(--text);
      font-size: 1.4rem;
      margin: 0 0 0.4rem;
    }

    .topic-column a {
      display: block;
      padding: 0.65rem 0;
      border-top: 1px solid rgba(255,255,255,0.07);
      line-height: 1.35;
    }

    .topic-column .topic-more {
      margin-top: 0.5rem;
      color: var(--text);
    }

    .plain-note {
      padding: 1.4rem;
      margin-top: 3rem;
      max-width: 860px;
    }

    @media (max-width: 980px) {
      .quick-grid,
      .article-grid,
      .topic-columns,
      .featured-strip {
        grid-template-columns: 1fr;
      }

      .simple-home {
        width: min(100% - 1rem, 760px);
        padding-top: 1.2rem;
      }
    }

    @media (max-width: 900px) {
      .hero-system { grid-template-columns: 1fr; }
      .hero-visual { min-height: 340px; }
    }

  </style>
</BaseLayout>
