---
import BaseLayout from '../layouts/BaseLayout.astro';
import ParticleHero from '../components/ParticleHero.astro';
import { getCollection } from 'astro:content';
const proofCatalog = await import('../../public/dashboard-data/public-proof-catalog.json');
const gapCatalog = await import('../../public/dashboard-data/market-gap-catalog.json');

// GET ARTICLE COUNT — computed, never hardcoded again
const allPosts = await getCollection('blog');
const articleCount = allPosts.length;
const proofCount = proofCatalog.default.projects.length;
const questionCount = gapCatalog.default.modern_questions.length;
const featuredPosts = allPosts.filter(p => p.data.featured);
const sortedPosts = allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const latestPost = sortedPosts[0];
const featuredArticle = featuredPosts[0] || sortedPosts[0];
const gridPosts = sortedPosts.filter(p => p.id !== featuredArticle.id).slice(0, 3);
---
<BaseLayout title="Home">

  <!-- HERO -->
  <div class="hero-wrap">
    <div class="glow-orb glow-orb-1"></div>
    <div class="glow-orb glow-orb-2"></div>
    <ParticleHero />
    <div class="hero">
      <div class="hero-left">
        <div class="hero-eyebrow">Finance · Code · Both</div>
        <h1>Inside Finance.<br><em>Building</em> Its Future.</h1>
        <p class="hero-sub">I work inside financial systems and build on top of them. Two sides of the same thing — the industry access, the code, the questions I can't stop asking.</p>
        <div class="hero-actions">
          <a href="#newsletter" class="btn-primary">Subscribe →</a>
          <a href="/proof-tour" class="btn-ghost">Start Proof Tour</a>
          <a href="/site-agent" class="btn-ghost">Ask the Site</a>
          <a href="/projects" class="btn-ghost">View Projects</a>
          <a href="/reports" class="btn-ghost">See Reports</a>
          <a href="/articles" class="btn-ghost">Read Articles</a>
        </div>
        <div class="hero-stats-row">
          <div class="hstat"><span class="hstat-n">{articleCount}</span><span class="hstat-l">Articles</span></div>
          <div class="hstat"><span class="hstat-n">{proofCount}</span><span class="hstat-l">Proof Lanes</span></div>
          <div class="hstat"><span class="hstat-n">{questionCount}</span><span class="hstat-l">Questions</span></div>
        </div>
      </div>

      <div class="hero-right">
        <div class="hero-card-label">Latest</div>
        <a href={`/blog/${latestPost.data.slug || latestPost.id}`} class="hero-article-card">
          <div class="hcard-tag">{(latestPost.data.featured ? 'Featured · ' : '') + latestPost.data.tags.join(' · ')}</div>
          <div class="hcard-title">{latestPost.data.title}</div>
          <div class="hcard-desc">{latestPost.data.description}</div>
          <div class="hcard-footer">
            <span class="hcard-read">Read the full story →</span>
            <span class="hcard-time">{latestPost.data.readTime}</span>
          </div>
        </a>
        <div class="hero-mini-stack">
          {sortedPosts.slice(1, 4).map(post => (
            <a href={`/blog/${post.data.slug || post.id}`} class="hero-mini-card">
              <div class="mini-dot"></div>
              <div class="mini-title">{post.data.title}</div>
              <span class="mini-time">{post.data.readTime}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- ARTICLES -->
  <div class="content-wrap" id="articles">
    <section class="proof-route-section animate-on-scroll">
      <div class="section-header">
        <div>
          <div class="section-label-text">Proof Surface</div>
          <div class="section-title-text">Start Here</div>
        </div>
        <a href="/proof-tour" class="view-all">Start proof tour -></a>
      </div>
      <div class="proof-route-grid">
        <a href="/proof-tour" class="article-card">
          <div class="article-tags"><span class="tag-pill tag-green">Tour</span></div>
          <h3>Guided proof app</h3>
          <p>A clickable route through AML, agents, heartbeat status, governance proof, reports, and public questions.</p>
          <div class="card-footer"><span class="read-more">Start tour -></span></div>
        </a>
        <a href="/projects" class="article-card">
          <div class="article-tags"><span class="tag-pill tag-green">Projects</span></div>
          <h3>What was built</h3>
          <p>Source-linked proof cards for AML, agent workflows, observability, governance, wallet risk, and technical writing.</p>
          <div class="card-footer"><span class="read-more">View projects -></span></div>
        </a>
        <a href="/reports" class="article-card">
          <div class="article-tags"><span class="tag-pill tag-green">Reports</span></div>
          <h3>Numbers and charts</h3>
          <p>Evidence density, benchmark numbers, capability coverage, and limitations in a report-style surface.</p>
          <div class="card-footer"><span class="read-more">View reports -></span></div>
        </a>
        <a href="/gaps" class="article-card">
          <div class="article-tags"><span class="tag-pill tag-green">Questions</span></div>
          <h3>Questions Worth Solving</h3>
          <p>Modern AI and finance questions mapped to public signals, experiments, and evidence routes.</p>
          <div class="card-footer"><span class="read-more">View questions -></span></div>
        </a>
        <a href="/learn" class="article-card">
          <div class="article-tags"><span class="tag-pill tag-green">Learn</span></div>
          <h3>Concept layer</h3>
          <p>Plain-English definitions for RAG, agents, RBAC, observability, embeddings, AML, and deployment concepts.</p>
          <div class="card-footer"><span class="read-more">Learn concepts -></span></div>
        </a>
        <a href="/site-agent" class="article-card">
          <div class="article-tags"><span class="tag-pill tag-green">Ask</span></div>
          <h3>Ask the site</h3>
          <p>Type a question and get routed to the right page: About, AML, agents, reports, learning notes, or live signal rows.</p>
          <div class="card-footer"><span class="read-more">Open site guide -></span></div>
        </a>
      </div>
    </section>

    <div class="section-header">
      <div>
        <div class="section-label-text">Writings</div>
        <div class="section-title-text">Articles</div>
      </div>
      <a href="/articles" class="view-all">View all {articleCount} →</a>
    </div>

    <div class="mag-grid animate-on-scroll">
      <div class="mag-featured">
        <a href={`/blog/${featuredArticle.data.slug || featuredArticle.id}`} class="article-card-featured">
          {featuredArticle.data.image && (
            <div class="featured-thumb">
              <img src={featuredArticle.data.image} alt={featuredArticle.data.title} loading="lazy" />
            </div>
          )}
          <div class="featured-badge">★ Featured</div>
          <div class="article-tags">
            {featuredArticle.data.tags.map(tag => (
              <span class="tag-pill">{tag}</span>
            ))}
          </div>
          <h3>{featuredArticle.data.title}</h3>
          <p>{featuredArticle.data.description}</p>
          <div class="featured-footer">
            <div class="featured-stats">
              <span class="featured-stat"><strong>{featuredArticle.data.readTime}</strong> read</span>
            </div>
            <span class="read-more">Full story →</span>
          </div>
        </a>
      </div>

      {gridPosts.map(post => (
        <a href={`/blog/${post.data.slug || post.id}`} class="article-card">
          {post.data.image && (
            <div class="card-thumb">
              <img src={post.data.image} alt={post.data.title} loading="lazy" />
            </div>
          )}
          <div class="article-tags">
            {post.data.tags.map(tag => (
              <span class="tag-pill">{tag}</span>
            ))}
          </div>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
          <div class="card-footer">
            <span class="read-more">Read →</span>
            <span class="read-time">{post.data.readTime}</span>
          </div>
        </a>
      ))}
    </div>

    <!-- BOTTOM SPLIT -->
    <div class="bottom-split animate-on-scroll">
      <div>
        <div class="section-header" style="margin-bottom:0.75rem;">
          <div>
            <div class="section-label-text">Personal Writing</div>
            <div class="section-title-text">Thoughts</div>
          </div>
        </div>
        <a href="/blog/the-anchor" class="thoughts-card">
          <div class="article-tags">
            <span class="tag-pill">Thoughts</span>
            <span class="tag-pill">AI</span>
          </div>
          <h3>The Anchor Problem</h3>
          <p>I went looking for a template for life. Found a return mechanism instead. Then realized I'd built the exact same structure into my AI systems — without ever consciously making the connection.</p>
          <div class="tc-footer">
            <span class="read-more">Read →</span>
            <span class="read-time">6 min · March 2026</span>
          </div>
        </a>
      </div>

      <div id="about">
        <div class="section-header" style="margin-bottom:0.75rem;">
          <div>
            <div class="section-label-text">Who</div>
            <div class="section-title-text">About</div>
          </div>
        </div>
        <div class="about-col">
          <div>
            <div class="about-name">Himanshu</div>
            <div class="about-role">Finance · Blockchain · Builder</div>
            <p class="about-bio">I am Himanshu, a computer engineer working in finance and building at the edge where banking, blockchain, AI agents, and risk systems meet. Bionic Banker is my public lab: the place where I turn private learning into visible proof, explain hard concepts in plain language, and keep asking what a useful financial AI system should actually show.</p>
            <p class="about-bio">The work here spans AML detection, wallet risk, agent governance, observability, technical writing, and market research. The goal is simple: make the proof inspectable enough that a recruiter, builder, founder, or curious reader can understand what exists before needing a meeting.</p>
          </div>
          <div class="about-stat-row">
            <div class="astat"><div class="astat-n">{articleCount}</div><div class="astat-l">Articles</div></div>
            <div class="astat"><div class="astat-n">{proofCount}</div><div class="astat-l">Proof Lanes</div></div>
            <div class="astat"><div class="astat-n">5+</div><div class="astat-l">Years</div></div>
            <div class="astat"><div class="astat-n">∞</div><div class="astat-l">Questions</div></div>
          </div>
        </div>
      </div>
    </div>

    <!-- NEWSLETTER + TELEGRAM -->
    <div class="newsletter-strip animate-on-scroll" id="newsletter-inline">
      <div class="nl-text">
        <h3>Stay in the loop</h3>
        <p>Finance, blockchain, AI — one piece at a time.<br>No fluff, no schedule, just when it's worth saying.</p>
      </div>
      <div class="telegram-cta-wrap">
        <a href="https://t.me/BionicBanker" class="telegram-cta" target="_blank" rel="noopener">
          Join the Telegram &rarr;
        </a>
      </div>
    </div>
  </div>

  <!-- CONTACT -->
  <div class="contact-section animate-on-scroll" id="contact">
    <div class="section-header" style="margin-bottom:1.5rem;">
      <div>
        <div class="section-label-text">Get in touch</div>
        <div class="section-title-text">Contact</div>
      </div>
    </div>
    <form class="contact-form" action="https://formspree.io/f/xdaljypn" method="POST">
      <input type="text" name="_gotcha" style="display:none !important" tabindex="-1" autocomplete="off" aria-hidden="true">
      <div class="form-group">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" placeholder="Your name" required />
      </div>
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="your@email.com" required />
      </div>
      <div class="form-group">
        <label for="message">Message</label>
        <textarea id="message" name="message" placeholder="What's on your mind?" required></textarea>
      </div>
      <button type="submit" class="btn-primary" style="width:fit-content;">Send →</button>
    </form>
  </div>
</BaseLayout>
