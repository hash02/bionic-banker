---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Projects';
const description = 'A minimal portfolio of Bionic Banker projects and labs: what each one does, what it produces, where to open it, and what boundary it keeps.';

const projects = [
  {
    label: 'Project 01',
    name: 'AML Review Engine',
    status: '46 tests passing',
    oneLine: 'Turns transaction rows into risk flags, evidence notes, and a human-review queue.',
    input: 'Transaction rows',
    output: 'Risk queue + rule reasons + evidence note',
    boundary: 'Triage only. It does not accuse, file, freeze, approve, or make a final compliance decision.',
    primary: { label: 'Launch dashboard', href: '/labs/aml-engine/demo/' },
    links: [
      { label: 'View lab', href: '/labs/aml-engine/' },
      { label: 'Download pack', href: '/downloads/aml-demo-pack/README.md' },
      { label: 'GitHub', href: 'https://github.com/hash02/aml-detection-engine' },
    ],
  },
  {
    label: 'Project 02',
    name: 'Bionic Lab App',
    status: 'static app build passes',
    oneLine: 'A compact finance-intelligence dashboard for signals, planning, AML view, and market context.',
    input: 'Public demo data + dashboard state',
    output: 'Interactive app surface with cards, charts, and guardrails',
    boundary: 'Demo surface only. It does not connect to accounts, move funds, or give investment advice.',
    primary: { label: 'Launch app', href: '/project-apps/bionic-lab/' },
    links: [
      { label: 'GitHub', href: 'https://github.com/hash02/bionic-lab' },
    ],
  },
  {
    label: 'Project 03',
    name: 'Governed Agent Proof',
    status: 'repo packaging queued',
    oneLine: 'A small agent-control proof for retrieval, safety checks, role boundaries, and audit traces.',
    input: 'Task request + policy context',
    output: 'Reviewed agent response + traceable control path',
    boundary: 'Proof environment only. It does not approve customer decisions or operate production systems.',
    primary: { label: 'GitHub', href: 'https://github.com/hash02/agent-framework-proof' },
    links: [
      { label: 'Payment control article', href: '/blog/agentic-payments-receipt-layer/' },
      { label: 'Human-in-loop tutorial', href: '/blog/human-in-loop-agent-payments/' },
    ],
  },
  {
    label: 'Project 04',
    name: 'AI-Agent Payment Control',
    status: 'checklist + tutorial live',
    oneLine: 'Shows how AI-agent payments should leave a receipt trail before autonomy increases.',
    input: 'Request + rule + payment event',
    output: 'Control checklist + receipt-layer review path',
    boundary: 'No wallet authority. No production payment execution. Human approval stays outside the agent.',
    primary: { label: 'Open control article', href: '/blog/agentic-payments-receipt-layer/' },
    links: [
      { label: 'Checklist PDF', href: '/blog-visuals/agentic-payments-receipt-layer/checklist/ai-agent-payment-control-checklist.pdf' },
      { label: 'Human-in-loop tutorial', href: '/blog/human-in-loop-agent-payments/' },
    ],
  },
  {
    label: 'Project 05',
    name: 'Wallet & Fraud Risk Review',
    status: 'interactive pages live',
    oneLine: 'Packages wallet-risk and fraud signals into readable case notes instead of verdicts.',
    input: 'Wallet row / fraud signal',
    output: 'Risk explanation + source limits + next review step',
    boundary: 'Educational review surface. Not trading advice, legal advice, enforcement, or customer decisioning.',
    primary: { label: 'Open wallet risk', href: '/wallet-risk/' },
    links: [
      { label: 'Fraud triage', href: '/fraud-alert-triage/' },
      { label: 'Risk evidence', href: '/risk-evidence/' },
      { label: 'Wallet notes', href: '/blog/wallet-risk-notes/' },
    ],
  },
  {
    label: 'Project 06',
    name: 'Kite Testnet Proof',
    status: 'testnet proof only',
    oneLine: 'Records Kite testnet and decentralized-infrastructure work with paper-mode portfolio state.',
    input: 'Public market snapshot + testnet configuration',
    output: 'Paper-mode portfolio state + testnet execution record',
    boundary: 'No real-fund execution, no wallet power, no order power. This is not investment advice.',
    primary: { label: 'View source catalog', href: '/evidence/' },
    links: [
      { label: 'Public boundary', href: '/projects/' },
    ],
  },
  {
    label: 'Project 07',
    name: 'Agent Operations Lessons',
    status: 'public boundary stated',
    oneLine: 'Records public lessons from running small agent systems without exposing the private operating layer.',
    input: 'Public-safe reports',
    output: 'Operating lessons + review boundary',
    boundary: 'Public lessons only. No production authority, live credentials, or autonomous outside action.',
    primary: { label: 'Read public report', href: '/blog/agent-graveyard/' },
    links: [
      { label: 'View source catalog', href: '/evidence/' },
    ],
  },
];

const doneSignals = [
  'Each priority project has a one-line explanation.',
  'Each project has a working demo or clickable surface.',
  'Each project states input, output, and boundary.',
  'Each project links to evidence, source, or downloadable proof.',
];

const publicSafetyChecks = [
  'Show the artifact and the boundary.',
  'Use public repos, public demos, screenshots, tests, and sanitized docs as proof.',
  'Keep internal working notes and account-level data off the page.',
  'Use a clear boundary line wherever a project touches AI, risk, wallet, payment, or compliance language.',
];

const packagingLanes = [
  { label: 'First lane', title: 'AI control review', text: 'Turn agent, model, or workflow ideas into a source-trail, boundary map, and human-review checklist.' },
  { label: 'Second lane', title: 'Project packaging', text: 'Package technical work into a public demo, evidence record, boundary note, and reader-readable page.' },
  { label: 'Later lane', title: 'Templates + checklists', text: 'Only after enough proof exists: publish reusable AI safety, evidence, and finance-control templates.' },
];
---

<BaseLayout title={title} description={description} canonical="https://bionicbanker.tech/projects/">
  <main class="project-apps-wrap">
    <section class="project-hero">
      <p class="eyebrow">Projects + Labs</p>
      <h1>Built work, packaged simply.</h1>
      <p class="lede">
        Projects and labs live here together. Click one, see what it does, inspect the proof, and read the boundary.
        No maze. No over-explaining.
      </p>
    </section>

    <section class="project-grid" aria-label="Packaged Bionic projects">
      {projects.map((project) => (
        <article class="project-card">
          <div class="project-topline">
            <span>{project.label}</span>
            <em>{project.status}</em>
          </div>
          <h2>{project.name}</h2>
          <p class="one-line">{project.oneLine}</p>
          <div class="io-strip" aria-label={`${project.name} input output`}>
            <div><span>Input</span><strong>{project.input}</strong></div>
            <div><span>Output</span><strong>{project.output}</strong></div>
          </div>
          <div class="boundary-box">
            <span>Boundary</span>
            <p>{project.boundary}</p>
          </div>
          <div class="project-actions">
            <a class="primary-action" href={project.primary.href}>{project.primary.label}</a>
            {project.links.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </div>
        </article>
      ))}
    </section>

    <section class="packaging-console" aria-label="Project packaging trust direction">
      <div class="packaging-path"><span>bionic</span><span>project → evidence → boundary → reader trust</span></div>
      <div class="packaging-head">
        <p class="eyebrow">Packaging standard</p>
        <h2>The project direction is trust before claims.</h2>
        <p>Projects should prove judgment, implementation taste, and control discipline. The first lane is a packaged review surface people can understand and trust.</p>
      </div>
      <div class="packaging-lanes">
        {packagingLanes.map((lane) => (
          <article>
            <span>{lane.label}</span>
            <h3>{lane.title}</h3>
            <p>{lane.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="done-panel" aria-label="Website packaging completion criteria">
      <div>
        <p class="eyebrow">Packaging standard</p>
        <h2>When is the website “done enough” for this layer?</h2>
        <p>
          This layer is done when a recruiter, collaborator, or technical reviewer can understand the work in one screen,
          open a demo, and see the risk boundary without asking for a long explanation.
        </p>
      </div>
      <ul>
        {doneSignals.map((signal) => <li>{signal}</li>)}
      </ul>
    </section>

    <section class="done-panel safety-panel" aria-label="Public safety packaging checks">
      <div>
        <p class="eyebrow">Public safety rule</p>
        <h2>The project page shows proof, not the private operating layer.</h2>
        <p>
          Packaging is intentionally narrow: clear demos, reproducible evidence, and boundaries. Internal working notes
          stay out of the public surface.
        </p>
      </div>
      <ul>
        {publicSafetyChecks.map((check) => <li>{check}</li>)}
      </ul>
    </section>
  </main>

  <style is:global>
    .project-apps-wrap { max-width: 1220px; margin: 0 auto; padding: 5.5rem 1.2rem 4rem; }
    .project-hero { border: 1px solid rgba(31,160,104,.35); border-radius: 30px; padding: clamp(2rem, 5vw, 4rem); background: radial-gradient(circle at 20% 0%, rgba(31,160,104,.2), transparent 42%), #020704; }
    .eyebrow { color: #7ee0aa; text-transform: uppercase; letter-spacing: .16em; font-size: .76rem; font-weight: 800; margin: 0 0 .75rem; }
    .project-hero h1 { font-size: clamp(3rem, 8vw, 7rem); line-height: .9; letter-spacing: -.07em; margin: 0 0 1rem; max-width: 950px; }
    .lede { color: #d8eee1; font-size: clamp(1.05rem, 2vw, 1.35rem); max-width: 820px; line-height: 1.55; }
    .project-grid { display: grid; gap: 1rem; margin: 1rem 0; }
    .project-card { border: 1px solid rgba(138,138,160,.25); background: rgba(5,18,11,.78); border-radius: 26px; padding: clamp(1.2rem, 2.5vw, 2rem); }
    .project-topline { display: flex; justify-content: space-between; gap: 1rem; align-items: center; margin-bottom: .8rem; }
    .project-topline span, .project-topline em, .io-strip span, .boundary-box span { color: #7ee0aa; text-transform: uppercase; letter-spacing: .13em; font-size: .74rem; font-weight: 800; font-style: normal; }
    .project-card h2 { font-size: clamp(2rem, 5vw, 4rem); letter-spacing: -.055em; margin: 0 0 .75rem; }
    .one-line { font-size: clamp(1.05rem, 2vw, 1.25rem); color: #e5f4ea; line-height: 1.5; max-width: 850px; }
    .io-strip { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; margin: 1rem 0; }
    .io-strip div, .boundary-box { border: 1px solid rgba(31,160,104,.22); border-radius: 18px; background: rgba(0,0,0,.18); padding: 1rem; }
    .io-strip strong { display: block; color: #fff; margin-top: .35rem; }
    .boundary-box p { color: #dceee3; line-height: 1.55; margin: .45rem 0 0; }
    .project-actions { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.15rem; }
    .project-actions a { border: 1px solid rgba(126,224,170,.3); color: #dff6e9; border-radius: 999px; padding: .72rem 1rem; font-weight: 800; text-decoration: none; }
    .project-actions .primary-action { background: #7ee0aa; color: #041009; border-color: #7ee0aa; }
    .packaging-console { position: relative; overflow: hidden; border: 1px solid rgba(94,188,255,.18); border-radius: 28px; padding: 0 1.25rem 1.25rem; background: radial-gradient(circle at 88% 0%, rgba(94,188,255,.13), transparent 30%), radial-gradient(circle at 12% 80%, rgba(31,160,104,.13), transparent 32%), linear-gradient(135deg, rgba(3,18,34,.92), rgba(1,8,7,.98)); box-shadow: 0 28px 90px rgba(0,0,0,.32); margin: 1rem 0; }
    .packaging-console::before { content: ''; position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(rgba(94,188,255,.07) 1px, transparent 1px), linear-gradient(90deg, rgba(94,188,255,.07) 1px, transparent 1px); background-size: 42px 42px; opacity: .55; }
    .packaging-path, .packaging-head, .packaging-lanes { position: relative; z-index: 1; }
    .packaging-path { height: 38px; display: flex; justify-content: flex-end; align-items: center; gap: .6rem; color: rgba(222,248,229,.58); font-family: var(--mono); font-size: .68rem; }
    .packaging-head h2 { max-width: 880px; font-size: clamp(2rem, 5vw, 4.6rem); line-height: .92; letter-spacing: -.065em; margin: 0 0 .85rem; }
    .packaging-head p:not(.eyebrow) { max-width: 850px; color: #dceee3; font-size: clamp(1rem, 1.8vw, 1.18rem); line-height: 1.55; font-weight: 650; }
    .packaging-lanes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .8rem; margin-top: 1rem; }
    .packaging-lanes article { min-height: 190px; border: 1px solid rgba(126,224,170,.22); border-radius: 18px; background: rgba(255,255,255,.035); padding: 1rem; }
    .packaging-lanes span { color: #86ccff; font-family: var(--mono); text-transform: uppercase; letter-spacing: .12em; font-size: .72rem; font-weight: 800; }
    .packaging-lanes h3 { color: #fff; margin: .75rem 0 .5rem; font-size: 1.35rem; }
    .packaging-lanes p { color: #dceee3; line-height: 1.55; margin: 0; }
    .done-panel { display: grid; grid-template-columns: minmax(0, 1fr) 420px; gap: 1rem; border: 1px solid rgba(31,160,104,.35); border-radius: 26px; padding: 2rem; background: rgba(3,13,8,.74); margin-top: 1rem; }
    .safety-panel { border-color: rgba(126,224,170,.25); background: rgba(2,8,5,.82); }
    .done-panel h2 { font-size: clamp(1.8rem, 4vw, 3rem); margin: 0 0 .75rem; letter-spacing: -.045em; }
    .done-panel p, .done-panel li { color: #dceee3; line-height: 1.6; }
    .done-panel ul { margin: 0; padding-left: 1.2rem; }
    @media (max-width: 900px) { .io-strip, .done-panel, .packaging-lanes { grid-template-columns: 1fr; } .project-topline { align-items: flex-start; flex-direction: column; } }
  </style>
</BaseLayout>
