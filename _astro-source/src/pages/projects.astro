---
import BaseLayout from '../layouts/BaseLayout.astro';

const proofCatalog = await import('../../public/dashboard-data/public-proof-catalog.json');
const verifiedDate = new Date(proofCatalog.default.generated_at).toISOString().slice(0, 10);
const catalogProjectCount = proofCatalog.default.projects.length;
const catalogSourceCount = proofCatalog.default.projects.reduce((sum, project) => sum + (project.sources?.length ?? 0), 0);
const catalogLimitCount = proofCatalog.default.projects.reduce((sum, project) => sum + (project.limits?.length ?? 0), 0);

const projects = [
  {
    name: 'Wallet Risk Assessment',
    description: 'A small evidence view for reading blockchain wallet-risk rows without turning every score into a verdict.',
    role: 'Wallets / Risk / Notes',
    url: '/wallet-risk',
    proof: 'The current map has 28 detection abilities and 23 direct functions. The interesting part is how the row, rule, score, and plain note sit together.',
    limitation: 'Research and learning page. Not legal advice, filing software, or a licensed compliance product.',
    links: [
      { label: 'Open wallet risk', url: '/wallet-risk' },
      { label: 'Field note', url: '/blog/wallet-risk-notes' },
      { label: 'Engine notes', url: '/blog/aml-engine' },
      { label: 'GitHub', url: 'https://github.com/hash02/aml-detection-engine' },
      { label: 'AML', url: '/learn#aml' },
      { label: 'False positives', url: '/learn#false-positive' },
    ],
  },
  {
    name: 'AML Status Evidence',
    description: 'A public-safe AML status evidence page for the AML Layer 1 evidence contract, artifact provenance, planner gate, and authority boundaries.',
    role: 'AML / Evidence / Boundary',
    url: '/aml-status-evidence',
    proof: 'Shows the contract path, local artifact pattern, evidence record docs, and the hard boundary that may_execute remains false.',
    limitation: 'Evidence surface only. No wallet, trade, filing, deploy, or KYC approval authority.',
    links: [
      { label: 'Open AML status evidence', url: '/aml-status-evidence' },
      { label: 'Evidence JSON', url: '/dashboard-data/aml-status-evidence-public.json' },
      { label: 'Wallet risk', url: '/wallet-risk' },
      { label: 'AML', url: '/learn#aml' },
    ],
  },
  {
    name: 'Agent Chess',
    description: 'A two-agent operating pattern where independent agents take turns, review each other, preserve board state, and hold external actions behind approval.',
    role: 'Agents / Memory / Turns',
    url: '/blog/two-agent-finance-operating-system',
    proof: 'The board now has a board-of-boards layer, 4 public roles, and a website-care lane so a restart can recover the next move.',
    limitation: 'Personal operating system. The public page shows tempo and broad roles only. No autonomous public publishing or external actions.',
    links: [
      { label: 'Story', url: '/blog/two-agent-finance-operating-system' },
      { label: 'Evidence records', url: '/dashboard-data/public-proof-catalog.json' },
      { label: 'AI agent', url: '/learn#agent' },
      { label: 'Audit log', url: '/learn#audit-log' },
    ],
  },
  {
    name: 'Agent Workflow System',
    description: 'A local evidence stack for asking a simple question: what should an AI-agent run leave behind so another person can inspect it later?',
    role: 'Agent Tools / Traces / Permissions',
    url: 'https://github.com/hash02/agent-framework-proof',
    proof: 'The stack covers tool-calling, graph workflows, retrieval notes, permission checks, trace rows, and observability output, with 70 local checks around the pieces.',
    limitation: 'Local evidence stack, not a production hosted agent or credentialed integration.',
    links: [
      { label: 'GitHub Repo', url: 'https://github.com/hash02/agent-framework-proof' },
      { label: 'LangChain', url: '/learn#langchain' },
      { label: 'LangGraph', url: '/learn#langgraph' },
      { label: 'RAG', url: '/learn#rag' },
      { label: 'RBAC', url: '/learn#rbac' },
    ],
  },
  {
    name: 'Agent Monitoring Heartbeat',
    description: 'A visible status snapshot showing an agent loop can wake up, write state, score prior predictions, and expose recent health.',
    role: 'Signals / Health / Loop',
    url: '/dashboard-data/heartbeat.json',
    proof: 'Latest snapshot shows alive and healthy status, 2,514 predictions made, and 53 percent accuracy over the last 100 BTC direction checks.',
    limitation: 'Research and observability only. Not investment advice, live trading performance, or infrastructure disclosure.',
    links: [
      { label: 'Heartbeat JSON', url: '/dashboard-data/heartbeat.json' },
      { label: 'Evidence records', url: '/dashboard-data/public-proof-catalog.json' },
      { label: 'Heartbeat', url: '/learn#heartbeat' },
      { label: 'Observability', url: '/learn#observability' },
    ],
  },
  {
    name: 'Hermes Kite',
    description: 'Kite testnet and decentralized-infrastructure work framed as a bounded engineering record: paper portfolio state, public testnet markers, and agent-run discipline.',
    role: 'Testnet / Decentralized Infra / Agents',
    url: 'https://github.com/hash02/hermes-kite',
    proof: 'The public repository presents a Kite AI Global Hackathon 2026 submission with paper-mode portfolio state, one-shot workers, and Kite testnet settlement markers.',
    limitation: 'Public testnet and paper-mode engineering record only. No real-fund execution, no wallet authority, no order authority, and no production capital management claim.',
    links: [
      { label: 'GitHub Repo', url: 'https://github.com/hash02/hermes-kite' },
      { label: 'Portfolio monitor', url: '/portfolio' },
      { label: 'Docker', url: '/learn#docker' },
      { label: 'Kubernetes', url: '/learn#kubernetes' },
    ],
  },
  {
    name: 'Hardware Compute Environment',
    description: 'A bounded local-compute and agent-infrastructure environment for learning how small AI systems behave when they have to run, recover, and leave inspectable state.',
    role: 'Compute / Agents / Observability',
    url: '/blog/agent-graveyard',
    proof: 'The public field note documents a modest always-on server, a second security-testing machine, local model usage, one-job agents, queueing, recovery, and observability lessons.',
    limitation: 'Public architecture summary only. No private topology, addresses, credentials, wallet control, external action authority, or production-service guarantee.',
    links: [
      { label: 'Field note', url: '/blog/agent-graveyard' },
      { label: 'Agent workflow system', url: 'https://github.com/hash02/agent-framework-proof' },
      { label: 'Observability', url: '/learn#observability' },
      { label: 'RBAC', url: '/learn#rbac' },
    ],
  },
  {
    name: 'Agent Rules Starter Kit',
    description: 'A small starter kit for writing down how an agent is allowed to use tools, leave traces, and wait for a human before the serious moves.',
    role: 'Agent Rules / Review / Tools',
    url: '/dashboard-data/public-proof-catalog.json',
    proof: 'The package has seven small files: a manifest, queue notes, trace examples, tool boundaries, and approval gates.',
    limitation: 'Template kit. Not legal advice, certification, or enterprise governance software.',
    links: [
      { label: 'Evidence records', url: '/dashboard-data/public-proof-catalog.json' },
      { label: 'Tool calling', url: '/learn#tool-calling' },
      { label: 'RBAC', url: '/learn#rbac' },
      { label: 'Audit log', url: '/learn#audit-log' },
    ],
  },
  {
    name: 'Wallet Risk Check',
    description: 'Lightweight EVM wallet triage helper that converts wallet signals into RED / YELLOW / GREEN risk ratings.',
    role: 'Wallets / Risk / Triage',
    url: 'https://github.com/hash02/wallet-risk-check',
    proof: 'Supports Ethereum, Polygon, Base, Arbitrum, Optimism, and 50+ EVM chains through Blockscout according to the README.',
    limitation: 'Quick triage helper, not a replacement for full blockchain intelligence platforms.',
    links: [
      { label: 'GitHub Repo', url: 'https://github.com/hash02/wallet-risk-check' },
      { label: 'EVM', url: '/learn#evm' },
      { label: 'AML', url: '/learn#aml' },
    ],
  },
  {
    name: 'Bionic Banker',
    description: 'The public writing and evidence page for AI, finance, blockchain, risk-system design, and builder systems.',
    role: 'Articles / Signals / Systems',
    url: 'https://bionicbanker.tech',
    proof: 'Live site with 38 source articles, signal snapshots, evidence records, and linked pages that keep growing with the work.',
    limitation: 'This page exists because the work used to be scattered across GitHub, articles, and notes.',
    links: [
      { label: 'Articles', url: '/articles' },
      { label: 'Evidence records', url: '/dashboard-data/public-proof-catalog.json' },
      { label: 'Knowledge Base', url: '/learn' },
      { label: 'Field notes', url: '/reports' },
      { label: 'Questions', url: '/gaps' },
    ],
  },
];
---
<BaseLayout title="Systems" description="AI, finance, wallet-risk, and agent-system systems by Himanshu. What runs, what it shows, and where the limits are.">
  <div class="page-header">
    <div class="page-label">Systems</div>
    <h1 class="page-title">Systems</h1>
    <p class="page-sub">Small machines, strange questions, and finance systems made visible. Each card shows what it is, what it watches, and where the boundary is.</p>
    <div class="page-metric-row" aria-label="Systems evidence snapshot">
      <div><strong>{projects.length}</strong><span>public cards</span></div>
      <div><strong>{catalogProjectCount}</strong><span>catalog lanes</span></div>
      <div><strong>{catalogSourceCount}</strong><span>source rows</span></div>
      <div><strong>{catalogLimitCount}</strong><span>named limits</span></div>
    </div>
  </div>

  <div class="articles-wrap systems-wrap">
    <div class="lab-strip">
      <div>
        <h2>Things that run, write, watch, or explain</h2>
        <p>This is the systems index: wallet-risk stories, agent loops, wallet checks, risk signals, and notes from the edge of finance and AI.</p>
      </div>
      <div class="lab-strip-links">
        <span>Wallet risk</span>
        <span>Agents</span>
        <span>Observability</span>
        <a href="https://github.com/hash02" target="_blank" rel="noopener">GitHub</a>
        <a href="/reports">Field Notes</a>
      </div>
    </div>
    <p class="verified-note">Notebook snapshot: {verifiedDate}. Counts above are computed from this page and the public proof catalog.</p>

    <section class="systems-audit-panel" aria-label="How this systems page should be judged">
      <div>
        <span class="systems-audit-label">Quality rule</span>
        <strong>Every card has to earn its surface area.</strong>
      </div>
      <p>What runs, what evidence is visible, what boundary is explicit, and where a reader can inspect the source. Anything weaker stays in notes until it has proof.</p>
    </section>

    <div class="article-card systems-guide-card" style="margin-bottom: 1.25rem;">
      <div class="article-tags">
        <span class="tag-pill tag-green">How to read it</span>
      </div>
      <h3>How to read this page</h3>
      <p>Start with curiosity. Open the experiment, look at the numbers, read the limit, then follow the next question. The point is not to make the work sound bigger. The point is to make it easier to inspect.</p>
        <p><strong>Evidence rule:</strong> if a line cannot point to a source, a number, a screenshot, a test, or a clear boundary, it does not belong here yet.</p>
      <div class="card-footer">
        <a href="/reports" class="read-more">Open field notes -></a>
        <a href="/gaps" class="read-more">See questions -></a>
        <a href="/learn" class="read-more">Learn the concepts -></a>
        <a href="/dashboard-data/public-proof-catalog.json" class="read-more">Open evidence records -></a>
      </div>
    </div>

    <div class="articles-grid stagger-children">
      {projects.map((project) => (
        <article class="article-card animate-on-scroll">
          <div class="article-tags">
            <span class="tag-pill tag-green">{project.role}</span>
          </div>
          <h3>{project.name}</h3>
          <p class="system-desc">{project.description}</p>
          <div class="system-proof-grid">
            <div>
              <span>What to notice</span>
              <p>{project.proof}</p>
            </div>
            <div>
              <span>Boundary</span>
              <p>{project.limitation}</p>
            </div>
          </div>
          {project.links && (
            <div class="system-link-cloud" aria-label={`Inspection links for ${project.name}`}>
              {project.links.map((link) => (
                <a href={link.url} target={link.url.startsWith('http') ? '_blank' : undefined} rel={link.url.startsWith('http') ? 'noopener' : undefined}>{link.label}</a>
              ))}
            </div>
          )}
          <div class="card-footer">
            <a href={project.url} class="read-more" target={project.url.startsWith('http') ? '_blank' : undefined} rel={project.url.startsWith('http') ? 'noopener' : undefined}>Open route -></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
