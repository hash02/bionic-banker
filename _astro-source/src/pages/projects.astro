---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    name: 'AML Detection Engine',
    description: 'Blockchain AML detection system that maps on-chain behavior to financial-crime typologies and reviewer-friendly risk outputs.',
    role: 'Crypto AML, RegTech, financial crime technology, compliance automation',
    url: 'https://github.com/hash02/aml-detection-engine',
    proof: '28 mapped detection abilities, 23 direct detection functions, benchmarked at 94.9 percent detection on a labeled transaction dataset.',
    limitation: 'Research and portfolio system, not a licensed compliance product or production exchange deployment.',
  },
  {
    name: 'Two-Agent Finance Operating System',
    description: 'A proof-backed operating layer where two agents critique each other, preserve decisions, and keep human approval gates around external actions.',
    role: 'AI agent builder, AI operations, compliance workflow automation, AI governance',
    url: '/blog/two-agent-finance-operating-system',
    proof: 'Produced real career artifacts: cleaned GitHub profile, corrected AML README, crypto AML resume variant, job-specific application packets, and this projects page.',
    limitation: 'Personal-scale production system, not enterprise compliance deployment.',
  },
  {
    name: 'Hermes Kite',
    description: 'Kite testnet and DeFi infrastructure proof showing agent-oriented crypto engineering and experiment discipline.',
    role: 'DeFi engineering, testnet systems, AI finance infrastructure, hackathon proof',
    url: 'https://github.com/hash02/hermes-kite',
    proof: 'Public GitHub repository exists and should be framed as testnet and hackathon infrastructure proof only.',
    limitation: 'Not live-money trading proof. Do not imply production capital management.',
  },
  {
    name: 'AML Roaster',
    description: 'Automated Ethereum transaction monitor that flags suspicious patterns and generates SAR-style investigative reports.',
    role: 'AML automation, financial crime analysis, compliance reporting',
    url: 'https://github.com/hash02/aml-roaster',
    proof: 'README describes a 30-minute GitHub Actions schedule, mixer and high-risk address monitoring, report archives, and SAR-style narrative output.',
    limitation: 'Investigator-support tool, not legal SAR filing software.',
  },
  {
    name: 'Wallet Risk Check',
    description: 'Lightweight EVM wallet triage helper that converts wallet signals into RED / YELLOW / GREEN risk ratings.',
    role: 'Wallet screening, crypto risk, fraud and AML triage',
    url: 'https://github.com/hash02/wallet-risk-check',
    proof: 'Supports Ethereum, Polygon, Base, Arbitrum, Optimism, and 50+ EVM chains through Blockscout according to the public README.',
    limitation: 'Quick triage helper, not a replacement for full blockchain intelligence platforms.',
  },
  {
    name: 'Bionic Banker',
    description: 'Public writing and proof surface for AI, finance, blockchain, compliance-system design, and builder experiments.',
    role: 'AI finance communication, developer advocacy, fintech education, technical storytelling',
    url: 'https://bionicbanker.tech',
    proof: 'Live public site with 37 source articles and a GitHub-backed publishing workflow.',
    limitation: 'This page exists because the proof was previously scattered across GitHub, articles, and local packets.',
  },
];
---
<BaseLayout title="Projects" description="Proof-backed AI, finance, AML, and agent-system work by Himanshu. Public evidence, role signal, and honest limitations in one place.">
  <div class="page-header">
    <div class="page-label">Proof</div>
    <h1 class="page-title">Projects</h1>
    <p class="page-sub">Proof-backed AI, finance, AML, and agent-system work. Each project links to public evidence and states the limitation clearly.</p>
  </div>

  <div class="articles-wrap">
    <div class="articles-grid stagger-children">
      {projects.map((project) => (
        <a href={project.url} class="article-card animate-on-scroll" target={project.url.startsWith('http') ? '_blank' : undefined} rel={project.url.startsWith('http') ? 'noopener' : undefined}>
          <div class="article-tags">
            <span class="tag-pill tag-green">{project.role}</span>
          </div>
          <h3>{project.name}</h3>
          <p>{project.description}</p>
          <p><strong>Proof:</strong> {project.proof}</p>
          <p><strong>Limit:</strong> {project.limitation}</p>
          <div class="card-footer">
            <span class="read-more">Open proof -></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
