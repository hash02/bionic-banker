.newsletter-section h2 { font-family: 'Bricolage Grotesque', serif; font-size: 2rem; margin-bottom: 0.5rem; }
.newsletter-section p { color: var(--fg-dim); margin-bottom: 1.5rem; }
.newsletter-form { display: flex; gap: 0.5rem; max-width: 500px; margin: 0 auto; }
.newsletter-input {
