<script>
// ---------- LIVE DATA LOADER ----------
const DATA_URL = '/dashboard-data/funds/portfolio_summary.json';
const FUND_LABELS = {
  fund_60_40_income: { title: '60/40 Income', sub: 'Conservative. Yield-first.' },
  fund_75_25_balanced: { title: '75/25 Balanced', sub: 'Balanced. Mixed risk.' },
  fund_90_10_growth: { title: '90/10 Growth', sub: 'Aggressive. Momentum + sniper.' },
};
const fmt$ = (n) => {
  if (n === null || n === undefined) return '-';
  const a = Math.abs(n);
  const s = n < 0 ? '-' : '';
  if (a >= 1000) return s + '$' + Math.round(a).toLocaleString();
  return s + '$' + a.toFixed(2);
};
const fmtPnl = (n) => {
  if (n === null || n === undefined) return '-';
  const sign = n >= 0 ? '+' : '';
  return sign + '$' + n.toFixed(2);
};
const ageFmt = (m) => {
  if (m === null || m === undefined) return '-';
  if (m < 60) return Math.round(m) + 'm';
  return (m / 60).toFixed(1) + 'h';
};

function renderAggregate(d) {
  const a = d.aggregate || {};
  document.getElementById('agg-coverage').textContent = (a.coverage_pct || 0).toFixed(1) + '%';
  document.getElementById('agg-exposure').textContent = fmt$(a.exposure_usd);
  const pnlEl = document.getElementById('agg-pnl');
  pnlEl.textContent = fmtPnl(a.pnl_usd);
  pnlEl.classList.toggle('accent', (a.pnl_usd || 0) > 0);
  document.getElementById('agg-funds').textContent =
    (a.funds_count || 0) + ' / ' + (a.sleeves_funded || 0) + '-' + (a.sleeves_total || 0);
  const workers = d.workers || {};
  const live = Object.values(workers).filter(w => w.heartbeat_fresh).length;
  document.getElementById('agg-workers').textContent = live + ' / ' + Object.keys(workers).length;

  const gen = new Date(d.generated_iso);
  const ageMin = Math.round((Date.now() - gen.getTime()) / 60000);
  document.getElementById('sync-ts').textContent =
    'synced ' + (ageMin <= 1 ? 'just now' : ageMin + 'm ago');
}

function renderFunds(d) {
  const host = document.getElementById('fund-grid');
  host.innerHTML = '';
  const funds = d.funds || {};
  Object.keys(FUND_LABELS).forEach(key => {
    const f = funds[key];
    if (!f) return;
    const label = FUND_LABELS[key];
    const sleevesHtml = Object.entries(f.sleeves || {}).map(([name, s]) =>
      `<div class="sleeve-row">
        <span><span class="sleeve-dot ${s.funded ? 'funded' : ''}"></span><span class="sleeve-name">${name}</span></span>
        <span class="sleeve-pos">${s.positions_total || 0} pos / ${fmt$(s.open_exposure_usd)}</span>
      </div>`
    ).join('');
    const pnlClass = (f.pnl_usd || 0) > 0 ? 'pos' : (f.pnl_usd || 0) < 0 ? 'neg' : '';
    host.insertAdjacentHTML('beforeend', `
      <div class="fund-card">
        <div>
          <h3>${label.title}</h3>
          <div class="fund-sub">${label.sub}</div>
        </div>
        <div>
          <div class="coverage-bar"><div class="coverage-fill" style="width:${f.coverage_pct}%"></div></div>
          <div class="coverage-label">
            <span>Coverage</span>
            <strong>${f.sleeves_funded}/${f.sleeves_total} / ${f.coverage_pct.toFixed(1)}%</strong>
          </div>
        </div>
        <div class="fund-stats">
          <div>
            <div class="fund-stat-label">Exposure</div>
            <div class="fund-stat-val">${fmt$(f.exposure_usd)}</div>
          </div>
          <div>
            <div class="fund-stat-label">Unrealized PnL</div>
            <div class="fund-stat-val ${pnlClass}">${fmtPnl(f.pnl_usd)}</div>
          </div>
        </div>
        <div class="sleeve-list">${sleevesHtml}</div>
      </div>
    `);
  });
}

function renderWorkers(d) {
  const host = document.getElementById('worker-table');
  // clear all rows except head
  Array.from(host.querySelectorAll('.worker-row:not(.head), .loader')).forEach(el => el.remove());
  const workers = d.workers || {};
  Object.entries(workers).forEach(([name, w]) => {
    const fresh = w.heartbeat_fresh;
    const strategy = (w.strategy || '-').replace(/_/g, ' ');
    const deployed = (w.deployed_usd !== null && w.deployed_usd !== undefined) ? fmt$(w.deployed_usd) : '-';
    host.insertAdjacentHTML('beforeend', `
      <div class="worker-row">
        <div class="worker-name">${name}</div>
        <div class="worker-meta">${strategy}</div>
        <div class="worker-col-hide-mobile"><span class="badge ${fresh ? 'ok' : 'stale'}">${fresh ? 'live' : (w.status || 'stale')}</span></div>
        <div class="worker-col-hide-mobile worker-meta">#${w.cycle_count || 0}</div>
        <div class="worker-col-hide-mobile worker-meta">${ageFmt(w.age_minutes)}</div>
        <div class="worker-col-hide-mobile worker-meta">${w.open_positions || 0} / ${deployed}</div>
      </div>
    `);
  });
}


function renderHermes(d) {
  const h = d.hermes || {};
  const html = `
    <div class="kv-row"><span class="kv-key">Mode</span><span class="kv-val">${h.mode || 'paper'}</span></div>
    <div class="kv-row"><span class="kv-key">Paper portfolio age</span><span class="kv-val">${ageFmt(h.paper_portfolio_age_min)}</span></div>
    <div class="kv-row"><span class="kv-key">Status age</span><span class="kv-val">${ageFmt(h.orchestrator_age_min)}</span></div>
    <div class="kv-row"><span class="kv-key">Total positions</span><span class="kv-val">${h.paper_portfolio_positions || 0}</span></div>
    <div class="kv-row"><span class="kv-key">Currently open</span><span class="kv-val">${h.paper_portfolio_open || 0}</span></div>
  `;
  document.getElementById('hermes-panel').innerHTML = html;
}

async function load() {
  try {
    const r = await fetch(DATA_URL, { cache: 'no-store' });
    if (!r.ok) throw new Error('fetch failed ' + r.status);
    const d = await r.json();
    renderAggregate(d);
    renderFunds(d);
    renderWorkers(d);
    renderHermes(d);
  } catch (e) {
    document.getElementById('sync-ts').textContent = 'sync error. retry soon';
    console.error(e);
  }
}
load();
setInterval(load, 60000);
</script>

</body>
</html>
