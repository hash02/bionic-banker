  border: 1px solid var(--border); border-radius: 6px; font-size: 0.85rem;
}
.nl-btn.secondary:hover { color: var(--accent); border-color: var(--accent); }

/* FOOTER */
.site-footer {
  margin-top: 4rem; padding: 3rem 2rem 2rem; border-top: 1px solid var(--border);
  background: var(--bg-2);
}
.footer-wrap { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
.footer-logo { font-family: 'Bricolage Grotesque', serif; font-weight: 800; font-size: 1.2rem; color: var(--fg); }
.footer-logo span { color: var(--accent); }
.footer-tagline { color: var(--fg-dim); font-size: 0.9rem; margin-top: 0.5rem; }
.footer-col h4 { color: var(--fg); font-size: 0.9rem; margin-bottom: 0.5rem; }
.footer-col a { display: block; color: var(--fg-dim); font-size: 0.85rem; padding: 0.25rem 0; }
.footer-col a:hover { color: var(--accent); }
.footer-bottom { max-width: 1100px; margin: 2rem auto 0; padding-top: 1.5rem; border-top: 1px solid var(--border); color: var(--fg-dim); font-size: 0.8rem; }

.loader { color: var(--fg-dim); font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; padding: 2rem 0; text-align: center; }
</style>
