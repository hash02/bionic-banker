}
.explainer p { color: var(--fg-dim); margin-bottom: 1rem; }
.explainer p:last-child { margin-bottom: 0; }
.explainer strong { color: var(--fg); }

/* NEWSLETTER */
.newsletter-section {
  max-width: 900px; margin: 4rem auto 0; padding: 3rem 2rem;
  background: var(--bg-2); border: 1px solid var(--border); border-radius: 16px;
  text-align: center;
