<style>
/* ============================================================
   LOCKED PALETTE - GREEN / BLACK / WHITE ONLY
   #1fa068 green  |  #020204 black  |  #e4e4ec white  |  #8a8aa0 grey
   NO blue. NO purple. NO red. NO gradients.
   ============================================================ */
:root {
  --bg: #020204;
  --bg-2: #0a0a0f;
  --bg-3: #13131a;
  --fg: #e4e4ec;
  --fg-dim: #8a8aa0;
  --accent: #1fa068;
  --accent-dim: #17774f;
  --border: #1f1f28;
  --ok: #1fa068;
  --warn: #8a8aa0;
  --stale: #3d3d4a;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html, body {
  background: var(--bg);
  color: var(--fg);
  font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
  font-size: 16px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
a { color: var(--accent); text-decoration: none; }
a:hover { color: #2ac682; }
code, .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }

/* NAV */
nav {
  position: sticky; top: 0; z-index: 100;
  background: rgba(2,2,4,0.92);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--border);
  padding: 1rem 2rem;
  display: flex; align-items: center; justify-content: space-between;
}
.nav-logo {
  font-family: 'Bricolage Grotesque', serif;
  font-weight: 800; font-size: 1.3rem; color: var(--fg);
  min-height: 44px; display: inline-flex; align-items: center;
}
.nav-logo span { color: var(--accent); }
.nav-right { display: flex; align-items: center; gap: 1.5rem; }
.nav-links { list-style: none; display: flex; gap: 1.5rem; }
.nav-links a { color: var(--fg); font-weight: 500; font-size: 0.95rem; min-width: 44px; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; }
.nav-links a:hover { color: var(--accent); }
.nav-cta {
  background: var(--accent); color: #02120a !important;
  min-height: 44px; display: inline-flex; align-items: center; padding: 0.5rem 1rem; border-radius: 6px; font-weight: 600; font-size: 0.9rem;
}
.nav-cta:hover { background: #2ac682; }
#bb-hamburger { display: none; background: none; border: 0; color: var(--fg); font-size: 1.5rem; cursor: pointer; min-width: 44px; min-height: 44px; align-items: center; justify-content: center; }
@media (max-width: 768px) {
  nav { padding: 1rem; }
  .nav-links, .nav-cta { display: none; }
  #bb-hamburger { display: inline-flex; }
}

/* HERO */
.page-header {
  max-width: 1100px; margin: 0 auto; padding: 4rem 2rem 2rem;
  text-align: left;
}
.page-label {
  color: var(--accent); font-size: 0.85rem; font-weight: 600;
  text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.75rem;
}
h1.page-title {
  font-family: 'Bricolage Grotesque', serif; font-weight: 800;
  font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.1; margin-bottom: 1rem;
}
.page-sub { color: var(--fg-dim); font-size: 1.05rem; max-width: 720px; }
.page-sub a { min-height: 44px; display: inline-flex; align-items: center; }

/* AGGREGATE BANNER */
.agg-banner {
  max-width: 1100px; margin: 2rem auto 0; padding: 0 2rem;
}
.agg-card {
  background: var(--bg-2); border: 1px solid var(--border); border-radius: 12px;
  padding: 1.5rem; display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1rem;
}
@media (max-width: 768px) { .agg-card { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
.agg-stat { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
.agg-num {
  font-family: 'JetBrains Mono', monospace; font-size: clamp(1.1rem, 5vw, 1.6rem); font-weight: 700;
  color: var(--fg); white-space: nowrap;
}
.agg-num.accent { color: var(--accent); }
.agg-label {
  font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em;
  color: var(--fg-dim);
}

.sync-pill {
  display: inline-flex; align-items: center; gap: 0.4rem;
  background: rgba(31,160,104,0.12); color: var(--accent);
  padding: 0.25rem 0.6rem; border-radius: 999px; font-size: 0.75rem;
  font-family: 'JetBrains Mono', monospace;
  border: 1px solid rgba(31,160,104,0.3);
}
.sync-dot {
  width: 6px; height: 6px; border-radius: 50%; background: var(--accent);
  animation: pulse 2s ease-in-out infinite;
}
@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

/* SECTIONS */
.section {
  max-width: 1100px; margin: 3rem auto 0; padding: 0 2rem;
}
.section-label {
  font-size: 0.8rem; font-weight: 600; text-transform: uppercase;
  letter-spacing: 0.12em; color: var(--accent); margin-bottom: 1rem;
}
.section h2 {
  font-family: 'Bricolage Grotesque', serif; font-size: 1.8rem;
  margin-bottom: 1.5rem;
}

/* FUND CARDS */
.fund-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem;
}
@media (max-width: 900px) { .fund-grid { grid-template-columns: 1fr; } }
.fund-card {
  background: var(--bg-2); border: 1px solid var(--border);
  border-radius: 12px; padding: 1.5rem;
  display: flex; flex-direction: column; gap: 1rem;
}
.fund-card h3 {
  font-family: 'Bricolage Grotesque', serif; font-size: 1.15rem;
  color: var(--fg);
}
.fund-card .fund-sub { color: var(--fg-dim); font-size: 0.85rem; }
.coverage-bar {
  position: relative; height: 8px; background: var(--bg-3);
  border-radius: 999px; overflow: hidden;
}
.coverage-fill {
  position: absolute; left: 0; top: 0; height: 100%;
  background: var(--accent); border-radius: 999px;
  transition: width 0.6s ease;
}
.coverage-label {
  display: flex; justify-content: space-between; font-size: 0.8rem;
  color: var(--fg-dim); margin-top: 0.4rem;
}
.coverage-label strong { color: var(--fg); font-family: 'JetBrains Mono', monospace; }
.fund-stats {
  display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem;
  padding-top: 0.8rem; border-top: 1px solid var(--border);
}
.fund-stat-label { font-size: 0.72rem; color: var(--fg-dim); text-transform: uppercase; letter-spacing: 0.06em; }
.fund-stat-val { font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 1rem; color: var(--fg); margin-top: 0.2rem; }
.fund-stat-val.pos { color: var(--accent); }
.fund-stat-val.neg { color: var(--fg-dim); }
.sleeve-list { font-size: 0.82rem; color: var(--fg-dim); margin-top: 0.25rem; line-height: 1.8; }
.sleeve-row { display: flex; justify-content: space-between; align-items: center; }
.sleeve-dot {
  display: inline-block; width: 8px; height: 8px; border-radius: 50%;
  margin-right: 0.5rem; background: var(--stale); vertical-align: middle;
}
.sleeve-dot.funded { background: var(--accent); }
.sleeve-name { color: var(--fg); font-family: 'JetBrains Mono', monospace; font-size: 0.78rem; }
.sleeve-pos { color: var(--fg-dim); font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; }

/* WORKER TABLE */
.worker-table {
  background: var(--bg-2); border: 1px solid var(--border); border-radius: 12px;
  overflow: hidden;
}
.worker-row {
  display: grid;
  grid-template-columns: 1.6fr 1fr 0.8fr 0.8fr 0.8fr 1.3fr;
  gap: 0.5rem; padding: 0.9rem 1.25rem; align-items: center;
  border-bottom: 1px solid var(--border); font-size: 0.9rem;
}
.worker-row:last-child { border-bottom: 0; }
.worker-row.head {
  background: var(--bg-3); color: var(--fg-dim); font-size: 0.72rem;
  text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600;
}
.worker-name { font-family: 'JetBrains Mono', monospace; font-weight: 600; color: var(--fg); }
.worker-meta { color: var(--fg-dim); font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; }
.badge {
  display: inline-flex; align-items: center; gap: 0.3rem;
  padding: 0.15rem 0.55rem; border-radius: 999px; font-size: 0.72rem;
  font-family: 'JetBrains Mono', monospace; font-weight: 600;
}
.badge.ok { background: rgba(31,160,104,0.15); color: var(--accent); border: 1px solid rgba(31,160,104,0.3); }
.badge.stale { background: rgba(138,138,160,0.1); color: var(--fg-dim); border: 1px solid var(--border); }
@media (max-width: 800px) {
  .worker-row { grid-template-columns: 1fr 1fr; row-gap: 0.3rem; }
  .worker-row.head { display: none; }
  .worker-col-hide-mobile { display: none; }
}

/* ORCHESTRATOR PANEL */
.panel-solo { max-width: 820px; }

/* PANELS */
.split-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;
}
@media (max-width: 800px) { .split-grid { grid-template-columns: 1fr; } }
.panel {
  background: var(--bg-2); border: 1px solid var(--border);
  border-radius: 12px; padding: 1.5rem;
}
.panel h3 { font-family: 'Bricolage Grotesque', serif; font-size: 1.05rem; margin-bottom: 0.8rem; }
.kv-row { display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px dashed var(--border); }
.kv-row:last-child { border-bottom: 0; }
.kv-key { color: var(--fg-dim); font-size: 0.85rem; }
.kv-val { font-family: 'JetBrains Mono', monospace; color: var(--fg); font-weight: 600; font-size: 0.9rem; }

/* EXPLAINER */
.explainer {
  background: var(--bg-2); border: 1px solid var(--border); border-radius: 12px;
