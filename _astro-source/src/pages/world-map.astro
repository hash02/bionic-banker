---
import BaseLayout from '../layouts/BaseLayout.astro';

const mapSystems = [
  {
    name: 'Wallet Risk Assessment',
    href: '/wallet-risk',
    signal: 'Risk judgment',
    detail: 'A wallet-risk row becomes a score, rationale, and plain-language note a person can inspect.',
  },
  {
    name: 'AML Status',
    href: '/aml-status-evidence',
    signal: 'Status records',
    detail: 'An AML-related status claim shows source trail, checks, visible claims, and clear limits.',
  },
  {
    name: 'Fraud Alert Triage Workflow',
    href: '/fraud-alert-triage',
    signal: 'Case review',
    detail: 'Synthetic fraud signals become a source list, rule explanation, case note, and human next step.',
  },
  {
    name: 'Agent Chess / Agent Workflow',
    href: '/risk-evidence-overview#agent-chess-showcase',
    signal: 'Agent operations',
    detail: 'Independent agents can prepare, review, and preserve state while outside actions stay with people.',
  },
  {
    name: 'Health Board',
    href: '/proof/site-health',
    signal: 'Self-checking site',
    detail: 'Public pages are checked with link, metric, JSON-framing, copy, and mobile gates.',
  },
];

const readingPaths = [
  {
    title: 'AI Finance Evaluator',
    bestFor: 'How to test financial reasoning, source use, and unsupported claims in AI output.',
    shows: ['finance answer review', 'unsupported-claim detection', 'plain-language explanation', 'source-backed reasoning'],
    links: ['/start-here', '/system-map', '/wallet-risk'],
  },
  {
    title: 'AML / RegTech / Fraud',
    bestFor: 'How AML, fraud, wallet-risk, and transaction-monitoring examples separate signal from decision.',
    shows: ['case-note structure', 'status records', 'human review steps', 'no filing or approval authority'],
    links: ['/aml-status-evidence', '/fraud-alert-triage', '/evidence'],
  },
  {
    title: 'FinTech Implementation',
    bestFor: 'How product, support, documentation, and workflow clarity make finance software easier to trust.',
    shows: ['workflow translation', 'client-readable documentation', 'dashboard discipline', 'clear escalation limits'],
    links: ['/apps', '/projects', '/proof/site-health'],
  },
  {
    title: 'AI Operations / Agent Systems',
    bestFor: 'How agent workflows can preserve state, review steps, and boundaries without hiding the work.',
    shows: ['review loops', 'tool boundaries', 'recoverable state', 'public-safe system records'],
    links: ['/risk-evidence-overview#agent-chess-showcase', '/agent-prototype-sprint', '/proof/site-health'],
  },
];

const limits = [
  'No live trading, transfer, wallet-control, or fund-movement claim.',
  'No SAR filing, KYC approval, enforcement, or final compliance decision.',
  'No employer data, customer data, private prompts, secrets, keys, tokens, or private infrastructure details.',
  'Public records only. Any real deployment needs separate governance, testing, data access, legal review, and ownership.',
];

const nextMoves = [
  'Compare one finance answer against the source trail, the claim, and the missing context.',
  'Read one AML or fraud example for the difference between a status record and a final decision.',
  'Follow one interface from input to record to limit so the system becomes understandable.',
  'Use the health board to see which checks keep the public map honest.',
];
---
<BaseLayout title="World Map" description="A compact map of AI, finance risk, source trails, system records, and human review limits.">
  <main class="opp-shell">
    <section class="opp-hero">
      <div class="opp-kicker">AI + Finance World Map</div>
      <h1>Regulated finance judgment, made visible through AI system records.</h1>
      <p>Hash combines financial-services work with public AI systems that show how wallet-risk, AML-style status, fraud triage, and agent operations can be reviewed without giving software final authority.</p>
      <div class="opp-actions">
        <a href="/start-here">Start with the mission map</a>
        <a href="/system-map">Read the system map</a>
        <a href="/evidence">Open source catalog</a>
      </div>
    </section>

    <section class="opp-section thesis-card">
      <span>Frame</span>
      <h2>The useful pattern: finance risk work becomes clearer when signals, records, and limits stay visible.</h2>
      <p>The site is strongest when it turns complex finance and AI material into structured records: what happened, what supports it, what is missing, and what a person still has to decide.</p>
    </section>

    <section class="opp-section">
      <span>What to read first</span>
      <h2>Five systems, one data story.</h2>
      <div class="system-grid">
        {mapSystems.map((item) => (
          <a class="system-card" href={item.href}>
            <small>{item.signal}</small>
            <h3>{item.name}</h3>
            <p>{item.detail}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="opp-section">
      <span>Reading paths</span>
      <h2>The same records can be read from four angles.</h2>
      <div class="packet-grid">
        {readingPaths.map((packet) => (
          <article class="packet-card">
            <h3>{packet.title}</h3>
            <p>{packet.bestFor}</p>
            <ul>
              {packet.shows.map((item) => <li>{item}</li>)}
            </ul>
            <div class="packet-links">
              {packet.links.map((href) => <a href={href}>Open record</a>)}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="opp-section split">
      <div>
        <span>Clear limits</span>
        <h2>The restraint is part of the value.</h2>
        <p>The public work is intentionally careful. It shows reasoning, records, checks, and boundaries without exposing private data or claiming regulated authority.</p>
      </div>
      <ul class="limit-list">
        {limits.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="opp-section">
      <span>How to use this map</span>
      <h2>Use this map to find the next useful question.</h2>
      <div class="move-grid">
        {nextMoves.map((item) => <article>{item}</article>)}
      </div>
      <div class="opp-footer-cta">
        <strong>Best next step:</strong>
        <a href="/system-map">Read the compressed system map</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .opp-shell { max-width: 1160px; margin: 0 auto; padding: 6rem 1.25rem 4rem; color: var(--text); }
  .opp-hero, .opp-section { border: 1px solid rgba(31,160,104,.16); background: rgba(3,16,8,.92); border-radius: 28px; padding: clamp(1.4rem, 3vw, 3rem); margin-bottom: 1.25rem; box-shadow: 0 24px 80px rgba(0,0,0,.28); }
  .opp-kicker, .opp-section > span, .system-card small { color: #1fa068; text-transform: uppercase; letter-spacing: .16em; font-size: .78rem; font-weight: 900; }
  .opp-hero h1 { font-size: clamp(2.2rem, 5.8vw, 5rem); line-height: .95; margin: .75rem 0 1rem; max-width: 980px; }
  .opp-hero p, .opp-section p, .opp-section li { color: #b0b0b8; line-height: 1.7; }
  .opp-actions, .packet-links, .opp-footer-cta { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.2rem; }
  .opp-actions a, .packet-links a, .opp-footer-cta a { text-decoration: none; border-radius: 999px; padding: .78rem 1rem; border: 1px solid rgba(31,160,104,.24); color: var(--text); font-weight: 800; }
  .opp-actions a:first-child { background: #1fa068; color: #010302; border: 0; }
  .system-grid, .packet-grid, .move-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-top: 1rem; }
  .system-card, .packet-card, .move-grid article { border: 1px solid rgba(31,160,104,.16); border-radius: 20px; padding: 1.1rem; background: rgba(31,160,104,.055); color: inherit; text-decoration: none; }
  .system-card h3, .packet-card h3 { margin: .55rem 0; }
  .packet-card ul, .limit-list { margin: 1rem 0 0; padding-left: 1.2rem; }
  .packet-links a { font-size: .86rem; padding: .62rem .78rem; }
  .split { display: grid; grid-template-columns: minmax(0,1fr) minmax(280px,.9fr); gap: 1.2rem; align-items: start; }
  .limit-list { border: 1px solid rgba(31,160,104,.16); border-radius: 20px; padding: 1.1rem 1.1rem 1.1rem 2rem; background: rgba(31,160,104,.055); }
  @media (max-width: 760px) { .split { grid-template-columns: 1fr; } .opp-shell { padding-top: 4.5rem; } }
</style>
