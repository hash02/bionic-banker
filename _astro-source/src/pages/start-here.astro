---
import BaseLayout from '../layouts/BaseLayout.astro';

const reviewerPath = [
  {
    step: '01',
    title: 'Wallet Risk Assessment',
    href: '/wallet-risk',
    proves: 'Risk judgment: a suspicious wallet row becomes a score, rule explanation, and reviewer note.',
    question: 'Can Hash reason about risk signals without turning a score into a verdict?',
  },
  {
    step: '02',
    title: 'AML Status Evidence',
    href: '/aml-status-evidence',
    proves: 'Auditability: a status claim includes artifact provenance, checks, and authority boundaries.',
    question: 'Can Hash preserve evidence and make compliance boundaries explicit?',
  },
  {
    step: '03',
    title: 'Fraud Alert Triage Workflow',
    href: '/fraud-alert-triage',
    proves: 'Operations design: synthetic alert signals become a review-ready field packet and case note.',
    question: 'Can Hash turn messy alerts into a human-review workflow?',
  },
  {
    step: '04',
    title: 'Agent Chess / Agent Workflow',
    href: '/risk-evidence-overview#agent-chess-showcase',
    proves: 'Human-gated agent operations: agents prepare artifacts, preserve state, and wait at approval gates.',
    question: 'Can Hash design AI-agent workflows where humans keep authority?',
  },
  {
    step: '05',
    title: 'Site Health / Health Board',
    href: '/proof/site-health',
    proves: 'Self-checking public map: metric, link, JSON-framing, and mobile gates protect the public site.',
    question: 'Can Hash build systems that check their own public claims?',
  },
];

const audienceCards = [
  ['Recruiter', 'Look for risk judgment, product sense, field packaging, and delivery discipline.', 'Start with Wallet Risk, then AML Status Evidence, then Health Board.'],
  ['Collaborator', 'Look for where a workflow could become a shared prototype or research path.', 'Start with Fraud Alert Triage, Agent Chess, and the field pack.'],
  ['Executive / investor', 'Look for category clarity, regulated-workflow restraint, and credible scope boundaries.', 'Start with the one-line thesis, market positioning, and boundaries.'],
  ['Technical explorer', 'Look for routes, source links, deterministic gates, public JSON, and what is intentionally not exposed.', 'Start with Systems, Evidence Catalog, and Site Health / Health Board.'],
];

const boundaries = [
  'No live trading, wallet movement, or fund transfer authority.',
  'No SAR filing, KYC approval, enforcement, or final compliance authority.',
  'No customer, employer, private wallet, private prompt, key, token, or internal infrastructure data.',
  'Portfolio grade public evidence, not a commercial deployment claim.',
];

const conversationFit = [
  'AI-assisted finance risk workflows',
  'AML, fraud, wallet-risk, and RegTech field packaging',
  'Human-gated agent operations and observability',
  'Product evidence surfaces for regulated or high-trust systems',
  'Founder/operator roles where evidence, shipping, and judgment matter',
];
---
<BaseLayout title="Start Here" description="A 90-second mission map for Bionic Banker: AI-assisted finance risk workflows, mapped like missions with humans in control.">
  <main class="guide-shell">
    <section class="guide-hero">
      <div class="guide-kicker">Start Quest / Mission Map</div>
      <h1>AI-assisted finance risk workflows, mapped like missions with humans in control.</h1>
      <p>Bionic Banker is a playable map of Hash's finance-risk and agent-systems work. Each stop has a task, evidence, and a boundary.</p>
      <div class="guide-actions">
        <a href="/proof-pack">Open Field Pack</a>
        <a href="/projects">Enter Systems</a>
        <a href="/proof/site-health">Check Health Board</a>
      </div>
    </section>

    <section class="guide-section">
      <div class="section-label">90-second quest</div>
      <h2>Clear these five stops in order.</h2>
      <div class="path-grid">
        {reviewerPath.map((item) => (
          <a class="path-card" href={item.href}>
            <span>{item.step}</span>
            <h3>{item.title}</h3>
            <p><strong>Mission question:</strong> {item.question}</p>
            <p>{item.proves}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="guide-section split">
      <div>
        <div class="section-label">What this unlocks</div>
        <h2>The loop is signal to evidence to review to artifact.</h2>
        <p>The strongest signal is not that an agent can write text. It is that a finance-risk workflow can keep the source trail visible, explain the reasoning, state the limit, and hand the decision to a person.</p>
      </div>
      <div class="evidence-list-card">
        <strong>Player stats</strong>
        <ul>
          <li>risk judgment</li>
          <li>evidence preservation</li>
          <li>audit-boundary thinking</li>
          <li>human-gated automation</li>
          <li>public QA discipline</li>
        </ul>
      </div>
    </section>

    <section class="guide-section">
      <div class="section-label">Choose your lens</div>
      <h2>Different readers can choose different routes.</h2>
      <div class="audience-grid">
        {audienceCards.map(([role, lookFor, path]) => (
          <article class="audience-card">
            <h3>{role}</h3>
            <p>{lookFor}</p>
            <small>{path}</small>
          </article>
        ))}
      </div>
    </section>

    <section class="guide-section split boundary-panel">
      <div>
        <div class="section-label">Trust boundary</div>
        <h2>What stays outside the game.</h2>
        <p>The site stays careful. It shows judgment and system design while keeping authority, private data, and regulated decisions out of scope.</p>
      </div>
      <ul>
        {boundaries.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="guide-section">
      <div class="section-label">Best-fit missions</div>
      <h2>Where this map is useful.</h2>
      <div class="fit-row">
        {conversationFit.map((item) => <span>{item}</span>)}
      </div>
      <div class="closing-cta">
        <strong>If you only send one link, send the mission map.</strong>
        <a href="/proof-pack">Then open the field pack</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .guide-shell { max-width: 1160px; margin: 0 auto; padding: 6rem 1.25rem 4rem; color: var(--text); }
  .guide-hero, .guide-section { border: 1px solid rgba(31,160,104,.16); background: rgba(3,16,8,.92); border-radius: 28px; padding: clamp(1.4rem, 3vw, 3rem); margin-bottom: 1.25rem; box-shadow: 0 24px 80px rgba(0,0,0,.28); }
  .guide-kicker, .section-label { color: #1fa068; text-transform: uppercase; letter-spacing: .16em; font-size: .78rem; font-weight: 800; }
  .guide-hero h1 { font-size: clamp(2.3rem, 6vw, 5rem); line-height: .95; margin: .7rem 0 1rem; max-width: 980px; }
  .guide-hero p, .guide-section p { color: #b0b0b8; font-size: 1.04rem; line-height: 1.7; }
  .guide-actions, .fit-row { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.2rem; }
  .guide-actions a, .closing-cta a { color: #010302; background: #1fa068; padding: .8rem 1rem; border-radius: 999px; font-weight: 800; text-decoration: none; }
  .guide-actions a:nth-child(2), .guide-actions a:nth-child(3), .closing-cta a { background: transparent; color: var(--text); border: 1px solid rgba(31,160,104,.24); }
  .path-grid, .audience-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-top: 1rem; }
  .path-card, .audience-card, .evidence-list-card { border: 1px solid rgba(31,160,104,.16); background: rgba(31,160,104,.055); border-radius: 20px; padding: 1.1rem; text-decoration: none; color: inherit; }
  .path-card span { color: #1fa068; font-weight: 900; }
  .path-card h3, .audience-card h3 { margin: .45rem 0; font-size: 1.15rem; }
  .path-card p, .audience-card p, .audience-card small { color: #b0b0b8; line-height: 1.6; }
  .split { display: grid; grid-template-columns: minmax(0,1.2fr) minmax(260px,.8fr); gap: 1.2rem; align-items: start; }
  .evidence-list-card ul, .boundary-panel ul { margin: .8rem 0 0; padding-left: 1.2rem; color: var(--text); line-height: 1.8; }
  .fit-row span { border: 1px solid rgba(31,160,104,.28); color: var(--text); border-radius: 999px; padding: .7rem .9rem; background: rgba(31,160,104,.08); }
  .closing-cta { margin-top: 1.5rem; display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }
  @media (max-width: 760px) { .split { grid-template-columns: 1fr; } .guide-shell { padding-top: 4.5rem; } }
</style>
