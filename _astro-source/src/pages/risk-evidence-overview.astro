---
import BaseLayout from '../layouts/BaseLayout.astro';

const labCatalog = await import('../../public/dashboard-data/public-proof-catalog.json');
const gapCatalog = await import('../../public/dashboard-data/market-gap-catalog.json');
const reportCatalog = await import('../../public/dashboard-data/engineering-report-catalog.json');
const agentChessStatus = await import('../../public/dashboard-data/agent-chess-status.json');

const projects = labCatalog.default.projects;
const questions = gapCatalog.default.modern_questions;
const reportMetrics = reportCatalog.default.summary_metrics;
const benchmarkMetrics = reportCatalog.default.benchmark_metrics;
const coverageBars = reportCatalog.default.coverage_bars;
const marketSources = gapCatalog.default.market_sources;
const agentChess = agentChessStatus.default;
const agentChessLanes = agentChess.lanes || [];
const agentChessFlow = agentChess.flow || [];
const agentChessRoles = agentChess.roles || agentChess.agents || [];
const agentChessPolicy = agentChess.no_private_data_policy || [];
const verifiedDate = new Date(labCatalog.default.generated_at).toISOString().slice(0, 10);

const getSources = (project) => project.sources || [];
const getNumbers = (project) => project.numbers || [];
const getLimits = (project) => project.limits || [];
const getStatus = (project) => project?.status || null;

const displayClaims = {
  'aml-engine-roaster': 'A wallet risk assessment where detection notes and plain-language assessment notes sit side by side.',
  'agent-chess': 'A turn-based way for two AI workers to leave notes, check each other, and keep a shared board readable.',
  'agent-heartbeat-lab': 'A small live loop that publishes enough state to show motion without exposing the machinery behind it.',
  'agent-framework-proof-v2': 'A local agent workflow lab with tools, roles, traces, retrieval notes, and observability lanes.',
};

const scenes = [
  {
    id: 'aml-engine-roaster',
    label: 'Wallet Risk',
    title: 'Wallet Risk Engine plus Assessment Notes',
    intent: 'A suspicious wallet pattern becomes easier to understand when the detection note and the plain-language explanation sit side by side.',
    project: projects.find((project) => project.id === 'aml-engine-roaster'),
    route: '/wallet-risk',
    next: 'How can someone move from transaction pattern to detection reason to plain-language explanation?',
  },
  {
    id: 'agent-chess',
    label: 'Agents',
    title: 'Agent Chess',
    intent: 'Two AI workers take turns, leave notes, and keep the board from losing traceability.',
    project: projects.find((project) => project.id === 'agent-chess'),
    route: '/blog/two-agent-finance-operating-system',
    next: 'How do independent AI workers coordinate without losing state, memory, or human approval boundaries?',
  },
  {
    id: 'agent-heartbeat-lab',
    label: 'Live Loop',
    title: 'Monitoring Heartbeat',
    intent: 'A running loop should show current status without pretending to be a trading oracle.',
    project: projects.find((project) => project.id === 'agent-heartbeat-lab'),
    route: '/dashboard-data/heartbeat.json',
    next: 'What should a public heartbeat reveal so a reader sees motion without needing backend details?',
  },
  {
    id: 'agent-framework-proof-v2',
    label: 'Workflow',
    title: 'Agent Workflow System',
    intent: 'Tools, roles, traces, retrieval, and observability make agent work easier to follow.',
    project: projects.find((project) => project.id === 'agent-framework-proof-v2'),
    route: 'https://github.com/hash02/agent-framework-proof',
    next: 'Which role, permission, trace, and evaluation signals make an AI workflow safer to inspect?',
  },
  {
    id: 'modern-questions',
    label: 'Questions',
    title: 'Modern Question Board',
    intent: 'Modern AI questions become less intimidating when the first answer is plain.',
    project: null,
    route: '/gaps',
    next: 'Move from question to concept to example without making the page feel like homework.',
  },
];

const firstScene = scenes[0];
const featuredQuestions = questions.slice(0, 4);
const inspectionRows = scenes
  .filter((scene) => scene.project)
  .map((scene) => {
    const project = scene.project;
    const sourceCount = getSources(project).length;
    const metricCount = getNumbers(project).length;
    const limitCount = getLimits(project).length;
    const readability = Math.min(100, sourceCount * 12 + metricCount * 8 + limitCount * 6);
    return {
      id: scene.id,
      label: scene.label,
      title: scene.title,
      sourceCount,
      metricCount,
      limitCount,
      readability,
    };
  });
---
<BaseLayout title="Risk & Evidence Overview" description="A guided tour through Bionic Banker systems, field notes, modern questions, and live signal pages.">
  <main class="tour-shell">
    <section class="tour-hero">
      <div>
        <h1>Risk & Evidence Overview</h1>
        <p>Start here if the site feels too big. Pick a lane, watch what is moving, read the limit, then follow the next question.</p>
      </div>
      <div class="tour-status">
        <span>Verified {verifiedDate}</span>
        <strong>{projects.length} systems</strong>
        <strong>{questions.length} questions</strong>
      </div>
    </section>

    <section class="tour-app" data-tour-app>
      <aside class="tour-rail" aria-label="Risk and evidence overview scenes">
        {scenes.map((scene, index) => (
          <button class={`tour-tab ${index === 0 ? 'active' : ''}`} type="button" data-scene-tab={scene.id}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{scene.label}</strong>
          </button>
        ))}
      </aside>

      <section class="tour-main">
        <div class="tour-map" aria-label="Bionic Banker evidence map">
          <svg viewBox="0 0 720 360" role="img">
            <line x1="140" y1="176" x2="310" y2="86" class="map-line" />
            <line x1="140" y1="176" x2="318" y2="254" class="map-line" />
            <line x1="318" y1="254" x2="510" y2="254" class="map-line" />
            <line x1="310" y1="86" x2="510" y2="118" class="map-line" />
            <line x1="510" y1="118" x2="590" y2="202" class="map-line" />
            <g class="map-node active" data-map-node="aml-engine-roaster" transform="translate(106 142)">
              <circle cx="34" cy="34" r="33" />
              <text x="34" y="39" text-anchor="middle">Wallet</text>
            </g>
            <g class="map-node" data-map-node="agent-chess" transform="translate(276 52)">
              <circle cx="34" cy="34" r="33" />
              <text x="34" y="39" text-anchor="middle">Agents</text>
            </g>
            <g class="map-node" data-map-node="agent-heartbeat-lab" transform="translate(284 220)">
              <circle cx="34" cy="34" r="33" />
              <text x="34" y="39" text-anchor="middle">Loop</text>
            </g>
            <g class="map-node" data-map-node="agent-framework-proof-v2" transform="translate(476 84)">
              <circle cx="34" cy="34" r="33" />
              <text x="34" y="39" text-anchor="middle">Flow</text>
            </g>
            <g class="map-node" data-map-node="modern-questions" transform="translate(556 168)">
              <circle cx="34" cy="34" r="33" />
              <text x="34" y="39" text-anchor="middle">Next</text>
            </g>
          </svg>
        </div>

        <div class="tour-scenes">
          {scenes.map((scene, index) => (
            <article class={`tour-scene ${index === 0 ? 'active' : ''}`} data-scene-panel={scene.id}>
              <div class="scene-head">
                <span>{scene.label}</span>
                <h2>{scene.title}</h2>
                <p>{scene.intent}</p>
              </div>

              {scene.project && (
                <div class="scene-method">
                  <div>
                    <span>Source links</span>
                    <strong>{getSources(scene.project).length}</strong>
                  </div>
                  <div>
                    <span>Number notes</span>
                    <strong>{getNumbers(scene.project).length}</strong>
                  </div>
                  <div>
                    <span>Stated limits</span>
                    <strong>{getLimits(scene.project).length}</strong>
                  </div>
                </div>
              )}

              {getStatus(scene.project) && (
                <div class="scene-status">
                  <div>
                    <span>Board state</span>
                    <p>{getStatus(scene.project).board_state}</p>
                  </div>
                  <div>
                    <span>Latest public move</span>
                    <p>{getStatus(scene.project).latest_public_move}</p>
                  </div>
                  <div>
                    <span>Review</span>
                    <p>{getStatus(scene.project).review_state}</p>
                  </div>
                  <div>
                    <span>Boundary</span>
                    <p>{getStatus(scene.project).approval_boundary}</p>
                  </div>
                </div>
              )}

              {scene.project ? (
                <div class="scene-grid">
                  <div>
                    <h3>What it is</h3>
                    <p>{displayClaims[scene.id] || scene.project.what_it_is}</p>
                  </div>
                  <div>
                    <h3>Sources</h3>
                    <ul>
                      {getSources(scene.project).slice(0, 4).map((item) => (
                        <li>
                          {item.url ? (
                            <a href={item.url} target={item.url.startsWith('http') ? '_blank' : undefined} rel={item.url.startsWith('http') ? 'noopener' : undefined}>{item.label}</a>
                          ) : (
                            <span>{item.label}</span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div>
                    <h3>Numbers</h3>
                    <ul>
                      {getNumbers(scene.project).slice(0, 4).map((metric) => (
                        <li>{metric}</li>
                      ))}
                    </ul>
                  </div>
                  <div>
                    <h3>Limits</h3>
                    <ul>
                      {getLimits(scene.project).slice(0, 4).map((limit) => (
                        <li>{limit}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              ) : (
                <div class="scene-grid">
                  {featuredQuestions.map((question) => (
                    <div>
                      <h3>{question.question}</h3>
                      <p>{question.plain_answer}</p>
                    </div>
                  ))}
                </div>
              )}

              <div class="scene-next">
                <div>
                  <span>Next question</span>
                  <p>{scene.next}</p>
                </div>
                 <a href={scene.route} target={scene.route.startsWith('http') ? '_blank' : undefined} rel={scene.route.startsWith('http') ? 'noopener' : undefined}>Open route -></a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <aside class="tour-metrics">
        <h2>Report snapshot</h2>
        {reportMetrics.slice(0, 6).map((metric) => (
          <div class="tour-metric">
            <span>{metric.label}</span>
            <strong>{metric.value}</strong>
            <small>{metric.unit}</small>
          </div>
        ))}
        <a href="/reports">Open reports -></a>
      </aside>
    </section>



    <section class="agent-chess-showcase" aria-labelledby="agent-chess-showcase-title">
      <div class="chess-hero-card">
        <div>
          <span class="section-kicker">Agent Chess board</span>
          <h2 id="agent-chess-showcase-title">Move, review, gate, artifact</h2>
          <p>{agentChess.summary}</p>
        </div>
        <div class="chess-now-card">
          <span>Now playing</span>
          <strong>{agentChess.now_playing.board}</strong>
          <small>Waiting on {agentChess.now_playing.waiting_on}: {agentChess.now_playing.public_state}</small>
        </div>
      </div>

      <div class="chess-flow" aria-label="Agent Chess public flow">
        {agentChessFlow.map((item) => (
          <article>
            <span>{item.step}</span>
            <strong>{item.label}</strong>
            <p>{item.description}</p>
          </article>
        ))}
      </div>

      <div class="chess-lane-grid">
        {agentChessLanes.map((lane) => (
          <article class="chess-lane-card">
            <div>
              <span>{lane.status}</span>
              <h3>{lane.label}</h3>
            </div>
            <p>{lane.purpose}</p>
            <small>Public artifact: {lane.public_artifact}</small>
          </article>
        ))}
      </div>

      <div class="chess-roles-boundaries">
        <div class="chess-role-panel">
          <span class="section-kicker">Roles and boundaries</span>
          <h3>Separate hands, visible limits</h3>
          <div class="role-list">
            {agentChessRoles.map((role) => (
              <div>
                <strong>{role.label}</strong>
                <span>{role.state}</span>
                <p>{role.boundary || role.role}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="chess-policy-panel">
          <span class="section-kicker">No private data policy</span>
          <h3>What stays off the public surface</h3>
          <ul>
            {agentChessPolicy.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <p>{agentChess.safety_note}</p>
        </div>
      </div>
    </section>

    <section class="route-rail" aria-label="Bionic Banker learning route">
      <div>
        <span>Route</span>
        <h2>Follow the evidence workflow</h2>
        <p>Start with a question, learn the term, open the risk and evidence overview, then check the numbers. This overview is the middle step.</p>
      </div>
      <div class="route-links">
        <a href="/gaps">Questions</a>
        <a href="/learn">Knowledge Base</a>
        <a href="/risk-evidence-overview">Risk & Evidence Overview</a>
        <a href="/aml-status-evidence">AML Status Evidence</a>
        <a href="/reports">Field notes</a>
        <a href="/intelligence">Risk signals</a>
      </div>
    </section>

    <section class="deep-panel">
      <div class="deep-head">
        <span>How to read it</span>
        <h2>Thing to source to next question</h2>
        <p>Each lane is a visible piece of work, not a product certification. The goal is simple: understand what exists, what points to it, what the limit is, and what question comes next.</p>
      </div>
      <div class="method-grid">
        <div>
          <strong>1. Thing</strong>
          <p>What you can actually inspect from links, reports, summaries, and stated limits.</p>
        </div>
        <div>
          <strong>2. Source</strong>
          <p>Repo, article, manifest summary, benchmark note, or JSON snapshot.</p>
        </div>
        <div>
          <strong>3. Limits</strong>
          <p>What this is not. This keeps finance, compliance, and agent notes honest.</p>
        </div>
        <div>
          <strong>4. Next question</strong>
          <p>The question that makes the system easier to understand.</p>
        </div>
      </div>
    </section>

    <section class="deep-panel">
      <div class="deep-head">
        <span>Route map</span>
        <h2>How easy each lane is to inspect today</h2>
        <p>This is a local display score from source links, number notes, and named limits. It is not a product maturity score.</p>
      </div>
      <div class="readiness-list">
        {inspectionRows.map((row) => (
          <div class="readiness-row">
            <div>
              <span>{row.label}</span>
              <strong>{row.title}</strong>
              <small>{row.sourceCount} sources, {row.metricCount} notes, {row.limitCount} limits</small>
            </div>
            <div class="readiness-bar" aria-label={`${row.title} tour score ${row.readability} percent`}>
              <i style={`width: ${row.readability}%`}></i>
            </div>
            <b>{row.readability}</b>
          </div>
        ))}
      </div>
    </section>

    <section class="deep-grid">
      <div class="deep-panel">
        <div class="deep-head compact">
          <span>Benchmarks</span>
          <h2>Numbers worth showing</h2>
          <p>Only values already present in linked summaries are shown here.</p>
        </div>
        <div class="benchmark-list">
          {benchmarkMetrics.slice(0, 6).map((metric) => (
            <div class="benchmark-row">
              <div>
                <strong>{metric.label}</strong>
                <span>{metric.value} {metric.unit}</span>
              </div>
              <div class="benchmark-bar">
                <i style={`width: ${Math.min(100, Math.round((metric.value / metric.scale_max) * 100))}%`}></i>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="deep-panel">
        <div class="deep-head compact">
          <span>Coverage</span>
          <h2>Current balance</h2>
        <p>The lightest area remains deployment. The serious question is how repeatable systems should be packaged, monitored, and explained.</p>
        </div>
        <div class="coverage-list">
          {coverageBars.map((item) => (
            <div class="coverage-row">
              <span>{item.label}</span>
              <div class="coverage-dots" aria-label={`${item.label} ${item.value} of ${item.max}`}>
                {Array.from({ length: item.max }).map((_, index) => (
                  <i class={index < item.value ? 'on' : ''}></i>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="deep-panel">
      <div class="deep-head">
        <span>Source list</span>
        <h2>Where the questions came from</h2>
        <p>The questions come from current AI engineering roles, demonstration patterns, and the way modern teams talk about agents, evals, observability, and deployment.</p>
      </div>
      <div class="source-ledger">
        {marketSources.map((source) => (
          <a href={source.url} target="_blank" rel="noopener">
            <strong>{source.label}</strong>
            <span>{source.signal}</span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <script is:inline>
  (function() {
    var app = document.querySelector('[data-tour-app]');
    if (!app) return;
    var tabs = Array.prototype.slice.call(app.querySelectorAll('[data-scene-tab]'));
    var panels = Array.prototype.slice.call(app.querySelectorAll('[data-scene-panel]'));
    var nodes = Array.prototype.slice.call(app.querySelectorAll('[data-map-node]'));

    function activate(id) {
      tabs.forEach(function(tab) { tab.classList.toggle('active', tab.getAttribute('data-scene-tab') === id); });
      panels.forEach(function(panel) { panel.classList.toggle('active', panel.getAttribute('data-scene-panel') === id); });
      nodes.forEach(function(node) { node.classList.toggle('active', node.getAttribute('data-map-node') === id); });
    }

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() { activate(tab.getAttribute('data-scene-tab')); });
    });
    nodes.forEach(function(node) {
      node.addEventListener('click', function() { activate(node.getAttribute('data-map-node')); });
    });
  })();
  </script>

  <style>
    .tour-shell {
      max-width: var(--max);
      margin: 0 auto;
      padding: 3.5rem 2rem 4rem;
    }

    .tour-hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 1.2rem;
      align-items: end;
      border-bottom: 1px solid var(--b1);
      padding-bottom: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .tour-hero h1 {
      font-size: clamp(2.2rem, 6vw, 4.8rem);
      letter-spacing: 0;
      margin: 0 0 0.6rem;
    }

    .tour-hero p {
      color: var(--text-2);
      line-height: 1.7;
      max-width: 760px;
      margin: 0;
    }

    .tour-status {
      display: grid;
      gap: 0.45rem;
      min-width: 210px;
    }

    .tour-status span,
    .tour-status strong {
      border: 1px solid rgba(31, 160, 104, 0.22);
      border-radius: 6px;
      padding: 0.45rem 0.65rem;
      background: rgba(31, 160, 104, 0.055);
      font-family: var(--mono);
      font-size: 0.72rem;
      color: var(--text);
    }

    .tour-app {
      display: grid;
      grid-template-columns: 150px minmax(0, 1fr) 210px;
      gap: 1rem;
      align-items: start;
    }

    .tour-rail,
    .tour-metrics,
    .tour-main {
      border: 1px solid rgba(228, 228, 236, 0.12);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.035);
    }

    .tour-rail {
      display: grid;
      gap: 0.35rem;
      padding: 0.55rem;
      position: sticky;
      top: 5rem;
    }

    .tour-tab {
      border: 1px solid transparent;
      background: transparent;
      color: var(--text-2);
      text-align: left;
      border-radius: 6px;
      padding: 0.65rem;
      cursor: pointer;
      font-family: var(--mono);
    }

    .tour-tab span {
      display: block;
      font-size: 0.62rem;
      color: var(--text-3);
      margin-bottom: 0.18rem;
    }

    .tour-tab strong {
      font-size: 0.78rem;
      letter-spacing: 0;
    }

    .tour-tab.active {
      border-color: rgba(31, 160, 104, 0.42);
      background: rgba(31, 160, 104, 0.1);
      color: var(--text);
    }

    .tour-main {
      padding: 1rem;
      min-width: 0;
    }

    .tour-map {
      border: 1px solid rgba(31, 160, 104, 0.18);
      border-radius: 8px;
      background: rgba(2, 2, 4, 0.5);
      margin-bottom: 1rem;
      overflow: hidden;
    }

    .tour-map svg {
      display: block;
      width: 100%;
      height: auto;
      min-height: 260px;
    }

    .map-line {
      stroke: rgba(31, 160, 104, 0.22);
      stroke-width: 2;
    }

    .map-node {
      cursor: pointer;
    }

    .map-node circle {
      fill: rgba(31, 160, 104, 0.08);
      stroke: rgba(31, 160, 104, 0.38);
      stroke-width: 2;
    }

    .map-node text {
      fill: var(--text);
      font-size: 12px;
      font-family: var(--mono);
    }

    .map-node.active circle {
      fill: rgba(31, 160, 104, 0.22);
      stroke: #1fa068;
      filter: drop-shadow(0 0 18px rgba(31, 160, 104, 0.35));
    }

    .tour-scene {
      display: none;
    }

    .tour-scene.active {
      display: block;
    }

    .scene-head {
      margin-bottom: 1rem;
    }

    .scene-method {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.6rem;
      margin-bottom: 0.85rem;
    }

    .scene-method div {
      border: 1px solid rgba(31, 160, 104, 0.2);
      border-radius: 6px;
      background: rgba(31, 160, 104, 0.055);
      padding: 0.65rem;
    }

    .scene-method span {
      display: block;
      color: var(--text-3);
      font-size: 0.66rem;
      margin-bottom: 0.1rem;
    }

    .scene-method strong {
      color: var(--text);
      font-size: 1.3rem;
    }

    .scene-status {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.65rem;
      border: 1px solid rgba(31, 160, 104, 0.22);
      border-radius: 8px;
      padding: 0.75rem;
      margin-bottom: 0.85rem;
      background: rgba(31, 160, 104, 0.055);
    }

    .scene-status div {
      min-width: 0;
    }

    .scene-status span {
      display: block;
      color: #1fa068;
      font-family: var(--mono);
      font-size: 0.66rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 0.32rem;
    }

    .scene-status p {
      color: var(--text-2);
      font-size: 0.86rem;
      line-height: 1.55;
      margin: 0;
    }

    .scene-head span,
    .scene-next span {
      display: block;
      color: #1fa068;
      font-family: var(--mono);
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 0.35rem;
    }

    .scene-head h2 {
      margin: 0 0 0.45rem;
      font-size: clamp(1.5rem, 3vw, 2.2rem);
      letter-spacing: 0;
    }

    .scene-head p,
    .scene-grid p,
    .scene-next p {
      color: var(--text-2);
      line-height: 1.65;
      margin: 0;
    }

    .scene-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 0.75rem;
    }

    .scene-grid > div {
