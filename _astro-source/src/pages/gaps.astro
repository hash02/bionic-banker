---
import BaseLayout from '../layouts/BaseLayout.astro';

const gapCatalog = await import('../../public/dashboard-data/market-gap-catalog.json');
const questions = gapCatalog.default.modern_questions;
const sources = gapCatalog.default.market_sources;
const guide = gapCatalog.default.reader_guide;
const websiteScan = gapCatalog.default.website_scan;
const verifiedDate = new Date(gapCatalog.default.generated_at).toISOString().slice(0, 10);

const categories = [...new Set(questions.map((question) => question.category))];
const grouped = categories
  .map((category) => ({
    category,
    items: questions.filter((question) => question.category === category),
  }))
  .filter((group) => group.items.length > 0);

const featuredQuestions = [
  questions.find((question) => question.id === 'ai-components'),
  questions.find((question) => question.id === 'production-rag'),
  questions.find((question) => question.id === 'ai-route-map'),
].filter(Boolean);
---
<BaseLayout title="Questions the Market Is Asking" description="A plain question map for modern AI, finance automation, engineering notes, and useful explanations.">
  <div class="page-header">
    <div class="page-label">Questions by topic</div>
    <h1 class="page-title">Questions the Market Is Asking</h1>
    <p class="page-sub">A plain map for modern AI, finance automation, and engineering notes. Start with a question, read the simple answer, then open the experiment or learning link when you want more depth.</p>
  </div>

  <div class="articles-wrap">
    <p class="verified-note">Last refreshed from the question catalog: {verifiedDate}. Current board: {sources.length} outside signals and {questions.length} public questions.</p>
    <p class="gap-intro">These are the questions the work keeps returning to. Some have partial answers in the experiments. Most are still open.</p>

    <section class="question-console">
      <div class="question-console-copy">
        <div class="section-label">Start here</div>
        <h2>Pick the kind of question you have.</h2>
        <p>AI gets easier when the first click is a question, not a wall of terms. This rail groups the page by the thing you are trying to understand.</p>
      </div>
      <div class="category-rail" aria-label="Question categories">
        {grouped.map((group) => (
          <a href={`#${group.items[0].id}`}>
            <span>{group.items.length}</span>
            <strong>{group.category}</strong>
          </a>
        ))}
      </div>
    </section>

    <section class="featured-question-grid" aria-label="Featured questions">
      {featuredQuestions.map((question) => (
        <article class="featured-question">
          <span>{question.category}</span>
          <h3>{question.question}</h3>
          <p>{question.plain_answer}</p>
          <a href={`#${question.id}`}>Open question -></a>
        </article>
      ))}
    </section>

    <section class="website-scan-panel">
      <div class="section-label">Reader Guide</div>
      <h2>{guide.headline}</h2>
      <div class="scan-grid">
        <article>
          <span>Plain answer</span>
          <p>{guide.plain_answer}</p>
        </article>
        <article>
          <span>Useful when</span>
          <p>{guide.useful_for_reader}</p>
        </article>
        <article>
          <span>Center question</span>
          <p>{websiteScan.main_question}</p>
        </article>
      </div>
      <div class="scan-next">
        <h3>How to use it</h3>
        <ul>
          {guide.how_to_read.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="matrix-intro-grid">
      <article class="article-card">
        <div class="article-tags">
          <span class="tag-pill tag-green">Guidance</span>
        </div>
        <h3>How to read this page</h3>
        <p>Every card starts as a question because that is how real engineering starts. The page stays on concepts, examples, and public routes anyone can open.</p>
        <p>Each row moves from question to plain answer to example, then gives one next click.</p>
        <div class="card-footer">
          <a class="read-more" href="/reports">Open reports -></a>
          <a class="read-more" href="/projects">Open experiments -></a>
        </div>
      </article>

      <article class="article-card">
        <div class="article-tags">
          <span class="tag-pill tag-green">Current read</span>
        </div>
        <h3>What makes a useful AI page?</h3>
        <p>{websiteScan.reader_value}</p>
        <p>Good AI content should help someone ask a sharper question, learn the term, inspect an example, and understand the limit.</p>
      </article>
    </section>

    <section class="source-panel">
      <div class="section-label">Market Signals</div>
      <h2>Why these questions matter now</h2>
      <div class="source-grid">
        {sources.map((source) => (
          <article class="source-card">
            <h3>{source.label}</h3>
            <p>{source.signal}</p>
            <a href={source.url} target="_blank" rel="noopener">Source -></a>
          </article>
        ))}
      </div>
    </section>

    <section class="source-panel">
      <div class="section-label">Interface Principles</div>
      <h2>What readers can inspect</h2>
      <div class="source-grid">
        {websiteScan.interface_principles.map((principle) => (
          <article class="source-card">
            <p>{principle}</p>
          </article>
        ))}
      </div>
    </section>

    {grouped.map((group) => (
      <section class="gap-section">
        <div class="section-label">{group.category}</div>
        <div class="gap-grid">
          {group.items.map((question) => (
            <article class="gap-card" id={question.id}>
              <div class="gap-head">
                <span>{question.category}</span>
                <h3>{question.question}</h3>
              </div>
              <p><strong>Why this comes up:</strong> {question.why_market_asks}</p>
              <p><strong>Plain answer:</strong> {question.plain_answer}</p>
              <p><strong>Example:</strong> {question.already_built_example}</p>
              <p><strong>Useful when:</strong> {question.useful_for_reader}</p>
              <div class="card-footer">
                <a class="read-more" href={question.website_surface}>Learn concept -></a>
                <a class="read-more" href={question.report_surface}>Follow note -></a>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>

  <style>
    .question-console {
      display: grid;
      grid-template-columns: minmax(0, 0.85fr) minmax(320px, 1.15fr);
      gap: 1rem;
      border: 1px solid rgba(31, 160, 104, 0.22);
      background: rgba(31, 160, 104, 0.055);
      border-radius: 8px;
      padding: 1.2rem;
      margin-bottom: 1rem;
    }

    .question-console h2 {
      margin: 0.25rem 0 0.6rem;
      font-size: clamp(1.35rem, 2.4vw, 2.1rem);
      letter-spacing: 0;
    }

    .question-console p,
    .featured-question p {
      color: var(--text-2);
      line-height: 1.65;
      margin: 0;
    }

    .category-rail {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(118px, 1fr));
      gap: 0.55rem;
      align-content: start;
    }

    .category-rail a {
      border: 1px solid rgba(228, 228, 236, 0.12);
      border-radius: 8px;
      padding: 0.75rem;
      background: rgba(2, 2, 4, 0.42);
      color: var(--text);
      text-decoration: none;
      min-width: 0;
    }

    .category-rail span,
    .featured-question span {
      display: block;
      color: #1fa068;
      font-family: var(--mono);
      font-size: 0.72rem;
      margin-bottom: 0.35rem;
      text-transform: uppercase;
    }

    .category-rail strong {
      display: block;
      font-size: 0.9rem;
      letter-spacing: 0;
      overflow-wrap: anywhere;
    }

    .featured-question-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
      margin-bottom: 1.25rem;
    }

    .featured-question {
      border: 1px solid rgba(228, 228, 236, 0.12);
      border-radius: 8px;
      padding: 1rem;
      background: rgba(2, 2, 4, 0.42);
      display: grid;
      gap: 0.65rem;
      min-width: 0;
    }

    .featured-question h3 {
      margin: 0;
      font-size: 1.05rem;
      line-height: 1.35;
      letter-spacing: 0;
    }

    .featured-question a {
      color: #1fa068;
      text-decoration: none;
      font-family: var(--mono);
      font-size: 0.85rem;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
    }

    .matrix-intro-grid,
    .source-grid,
    .gap-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1rem;
      margin-bottom: 1.25rem;
    }

    .source-panel,
    .gap-section,
    .website-scan-panel {
      border: 1px solid rgba(31, 160, 104, 0.22);
      background: rgba(255, 255, 255, 0.035);
      border-radius: 8px;
      padding: 1.35rem;
      margin-bottom: 1.25rem;
    }

    .source-panel h2,
    .website-scan-panel h2 {
      margin: 0.25rem 0 1rem;
      font-size: clamp(1.35rem, 2vw, 2rem);
    }

    .scan-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .scan-grid article,
    .scan-next {
      border: 1px solid rgba(228, 228, 236, 0.12);
      border-radius: 8px;
      padding: 1rem;
      background: rgba(2, 2, 4, 0.42);
    }

    .scan-grid span {
      display: block;
      color: #1fa068;
      font-family: var(--mono);
      font-size: 0.75rem;
      text-transform: uppercase;
      margin-bottom: 0.4rem;
    }

    .scan-next h3 {
      margin: 0 0 0.7rem;
    }

    .scan-next ul {
      margin: 0;
      padding-left: 1.1rem;
      color: var(--text-2);
      line-height: 1.7;
    }

    .source-card,
    .gap-card {
      border: 1px solid rgba(228, 228, 236, 0.12);
      border-radius: 8px;
      padding: 1rem;
      background: rgba(2, 2, 4, 0.42);
      display: grid;
      gap: 0.55rem;
      min-width: 0;
    }

    .source-card h3,
    .gap-card h3 {
      margin: 0;
      font-size: 1.05rem;
    }

    .source-card a {
      color: #1fa068;
      text-decoration: none;
      font-family: var(--mono);
      font-size: 0.9rem;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
    }

    .matrix-intro-grid .read-more,
    .gap-card .read-more {
      min-height: 44px;
      align-items: center;
    }

    .gap-head {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .gap-head span {
      border: 1px solid rgba(31, 160, 104, 0.45);
      color: #1fa068;
      border-radius: 999px;
      padding: 0.25rem 0.55rem;
      font-family: var(--mono);
      font-size: 0.8rem;
    }

    .gap-card p,
    .source-card p {
      margin: 0;
      color: var(--text-2);
      line-height: 1.65;
    }

    @media (max-width: 900px) {
      .question-console,
      .featured-question-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .question-console {
        padding: 1rem;
      }

      .category-rail {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
  </style>
</BaseLayout>
