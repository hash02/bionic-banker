---
import BaseLayout from '../layouts/BaseLayout.astro';

const gapCatalog = await import('../../public/dashboard-data/market-gap-catalog.json');
const questions = gapCatalog.default.modern_questions;
const sources = gapCatalog.default.market_sources;
const websiteScan = gapCatalog.default.website_scan;
const verifiedDate = new Date(gapCatalog.default.generated_at).toISOString().slice(0, 10);

const priorityOrder = ['P1', 'P2', 'P3'];
const grouped = priorityOrder
  .map((priority) => ({
    priority,
    items: questions.filter((question) => question.priority === priority),
  }))
  .filter((group) => group.items.length > 0);
---
<BaseLayout title="Modern Questions" description="A public-safe question board for modern AI, finance, automation, and proof questions Bionic Banker is exploring.">
  <div class="page-header">
    <div class="page-label">Modern Questions</div>
    <h1 class="page-title">Questions Worth Solving</h1>
    <p class="page-sub">This page is not a weakness list. It is the question board: the AI, finance, automation, and proof questions people are already searching for, and how this site is testing them in public-safe ways.</p>
  </div>

  <div class="articles-wrap">
    <p class="verified-note">Last refreshed from the question catalog: {verifiedDate}. Current board: {sources.length} market signals and {questions.length} public questions.</p>

    <section class="website-scan-panel">
      <div class="section-label">Website Scan</div>
      <h2>How far the surface is from a modern AI engineering site</h2>
      <div class="scan-grid">
        <article>
          <span>Current strength</span>
          <p>{websiteScan.current_strength}</p>
        </article>
        <article>
          <span>Main question</span>
          <p>{websiteScan.main_gap}</p>
        </article>
        <article>
          <span>Distance</span>
          <p>{websiteScan.distance_from_modern_standard}</p>
        </article>
      </div>
      <div class="scan-next">
        <h3>Interface questions now open</h3>
        <ul>
          {websiteScan.next_ui_moves.map((move) => (
            <li>{move}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="matrix-intro-grid">
      <article class="article-card">
        <div class="article-tags">
          <span class="tag-pill tag-green">Guidance</span>
        </div>
        <h3>How to read this page</h3>
        <p>Every card starts as a question because that is how real engineering starts. The value is not pretending the answer is finished. The value is showing how the answer is being tested.</p>
        <p>Each row maps a modern question to why people ask it, how the system is testing it, and where a reader can inspect the related public surface.</p>
        <div class="card-footer">
          <a class="read-more" href="/reports">Open reports -></a>
          <a class="read-more" href="/projects">Open proof console -></a>
        </div>
      </article>

      <article class="article-card">
        <div class="article-tags">
          <span class="tag-pill tag-green">Current read</span>
        </div>
        <h3>Strongest question right now</h3>
        <p>Can the website become its own AI learning dataset? That one question connects RAG, embeddings, evals, citations, FastAPI, reporting, and content automation without forcing a fake enterprise story.</p>
        <p>The public answer should be inspectable: ask a question, retrieve source articles, show citations, score the answer, and state the limitation.</p>
      </article>
    </section>

    <section class="source-panel">
      <div class="section-label">Market Signals</div>
      <h2>Why these questions matter now</h2>
      <div class="source-grid">
        {sources.map((source) => (
          <article class="source-card">
            <h3>{source.label}</h3>
            <p>{source.signal}</p>
            <a href={source.url} target="_blank" rel="noopener">Source -></a>
          </article>
        ))}
      </div>
    </section>

    {grouped.map((group) => (
      <section class="gap-section">
        <div class="section-label">{group.priority} Question Lane</div>
        <div class="gap-grid">
          {group.items.map((question) => (
            <article class="gap-card" id={question.id}>
              <div class="gap-head">
                <span>{question.priority}</span>
                <h3>{question.question}</h3>
              </div>
              <p><strong>Why people ask:</strong> {question.why_people_ask}</p>
              <p><strong>How this site is testing it:</strong> {question.how_we_are_testing}</p>
              <p><strong>What to inspect:</strong> {question.what_reader_can_check}</p>
              <div class="card-footer">
                <a class="read-more" href={question.website_surface}>Follow question -></a>
                <a class="read-more" href={question.report_surface}>View evidence -></a>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>

  <style>
    .matrix-intro-grid,
    .source-grid,
    .gap-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1rem;
      margin-bottom: 1.25rem;
    }

    .source-panel,
    .gap-section,
    .website-scan-panel {
      border: 1px solid rgba(31, 160, 104, 0.22);
      background: rgba(255, 255, 255, 0.035);
      border-radius: 8px;
      padding: 1.35rem;
      margin-bottom: 1.25rem;
    }

    .source-panel h2,
    .website-scan-panel h2 {
      margin: 0.25rem 0 1rem;
      font-size: clamp(1.35rem, 2vw, 2rem);
    }

    .scan-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .scan-grid article,
    .scan-next {
      border: 1px solid rgba(228, 228, 236, 0.12);
      border-radius: 8px;
      padding: 1rem;
      background: rgba(2, 2, 4, 0.42);
    }

    .scan-grid span {
      display: block;
      color: #1fa068;
      font-family: var(--mono);
      font-size: 0.75rem;
      text-transform: uppercase;
      margin-bottom: 0.4rem;
    }

    .scan-next h3 {
      margin: 0 0 0.7rem;
    }

    .scan-next ul {
      margin: 0;
      padding-left: 1.1rem;
      color: var(--text-2);
      line-height: 1.7;
    }

    .source-card,
    .gap-card {
      border: 1px solid rgba(228, 228, 236, 0.12);
      border-radius: 8px;
      padding: 1rem;
      background: rgba(2, 2, 4, 0.42);
      display: grid;
      gap: 0.55rem;
      min-width: 0;
    }

    .source-card h3,
    .gap-card h3 {
      margin: 0;
      font-size: 1.05rem;
    }

    .source-card a {
      color: #1fa068;
      text-decoration: none;
      font-family: var(--mono);
      font-size: 0.9rem;
    }

    .gap-head {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .gap-head span {
      border: 1px solid rgba(31, 160, 104, 0.45);
      color: #1fa068;
      border-radius: 999px;
      padding: 0.25rem 0.55rem;
      font-family: var(--mono);
      font-size: 0.8rem;
    }

    .gap-card p,
    .source-card p {
      margin: 0;
      color: var(--text-2);
      line-height: 1.65;
    }
  </style>
</BaseLayout>
