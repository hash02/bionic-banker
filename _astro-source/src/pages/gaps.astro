---
import BaseLayout from '../layouts/BaseLayout.astro';

const gapCatalog = await import('../../public/dashboard-data/market-gap-catalog.json');
const questions = gapCatalog.default.modern_questions;
const sources = gapCatalog.default.market_sources;
const guide = gapCatalog.default.reader_guide;
const websiteScan = gapCatalog.default.website_scan;
const verifiedDate = new Date(gapCatalog.default.generated_at).toISOString().slice(0, 10);

const categories = [...new Set(questions.map((question) => question.category))];
const grouped = categories
  .map((category) => ({
    category,
    items: questions.filter((question) => question.category === category),
  }))
  .filter((group) => group.items.length > 0);
---
<BaseLayout title="Questions the Market Is Asking" description="A reader-facing question atlas for modern AI, finance automation, engineering proof, and useful explanations.">
  <div class="page-header">
    <div class="page-label">Question Atlas</div>
    <h1 class="page-title">Questions the Market Is Asking</h1>
    <p class="page-sub">A reader-facing map for modern AI, finance automation, and engineering proof. Start with a question, read the plain answer, then open the proof or learning link when you want more depth.</p>
  </div>

  <div class="articles-wrap">
    <p class="verified-note">Last refreshed from the question catalog: {verifiedDate}. Current board: {sources.length} market signals and {questions.length} public questions.</p>

    <section class="website-scan-panel">
      <div class="section-label">Reader Guide</div>
      <h2>{guide.headline}</h2>
      <div class="scan-grid">
        <article>
          <span>Plain answer</span>
          <p>{guide.plain_answer}</p>
        </article>
        <article>
          <span>Useful for</span>
          <p>{guide.useful_for_reader}</p>
        </article>
        <article>
          <span>Core question</span>
          <p>{websiteScan.main_question}</p>
        </article>
      </div>
      <div class="scan-next">
        <h3>How to use it</h3>
        <ul>
          {guide.how_to_read.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="matrix-intro-grid">
      <article class="article-card">
        <div class="article-tags">
          <span class="tag-pill tag-green">Guidance</span>
        </div>
        <h3>How to read this page</h3>
        <p>Every card starts as a question because that is how real engineering starts. The page avoids private architecture and focuses on concepts a reader can use.</p>
        <p>Each row maps a modern question to why people ask it, a plain answer, an existing public example, and the next useful click.</p>
        <div class="card-footer">
          <a class="read-more" href="/reports">Open reports -></a>
          <a class="read-more" href="/projects">Open proof console -></a>
        </div>
      </article>

      <article class="article-card">
        <div class="article-tags">
          <span class="tag-pill tag-green">Current read</span>
        </div>
        <h3>What makes a useful AI page?</h3>
        <p>{websiteScan.reader_value}</p>
        <p>Good AI content should help a reader ask a sharper question, learn the term, inspect an example, and understand the limit.</p>
      </article>
    </section>

    <section class="source-panel">
      <div class="section-label">Market Signals</div>
      <h2>Why these questions matter now</h2>
      <div class="source-grid">
        {sources.map((source) => (
          <article class="source-card">
            <h3>{source.label}</h3>
            <p>{source.signal}</p>
            <a href={source.url} target="_blank" rel="noopener">Source -></a>
          </article>
        ))}
      </div>
    </section>

    <section class="source-panel">
      <div class="section-label">Interface Principles</div>
      <h2>What readers can inspect</h2>
      <div class="source-grid">
        {websiteScan.interface_principles.map((principle) => (
          <article class="source-card">
            <p>{principle}</p>
          </article>
        ))}
      </div>
    </section>

    {grouped.map((group) => (
      <section class="gap-section">
        <div class="section-label">{group.category}</div>
        <div class="gap-grid">
          {group.items.map((question) => (
            <article class="gap-card" id={question.id}>
              <div class="gap-head">
                <span>{question.category}</span>
                <h3>{question.question}</h3>
              </div>
              <p><strong>Why people ask:</strong> {question.why_market_asks}</p>
              <p><strong>Plain answer:</strong> {question.plain_answer}</p>
              <p><strong>Existing example:</strong> {question.already_built_example}</p>
              <p><strong>Useful for reader:</strong> {question.useful_for_reader}</p>
              <div class="card-footer">
                <a class="read-more" href={question.website_surface}>Learn concept -></a>
                <a class="read-more" href={question.report_surface}>Inspect proof -></a>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>

  <style>
    .matrix-intro-grid,
    .source-grid,
    .gap-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1rem;
      margin-bottom: 1.25rem;
    }

    .source-panel,
    .gap-section,
    .website-scan-panel {
      border: 1px solid rgba(31, 160, 104, 0.22);
      background: rgba(255, 255, 255, 0.035);
      border-radius: 8px;
      padding: 1.35rem;
      margin-bottom: 1.25rem;
    }

    .source-panel h2,
    .website-scan-panel h2 {
      margin: 0.25rem 0 1rem;
      font-size: clamp(1.35rem, 2vw, 2rem);
    }

    .scan-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .scan-grid article,
    .scan-next {
      border: 1px solid rgba(228, 228, 236, 0.12);
      border-radius: 8px;
      padding: 1rem;
      background: rgba(2, 2, 4, 0.42);
    }

    .scan-grid span {
      display: block;
      color: #1fa068;
      font-family: var(--mono);
      font-size: 0.75rem;
      text-transform: uppercase;
      margin-bottom: 0.4rem;
    }

    .scan-next h3 {
      margin: 0 0 0.7rem;
    }

    .scan-next ul {
      margin: 0;
      padding-left: 1.1rem;
      color: var(--text-2);
      line-height: 1.7;
    }

    .source-card,
    .gap-card {
      border: 1px solid rgba(228, 228, 236, 0.12);
      border-radius: 8px;
      padding: 1rem;
      background: rgba(2, 2, 4, 0.42);
      display: grid;
      gap: 0.55rem;
      min-width: 0;
    }

    .source-card h3,
    .gap-card h3 {
      margin: 0;
      font-size: 1.05rem;
    }

    .source-card a {
      color: #1fa068;
      text-decoration: none;
      font-family: var(--mono);
      font-size: 0.9rem;
    }

    .gap-head {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .gap-head span {
      border: 1px solid rgba(31, 160, 104, 0.45);
      color: #1fa068;
      border-radius: 999px;
      padding: 0.25rem 0.55rem;
      font-family: var(--mono);
      font-size: 0.8rem;
    }

    .gap-card p,
    .source-card p {
      margin: 0;
      color: var(--text-2);
      line-height: 1.65;
    }
  </style>
</BaseLayout>
