---
import BaseLayout from '../layouts/BaseLayout.astro';

const proofs = [
  {
    badge: 'Featured proof',
    title: 'AML Detection Engine',
    problem: 'Financial-crime review needs explainable triage, not black-box confidence.',
    input: 'Synthetic transaction and wallet-risk patterns.',
    output: 'Rules, flags, review notes, tests, and explicit limits.',
    metric: '46 local tests passed in the last verified run.',
    boundary: 'Triage support only — not SAR filing, legal advice, compliance approval, or production monitoring.',
    links: [
      { label: 'GitHub', href: 'https://github.com/hash02/aml-detection-engine' },
      { label: 'Static demo', href: '/labs/aml-engine/demo/' },
    ],
  },
  {
    badge: 'Agent control proof',
    title: 'Agent Governance / Audit Trail',
    problem: 'AI agents that touch tools need gates, trace records, and blocked-action proof.',
    input: 'Agent task, retrieved sources, tool call, and review boundary.',
    output: 'Control map for what was read, trusted, called, blocked, and reviewed.',
    metric: '70-test agent framework proof referenced from the public project surface.',
    boundary: 'Proof layer only — not a production authorization system or autonomous financial actor.',
    links: [
      { label: 'GitHub', href: 'https://github.com/hash02/agent-framework-proof' },
      { label: 'Read the control essay', href: '/blog/ai-agents-need-gates-not-vibes/' },
    ],
  },
  {
    badge: 'Prototype proof',
    title: 'AI Financial Advice Review Layer',
    problem: 'AI-generated finance answers can sound complete before their claims are checked.',
    input: 'Sample client question plus AI-generated answer.',
    output: 'Claim table, missing-source flags, suitability concerns, human-review trigger, and evidence packet.',
    metric: 'Static proof in progress; interactive demo comes later.',
    boundary: 'Educational prototype — not financial, tax, legal, investment, or compliance advice.',
    links: [
      { label: 'Evidence checklist', href: '/blog/ai-hallucination-evidence-checklist-finance/' },
      { label: 'Contact about this proof', href: 'https://ca.linkedin.com/in/himanshu-h-a357684a' },
    ],
  },
];

const writing = [
  ['AI agents need gates, not vibes', '/blog/ai-agents-need-gates-not-vibes/'],
  ['AI Hallucination Evidence Checklist for Finance Teams', '/blog/ai-hallucination-evidence-checklist-finance/'],
  ['Human-in-loop agent payments', '/blog/human-in-loop-agent-payments/'],
  ['Agent graveyard', '/blog/agent-graveyard/'],
  ['Wallet risk notes', '/blog/wallet-risk-notes/'],
  ["What Claude can't do for KYC", '/blog/what-claude-cant-do-for-kyc/'],
];
---

<BaseLayout
  title="Work"
  description="Himanshu builds governed AI systems for finance: AML workflows, model-risk checks, agent audit trails, and evidence packets."
>
  <main class="work-shell">
    <section class="work-hero" aria-label="Work with Himanshu">
      <div class="hero-copy">
        <div class="eyebrow">Work with Himanshu</div>
        <h1>I build governed AI systems for finance.</h1>
        <p class="lede">Bionic Banker is a public lab for AI finance controls: source trails, model-risk checks, AML workflows, agent governance, and human review.</p>
        <p class="positioning">Himanshu · Canadian banking · AI governance, AML triage, agent controls · Python, LangGraph, FastAPI</p>
        <div class="hero-actions">
          <a class="btn-primary" href="#proof">View proof</a>
          <a class="btn-ghost" href="https://ca.linkedin.com/in/himanshu-h-a357684a" target="_blank" rel="noopener">Contact</a>
        </div>
      </div>
      <aside class="identity-card" aria-label="Identity and collaboration fit">
        <strong>Regulated banking + AI governance builder</strong>
        <p>Focused on wealthtech trust, AML/compliance automation, model-risk checks, and evidence trails for AI-assisted financial workflows.</p>
        <div class="identity-links">
          <a href="https://ca.linkedin.com/in/himanshu-h-a357684a" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://github.com/hash02" target="_blank" rel="noopener">GitHub</a>
          <a href="/about/">About</a>
        </div>
      </aside>
    </section>

    <section class="proof-section" id="proof" aria-label="Proof artifacts">
      <div class="section-head">
        <span>Proof</span>
        <h2>Three artifacts, not the whole maze.</h2>
        <p>Each proof shows input, output, boundary, and where to inspect the work. The deeper archive stays available after this first path is clear.</p>
      </div>
      <div class="proof-grid">
        {proofs.map((proof) => (
          <article class="proof-card">
            <div class="card-badge">{proof.badge}</div>
            <h3>{proof.title}</h3>
            <p class="problem">{proof.problem}</p>
            <dl>
              <div><dt>Input</dt><dd>{proof.input}</dd></div>
              <div><dt>Output</dt><dd>{proof.output}</dd></div>
              <div><dt>Metric</dt><dd>{proof.metric}</dd></div>
            </dl>
            <p class="boundary"><strong>Boundary:</strong> {proof.boundary}</p>
            <div class="card-links">
              {proof.links.map((link) => (
                <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener' : undefined}>{link.label}</a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="work-lanes" aria-label="Ways to work together">
      <div>
        <span>Fit</span>
        <h2>Where this work is useful.</h2>
      </div>
      <div class="lane-grid">
        <article><h3>Hire</h3><p>AI governance, model risk, AML automation, client-trust AI, and wealthtech product/risk roles.</p></article>
        <article><h3>Collaborate</h3><p>Fintech, RegTech, agent-control, AML, model-evaluation, and finance workflow prototypes.</p></article>
        <article><h3>Builder peer</h3><p>Source trails, evidence packets, evals, observability, and human-review patterns for regulated AI.</p></article>
      </div>
    </section>

    <section class="writing-section" aria-label="Best writing">
      <div class="section-head compact">
        <span>Best writing</span>
        <h2>Start with these six pieces.</h2>
        <a href="/articles/">Open archive →</a>
      </div>
      <div class="writing-list">
        {writing.map(([title, href]) => <a href={href}>{title}<em>Read →</em></a>)}
      </div>
    </section>

    <section class="contact-panel" aria-label="Contact and boundaries">
      <div>
        <span>Boundary</span>
        <h2>Public proof, not private data.</h2>
        <p>This work uses public, synthetic, or educational material. It does not expose employer data, client records, internal instructions, or production credentials. Nothing here is legal, tax, trading, investment, or compliance advice.</p>
      </div>
      <a class="btn-primary" href="https://ca.linkedin.com/in/himanshu-h-a357684a" target="_blank" rel="noopener">Reach out on LinkedIn</a>
    </section>
  </main>
</BaseLayout>

<style>
  .work-shell { max-width: 1180px; margin: 0 auto; padding: 6rem 1.25rem 4rem; color: var(--text); }
  .work-hero { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(300px, .75fr); gap: 1rem; align-items: stretch; }
  .work-hero, .proof-section, .work-lanes, .writing-section, .contact-panel { margin-bottom: 1rem; }
  .hero-copy, .identity-card, .proof-section, .work-lanes, .writing-section, .contact-panel { border: 1px solid rgba(31,160,104,.16); background: linear-gradient(135deg, rgba(3,16,8,.96), rgba(1,7,4,.94)); border-radius: 26px; box-shadow: 0 24px 80px rgba(0,0,0,.28); }
  .hero-copy { padding: clamp(1.5rem, 4vw, 3.2rem); }
  .identity-card { padding: clamp(1.25rem, 3vw, 2rem); display: flex; flex-direction: column; justify-content: flex-end; }
  .eyebrow, .section-head span, .work-lanes span, .contact-panel span { color: #1fa068; text-transform: uppercase; letter-spacing: .16em; font-size: .76rem; font-weight: 900; }
  h1 { font-size: clamp(2.45rem, 7vw, 5.8rem); line-height: .93; max-width: 880px; margin: .75rem 0 1rem; }
  h2 { font-size: clamp(1.65rem, 3vw, 2.8rem); line-height: 1; margin: .45rem 0 .7rem; }
  h3 { margin: 0 0 .5rem; font-size: 1.18rem; }
  .lede { max-width: 760px; color: #dcefe5; font-size: clamp(1.05rem, 2vw, 1.28rem); line-height: 1.6; }
  .positioning { color: #87d9ae; font-weight: 800; margin-top: 1rem; }
  .hero-actions, .identity-links, .card-links { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.2rem; }
  .btn-primary, .btn-ghost, .identity-links a, .card-links a { text-decoration: none; border-radius: 999px; padding: .78rem 1rem; font-weight: 900; }
  .btn-primary { background: #1fa068; color: #010302; }
  .btn-ghost, .identity-links a, .card-links a { border: 1px solid rgba(31,160,104,.28); color: var(--text); }
  .identity-card strong { display: block; font-size: 1.35rem; margin-bottom: .75rem; }
  .identity-card p, .section-head p, .proof-card p, .proof-card dd, .lane-grid p, .contact-panel p { color: #b9c8bf; line-height: 1.65; }
  .proof-section, .work-lanes, .writing-section, .contact-panel { padding: clamp(1.25rem, 3vw, 2.2rem); }
  .section-head { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .section-head p { max-width: 660px; margin: .3rem 0 0; }
  .section-head.compact a { color: #7cffb6; font-weight: 900; text-decoration: none; }
  .proof-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .85rem; }
  .proof-card { border: 1px solid rgba(31,160,104,.16); background: rgba(31,160,104,.045); border-radius: 20px; padding: 1rem; }
  .proof-card:first-child { border-color: rgba(124,255,182,.5); background: rgba(31,160,104,.08); }
  .card-badge { display: inline-flex; margin-bottom: .85rem; color: #010302; background: #7cffb6; font-size: .72rem; font-weight: 1000; text-transform: uppercase; letter-spacing: .12em; padding: .35rem .55rem; border-radius: 999px; }
  .problem { color: #e7fff0 !important; font-weight: 800; }
  dl { margin: .85rem 0; display: grid; gap: .55rem; }
  dt { color: #1fa068; font-size: .72rem; text-transform: uppercase; letter-spacing: .12em; font-weight: 1000; }
  dd { margin: .1rem 0 0; }
  .boundary { border-top: 1px solid rgba(31,160,104,.16); padding-top: .85rem; }
  .boundary strong { color: #f2fff7; }
  .lane-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .85rem; margin-top: 1rem; }
  .lane-grid article { border: 1px solid rgba(31,160,104,.16); border-radius: 18px; padding: 1rem; background: rgba(1,7,4,.65); }
  .writing-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .7rem; }
  .writing-list a { display: flex; justify-content: space-between; gap: 1rem; border: 1px solid rgba(31,160,104,.14); border-radius: 16px; padding: .85rem 1rem; color: var(--text); text-decoration: none; background: rgba(1,7,4,.6); font-weight: 800; }
  .writing-list em { color: #7cffb6; font-style: normal; white-space: nowrap; }
  .contact-panel { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .contact-panel p { max-width: 760px; }
  @media (max-width: 900px) {
    .work-shell { padding-top: 4.5rem; }
    .work-hero, .proof-grid, .lane-grid, .writing-list, .contact-panel { grid-template-columns: 1fr; display: grid; }
    .contact-panel { align-items: start; }
    .section-head { display: block; }
  }
</style>
