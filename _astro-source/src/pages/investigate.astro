---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="NEXUS-RISK | Investigate Any Wallet" description="Paste an Ethereum wallet address for a public risk-screening demonstration. Sample wallets show preloaded risk narratives and unknown wallets return sample-mode output.">

<div class="investigate-wrap">

    <div class="raksha-badge">NEXUS-RISK | Wallet Investigator</div>

    <h1>Investigate Any <span>Wallet</span></h1>
    <p class="investigate-sub">
      Paste an Ethereum address. Sample and demonstration-mode risk signals are shown with clear boundaries.
      The result shows risk signals, supporting context, and assessment limits.
    </p>

    <div class="input-group">
      <input type="text" class="address-input" id="walletInput"
             placeholder="0x742d35Cc6634C0532925a3b844Bc9e7595f2bD28"
             spellcheck="false" autocomplete="off" />
      <button class="investigate-btn" id="investigateBtn" onclick="investigate()">
        Investigate
      </button>
    </div>

    <div class="input-hint">
      <span>Or try:</span>
      <button class="sample-btn" onclick="runSample()">Run Sample (Lazarus Group)</button>
      <button class="sample-btn" onclick="fillExample('0x098B716B8Aaf21512996dC57EB0615e2383E2f96')">Ronin Exploiter</button>
      <button class="sample-btn" onclick="fillExample('0x0836222F2B2B24A3F36f98668Ed8F0B38D1a872f')">Tornado Cash</button>
    </div>

    <!-- Scanning State -->
    <div class="scan-container" id="scanContainer">
      <div class="scan-spinner"></div>
      <div class="scan-text" id="scanText">Fetching blockchain data...</div>
      <div class="scan-sub">This may take 30-60 seconds for live addresses</div>
    </div>

    <!-- Error State -->
    <div class="error-box" id="errorBox">
      <p id="errorText"></p>
    </div>

    <!-- Results -->
    <div class="results" id="results">

      <div class="result-header">
        <div>
          <div class="result-address" id="resultAddress"></div>
          <div class="risk-badge" id="riskScore"></div>
          <div class="risk-label" id="riskLevel"></div>
        </div>
      </div>

      <!-- Assessment note -->
      <div class="risk-note-card">
        <div class="risk-note-label">Risk assessment note</div>
        <p class="risk-note-text" id="riskNoteText"></p>
      </div>

      <!-- Stats -->
      <div class="stats-row" id="statsRow"></div>

      <!-- Signals -->
      <div class="signals-section" id="signalsSection">
        <div class="signals-title">Triggered Signals</div>
        <div class="signals-grid" id="signalsGrid"></div>
      </div>

      <!-- Risk Distribution -->
      <div class="signals-section" id="distSection">
        <div class="signals-title">Risk Distribution</div>
        <div id="distContainer"></div>
      </div>

      <!-- Engine info -->
      <div class="engine-info">
        <span class="engine-label" id="engineLabel"></span>
        <span class="engine-label" id="elapsedLabel"></span>
      </div>
    </div>

  </div>

  

  <script is:inline>
    // SAMPLE DATA: demonstrates engine output without live backend
    var SAMPLE_DATA = {
      'lazarus': {
        address: '0x098B716B8Aaf21512996dC57EB0615e2383E2f96',
        risk_score: 97,
        risk_level: 'CRITICAL',
        risk_note: "This sample wallet is associated with high-risk indicators including Lazarus Group attribution, state-sponsored laundering patterns, mixer exposure, bridge exploit activity, and multi-hop layering. The result should be treated as a reason for enhanced review, not as a legal conclusion.",
        tx_count: 847,
        flagged_count: 312,
        total_volume: 625000000,
        avg_risk_score: 89,
        signals: ['OFAC Sanctioned Entity', 'Tornado Cash Interaction', 'Bridge Exploit Pattern', 'Rapid Layering (6+ hops)', 'Mixer Activity Detected', 'State-Sponsored Threat Actor', 'Cross-Chain Laundering', 'Structuring Pattern', 'Dormant to Active Spike'],
        risk_distribution: { CRITICAL: 8, HIGH: 5, MEDIUM: 3, LOW: 1 },
        engine: 'AML Detection Engine v12, 28 rules',
        elapsed: 2.4
      },
      'ronin': {
        address: '0x098B716B8Aaf21512996dC57EB0615e2383E2f96',
        risk_score: 94,
        risk_level: 'CRITICAL',
        risk_note: "This sample is associated with the Ronin Bridge exploit and high-value fund dispersal. The pattern shows rapid movement through intermediary wallets and should be reviewed as a critical-risk exposure scenario.",
        tx_count: 1203,
        flagged_count: 456,
        total_volume: 625000000,
        avg_risk_score: 85,
        signals: ['Bridge Exploit: Ronin', 'OFAC Sanctioned', 'Rapid Fund Dispersal', 'Tornado Cash (Multiple)', 'Cross-Chain Movement', 'Wash Trading Pattern', 'High-Value Single Transaction'],
        risk_distribution: { CRITICAL: 6, HIGH: 7, MEDIUM: 4, LOW: 2 },
        engine: 'AML Detection Engine v12, 28 rules',
        elapsed: 3.1
      },
      'tornado': {
        address: '0x0836222F2B2B24A3F36f98668Ed8F0B38D1a872f',
        risk_score: 91,
        risk_level: 'CRITICAL',
        risk_note: "This sample references a Tornado Cash router contract with sanctions exposure and mixer-related activity. The pattern indicates privacy-protocol interaction and should be treated as a critical-risk screening signal.",
        tx_count: 28450,
        flagged_count: 28450,
        total_volume: 7800000000,
        avg_risk_score: 91,
        signals: ['OFAC Sanctioned Contract', 'Mixer: Primary', 'Privacy Protocol', 'High Throughput Laundering', 'Cross-Protocol Deposits'],
        risk_distribution: { CRITICAL: 12, HIGH: 3, MEDIUM: 1, LOW: 0 },
        engine: 'AML Detection Engine v12, 28 rules',
        elapsed: 1.8
      }
    };

    var scanSteps = [
      'Fetching blockchain transactions...',
      'Running 28 AML detection rules...',
      'Analyzing transaction patterns...',
      'Cross-referencing OFAC sanctions...',
      'Detecting mixer & bridge activity...',
      'Scoring risk profile...',
      'Generating risk assessment...',
    ];

    var scanInterval = null;

    function showScan() {
      document.getElementById('scanContainer').classList.add('active');
      document.getElementById('results').classList.remove('active');
      document.getElementById('errorBox').classList.remove('active');
      document.getElementById('investigateBtn').disabled = true;

      var step = 0;
      document.getElementById('scanText').textContent = scanSteps[0];
      scanInterval = setInterval(function() {
        step = (step + 1) % scanSteps.length;
        document.getElementById('scanText').textContent = scanSteps[step];
      }, 1500);
    }

    function hideScan() {
      document.getElementById('scanContainer').classList.remove('active');
      document.getElementById('investigateBtn').disabled = false;
      if (scanInterval) clearInterval(scanInterval);
    }

    function showError(msg) {
      hideScan();
      var box = document.getElementById('errorBox');
      document.getElementById('errorText').textContent = msg;
      box.classList.add('active');
    }

    function fillExample(addr) {
      document.getElementById('walletInput').value = addr;
    }

    function riskClass(level) {
      return (level || '').toLowerCase().replace(/\s/g, '');
    }

    function riskColor(level) {
      var map = { CRITICAL: '#ef4444', HIGH: '#f97316', MEDIUM: '#eab308', LOW: '#1fa068' };
      return map[level] || '#c8c8d8';
    }

    function formatVolume(v) {
      if (v >= 1e9) return '$' + (v / 1e9).toFixed(1) + 'B';
      if (v >= 1e6) return '$' + (v / 1e6).toFixed(1) + 'M';
      if (v >= 1e3) return '$' + (v / 1e3).toFixed(1) + 'K';
      return '$' + v.toFixed(2);
    }

    function dangerSignals(name) {
      var danger = ['OFAC', 'Sanction', 'Mixer', 'Tornado', 'Layering', 'Wash', 'Exploit', 'State-Sponsored', 'Laundering'];
      var warn = ['Jurisdiction', 'Smurfing', 'Structuring', 'Dormant', 'Cross-Chain', 'Dispersal', 'High-Value'];
      if (danger.some(function(d) { return name.includes(d); })) return 'danger';
      if (warn.some(function(w) { return name.includes(w); })) return 'warning';
      return '';
    }

    function renderResults(data) {
      hideScan();
      var r = document.getElementById('results');
      r.classList.add('active');

      document.getElementById('resultAddress').textContent = data.address;

      var cls = riskClass(data.risk_level);
      document.getElementById('riskScore').textContent = data.risk_score + '/100';
      document.getElementById('riskScore').className = 'risk-badge ' + cls;
      document.getElementById('riskLevel').textContent = data.risk_level;
      document.getElementById('riskLevel').className = 'risk-label ' + cls;

      document.getElementById('riskNoteText').textContent = data.risk_note;

      var stats = [
        { label: 'Transactions', value: data.tx_count },
        { label: 'Flagged', value: data.flagged_count },
        { label: 'Total Volume', value: formatVolume(data.total_volume || 0) },
        { label: 'Avg Risk', value: (data.avg_risk_score || data.risk_score) + '' },
      ];
      document.getElementById('statsRow').innerHTML = stats.map(function(s) {
        return '<div class="stat-card"><div class="stat-label">' + s.label + '</div><div class="stat-value">' + s.value + '</div></div>';
      }).join('');

      var grid = document.getElementById('signalsGrid');
      if (data.signals && data.signals.length > 0) {
        document.getElementById('signalsSection').style.display = 'block';
        grid.innerHTML = data.signals.map(function(s) {
          return '<span class="signal-pill ' + dangerSignals(s) + '">' + s + '</span>';
        }).join('');
      } else {
        document.getElementById('signalsSection').style.display = 'none';
      }

      var dist = data.risk_distribution || {};
      var distContainer = document.getElementById('distContainer');
      var levels = ['CRITICAL', 'HIGH', 'MEDIUM', 'LOW'];
      var maxCount = Math.max.apply(null, levels.map(function(l) { return dist[l] || 0; }).concat([1]));

      if (Object.keys(dist).length > 0) {
        document.getElementById('distSection').style.display = 'block';
        distContainer.innerHTML = levels.filter(function(l) { return (dist[l] || 0) > 0; }).map(function(l) {
          var count = dist[l] || 0;
          var pct = Math.round((count / maxCount) * 100);
          var color = riskColor(l);
          return '<div class="dist-row"><span class="dist-label" style="color:' + color + '">' + l + '</span><div class="dist-bar-bg"><div class="dist-bar" style="width:' + pct + '%;background:' + color + '"></div></div><span class="dist-count">' + count + '</span></div>';
        }).join('');
      } else {
        document.getElementById('distSection').style.display = 'none';
      }

      document.getElementById('engineLabel').textContent = data.engine || 'AML Detection Engine v12, 28 rules';
      document.getElementById('elapsedLabel').textContent = 'Completed in ' + data.elapsed + 's';
    }

    function runSample() {
      showScan();
      setTimeout(function() {
        renderResults(SAMPLE_DATA.lazarus);
      }, 5000);
    }

    function investigate() {
      var address = document.getElementById('walletInput').value.trim();
      if (!address) {
        showError('Paste an Ethereum address to investigate.');
        return;
      }
      if (!address.startsWith('0x') || address.length !== 42) {
        showError('Invalid Ethereum address. Must start with 0x and be 42 characters.');
        return;
      }

      showScan();

      // Check if it matches a known sample address
      if (address === '0x098B716B8Aaf21512996dC57EB0615e2383E2f96') {
        setTimeout(function() { renderResults(SAMPLE_DATA.ronin); }, 4500);
        return;
      }
      if (address === '0x0836222F2B2B24A3F36f98668Ed8F0B38D1a872f') {
        setTimeout(function() { renderResults(SAMPLE_DATA.tornado); }, 4000);
        return;
      }

      // For unknown addresses, generate a demonstration result
      setTimeout(function() {
        var score = 15 + Math.floor(Math.random() * 40);
        var level = score > 60 ? 'HIGH' : score > 35 ? 'MEDIUM' : 'LOW';
        renderResults({
          address: address,
          risk_score: score,
          risk_level: level,
          risk_note: "This address does not match the sample threat-actor patterns in this demonstration dataset. Transaction volume is moderate, no mixer interactions are detected, and the visible behavioral indicators are low risk for this sample view.",
          tx_count: 50 + Math.floor(Math.random() * 500),
          flagged_count: Math.floor(Math.random() * 5),
          total_volume: 1000 + Math.random() * 500000,
          avg_risk_score: score,
          signals: score > 35 ? ['Moderate Activity Volume', 'Multiple Counterparties'] : ['Low Activity'],
          risk_distribution: score > 35 ? { MEDIUM: 2, LOW: 4 } : { LOW: 3 },
          engine: 'AML Detection Engine v12, 28 rules (Demonstration)',
          elapsed: (2 + Math.random() * 3).toFixed(1)
        });
      }, 5000);
    }

    document.getElementById('walletInput').addEventListener('keydown', function(e) {
      if (e.key === 'Enter') investigate();
    });
  </script>

<style>

    /* ── NEXUS-RISK Page-Specific Styles ── */
    .investigate-wrap {
      max-width: 800px;
      margin: 0 auto;
      padding: 3rem 2rem 5rem;
    }

    .raksha-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--mono);
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent);
      border: 1px solid var(--accent-border);
      border-radius: 999px;
      padding: 0.3rem 1rem;
      margin-bottom: 1.5rem;
    }
    .raksha-badge::before {
      content: '';
      width: 6px; height: 6px;
      background: var(--accent);
      border-radius: 50%;
      box-shadow: 0 0 10px rgba(31,160,104,0.6);
      animation: pulse-dot 2s ease-in-out infinite;
    }
    @keyframes pulse-dot {
      0%, 100% { opacity: 1; box-shadow: 0 0 10px rgba(31,160,104,0.6); }
      50% { opacity: 0.5; box-shadow: 0 0 20px rgba(31,160,104,0.3); }
    }

    .investigate-wrap h1 {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-size: clamp(2rem, 4vw, 2.8rem);
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 1.1;
      color: #fff;
      margin-bottom: 0.75rem;
      text-shadow: 0 0 60px rgba(31,160,104,0.12);
    }
    .investigate-wrap h1 span { color: var(--accent); }

    .investigate-sub {
      font-size: 1rem;
      color: #c8c8d8;
      line-height: 1.7;
      margin-bottom: 2.5rem;
      max-width: 600px;
    }

    /* ── Input Area ── */
    .input-group {
      display: flex;
      gap: 0.75rem;
      margin-bottom: 1rem;
      align-items: stretch;
    }
    .address-input {
      flex: 1;
      background: var(--bg2);
      border: 1px solid var(--b2);
      border-radius: 10px;
      padding: 0.85rem 1.2rem;
      color: #fff;
      font-family: var(--mono);
      font-size: 0.88rem;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .address-input::placeholder { color: rgba(255,255,255,0.25); }
    .address-input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 20px rgba(31,160,104,0.1);
    }

    .investigate-btn {
      background: var(--accent);
      color: #fff;
      font-family: var(--mono);
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 0.85rem 1.8rem;
      border-radius: 10px;
      border: none;
      cursor: pointer;
      transition: opacity 0.2s, box-shadow 0.2s, transform 0.15s;
      white-space: nowrap;
    }
    .investigate-btn:hover:not(:disabled) {
      opacity: 0.9;
      box-shadow: 0 0 25px rgba(31,160,104,0.3);
      transform: translateY(-1px);
    }
    .investigate-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .sample-btn {
      background: transparent;
      border: 1px solid var(--b2);
      color: #c8c8d8;
      font-family: var(--mono);
      font-size: 0.72rem;
      font-weight: 500;
      padding: 0.5rem 1rem;
      border-radius: 8px;
      cursor: pointer;
      transition: border-color 0.2s, color 0.2s;
    }
    .sample-btn:hover { border-color: var(--accent); color: var(--accent); }

    .input-hint {
      font-family: var(--mono);
      font-size: 0.68rem;
      color: rgba(255,255,255,0.35);
      margin-bottom: 2rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    /* ── Scanning Animation ── */
    .scan-container {
      display: none;
      background: var(--bg2);
      border: 1px solid var(--b2);
      border-radius: 14px;
      padding: 2.5rem;
      text-align: center;
      margin-bottom: 2rem;
    }
    .scan-container.active { display: block; }

    .scan-spinner {
      width: 48px; height: 48px;
      border: 3px solid var(--b2);
      border-top: 3px solid var(--accent);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin: 0 auto 1.2rem;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    .scan-text {
      font-family: var(--mono);
      font-size: 0.78rem;
      color: var(--accent);
      letter-spacing: 0.06em;
    }
    .scan-sub {
      font-size: 0.75rem;
      color: rgba(255,255,255,0.4);
      margin-top: 0.5rem;
    }

    /* ── Results ── */
    .results { display: none; }
    .results.active { display: block; }

    .result-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1.5rem;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
    }

    .risk-badge {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-size: 3.2rem;
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 1;
    }
    .risk-badge.critical { color: #ef4444; text-shadow: 0 0 40px rgba(239,68,68,0.3); }
    .risk-badge.high { color: #f97316; text-shadow: 0 0 40px rgba(249,115,22,0.3); }
    .risk-badge.medium { color: #eab308; text-shadow: 0 0 40px rgba(234,179,8,0.3); }
    .risk-badge.low { color: var(--accent); text-shadow: 0 0 40px rgba(31,160,104,0.3); }

    .risk-label {
      font-family: var(--mono);
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-top: 0.3rem;
    }
    .risk-label.critical { color: #ef4444; }
    .risk-label.high { color: #f97316; }
    .risk-label.medium { color: #eab308; }
    .risk-label.low { color: var(--accent); }

    .result-address {
      font-family: var(--mono);
      font-size: 0.72rem;
      color: rgba(255,255,255,0.5);
      word-break: break-all;
      margin-bottom: 0.3rem;
    }

    /* Stats row */
    .stats-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }
    .stat-card {
      background: var(--bg2);
      border: 1px solid var(--b1);
      border-radius: 10px;
      padding: 1rem 1.1rem;
    }
    .stat-label {
      font-family: var(--mono);
      font-size: 0.6rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 0.3rem;
    }
    .stat-value {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-size: 1.4rem;
      font-weight: 700;
      color: #fff;
      letter-spacing: -0.02em;
    }

    /* Assessment note card */
    .risk-note-card {
      background: var(--bg2);
      border: 1px solid var(--accent-border);
      border-radius: 14px;
      padding: 1.75rem;
      margin-bottom: 1.5rem;
      position: relative;
      overflow: hidden;
    }
    .risk-note-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--accent), transparent);
    }
    .risk-note-label {
      font-family: var(--mono);
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 0.75rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .risk-note-text {
      font-size: 1.05rem;
      color: #e4e4ec;
      line-height: 1.75;
      font-style: italic;
    }

    /* Signals grid */
    .signals-section {
      margin-bottom: 1.5rem;
    }
    .signals-title {
      font-family: var(--mono);
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 0.75rem;
    }
    .signals-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }
    .signal-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      font-family: var(--mono);
      font-size: 0.68rem;
      font-weight: 500;
      color: #e4e4ec;
      background: rgba(31,160,104,0.06);
      border: 1px solid rgba(31,160,104,0.18);
      border-radius: 6px;
      padding: 0.35rem 0.7rem;
    }
    .signal-pill.danger {
      color: var(--accent);
      background: rgba(31,160,104,0.06);
      border-color: rgba(31,160,104,0.22);
    }
    .signal-pill.warning {
      color: var(--accent);
      background: rgba(31,160,104,0.06);
      border-color: rgba(31,160,104,0.15);
    }

    /* Risk distribution */
    .dist-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.6rem;
    }
    .dist-label {
      font-family: var(--mono);
      font-size: 0.7rem;
      font-weight: 600;
      width: 70px;
      flex-shrink: 0;
    }
    .dist-bar-bg {
      flex: 1;
      height: 8px;
      background: var(--bg3);
      border-radius: 4px;
      overflow: hidden;
    }
    .dist-bar {
      height: 100%;
      border-radius: 4px;
      transition: width 0.8s ease;
    }
    .dist-count {
      font-family: var(--mono);
      font-size: 0.72rem;
      color: #c8c8d8;
      width: 30px;
      text-align: right;
    }

    /* Engine info */
    .engine-info {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--b1);
      margin-top: 2rem;
    }
    .engine-label {
      font-family: var(--mono);
      font-size: 0.65rem;
      color: rgba(255,255,255,0.35);
      letter-spacing: 0.04em;
    }

    /* Error state */
    .error-box {
      display: none;
      background: rgba(31,160,104,0.06);
      border: 1px solid rgba(31,160,104,0.2);
      border-radius: 10px;
      padding: 1.25rem;
      margin-bottom: 1.5rem;
    }
    .error-box.active { display: block; }
    .error-box p {
