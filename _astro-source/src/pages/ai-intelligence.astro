---
import BaseLayout from '../layouts/BaseLayout.astro';

const visualMap = await import('../../public/dashboard-data/visual-learning-map.json');
const learningLanes = visualMap.default.learning_lanes;
const infographicBacklog = visualMap.default.infographic_backlog;

const intelligenceCards = [
  {
    label: 'Agents',
    title: 'Agents are becoming operating layers',
    body: 'The useful question is not whether an agent sounds smart. The question is what it can touch, what it records, and when it stops for a person.',
    href: '/learn#agent'
  },
  {
    label: 'Tools',
    title: 'Tools change the shape of work',
    body: 'Hermes, LangGraph, local models, notebooks, and browser agents are not just software names. They are new ways to turn thought into repeatable work.',
    href: '/learn#tool-calling'
  },
  {
    label: 'Finance risk',
    title: 'Risk needs records, not mood',
    body: 'Wallet scores, AML status, fraud alerts, and market signals only matter when the source trail stays visible and the human limit is clear.',
    href: '/risk-evidence-overview'
  },
  {
    label: 'Publishing loop',
    title: 'Learning becomes content',
    body: 'When a new tool matters, the site can turn it into a report: what it is, why it matters, how we tested it, and what we are not claiming.',
    href: '/articles'
  }
];

const watchList = [
  'Agent browsers and computer-use tools',
  'Local agent operating systems',
  'RegTech and wallet intelligence workflows',
  'AI coding agents with traceable output',
  '3D and animated explanation layers for public learning'
];

const collaborationLoop = [
  { step: 'Hash brings the world', text: 'Physical-world context, finance work, public signals, user frustration, and the messy questions that matter.' },
  { step: 'Agent Her makes the map', text: 'Turn that context into sharper questions, safer boundaries, pages, checkers, and small experiments.' },
  { step: 'The site keeps score', text: 'Useful patterns become apps, reports, or deterministic gates. Weak claims stay out.' },
  { step: 'Both level up', text: 'Hash improves clarity and judgment. Agent Her improves the operating layer, memory, and public packaging.' }
];
---
<BaseLayout title="AI Intelligence" description="Bionic Banker AI intelligence map: agents, tools, finance-risk workflows, and reports for what comes next.">
  <div class="page-header">
    <div class="page-label">AI Intelligence</div>
    <h1 class="page-title">What Agent Her is watching</h1>
    <p class="page-sub">A public map for agents, tools, AI finance workflows, and the learning loop behind Bionic Banker. Not a news feed. A filter for what may change the work and what deserves a real test.</p>
  </div>

  <main class="articles-wrap ai-intel-wrap">
    <section class="systems-audit-panel" aria-label="AI intelligence rule">
      <div>
        <span class="systems-audit-label">Rule</span>
        <strong>Every new tool has to earn a clear report.</strong>
      </div>
      <p>If a technology changes how we build, review, automate, or explain finance-risk systems, it becomes a candidate for a blog post, app improvement, or experiment. Hype is not enough. It has to help produce evidence, judgment, or a better boundary.</p>
    </section>

    <div class="articles-grid stagger-children">
      {intelligenceCards.map((card) => (
        <a href={card.href} class="article-card animate-on-scroll">
          <div class="article-tags"><span class="tag-pill tag-green">{card.label}</span></div>
          <h3>{card.title}</h3>
          <p>{card.body}</p>
          <div class="card-footer"><span class="read-more">Open path</span></div>
        </a>
      ))}
    </div>

    <section class="article-card systems-guide-card" style="margin-top: 1.25rem;">
      <div class="article-tags"><span class="tag-pill tag-green">Symbiosis loop</span></div>
      <h3>How Hash and Agent Her watch the AI world</h3>
      <div class="system-proof-grid">
        {collaborationLoop.map((item) => (
          <div>
            <span>{item.step}</span>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
      <p class="verified-note">This is the collaboration rule: outside-world signal becomes a question, question becomes a test, test becomes a public summary only when it earns support.</p>
    </section>


    <section class="article-card systems-guide-card" style="margin-top: 1.25rem;" aria-label="Visual learning map">
      <div class="article-tags"><span class="tag-pill tag-green">Visual learning map</span></div>
      <h3>Build the site around cases, countries, mistakes, and diagrams</h3>
      <p>Each new topic should earn the same public shape: real-world question, source trail, system record, missing context, and clear limit. This keeps the site useful for AI finance risk and compliance without turning raw code or raw records into the public lesson.</p>
      <div class="system-proof-grid">
        {learningLanes.map((lane) => (
          <div>
            <span>{lane.label}</span>
            <p><strong>{lane.title}</strong></p>
            <p>{lane.reader_question}</p>
            <p><strong>Visual:</strong> {lane.visual_shape}</p>
            <p><strong>Limit:</strong> {lane.clear_limit}</p>
            <a href={lane.next_surface}>View related page</a>
          </div>
        ))}
      </div>
    </section>

    <section class="article-card systems-guide-card" style="margin-top: 1.25rem;" aria-label="Infographic backlog">
      <div class="article-tags"><span class="tag-pill tag-green">Infographic queue</span></div>
      <h3>The first visuals should explain systems, not decorate them</h3>
      <p>Priority goes to diagrams that make a reader understand what is happening: wallet source trail, context engine, agent controls, and KYC record path.</p>
      <div class="system-link-cloud" aria-label="Infographic backlog">
        {infographicBacklog.map((item) => (
          <a href={item.first_page}>{item.title} · {item.layout}</a>
        ))}
      </div>
      <p class="verified-note">This queue is deliberately bounded: every visual needs a source path, a review question, and a normal sentence saying what the system cannot decide.</p>
    </section>

    <section class="article-card systems-guide-card" style="margin-top: 1.25rem;">
      <div class="article-tags"><span class="tag-pill tag-green">Watchlist</span></div>
      <h3>Things worth tracking now</h3>
      <div class="system-link-cloud" aria-label="AI intelligence watchlist">
        {watchList.map((item) => <span>{item}</span>)}
      </div>
      <p class="verified-note">This page is the learning engine. Signals show what is moving. Blog posts explain what was learned. Apps turn the useful parts into something inspectable.</p>
    </section>
  </main>
</BaseLayout>
