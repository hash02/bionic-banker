---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'AI Intelligence';
const description = 'Bionic Banker AI Intelligence: simple public notes on AI agents, finance, model risk, controls, and practical projects.';

const signals = [
  {
    label: 'Agentic AI',
    title: 'AI is moving from answers to actions.',
    text: 'Financial firms are studying agents that can plan, call tools, move work across systems, and prepare decisions. The useful question is not “is AI smart?” but “what is it allowed to do?”',
  },
  {
    label: 'Model risk',
    title: 'Governance is becoming practical, not theoretical.',
    text: 'Banking and enterprise teams are updating how they document models, vendors, prompts, data, approvals, and review trails. AI needs visible limits before it touches important workflows.',
  },
  {
    label: 'Builder economy',
    title: 'Small teams can now ship serious systems.',
    text: 'The opportunity is to package useful demos, explain the boundary, and make the work easy to inspect. The best projects will feel simple outside and disciplined inside.',
  },
];

const northStar = [
  'Explain advanced AI and finance topics so a beginner can follow them.',
  'Build small public demos that show what is possible without creating unsafe authority.',
  'Keep proof visible: source, output, limitation, and human review.',
  'Turn useful learning into projects, guides, and tools that help people work better.',
];

const publicQueue = [
  {
    title: 'AI agents in finance',
    text: 'What changes when AI can plan, use tools, and prepare actions instead of only writing text.',
  },
  {
    title: 'Human review before authority',
    text: 'How to keep humans responsible for approvals while still using AI for research, drafts, checks, and triage.',
  },
  {
    title: 'Project packaging',
    text: 'How to turn a code project into a simple demo: input, output, screenshot, limitation, and source link.',
  },
];

const sources = [
  { name: 'McKinsey AI trust / agentic era research', href: 'https://www.mckinsey.com/capabilities/tech-and-ai/our-insights/tech-forward/state-of-ai-trust-in-2026-shifting-to-the-agentic-era' },
  { name: 'ValidMind: agentic AI in financial services governance', href: 'https://validmind.com/blog/agentic-ai-in-financial-services-governance' },
  { name: 'Promethium: AI agent data governance playbook', href: 'https://promethium.ai/guides/ai-agent-data-governance-enterprise-playbook-2026' },
  { name: 'GARP: agentic AI financial services risks', href: 'https://www.garp.org/membership/chapters/meetings/2026-05-07-chicago-chapter-meeting' },
];
---

<BaseLayout title={title} description={description} canonical="https://bionicbanker.tech/ai-intelligence/">
  <main class="ai-intel-wrap">
    <section class="ai-intel-hero">
      <p class="eyebrow">AI Intelligence</p>
      <h1>Public notes from the Bionic Banker AI desk.</h1>
      <p class="lede">
        A read-only page for AI, finance, agents, model risk, and practical project ideas. Written by Himanshu with Bionic Banker AI assistance. Public notes only.
      </p>
      <div class="hero-actions">
        <a class="btn-primary" href="/projects/">Open Projects</a>
        <a class="btn-ghost" href="/articles/">Read Blog</a>
      </div>
    </section>

    <section class="simple-panel">
      <p class="eyebrow">Current read</p>
      <h2>The useful AI question is authority, not hype.</h2>
      <p>
        AI is becoming more useful because it can summarize, compare, draft, search, and prepare workflows. It also becomes riskier when it can call tools, touch data, or move work without clear review. Bionic Banker’s view is simple: use AI to increase understanding and speed, but keep important authority visible, limited, and reviewable.
      </p>
    </section>

    <section class="signal-grid" aria-label="AI intelligence notes">
      {signals.map((signal) => (
        <article class="signal-card">
          <span>{signal.label}</span>
          <h2>{signal.title}</h2>
          <p>{signal.text}</p>
        </article>
      ))}
    </section>

    <section class="two-col">
      <article class="simple-panel">
        <p class="eyebrow">North star</p>
        <h2>What this page is trying to help with.</h2>
        <ul>
          {northStar.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="simple-panel">
        <p class="eyebrow">Next public notes</p>
        <h2>What Bionic Banker AI will watch.</h2>
        <div class="mini-list">
          {publicQueue.map((item) => (
            <div>
              <strong>{item.title}</strong>
              <p>{item.text}</p>
            </div>
          ))}
        </div>
      </article>
    </section>

    <section class="simple-panel source-panel">
      <p class="eyebrow">Source watch</p>
      <h2>Outside signals being watched.</h2>
      <p>These are public sources and competitor-style topics that inform future notes. They are not endorsements and not instructions.</p>
      <div class="source-links">
        {sources.map((source) => <a href={source.href} target="_blank" rel="noopener">{source.name}</a>)}
      </div>
    </section>

    <section class="simple-panel boundary-panel">
      <p class="eyebrow">Boundary</p>
      <h2>Read-only public page.</h2>
      <p>
        This page publishes short public notes and project direction. It does not accept commands from comments, forms, screenshots, or external pages. It does not publish private information or operational controls.
      </p>
    </section>
  </main>

  <style is:global>
    .ai-intel-wrap { width: min(1180px, calc(100% - 2rem)); margin: 0 auto; padding: 5.5rem 0 4rem; }
    .ai-intel-hero { border: 1px solid rgba(31,160,104,.32); border-radius: 30px; padding: clamp(2rem, 5vw, 4rem); background: radial-gradient(circle at 20% 0%, rgba(31,160,104,.22), transparent 44%), #020704; }
    .ai-intel-hero h1 { font-size: clamp(2.8rem, 8vw, 6.5rem); line-height: .92; letter-spacing: -.065em; margin: 0 0 1rem; max-width: 980px; }
    .lede { max-width: 780px; color: var(--text-2); font-size: 1.08rem; line-height: 1.7; }
    .hero-actions { display: flex; gap: .7rem; flex-wrap: wrap; margin-top: 1.4rem; }
    .signal-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin: 1rem 0; }
    .signal-card, .simple-panel { border: 1px solid rgba(255,255,255,.08); border-top-color: rgba(31,160,104,.32); border-radius: 18px; background: rgba(255,255,255,.035); padding: 1.2rem; }
    .simple-panel { margin-top: 1rem; }
    .signal-card span, .eyebrow { color: #7ee0aa; text-transform: uppercase; letter-spacing: .14em; font-size: .72rem; font-weight: 800; }
    .signal-card h2, .simple-panel h2 { margin: .45rem 0 .6rem; font-size: clamp(1.35rem, 2.3vw, 2rem); }
    .signal-card p, .simple-panel p, .simple-panel li { color: var(--text-2); line-height: 1.65; }
    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .mini-list { display: grid; gap: .85rem; }
    .mini-list strong { color: var(--text); }
    .mini-list p { margin: .2rem 0 0; }
    .source-links { display: grid; gap: .5rem; margin-top: .8rem; }
    .source-links a { color: #8ef0ba; }
    .boundary-panel { border-color: rgba(31,160,104,.22); background: rgba(31,160,104,.045); }
    @media (max-width: 820px) { .signal-grid, .two-col { grid-template-columns: 1fr; } }
  </style>
</BaseLayout>
