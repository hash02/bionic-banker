---
import BaseLayout from '../layouts/BaseLayout.astro';
import DataRepresentationCard from '../components/DataRepresentationCard.astro';

const proof = await import('../../public/dashboard-data/aml-status-evidence-public.json');
const generatedDate = new Date(proof.default.generated_at).toISOString().slice(0, 10);
const provenance = proof.default.provenance;
const boundary = proof.default.boundary;
const checks = proof.default.checks ?? [];
const claims = proof.default.visible_claims ?? [];
const nextSteps = proof.default.next_steps ?? [];

const proofCards = [
  {
    label: 'Status rule',
    title: 'A status row has to show its work.',
    body: 'The AML status contract only trusts a row when the source, counts, rule coverage, and freshness checks are present.',
    source: provenance.contract_doc,
  },
  {
    label: 'What it cannot do',
    title: 'The planner can prepare a note. It cannot act.',
    body: `Every compliance gate keeps action approval set to ${String(boundary.may_execute)}. In simple words: this can prepare a proposal, but it cannot approve, file, trade, deploy, or execute.`,
    source: provenance.planning_endpoint,
  },
  {
    label: 'Source trail',
    title: 'The record shape comes before the public claim.',
    body: 'Private records keep timestamped snapshots and checksum sidecars; the public page shows only the summary needed to understand the status.',
    source: provenance.local_artifact_pattern,
  },
];
---
<BaseLayout title="AML Status" description="An AML status page for Bionic Banker: what was checked, what stays local, and what the system cannot do.">
  <main class="aml-proof-shell">
    <section class="aml-proof-hero">
      <div>
        <span class="eyebrow">AML Status</span>
        <h1>The status is only useful when a reader can see what was checked and what the system cannot do.</h1>
        <p>
          This page shows an AML status record without turning it into a compliance claim. It explains the rule, the source trail, the planner limit, and the parts that stay local.
        </p>
        <div class="reviewer-callout"><span>What this shows</span><strong>An AML status can be checked and explained without giving the system approval, filing, wallet, trade, or deploy power.</strong></div>
        <div class="proof-actions">
          <a href="#proof-cards">Review supporting records</a>
          <a href="/wallet-risk">Open wallet risk assessment</a>
          <a href="/system-map">View system map</a>
        </div>
      </div>
      <aside class="authority-card" aria-label="AML status limit">
        <span>What it cannot do</span>
        <strong>No outside action</strong>
        <p>No wallet, trade, filing, deploy, or KYC approval power.</p>
        <small>Snapshot: {generatedDate}</small>
      </aside>
    </section>

    <DataRepresentationCard
      signal="An AML-related status is only useful when the checked rule, source trail, and action boundary are visible together."
      source="A redacted public status record, source summary, check categories, and explicit outside-action refusal."
      record="A status snapshot with visible claims, freshness checks, source references, and explicit outside-action refusal."
      missing="Private logs, customer data, employer data, confidential policy, and any real filing or approval context."
      nextQuestion="Which missing field would a human need before treating the status as operationally meaningful?"
      limit="The planner can prepare a proposal record. It cannot approve, file, trade, deploy, enforce, or execute."
    />

    <section class="proof-grid" id="proof-cards">
      {proofCards.map((card) => (
        <article class="proof-card">
          <span>{card.label}</span>
          <h2>{card.title}</h2>
          <p>{card.body}</p>
          <small>{card.source}</small>
        </article>
      ))}
    </section>

    <section class="proof-panel split-panel">
      <div>
        <span class="eyebrow">What is visible</span>
        <h2>Public-safe claims</h2>
        <ul class="proof-list">
          {claims.map((claim) => <li>{claim}</li>)}
        </ul>
      </div>
      <div>
        <span class="eyebrow">What stays bounded</span>
        <h2>Not an execution system</h2>
        <ul class="boundary-list">
          <li>Outside action allowed: {String(boundary.may_execute)}</li>
          <li>KYC approval allowed: {String(boundary.kyc_approval_authority)}</li>
          <li>Wallet or trade movement allowed: {String(boundary.wallet_or_trade_authority)}</li>
          <li>Report filing allowed: {String(boundary.filing_authority)}</li>
          <li>Deployment allowed: {String(boundary.deploy_authority)}</li>
        </ul>
      </div>
    </section>


    <section class="proof-panel" id="public-wallet-source-records">
      <div class="panel-head">
        <span>Public wallet source records</span>
        <h2>Public blockchain watching belongs here only as source context.</h2>
        <p>Popular public wallet addresses can keep the AML learning layer current because public blockchains show movements that people already discuss. The safe version records the public source, movement type, pattern question, and missing context. It does not turn the status page into an accusation, filing decision, trade recommendation, or external submission.</p>
      </div>
      <div class="provenance-grid">
        <article><span>Source</span><strong>Public explorers and public labels only</strong></article>
        <article><span>Record</span><strong>Movement type, timing, size band, direction, and missing context</strong></article>
        <article><span>AML question</span><strong>Does surrounding activity repeat a routing, exchange, bridge, mixer, or consolidation pattern?</strong></article>
        <article><span>Limit</span><strong>No accusation, no KYC approval, no filing, no wallet control, no third-party account actions</strong></article>
      </div>
    </section>

    <section class="proof-panel">
      <div class="panel-head">
        <span>Source trail</span>
        <h2>The record has a source trail. It is not just a claim.</h2>
        <p>Readers can see the public source summary. Private modules, raw commands, local paths, and operational internals stay off the public site.</p>
      </div>
      <div class="provenance-grid">
        <article>
          <span>Contract summary</span>
          <strong>{provenance.contract_doc}</strong>
        </article>
        <article>
          <span>Private module</span>
          <strong>{provenance.contract_module}</strong>
        </article>
        <article>
          <span>Private refresher</span>
          <strong>{provenance.refresher_module}</strong>
        </article>
        <article>
          <span>Record pattern</span>
          <strong>{provenance.local_artifact_pattern}</strong>
        </article>
      </div>
    </section>

    <section class="proof-panel">
      <div class="panel-head">
        <span>Verification records</span>
        <h2>What was checked locally</h2>
        <p>The public page records check categories and results. Raw commands, private paths, and internal module names stay out of the reader-facing page.</p>
      </div>
      <div class="check-list">
        {checks.map((check) => (
          <article>
            <span>{check.label}</span>
            <strong>{check.command}</strong>
            <p>{check.recorded_result}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="proof-panel split-panel">
      <div>
        <span class="eyebrow">Next hardening</span>
        <h2>Where this should get stronger</h2>
        <ul class="proof-list">
          {nextSteps.map((step) => <li>{step}</li>)}
        </ul>
      </div>
      <div>
        <span class="eyebrow">Short version</span>
        <h2>What this means</h2>
        <p>
          The AML status page keeps the simple order: show the source, show the check, show the limit, and do not jump from a local record to a real-world decision.
        </p>
      </div>
    </section>

    <section class="proof-links">
      <a href="/wallet-risk#public-blockchain-watch">
        <span>Wallet Risk Assessment</span>
        <strong>See the public blockchain watch connection</strong>
      </a>
      <a href="/signals#public-wallet-watch">
        <span>Public Wallet Watch</span>
        <strong>Open the public-address signal lane</strong>
      </a>
      <a href="/risk-evidence-overview">
        <span>Risk Review Overview</span>
        <strong>Follow the broader review map</strong>
      </a>
      <a href="/projects">
        <span>Systems</span>
        <strong>Return to the systems index</strong>
      </a>
    </section>
  </main>

  <style>
    .aml-proof-shell {
      width: 100%;
      max-width: var(--max);
      margin: 0 auto;
      padding: 3.5rem 2rem 4rem;
      overflow-x: hidden;
    }

    .aml-proof-shell,
    .aml-proof-shell * {
      box-sizing: border-box;
    }

    .aml-proof-hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(280px, 390px);
      gap: 1.25rem;
      align-items: stretch;
      margin-bottom: 1.25rem;
    }

    .aml-proof-hero > div,
    .authority-card,
    .proof-card,
    .proof-panel,
    .proof-links a {
      border: 1px solid rgba(228, 228, 236, 0.12);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.035);
      max-width: 100%;
      min-width: 0;
    }

    .aml-proof-hero > div {
      padding: clamp(1.5rem, 4vw, 3rem);
    }

    .eyebrow,
    .proof-card span,
    .authority-card span,
    .panel-head span,
    .provenance-grid span,
    .check-list span,
    .proof-links span {
      display: inline-flex;
      color: var(--accent);
      font-size: 0.76rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 0.5rem;
    }

    .aml-proof-hero h1 {
      max-width: 820px;
      margin: 0 0 1rem;
      font-size: clamp(2.4rem, 6vw, 5.8rem);
      line-height: 0.94;
      letter-spacing: -0.05em;
    }

    .aml-proof-hero p,
    .proof-panel p,
    .proof-card p,
    .check-list p {
      color: var(--muted);
      line-height: 1.7;
    }

    .proof-actions,
    .proof-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 1.4rem;
    }

    .proof-actions a,
    .proof-links a {
      color: var(--fg);
      text-decoration: none;
    }

    .proof-actions a {
      border: 1px solid rgba(228, 228, 236, 0.14);
      border-radius: 999px;
      padding: 0.75rem 1rem;
      background: rgba(57, 255, 136, 0.08);
      font-weight: 800;
    }

    .authority-card {
      padding: 1.4rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      background:
        radial-gradient(circle at 70% 20%, rgba(57, 255, 136, 0.16), transparent 36%),
        rgba(31, 160, 104, 0.055);
    }

    .authority-card strong {
      display: block;
      font-size: clamp(1.8rem, 4vw, 2.8rem);
      letter-spacing: -0.04em;
      color: var(--accent);
      margin: 1rem 0;
      overflow-wrap: anywhere;
    }

    .authority-card small,
    .proof-card small {
      color: var(--muted);
      overflow-wrap: anywhere;
    }

    .proof-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .proof-card,
    .proof-panel {
      padding: 1.25rem;
    }

    .proof-card h2,
    .proof-panel h2 {
      margin: 0 0 0.75rem;
      line-height: 1.05;
      letter-spacing: -0.03em;
    }

    .split-panel {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
      margin-bottom: 1rem;
    }

    .proof-list,
    .boundary-list {
      margin: 0;
      padding-left: 1.1rem;
      color: var(--muted);
      line-height: 1.7;
    }

    .boundary-list li::marker,
    .proof-list li::marker {
      color: var(--accent);
    }

    .panel-head {
      max-width: 780px;
      margin-bottom: 1rem;
    }

    .provenance-grid,
    .check-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.85rem;
    }

    .provenance-grid article,
    .check-list article {
      border: 1px solid rgba(228, 228, 236, 0.1);
      border-radius: 8px;
      padding: 1rem;
      background: rgba(0, 0, 0, 0.18);
      min-width: 0;
    }

    .provenance-grid strong,
    .check-list code {
      display: block;
      color: var(--fg);
      overflow-wrap: anywhere;
      line-height: 1.55;
    }

    .check-list code {
      color: var(--accent);
      font-size: 0.84rem;
    }

    .proof-links {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-top: 1rem;
    }

    .proof-links a {
      padding: 1.1rem;
    }

    .proof-links strong {
      display: block;
      line-height: 1.2;
    }

    @media (max-width: 860px) {
      .aml-proof-shell {
        padding: 2rem 1rem 3rem;
      }

      .aml-proof-hero,
      .proof-grid,
      .split-panel,
      .provenance-grid,
      .check-list,
      .proof-links {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>

<style>
  .reviewer-callout { display: grid; gap: .35rem; margin: 1rem 0; padding: .9rem 1rem; border: 1px solid rgba(31,160,104,.22); border-radius: 16px; background: rgba(31,160,104,.06); }
  .reviewer-callout span { color: #1fa068; font-family: monospace; font-size: .68rem; text-transform: uppercase; letter-spacing: .08em; }
  .reviewer-callout strong { color: var(--text); line-height: 1.35; }
</style>
