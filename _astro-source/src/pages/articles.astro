---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const articleCount = allPosts.length;

const sortedPosts = allPosts.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const categories = ['AI Systems', 'Finance Risk', 'Blockchain / DeFi', 'Builder Notes'];
const normalizeCategory = (value = '') => {
  if (['AI', 'Tech'].includes(value)) return 'AI Systems';
  if (value === 'Finance') return 'Finance Risk';
  if (['Blockchain', 'DeFi'].includes(value)) return 'Blockchain / DeFi';
  return 'Builder Notes';
};

const tagColorMap: Record<string, string> = {
  'AI': 'tag-cyan', 'Agents': 'tag-cyan', 'SYOS': 'tag-cyan',
  'Blockchain': 'tag-cyan', 'DeFi': 'tag-cyan', 'AML': 'tag-red',
  'Finance': 'tag-amber', 'Fintech': 'tag-amber', 'Crypto': 'tag-cyan',
  'Tech': 'tag-cyan', 'AI Systems': 'tag-cyan', 'Finance Risk': 'tag-amber', 'Blockchain / DeFi': 'tag-cyan', 'Builder Notes': 'tag-green', 'Thoughts': 'tag-rose', 'Gaming': 'tag-cyan',
  'Nobel Prize': 'tag-amber', 'Physics': 'tag-cyan',
};

const cleanText = (value = '') => value
  .replace(/[\u2013\u2014]/g, '-')
  .replace(/\b[Dd]eep dive\b/g, 'report')
  .replace(/\b[Tt]ransformative\b/g, 'changing')
  .replace(/\b[Rr]obust\b/g, 'steady')
  .replace(/\b[Cc]utting-edge\b/g, 'new')
  .replace(/\b[Bb]est practices\b/g, 'working habits');

const getSlug = (post: typeof sortedPosts[number]) => post.data.slug || post.id;
const featuredSlugs = [
  'agent-governance-flow',
  'wallet-risk-notes',
  'aml-engine',
  'two-agent-finance-operating-system',
];
const featuredPosts = featuredSlugs
  .map((slug) => sortedPosts.find((post) => getSlug(post) === slug))
  .filter(Boolean);

const routeLabels: Record<string, string> = {
  'agent-governance-flow': 'Agent control',
  'wallet-risk-notes': 'Wallet risk',
  'aml-engine': 'AML notes',
  'two-agent-finance-operating-system': 'AI systems',
};

const controlLanes = [
  { label: 'AI security', tone: 'pink', text: 'Prompt injection, agent boundaries, and what should never be trusted blindly.', href: '/blog/ai-prompt-injection-control-failure/' },
  { label: 'Agent controls', tone: 'blue', text: 'Gates, traces, source records, and human review before an agent can act.', href: '/blog/ai-agents-need-gates-not-vibes/' },
  { label: 'Finance risk', tone: 'green', text: 'Wallet, fraud, payment, and AML notes framed as review records, not verdicts.', href: '/blog/wallet-risk-notes/' },
];
---
<BaseLayout title="Blog" description={`${articleCount} blog notes on finance, AI, agents, blockchain, and learning by building.`}>

  <div class="page-header">
    <div class="page-label">Blog</div>
    <h1 class="page-title">Blog notes.</h1>
    <p class="page-sub">{articleCount} notes on AI, finance, crypto, and projects. Search or choose a topic.</p>

    <div class="archive-tools" aria-label="Blog search and filters">
      <label class="search-wrap" for="blog-search">
        <span>Search</span>
        <input id="blog-search" type="search" placeholder="Search AI governance, wallet risk, stablecoins..." autocomplete="off" />
      </label>
      <div class="filter-bar" id="filter-bar">
        <button class="filter-btn active" data-filter="all">All</button>
        {categories.map(cat => (
          <button class="filter-btn" data-filter={cat}>{cat}</button>
        ))}
      </div>
    </div>
  </div>

  <section class="archive-console" aria-label="Bionic Control Desk article map">
    <aside class="archive-rail">
      <span class="rail-dot"></span>
      <strong>control-desk/articles</strong>
      <a href="/ai-models/">AI Models</a>
      <a href="/ai-intelligence/">AI Intelligence</a>
      <a href="/projects/">Projects</a>
      <a href="/signals/">Signals</a>
    </aside>
    <div class="archive-console-main">
      <div class="archive-path"><span>bionic</span><span>source → review → limit → next read</span></div>
      <div class="archive-console-head">
        <div>
          <p class="section-kicker">Bionic Control Desk</p>
          <h2>Read the archive as an intelligence library.</h2>
          <p>Start from a lane, inspect the source trail, and keep the boundary visible. Each note is a review record, not a verdict.</p>
        </div>
        <div class="archive-count"><strong>{articleCount}</strong><span>records</span></div>
      </div>
      <div class="lane-grid">
        {controlLanes.map((lane) => (
          <a class={`lane-card tone-${lane.tone}`} href={lane.href}>
            <span>{lane.label}</span>
            <p>{lane.text}</p>
            <em>Inspect lane →</em>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="articles-wrap">
    <div class="archive-note">
      <p class="section-kicker">Archive</p>
      <p>Newest notes first.</p>
    </div>
    <div class="articles-grid stagger-children" id="articles-grid">
      {sortedPosts.map((post) => (
        <a href={`/blog/${getSlug(post)}/`} class="article-card animate-on-scroll" data-category={normalizeCategory(post.data.category)} data-search={`${post.data.title} ${post.data.description} ${(post.data.tags || []).join(' ')} ${normalizeCategory(post.data.category)}`.toLowerCase()}>
          {post.data.image && (
            <div class="card-thumb">
              <img src={post.data.image} alt={cleanText(post.data.title)} loading="lazy" />
            </div>
          )}
          <div class="article-tags">
            {post.data.tags.slice(0, 3).map((tag: string) => (
              <span class={`tag-pill ${tagColorMap[tag] || 'tag-green'}`}>{tag}</span>
            ))}
          </div>
          <h3>{cleanText(post.data.title)}</h3>
          <p>{cleanText(post.data.description)}</p>
          <div class="card-footer">
            <span class="read-more">Open</span>
            <span class="read-time">{post.data.readTime}</span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <script is:inline>
    var activeFilter = 'all';
    var searchInput = document.getElementById('blog-search');
    function applyArchiveFilters() {
      var query = (searchInput && searchInput.value || '').trim().toLowerCase();
      document.querySelectorAll('.article-card').forEach(function(card) {
        var matchesFilter = activeFilter === 'all' || card.getAttribute('data-category') === activeFilter;
        var matchesSearch = !query || (card.getAttribute('data-search') || '').includes(query);
        card.style.display = matchesFilter && matchesSearch ? '' : 'none';
      });
    }
    document.querySelectorAll('.filter-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.filter-btn').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        activeFilter = btn.getAttribute('data-filter');
        applyArchiveFilters();
      });
    });
    if (searchInput) searchInput.addEventListener('input', applyArchiveFilters);
  </script>
  <style>

    .archive-console {
      position: relative;
      width: min(1180px, calc(100% - 32px));
      margin: -1rem auto 2rem;
      display: grid;
      grid-template-columns: 190px minmax(0, 1fr);
      overflow: hidden;
      border: 1px solid rgba(94, 188, 255, 0.16);
      border-radius: 28px;
      background:
        radial-gradient(circle at 84% 0%, rgba(94,188,255,0.12), transparent 28%),
        radial-gradient(circle at 10% 75%, rgba(31,160,104,0.12), transparent 30%),
        linear-gradient(135deg, rgba(3,18,34,0.92), rgba(1,8,7,0.98));
      box-shadow: 0 28px 90px rgba(0,0,0,0.34), inset 0 1px 0 rgba(255,255,255,0.045);
    }

    .archive-console::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(94,188,255,0.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(94,188,255,0.07) 1px, transparent 1px);
      background-size: 44px 44px;
      opacity: 0.55;
    }

    .archive-rail,
    .archive-console-main {
      position: relative;
      z-index: 1;
    }

    .archive-rail {
      padding: 1rem;
      display: grid;
      align-content: start;
      gap: 0.58rem;
      border-right: 1px solid rgba(94,188,255,0.12);
      background: rgba(2,12,22,0.56);
      font-family: var(--mono);
    }

    .rail-dot {
      width: 11px;
      height: 11px;
      border-radius: 999px;
      background: #2ef29a;
      box-shadow: 0 0 18px rgba(46,242,154,0.55);
    }

    .archive-rail strong {
      color: rgba(246,255,249,0.82);
      font-size: 0.68rem;
      letter-spacing: 0.08em;
      margin: 0.1rem 0 0.45rem;
      overflow-wrap: anywhere;
    }

    .archive-rail a {
      color: rgba(213,237,255,0.68);
      font-size: 0.74rem;
      text-decoration: none;
    }

    .archive-rail a:hover { color: #86ccff; }

    .archive-console-main { padding: 0 1.35rem 1.35rem; }

    .archive-path {
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 0.6rem;
      color: rgba(222,248,229,0.58);
      font-family: var(--mono);
      font-size: 0.68rem;
    }

    .archive-console-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 1rem;
      align-items: start;
      padding: 0.7rem 0 1rem;
    }

    .archive-console-head h2 {
      margin: 0;
      color: var(--text);
      font-size: clamp(2rem, 4.8vw, 4.4rem);
      line-height: 0.94;
      letter-spacing: -0.065em;
      max-width: 850px;
    }

    .archive-console-head p:not(.section-kicker) {
      margin: 0.85rem 0 0;
      color: rgba(222,248,229,0.8);
      line-height: 1.55;
      max-width: 760px;
      font-weight: 650;
    }

    .archive-count {
      display: grid;
      justify-items: end;
      gap: 0.08rem;
      padding-top: 1.8rem;
      font-family: var(--mono);
      color: rgba(213,237,255,0.62);
    }

    .archive-count strong { color: #2ef29a; font-size: 1.55rem; }
    .archive-count span { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; }

    .lane-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .lane-card {
      min-height: 178px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 1rem;
      border: 1px solid rgba(94,188,255,0.18);
      border-radius: 18px;
      background: rgba(255,255,255,0.035);
      color: inherit;
      text-decoration: none;
      transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
    }

    .lane-card:hover,
    .lane-card:focus-visible {
      transform: translateY(-3px);
      border-color: rgba(46,242,154,0.42);
      background: rgba(31,160,104,0.075);
      outline: none;
    }

    .lane-card span {
      color: #86ccff;
      font-family: var(--mono);
      font-size: 0.74rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-weight: 800;
    }

    .lane-card p {
      margin: 0.9rem 0;
      color: rgba(232,255,240,0.86);
      line-height: 1.48;
      font-weight: 650;
    }

    .lane-card em { color: #2ef29a; font-style: normal; font-weight: 850; }
    .tone-pink span { color: #ff82d8; }
    .tone-green span { color: #74f2ae; }

    @media (prefers-reduced-motion: reduce) {
      .lane-card,
      .featured-card,
      .article-card { transition: none !important; }
      .lane-card:hover,
      .lane-card:focus-visible { transform: none; }
    }

    .archive-tools {
      width: min(100%, 900px);
      display: grid;
      gap: 0.8rem;
      margin: 1.5rem auto 0;
    }

    .search-wrap {
      display: grid;
      gap: 0.42rem;
      text-align: left;
    }

    .search-wrap span {
      color: var(--accent, #1fa068);
      font-family: var(--mono);
      font-size: 0.68rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .search-wrap input {
      min-height: 48px;
      width: 100%;
      border: 1px solid rgba(128,255,196,0.18);
      border-radius: 999px;
      background: rgba(255,255,255,0.035);
      color: var(--text);
      padding: 0.85rem 1rem;
      font: inherit;
      outline: none;
    }

    .search-wrap input:focus {
      border-color: rgba(31,160,104,0.62);
      box-shadow: 0 0 0 3px rgba(31,160,104,0.10);
    }

    .featured-articles {
      width: min(1180px, calc(100% - 32px));
      margin: -1.2rem auto 2.25rem;
    }

    .featured-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(220px, 360px);
      gap: 1.25rem;
      align-items: end;
      margin-bottom: 1rem;
    }

    .section-kicker {
      margin: 0 0 0.4rem;
      color: var(--accent, #1fa068);
      font-size: 0.74rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .featured-head h2 {
      margin: 0;
      color: var(--text-primary, var(--text));
      font-size: clamp(1.45rem, 2vw, 2rem);
      letter-spacing: 0;
    }

    .featured-head p,
    .archive-note p:last-child {
      margin: 0;
      color: var(--text-muted, #9a9aaa);
      line-height: 1.6;
    }

    .featured-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.9rem;
    }

    .featured-card {
      display: flex;
      min-height: 260px;
      flex-direction: column;
      justify-content: space-between;
      padding: 1rem;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 8px;
      background: rgba(31, 160, 104, 0.055);
      color: inherit;
      text-decoration: none;
      transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
    }

    .featured-card:hover,
    .featured-card:focus-visible {
      transform: translateY(-3px);
      border-color: rgba(31, 160, 104, 0.6);
      background: rgba(31, 160, 104, 0.08);
      outline: none;
    }

    .featured-card span {
      color: var(--accent, #1fa068);
      font-size: 0.78rem;
      font-weight: 800;
      text-transform: uppercase;
    }

    .featured-card h3 {
      margin: 1.1rem 0 0.75rem;
      color: var(--text-primary, var(--text));
      font-size: 1.1rem;
      line-height: 1.25;
      letter-spacing: 0;
    }

    .featured-card p {
      flex: 1;
      margin: 0;
      color: var(--text-muted, #9a9aaa);
      line-height: 1.55;
    }

    .featured-card strong {
      margin-top: 1rem;
      color: var(--text-primary, var(--text));
      font-size: 0.9rem;
    }

    .archive-note {
      width: min(1180px, calc(100% - 32px));
      margin: 0 auto 1rem;
    }



    .discipline-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: flex-end;
    }

    .discipline-list span {
      border: 1px solid rgba(31, 160, 104, 0.28);
      border-radius: 999px;
      padding: 0.45rem 0.7rem;
      color: var(--text-primary, #f4f7f4);
      background: rgba(31, 160, 104, 0.07);
      font-size: 0.82rem;
      font-weight: 700;
    }


    .route-map {
      width: min(1180px, calc(100% - 32px));
      margin: -0.75rem auto 2.25rem;
      padding: 1rem;
      border: 1px solid rgba(128,255,196,0.16);
      border-radius: 22px;
      background: linear-gradient(180deg, rgba(8,32,20,0.70), rgba(2,10,6,0.88));
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.04), 0 24px 70px rgba(0,0,0,0.22);
    }

    .route-map-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 0.9rem;
    }

    .route-map-head h2 {
      max-width: 720px;
      margin: 0;
      color: var(--text-primary, var(--text));
      font-size: clamp(1.2rem, 2.2vw, 1.8rem);
      line-height: 1.15;
      letter-spacing: -0.03em;
    }

    .route-map-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.7rem;
    }

    .route-map-grid a {
      min-height: 148px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 0.9rem;
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 16px;
      background: rgba(255,255,255,0.035);
      text-decoration: none;
      color: inherit;
    }

    .route-map-grid span { color: rgba(137,255,198,0.66); font-family: var(--mono); font-size: 0.68rem; }
    .route-map-grid strong { color: #f2fff7; font-size: 1rem; }
    .route-map-grid p { margin: 0; color: var(--text-muted, #9a9aaa); font-size: 0.86rem; line-height: 1.45; }


    .learn-bridge {
      width: min(1180px, calc(100% - 32px));
      margin: -0.75rem auto 2.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      border: 1px solid rgba(31, 160, 104, 0.22);
      border-radius: 8px;
      background: rgba(31, 160, 104, 0.055);
      padding: 1rem;
    }

    .learn-bridge h2 {
      margin: 0;
      color: var(--text-primary, var(--text));
      font-size: clamp(1.05rem, 1.8vw, 1.4rem);
      letter-spacing: 0;
      line-height: 1.3;
    }

    .learn-bridge a {
      min-height: 44px;
      border: 1px solid rgba(228, 228, 236, 0.16);
      border-radius: 999px;
      color: var(--text);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.65rem 0.9rem;
      text-decoration: none;
      white-space: nowrap;
      background: rgba(2, 2, 4, 0.35);
    }

    .learn-bridge a:hover,
    .learn-bridge a:focus-visible {
      border-color: rgba(31, 160, 104, 0.55);
      color: var(--text);
      outline: none;
    }

    .filter-btn,
    .article-card,
    .featured-card {
      touch-action: manipulation;
    }

    .filter-btn {
      min-height: 44px;
      padding: 0.7rem 1rem;
    }

    @media (max-width: 920px) {
      .archive-console {
        grid-template-columns: 1fr;
      }

      .archive-rail {
        display: none;
      }

      .archive-console-head,
      .lane-grid {
        grid-template-columns: 1fr;
      }

      .archive-count {
        justify-items: start;
        padding-top: 0;
      }

      .featured-head {
        grid-template-columns: 1fr;
      }

      .featured-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .route-map-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 560px) {

    .archive-tools {
      width: min(100%, 900px);
      display: grid;
      gap: 0.8rem;
      margin: 1.5rem auto 0;
    }

    .search-wrap {
      display: grid;
      gap: 0.42rem;
      text-align: left;
    }

    .search-wrap span {
      color: var(--accent, #1fa068);
      font-family: var(--mono);
      font-size: 0.68rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .search-wrap input {
      min-height: 48px;
      width: 100%;
      border: 1px solid rgba(128,255,196,0.18);
      border-radius: 999px;
      background: rgba(255,255,255,0.035);
      color: var(--text);
      padding: 0.85rem 1rem;
      font: inherit;
      outline: none;
    }

    .search-wrap input:focus {
      border-color: rgba(31,160,104,0.62);
      box-shadow: 0 0 0 3px rgba(31,160,104,0.10);
    }

    .featured-articles {
        width: min(100% - 24px, 1180px);
        margin-top: -0.6rem;
      }

      .featured-grid {
        grid-template-columns: 1fr;
      }

      .featured-card {
        min-height: 220px;
      }


      .discipline-list {
        justify-content: flex-start;
      }

    .learn-bridge {
        width: min(100% - 24px, 1180px);
        flex-direction: column;
        align-items: flex-start;
        margin-top: -0.5rem;
      }

      .archive-note,
      .route-map {
        width: min(100% - 24px, 1180px);
      }
      .route-map-head { align-items: flex-start; flex-direction: column; }
      .route-map-grid { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
