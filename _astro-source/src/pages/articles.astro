---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const articleCount = allPosts.length;

const sortedPosts = allPosts.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const categories = ['AI Systems', 'Finance Risk', 'Blockchain / DeFi', 'Builder Notes'];
const normalizeCategory = (value = '') => {
  if (['AI', 'Tech'].includes(value)) return 'AI Systems';
  if (value === 'Finance') return 'Finance Risk';
  if (['Blockchain', 'DeFi'].includes(value)) return 'Blockchain / DeFi';
  return 'Builder Notes';
};

const tagColorMap: Record<string, string> = {
  'AI': 'tag-cyan', 'Agents': 'tag-cyan', 'SYOS': 'tag-cyan',
  'Blockchain': 'tag-cyan', 'DeFi': 'tag-cyan', 'AML': 'tag-red',
  'Finance': 'tag-amber', 'Fintech': 'tag-amber', 'Crypto': 'tag-cyan',
  'Tech': 'tag-cyan', 'AI Systems': 'tag-cyan', 'Finance Risk': 'tag-amber', 'Blockchain / DeFi': 'tag-cyan', 'Builder Notes': 'tag-green', 'Thoughts': 'tag-rose', 'Gaming': 'tag-cyan',
  'Nobel Prize': 'tag-amber', 'Physics': 'tag-cyan',
};

const cleanText = (value = '') => value
  .replace(/[\u2013\u2014]/g, '-')
  .replace(/\b[Dd]eep dive\b/g, 'report')
  .replace(/\b[Tt]ransformative\b/g, 'changing')
  .replace(/\b[Rr]obust\b/g, 'steady')
  .replace(/\b[Cc]utting-edge\b/g, 'new')
  .replace(/\b[Bb]est practices\b/g, 'working habits');

const getSlug = (post: typeof sortedPosts[number]) => post.data.slug || post.id;
const featuredSlugs = [
  'agent-governance-flow',
  'wallet-risk-notes',
  'aml-engine',
  'two-agent-finance-operating-system',
];
const featuredPosts = featuredSlugs
  .map((slug) => sortedPosts.find((post) => getSlug(post) === slug))
  .filter(Boolean);

const routeLabels: Record<string, string> = {
  'agent-governance-flow': 'Agent control',
  'wallet-risk-notes': 'Wallet risk',
  'aml-engine': 'AML notes',
  'two-agent-finance-operating-system': 'AI systems',
};
---
<BaseLayout title="Articles" description={`${articleCount} articles on finance, AI, agents, blockchain, and learning by building.`}>

  <div class="page-header">
    <div class="page-label">Articles</div>
    <h1 class="page-title">Pick a thread.</h1>
    <p class="page-sub">{articleCount} notes on finance, AI, agents, blockchain, and learning by building. Start with the piece that matches the question in front of you.</p>

    <div class="filter-bar" id="filter-bar">
      <button class="filter-btn active" data-filter="all">All</button>
      {categories.map(cat => (
        <button class="filter-btn" data-filter={cat}>{cat}</button>
      ))}
    </div>
  </div>

  <section class="featured-articles" aria-label="Start here">
    <div class="featured-head">
      <div>
        <p class="section-kicker">Start here</p>
        <h2>Four system-first starting points.</h2>
      </div>
      <p>Start with records, controls, wallet-risk notes, and the operating pattern before scanning the full archive.</p>
    </div>
    <div class="featured-grid">
      {featuredPosts.map((post) => (
        <a href={`/blog/${getSlug(post)}`} class="featured-card">
          <span>{routeLabels[getSlug(post)]}</span>
          <h3>{cleanText(post.data.title)}</h3>
          <p>{cleanText(post.data.description)}</p>
          <strong>Open note</strong>
        </a>
      ))}
    </div>
  </section>

  <section class="learn-bridge article-discipline" aria-label="Article discipline">
    <div>
      <p class="section-kicker">Article discipline</p>
      <h2>Every strong note should connect the reader to the record.</h2>
      <p>Use this archive as a learning system, not a pile of posts. The cleanup standard for important articles is: Source links, Internal records, Limits, and Next read.</p>
    </div>
    <div class="discipline-list" aria-label="Article ending standard">
      <span>Source links</span>
      <span>Internal records</span>
      <span>Limits</span>
      <span>Next read</span>
    </div>
  </section>

  <section class="learn-bridge" aria-label="Learning route">
    <div>
      <p class="section-kicker">New to the terms?</p>
      <h2>Open Knowledge Base first, then come back to the articles.</h2>
    </div>
    <a href="/learn/">Open Knowledge Base</a>
  </section>

  <section class="learn-bridge" aria-label="AI model route">
    <div>
      <p class="section-kicker">Following AI model news?</p>
      <h2>Use the AI Models hub for plain-English definitions, model explainers, and finance use cases.</h2>
    </div>
    <a href="/ai-models/">Open AI Models</a>
  </section>

  <section class="learn-bridge" aria-label="Risk profile route">
    <div>
      <p class="section-kicker">Need examples?</p>
      <h2>Risk Profiles turn finance and crypto stories into plain-English evidence trails.</h2>
    </div>
    <a href="/risk-evidence/">Open Risk Profiles</a>
  </section>

  <div class="articles-wrap">
    <div class="archive-note">
      <p class="section-kicker">Full archive</p>
      <p>The full archive is useful, but the system-first notes above are the cleaner front door.</p>
    </div>
    <div class="articles-grid stagger-children" id="articles-grid">
      {sortedPosts.map((post) => (
        <a href={`/blog/${getSlug(post)}`} class="article-card animate-on-scroll" data-category={normalizeCategory(post.data.category)}>
          {post.data.image && (
            <div class="card-thumb">
              <img src={post.data.image} alt={cleanText(post.data.title)} loading="lazy" />
            </div>
          )}
          <div class="article-tags">
            {post.data.tags.slice(0, 3).map((tag: string) => (
              <span class={`tag-pill ${tagColorMap[tag] || 'tag-green'}`}>{tag}</span>
            ))}
          </div>
          <h3>{cleanText(post.data.title)}</h3>
          <p>{cleanText(post.data.description)}</p>
          <div class="card-footer">
            <span class="read-more">Open</span>
            <span class="read-time">{post.data.readTime}</span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <script is:inline>
    document.querySelectorAll('.filter-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.filter-btn').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        var filter = btn.getAttribute('data-filter');
        document.querySelectorAll('.article-card').forEach(function(card) {
          if (filter === 'all' || card.getAttribute('data-category') === filter) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
  <style>
    .featured-articles {
      width: min(1180px, calc(100% - 32px));
      margin: -1.2rem auto 2.25rem;
    }

    .featured-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(220px, 360px);
      gap: 1.25rem;
      align-items: end;
      margin-bottom: 1rem;
    }

    .section-kicker {
      margin: 0 0 0.4rem;
      color: var(--accent, #1fa068);
      font-size: 0.74rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .featured-head h2 {
      margin: 0;
      color: var(--text-primary, var(--text));
      font-size: clamp(1.45rem, 2vw, 2rem);
      letter-spacing: 0;
    }

    .featured-head p,
    .archive-note p:last-child {
      margin: 0;
      color: var(--text-muted, #9a9aaa);
      line-height: 1.6;
    }

    .featured-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.9rem;
    }

    .featured-card {
      display: flex;
      min-height: 260px;
      flex-direction: column;
      justify-content: space-between;
      padding: 1rem;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 8px;
      background: rgba(31, 160, 104, 0.055);
      color: inherit;
      text-decoration: none;
      transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
    }

    .featured-card:hover,
    .featured-card:focus-visible {
      transform: translateY(-3px);
      border-color: rgba(31, 160, 104, 0.6);
      background: rgba(31, 160, 104, 0.08);
      outline: none;
    }

    .featured-card span {
      color: var(--accent, #1fa068);
      font-size: 0.78rem;
      font-weight: 800;
      text-transform: uppercase;
    }

    .featured-card h3 {
      margin: 1.1rem 0 0.75rem;
      color: var(--text-primary, var(--text));
      font-size: 1.1rem;
      line-height: 1.25;
      letter-spacing: 0;
    }

    .featured-card p {
      flex: 1;
      margin: 0;
      color: var(--text-muted, #9a9aaa);
      line-height: 1.55;
    }

    .featured-card strong {
      margin-top: 1rem;
      color: var(--text-primary, var(--text));
      font-size: 0.9rem;
    }

    .archive-note {
      width: min(1180px, calc(100% - 32px));
      margin: 0 auto 1rem;
    }



    .discipline-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: flex-end;
    }

    .discipline-list span {
      border: 1px solid rgba(31, 160, 104, 0.28);
      border-radius: 999px;
      padding: 0.45rem 0.7rem;
      color: var(--text-primary, #f4f7f4);
      background: rgba(31, 160, 104, 0.07);
      font-size: 0.82rem;
      font-weight: 700;
    }

    .learn-bridge {
      width: min(1180px, calc(100% - 32px));
      margin: -0.75rem auto 2.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      border: 1px solid rgba(31, 160, 104, 0.22);
      border-radius: 8px;
      background: rgba(31, 160, 104, 0.055);
      padding: 1rem;
    }

    .learn-bridge h2 {
      margin: 0;
      color: var(--text-primary, var(--text));
      font-size: clamp(1.05rem, 1.8vw, 1.4rem);
      letter-spacing: 0;
      line-height: 1.3;
    }

    .learn-bridge a {
      min-height: 44px;
      border: 1px solid rgba(228, 228, 236, 0.16);
      border-radius: 999px;
      color: var(--text);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.65rem 0.9rem;
      text-decoration: none;
      white-space: nowrap;
      background: rgba(2, 2, 4, 0.35);
    }

    .learn-bridge a:hover,
    .learn-bridge a:focus-visible {
      border-color: rgba(31, 160, 104, 0.55);
      color: var(--text);
      outline: none;
    }

    .filter-btn,
    .article-card,
    .featured-card {
      touch-action: manipulation;
    }

    .filter-btn {
      min-height: 44px;
      padding: 0.7rem 1rem;
    }

    @media (max-width: 920px) {
      .featured-head {
        grid-template-columns: 1fr;
      }

      .featured-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 560px) {
      .featured-articles {
        width: min(100% - 24px, 1180px);
        margin-top: -0.6rem;
      }

      .featured-grid {
        grid-template-columns: 1fr;
      }

      .featured-card {
        min-height: 220px;
      }


      .discipline-list {
        justify-content: flex-start;
      }

    .learn-bridge {
        width: min(100% - 24px, 1180px);
        flex-direction: column;
        align-items: flex-start;
        margin-top: -0.5rem;
      }

      .archive-note {
        width: min(100% - 24px, 1180px);
      }
    }
  </style>
</BaseLayout>
