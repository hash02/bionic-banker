---
import BaseLayout from '../layouts/BaseLayout.astro';

const reportCatalog = await import('../../public/dashboard-data/engineering-report-catalog.json');

const benchmarkMetrics = reportCatalog.default.benchmark_metrics;
const catalogDate = new Date(reportCatalog.default.generated_at).toISOString().slice(0, 10);

const metricLabels = [
  'AML benchmark detection',
  'AML benchmark false-positive rate',
  'Direct detection functions',
  'Mapped detection abilities',
];

const walletMetrics = benchmarkMetrics.filter((metric) => metricLabels.includes(metric.label));

const sampleRules = [
  'mixer touch',
  'sanctions context',
  'repeated timing',
  'routing pattern',
];

const readingSteps = [
  {
    title: 'Rules',
    body: 'The engine looks for patterns in public transaction rows: timing, routing, mixer contact, consolidation, and other signals that can make a row worth a second look.',
  },
  {
    title: 'Score',
    body: 'A score is a sorting tool. It helps decide what to inspect first. It is not a legal finding, and it is not a final answer.',
  },
  {
    title: 'Voice',
    body: 'The risk-note layer turns a technical flag into a sentence a human can read. The tone can be direct, but the limit stays clear.',
  },
  {
    title: 'Limit',
    body: 'This assessment view uses sample rows and visible summaries. It does not use employer data, client data, private wallet data, or live filing workflows.',
  },
];

const sourceCards = [
  {
    title: 'Readable source package',
    body: 'The public source path points to the wallet-risk and AML engine repositories so the implementation can be inspected beside the page copy, not treated as a hidden claim.',
  },
  {
    title: 'Records before claims',
    body: 'The page presents benchmark metrics, mapped detection abilities, sample rows, and supporting records. It stays portfolio-grade: useful for review, not a licensed compliance product.',
  },
  {
    title: 'What it cannot do',
    body: 'No KYC approval, no SAR filing power, no wallet control, no trade control, and no production monitoring claim. Human review remains required before any operational decision.',
  },
];

const proofFlow = [
  {
    label: 'Public row',
    detail: 'Masked sample transaction context only',
  },
  {
    label: 'Rules fire',
    detail: 'Timing, routing, mixer, sanctions-context, and behavior flags',
  },
  {
    label: 'Score sorts',
    detail: 'Priority signal for human review, not a legal finding',
  },
  {
    label: 'Note explains',
    detail: 'Plain-language reason with the limits kept visible',
  },
];

const sourceLinks = [
  {
    label: 'Metrics JSON',
    href: '/dashboard-data/engineering-report-catalog.json',
    detail: 'The public metric snapshot that feeds the numbers on this page.',
  },
  {
    label: 'AML engine source',
    href: 'https://github.com/hash02/aml-detection-engine',
    detail: 'The repository link for inspecting the detection-engine package named in the review card.',
  },
  {
    label: 'Wallet checker source',
    href: 'https://github.com/hash02/wallet-risk-check',
    detail: 'The repository link for the wallet-risk screening surface.',
  },
];
---
<BaseLayout title="Wallet Risk Assessment" description="A plain-language wallet risk assessment showing how transaction rules, scores, and explanation notes can sit next to each other without exposing private data.">
  <main class="wallet-shell">
    <section class="wallet-hero">
      <div class="wallet-hero-copy">
        <span class="eyebrow">Wallet Risk Assessment</span>
        <h1>Some rows only get interesting when the rules explain why.</h1>
        <p>
          This is the quieter front door for the AML Engine and wallet risk notes. A transaction pattern gets scored, the rules say what fired, and the explanation layer turns it into a note a human can actually read.
        </p>
        <div class="reviewer-callout"><span>What this shows</span><strong>A wallet row can be scored and explained without pretending the score is a final verdict.</strong></div>
        <div class="hero-actions">
          <a href="#sample-row">Watch one row</a>
          <a href="/learn#aml">Learn AML</a>
          <a href="/reports">Open numbers</a>
        </div>
      </div>
      <aside class="risk-card" aria-label="Wallet risk sample summary">
        <div class="risk-card-top">
          <span>Sample view</span>
          <strong>0x0a5b...4c91</strong>
        </div>
        <div class="risk-ring" aria-label="Sample score 72 of 100">
          <svg viewBox="0 0 120 120" role="img">
            <circle cx="60" cy="60" r="48" class="ring-back" />
            <circle cx="60" cy="60" r="48" class="ring-front" pathLength="100" stroke-dasharray="72 100" />
          </svg>
          <div>
            <strong>72</strong>
            <span>review score</span>
          </div>
        </div>
        <p>Pattern note: a masked sample row with mixer context, repeated timing, and routing behavior. Interesting enough to inspect. Not a finding by itself.</p>
      </aside>
    </section>

    <section class="wallet-panel">
      <div class="panel-head">
        <span>How I read it</span>
        <h2>Rules first. Voice second.</h2>
        <p>The engine should do the boring part well. The risk-note layer should make the result readable without pretending the sentence is the evidence layer.</p>
      </div>
      <div class="step-grid">
        {readingSteps.map((step, index) => (
          <article>
            <small>{String(index + 1).padStart(2, '0')}</small>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="sample-layout" id="sample-row">
      <article class="sample-row-card">
        <div class="panel-head compact">
          <span>One sample row</span>
          <h2>Why did the engine pause?</h2>
        </div>
        <div class="row-line">
          <span>Masked address</span>
          <strong>0xd0b9...81aa</strong>
        </div>
        <div class="row-line">
          <span>Pattern</span>
          <strong>Mixer context plus routing behavior</strong>
        </div>
        <div class="row-line">
          <span>Rules fired</span>
          <div class="rule-list">
            {sampleRules.map((rule) => <i>{rule}</i>)}
          </div>
        </div>
        <div class="voice-note">
          <span>Plain note</span>
          <p>A row like this is not evidence of wrongdoing. It is a reason to slow down, read the surrounding activity, and ask whether the pattern repeats.</p>
        </div>
      </article>

      <article class="sample-row-card voice-card">
        <div class="panel-head compact">
          <span>Risk-note limit</span>
          <h2>Make it readable, not reckless.</h2>
        </div>
        <p>
          The funny layer only works if it respects the limit. It can point at the pattern. It cannot accuse a person, claim a filing decision, or turn a sample into a verdict.
        </p>
        <blockquote>
          "This row is waving for attention. Small amount, noisy transaction path, familiar mixer context. Worth a second look before anyone pretends it is invisible."
        </blockquote>
        <p class="limit-copy">That is the tone: curious, sharp, bounded.</p>
      </article>
    </section>

    <section class="wallet-panel">
      <div class="panel-head">
        <span>Source and evidence limit</span>
        <h2>Portfolio-grade evidence, not a commercial compliance claim.</h2>
        <p>The useful presentation is the source, metrics, sample row, and limitation shown together. The limit is part of the card, not a footnote.</p>
      </div>
      <div class="step-grid">
        {sourceCards.map((card, index) => (
          <article>
            <small>{String(index + 1).padStart(2, '0')}</small>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="wallet-panel proof-panel" aria-label="Wallet risk review flow diagram">
      <div class="panel-head">
        <span>Review flow</span>
        <h2>The diagram is intentionally boring: row → rules → score → note.</h2>
        <p>No single box is the product. The important point is that each layer keeps its source, role, and limit visible before a human makes a decision.</p>
      </div>
      <div class="proof-flow">
        {proofFlow.map((step, index) => (
          <article>
            <small>{String(index + 1).padStart(2, '0')}</small>
            <h3>{step.label}</h3>
            <p>{step.detail}</p>
          </article>
        ))}
      </div>
      <div class="source-list" aria-label="Wallet risk source citations">
        {sourceLinks.map((source) => (
          <a href={source.href} target={source.href.startsWith('http') ? '_blank' : undefined} rel={source.href.startsWith('http') ? 'noopener' : undefined}>
            <span>{source.label}</span>
            <strong>{source.detail}</strong>
          </a>
        ))}
      </div>
    </section>

    <section class="wallet-panel">
      <div class="panel-head">
        <span>Numbers I am watching</span>
        <h2>Useful numbers need their limits beside them.</h2>
        <p>These values come from the local report catalog snapshot on {catalogDate}. They are shown as research notes, not product certification.</p>
      </div>
      <div class="metric-strip">
        {walletMetrics.map((metric) => (
          <article>
            <span>{metric.label}</span>
            <strong>{metric.value}</strong>
            <small>{metric.unit}. Source: {metric.source}.</small>
          </article>
        ))}
      </div>
    </section>

    <section class="wallet-panel split-panel">
      <div>
        <span class="eyebrow">What this is</span>
        <h2>A learning surface for finance patterns.</h2>
        <p>It shows how a rule-based wallet-risk engine, a score, and a plain-language note can live on the same page. That makes the system easier to inspect without turning it into a compliance product.</p>
      </div>
      <div>
        <span class="eyebrow">What this is not</span>
        <h2>Not a verdict machine.</h2>
        <p>No client data. No employer data. No private wallet data. No legal advice. No filing recommendation. The page is about reading patterns, not accusing people.</p>
      </div>
    </section>

    <section class="wallet-links">
      <a href="https://github.com/hash02/aml-detection-engine" target="_blank" rel="noopener">
        <span>Source package</span>
        <strong>Inspect the AML engine repository</strong>
      </a>
      <a href="https://github.com/hash02/wallet-risk-check" target="_blank" rel="noopener">
        <span>Wallet screening source</span>
        <strong>Open the wallet-risk checker</strong>
      </a>
      <a href="/dashboard">
        <span>Dashboard</span>
        <strong>Open the wider signal board</strong>
      </a>
      <a href="/learn#aml">
        <span>Learning layer</span>
        <strong>Read the AML plain-English note</strong>
      </a>
      <a href="/risk-evidence-overview">
        <span>Risk & Evidence Overview</span>
        <strong>Follow the full review path</strong>
      </a>
      <a href="/reports">
        <span>Reports</span>
        <strong>Check the report snapshot</strong>
      </a>
    </section>
  </main>

  <style>
    .wallet-shell {
      width: 100%;
      max-width: var(--max);
      margin: 0 auto;
      padding: 3.5rem 2rem 4rem;
      overflow-x: hidden;
    }

    .wallet-shell,
    .wallet-shell * {
      box-sizing: border-box;
    }

    .wallet-hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(300px, 420px);
      gap: 1.25rem;
      align-items: stretch;
      margin-bottom: 1rem;
    }

    .wallet-hero-copy,
    .risk-card,
    .wallet-panel,
    .sample-row-card,
    .wallet-links a,
    .source-list a {
      border: 1px solid rgba(228, 228, 236, 0.12);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.035);
      max-width: 100%;
      min-width: 0;
    }

    .wallet-hero-copy {
      padding: clamp(1.25rem, 3vw, 2rem);
      min-width: 0;
    }

    .eyebrow,
    .panel-head span,
    .risk-card-top span,
    .voice-note span,
    .wallet-links span,
    .source-list span {
      display: block;
      color: #1fa068;
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 0.45rem;
    }

    .wallet-hero h1 {
      font-size: clamp(2.3rem, 6vw, 5rem);
      line-height: 0.98;
      letter-spacing: 0;
      margin: 0 0 1rem;
      max-width: 880px;
    }

    .wallet-hero p,
    .panel-head p,
    .step-grid p,
    .voice-card p,
    .split-panel p,
    .risk-card p,
    .voice-note p {
      color: var(--text-2);
      line-height: 1.7;
      margin: 0;
      overflow-wrap: anywhere;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.7rem;
      margin-top: 1.35rem;
    }

    .hero-actions a,
    .wallet-links a {
      color: var(--text);
      text-decoration: none;
    }

    .hero-actions a {
      border: 1px solid rgba(31, 160, 104, 0.35);
      border-radius: 999px;
      max-width: 100%;
      padding: 0.62rem 0.85rem;
      background: rgba(31, 160, 104, 0.08);
      overflow-wrap: anywhere;
    }

    .risk-card {
      padding: 1rem;
      display: grid;
      align-content: space-between;
      gap: 1rem;
      min-width: 0;
      background:
        radial-gradient(circle at top right, rgba(31, 160, 104, 0.18), transparent 42%),
        rgba(255, 255, 255, 0.035);
    }

    .risk-card-top strong {
      display: block;
      color: var(--text);
      font-family: var(--mono);
      font-size: 1rem;
      overflow-wrap: anywhere;
    }

    .risk-ring {
      position: relative;
      width: min(240px, 100%);
      aspect-ratio: 1;
      margin: 0 auto;
      display: grid;
      place-items: center;
    }

    .risk-ring svg,
    .risk-ring > div {
      grid-area: 1 / 1;
    }

    .ring-back {
      fill: none;
      stroke: rgba(228, 228, 236, 0.12);
      stroke-width: 10;
    }

    .ring-front {
      fill: none;
      stroke: #1fa068;
      stroke-width: 10;
      stroke-linecap: round;
      transform: rotate(-90deg);
      transform-origin: 50% 50%;
    }

    .risk-ring > div {
      text-align: center;
    }

    .risk-ring strong {
      display: block;
      color: var(--text);
      font-size: clamp(2.4rem, 7vw, 4rem);
      line-height: 1;
    }

    .risk-ring span {
      color: var(--text-3);
      font-family: var(--mono);
      font-size: 0.72rem;
    }

    .wallet-panel {
      padding: 1.15rem;
      margin-top: 1rem;
    }

    .panel-head {
      margin-bottom: 1rem;
    }

    .panel-head.compact {
      margin-bottom: 0.75rem;
    }

    .panel-head h2,
    .split-panel h2 {
      margin: 0 0 0.55rem;
      font-size: clamp(1.45rem, 3vw, 2.25rem);
      letter-spacing: 0;
    }

    .step-grid,
    .metric-strip,
    .wallet-links,
    .proof-flow,
    .source-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 0.85rem;
    }

    .step-grid article,
    .metric-strip article,
    .proof-flow article {
      border: 1px solid rgba(228, 228, 236, 0.12);
      border-radius: 8px;
      padding: 0.9rem;
      background: rgba(2, 2, 4, 0.42);
      min-width: 0;
    }

    .step-grid small,
    .proof-flow small {
      display: block;
      color: #1fa068;
      font-family: var(--mono);
      margin-bottom: 0.7rem;
    }

    .step-grid h3,
    .proof-flow h3 {
      margin: 0 0 0.45rem;
      letter-spacing: 0;
    }

    .proof-panel {
      background:
        linear-gradient(135deg, rgba(31, 160, 104, 0.07), transparent 34%),
        rgba(255, 255, 255, 0.035);
    }

    .proof-flow article {
      position: relative;
    }

    .proof-flow article:not(:last-child)::after {
      content: '→';
      position: absolute;
      top: 0.75rem;
      right: 0.85rem;
      color: rgba(31, 160, 104, 0.72);
      font-family: var(--mono);
    }

    .proof-flow p,
    .source-list strong {
      color: var(--text-2);
      line-height: 1.6;
      margin: 0;
    }

    .source-list {
      margin-top: 0.85rem;
    }

    .source-list a {
      color: var(--text);
      padding: 0.85rem;
      text-decoration: none;
    }

    .source-list strong {
      display: block;
      font-weight: 500;
    }

    .sample-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(280px, 0.8fr);
      gap: 1rem;
      margin-top: 1rem;
    }

    .sample-row-card {
      padding: 1.15rem;
      min-width: 0;
    }

    .row-line {
      display: grid;
      grid-template-columns: 150px minmax(0, 1fr);
      gap: 1rem;
      align-items: start;
      border-top: 1px solid rgba(228, 228, 236, 0.1);
      padding: 0.8rem 0;
    }

    .row-line span {
      color: var(--text-3);
      font-size: 0.82rem;
    }

    .row-line strong {
      color: var(--text);
      overflow-wrap: anywhere;
    }

    .rule-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
    }

    .rule-list i {
      border: 1px solid rgba(31, 160, 104, 0.3);
      border-radius: 999px;
      color: var(--text);
      font-style: normal;
      padding: 0.35rem 0.55rem;
      background: rgba(31, 160, 104, 0.08);
      font-size: 0.82rem;
    }

    .voice-note {
      border: 1px solid rgba(31, 160, 104, 0.22);
      border-radius: 8px;
      background: rgba(31, 160, 104, 0.06);
      padding: 0.9rem;
      margin-top: 0.4rem;
    }

    blockquote {
      border-left: 3px solid #1fa068;
      margin: 1rem 0;
      padding: 0.2rem 0 0.2rem 1rem;
      color: var(--text);
      line-height: 1.65;
      font-size: 1.05rem;
    }

    .limit-copy {
      color: var(--text);
      font-family: var(--mono);
      font-size: 0.82rem;
    }

    .metric-strip article span,
    .metric-strip article small {
      display: block;
      color: var(--text-3);
      line-height: 1.45;
    }

    .metric-strip article strong {
      display: block;
      color: var(--text);
      font-size: clamp(2rem, 5vw, 3.2rem);
      line-height: 1;
      margin: 0.45rem 0;
    }

    .split-panel {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .split-panel > div {
      border: 1px solid rgba(228, 228, 236, 0.1);
      border-radius: 8px;
      background: rgba(2, 2, 4, 0.32);
      padding: 1rem;
    }

    .wallet-links {
      margin-top: 1rem;
    }

    .wallet-links a {
      padding: 1rem;
      min-width: 0;
    }

    .wallet-links strong {
      display: block;
      color: var(--text);
      line-height: 1.35;
    }

    @media (max-width: 900px) {
      .wallet-hero,
      .sample-layout,
      .split-panel {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .wallet-shell {
        max-width: 100vw;
        padding: 2.5rem 1rem 3rem;
      }

      .wallet-hero h1 {
        font-size: 2rem;
        line-height: 1.08;
        overflow-wrap: break-word;
      }

      .wallet-hero-copy,
      .risk-card,
      .wallet-panel,
      .sample-row-card {
        padding: 1rem;
      }

      .row-line {
        grid-template-columns: 1fr;
        gap: 0.35rem;
      }

      .hero-actions {
        align-items: flex-start;
        flex-direction: column;
      }
    }
  </style>
</BaseLayout>

<style>
  .reviewer-callout { display: grid; gap: .35rem; max-width: 660px; margin: 1rem 0; padding: .9rem 1rem; border: 1px solid rgba(31,160,104,.22); border-radius: 16px; background: rgba(31,160,104,.06); }
  .reviewer-callout span { color: #1fa068; font-family: var(--mono, monospace); font-size: .68rem; text-transform: uppercase; letter-spacing: .08em; }
  .reviewer-callout strong { color: var(--text); line-height: 1.35; }
</style>
