---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const aiPosts = allPosts
  .filter(p => p.data.category === 'AI' || p.data.tags.some(t => ['AI', 'Agents', 'SYOS', 'AML'].includes(t)))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---
<BaseLayout title="AI Intelligence" description="What happens when you build AI systems from inside finance. Public-safe projects, research results, and the tools that came out of it.">

  <div class="page-header">
    <div class="page-label">Projects & Research</div>
    <h1 class="page-title">AI Intelligence</h1>
    <p class="page-sub">I build AI systems for AML detection, blockchain investigation, reasoning engines, and agent governance. This page shows public-safe proof and limitations.</p>
  </div>

  <div class="intel-dashboard">

    <!-- LIVE PROJECTS -->
    <div class="intel-section animate-on-scroll">
      <div class="section-label">Public Proof</div>

      <div class="intel-grid stagger-children">
        <!-- AML Engine -->
        <div class="intel-card project-card">
          <div class="project-header">
            <h3>AML Detection Engine</h3>
            <span class="version-badge">Manifest</span>
          </div>
          <p class="project-desc">28 mapped detection abilities documented through the public proof layer and manifest summary. The project focuses on mixer activity, sanctions patterns, structuring, and wallet risk profiling.</p>
          <div class="result-highlights">
            <div class="result-stat">
              <span class="stat-num">94.9%</span>
              <span class="stat-label">Detection Rate</span>
            </div>
            <div class="result-stat">
              <span class="stat-num">28</span>
              <span class="stat-label">Rules Active</span>
            </div>
            <div class="result-stat">
              <span class="stat-num">6</span>
              <span class="stat-label">Major Exploits Caught</span>
            </div>
          </div>
          <div class="caught-list">
            <span class="caught-tag danger">Lazarus Group</span>
            <span class="caught-tag danger">Tornado Cash</span>
            <span class="caught-tag danger">Ronin Bridge</span>
            <span class="caught-tag warning">Wormhole</span>
            <span class="caught-tag warning">Nomad Bridge</span>
          </div>
          <div class="project-actions">
            <a href="https://aml-detection-engine-ewxnmkbekcg8scjjes7caa.streamlit.app/" target="_blank" class="action-btn primary">Try the Live Demo ↗</a>
            <a href="/investigate" class="action-btn secondary">Investigate a Wallet →</a>
          </div>
        </div>

        <!-- Wallet Investigator -->
        <div class="intel-card project-card">
          <div class="project-header">
            <h3>Wallet Risk Investigator</h3>
            <span class="version-badge">v3</span>
          </div>
          <p class="project-desc">Paste a sample or demo Ethereum address and inspect a public-safe risk breakdown. Unknown addresses use demo-mode output so the page can be shown without overclaiming live chain coverage.</p>
          <div class="result-highlights">
            <div class="result-stat">
              <span class="stat-num">28</span>
              <span class="stat-label">AML Rules</span>
            </div>
            <div class="result-stat">
              <span class="stat-num">Demo</span><span class="stat-label">Public Mode</span>
            </div>
          </div>
          <div class="project-actions">
            <a href="/investigate" class="action-btn primary">Investigate a Wallet →</a>
            <a href="/blog/nexus-agent" class="action-btn secondary">Read How It Works →</a>
          </div>
        </div>

        <!-- SYOS -->
        <div class="intel-card project-card">
          <div class="project-header">
            <h3>Symbolic Reasoning Engine</h3>
            <span class="version-badge research">Research</span>
          </div>
          <p class="project-desc">What happens when you make an LLM audit its own reasoning? A year of building a cross-model symbolic verification system. Four rounds of adversarial testing.</p>
          <div class="result-highlights">
            <div class="result-stat">
              <span class="stat-num">9.0/10</span>
              <span class="stat-label">Metamorphic Score</span>
            </div>
            <div class="result-stat">
              <span class="stat-num">4</span>
              <span class="stat-label">Falsification Rounds</span>
            </div>
            <div class="result-stat">
              <span class="stat-num">8.0/10</span>
              <span class="stat-label">Semantic Anchor</span>
            </div>
          </div>
          <div class="test-results">
            <div class="test-row">
              <span class="test-name">v1 TF-IDF Drift Test</span>
              <span class="test-score">0.67 drift</span>
            </div>
            <div class="test-row">
              <span class="test-name">v2 Semantic Anchoring</span>
              <span class="test-score pass">8.0/10</span>
            </div>
            <div class="test-row">
              <span class="test-name">v3 Metamorphic + Adversarial</span>
              <span class="test-score pass">9.0 / 7.1</span>
            </div>
            <div class="test-row">
              <span class="test-name">v4 Hardened Capsule</span>
              <span class="test-score pass">7.5/10</span>
            </div>
          </div>
          <div class="project-actions">
            <a href="/blog/syos" class="action-btn primary">Read the Full Research →</a>
            <a href="/blog/syos-falsification" class="action-btn secondary">Falsification Results →</a>
          </div>
        </div>
      </div>
    </div>

    <!-- HOW IT'S BUILT -->
    <div class="intel-section animate-on-scroll">
      <div class="section-label">Architecture</div>
      <div class="arch-card">
        <h3>How It Works</h3>
        <p>Multiple specialized AI agents, each doing one job well. Detection agents scan blockchain data. Reasoning agents cross-verify outputs. No single model trusts its own answer — everything gets checked against independent sources.</p>
        <div class="principle-grid">
          <div class="principle">
            <span class="principle-icon">🔍</span>
            <div>
              <strong>Detection Layer</strong>
              <p>Pattern matching against known exploit signatures, sanctions lists, mixer activity, and behavioral anomalies.</p>
            </div>
          </div>
          <div class="principle">
            <span class="principle-icon">⚖️</span>
            <div>
              <strong>Verification Layer</strong>
              <p>No agent validates its own output. Every critical finding gets cross-checked against external ground truth — OFAC lists, DeFiLlama, public chain data.</p>
            </div>
          </div>
          <div class="principle">
            <span class="principle-icon">🧠</span>
            <div>
              <strong>Reasoning Layer</strong>
              <p>Symbolic reasoning over raw outputs. Not just "what happened" but "why it matters" — connecting transaction patterns to known threat models.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- RELATED WRITING -->
    <div class="intel-section animate-on-scroll">
      <div class="section-label">Writings</div>
      <div class="writing-grid stagger-children">
        {aiPosts.slice(0, 6).map((post) => (
          <a href={`/blog/${post.data.slug || post.id}`} class="writing-card">
            <div class="writing-tags">
              {post.data.tags.slice(0, 2).map((tag: string) => (
                <span class="tag-pill tag-green">{tag}</span>
              ))}
            </div>
            <h4>{post.data.title}</h4>
            <p>{post.data.description}</p>
            <span class="writing-meta">{post.data.readTime}</span>
          </a>
        ))}
      </div>
      <div style="text-align:center;margin-top:1.5rem;">
        <a href="/articles" class="action-btn secondary">View All Articles →</a>
      </div>
    </div>
  </div>

  <style>
    .intel-dashboard {
      max-width: var(--max);
      margin: 0 auto;
      padding: 0 2rem 3rem;
    }
    .intel-section {
      margin-bottom: 2.5rem;
    }
    .section-label {
      font-family: var(--mono);
      font-size: 0.62rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 1rem;
    }

    /* Project Grid */
    .intel-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 1rem;
    }
    .intel-card {
      background: var(--bg2);
      border: 1px solid var(--b1);
      border-radius: var(--radius);
      padding: 1.5rem;
      transition: border-color 0.25s, box-shadow 0.25s;
      box-shadow: var(--shadow-card);
    }
    .intel-card:hover {
      border-color: var(--b3);
      box-shadow: var(--shadow-card-hover);
    }
    .project-card {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .project-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
    }
    .project-header h3 {
      font-size: 1rem;
      font-weight: 700;
      color: var(--text);
    }
    .version-badge {
      font-family: var(--mono);
      font-size: 0.58rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent);
      background: var(--accent-glow);
      border: 1px solid var(--accent-border);
      padding: 0.15rem 0.5rem;
      border-radius: 4px;
      white-space: nowrap;
    }
    .version-badge.research {
      color: var(--accent);
      background: var(--accent-glow);
      border-color: var(--accent-border);
    }
    .project-desc {
      font-size: 0.82rem;
      color: var(--text-2);
      line-height: 1.6;
    }

    /* Result Highlights */
    .result-highlights {
      display: flex;
      gap: 1.25rem;
      flex-wrap: wrap;
    }
    .result-stat {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }
    .stat-num {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-size: 1.3rem;
      font-weight: 800;
      color: var(--accent);
      letter-spacing: -0.02em;
    }
    .stat-label {
      font-family: var(--mono);
      font-size: 0.58rem;
      font-weight: 500;
      color: var(--text-3);
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    /* Caught Tags */
    .caught-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
    }
    .caught-tag {
      font-family: var(--mono);
      font-size: 0.62rem;
      font-weight: 500;
      padding: 0.2rem 0.55rem;
      border-radius: 4px;
    }
    .caught-tag.danger {
      color: var(--accent);
      background: rgba(31,160,104,0.06);
      border: 1px solid rgba(31,160,104,0.22);
    }
    .caught-tag.warning {
      color: var(--accent);
      background: rgba(31,160,104,0.06);
      border: 1px solid rgba(31,160,104,0.15);
    }

    /* Project Actions */
    .project-actions {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      margin-top: 0.25rem;
    }
    .action-btn {
      font-family: var(--mono);
      font-size: 0.7rem;
      font-weight: 600;
      padding: 0.45rem 1rem;
      border-radius: 6px;
      transition: all 0.2s;
      text-decoration: none;
      white-space: nowrap;
    }
    .action-btn.primary {
      color: #fff;
      background: var(--accent);
    }
    .action-btn.primary:hover {
      opacity: 0.9;
      box-shadow: 0 0 20px rgba(31,160,104,0.25);
    }
    .action-btn.secondary {
      color: var(--accent);
      border: 1px solid var(--accent-border);
      background: transparent;
    }
    .action-btn.secondary:hover {
      border-color: var(--accent);
      box-shadow: 0 0 12px rgba(31,160,104,0.1);
    }

    /* Test Results */
    .test-results {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      background: var(--bg3);
      border-radius: 8px;
      padding: 0.75rem 1rem;
    }
    .test-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: var(--mono);
      font-size: 0.68rem;
    }
    .test-name {
      color: var(--text-2);
    }
    .test-score {
      color: var(--text-3);
      font-weight: 600;
    }
    .test-score.pass {
      color: var(--accent);
    }

    /* Architecture Card */
    .arch-card {
      background: var(--bg2);
      border: 1px solid var(--b1);
      border-radius: var(--radius);
      padding: 1.75rem;
      box-shadow: var(--shadow-card);
    }
    .arch-card h3 {
      font-size: 1rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
    }
    .arch-card > p {
      font-size: 0.85rem;
      color: var(--text-2);
      line-height: 1.65;
      margin-bottom: 1.25rem;
    }
    .principle-grid {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .principle {
      display: flex;
      gap: 0.75rem;
      align-items: flex-start;
    }
    .principle-icon {
      font-size: 1.1rem;
      flex-shrink: 0;
      margin-top: 0.1rem;
    }
    .principle strong {
      font-size: 0.85rem;
      color: var(--text);
      display: block;
      margin-bottom: 0.2rem;
    }
    .principle p {
      font-size: 0.78rem;
      color: var(--text-2);
      line-height: 1.55;
    }

    /* Writing Grid */
    .writing-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 0.75rem;
    }
    .writing-card {
      background: var(--bg2);
      border: 1px solid var(--b1);
      border-radius: var(--radius);
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      transition: border-color 0.25s, box-shadow 0.25s;
      text-decoration: none;
    }
    .writing-card:hover {
      border-color: var(--b3);
      box-shadow: var(--shadow-card-hover);
    }
    .writing-tags {
      display: flex;
      gap: 0.3rem;
    }
    .writing-card h4 {
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--text);
      line-height: 1.35;
    }
    .writing-card p {
      font-size: 0.78rem;
      color: var(--text-2);
      line-height: 1.55;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .writing-meta {
      font-family: var(--mono);
      font-size: 0.62rem;
      color: var(--text-3);
      margin-top: auto;
    }

    @media (max-width: 640px) {
      .intel-dashboard { padding: 0 1.25rem 2rem; }
      .intel-grid { grid-template-columns: 1fr; }
      .writing-grid { grid-template-columns: 1fr; }
      .result-highlights { gap: 0.75rem; }
    }
  </style>
</BaseLayout>
