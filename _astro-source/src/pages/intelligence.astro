---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="AI Intelligence" description="Real-time intelligence from HASH's autonomous agent network. Live data, not demos.">

  <div class="page-header">
    <div class="page-label">Live Intelligence</div>
    <h1 class="page-title">AI Intelligence Dashboard</h1>
    <p class="page-sub">Autonomous agents running 24/7. Monitoring blockchain, analyzing markets, detecting anomalies. This is what they see.</p>
  </div>

  <div class="intel-dashboard">
    <!-- Status Bar -->
    <div class="intel-status-bar animate-on-scroll">
      <div class="status-indicator">
        <span class="status-dot live"></span>
        <span class="status-text">System Online</span>
      </div>
      <div class="status-meta">
        <span id="agent-count">15 agents active</span>
        <span class="status-sep">·</span>
        <span id="data-points">936 reports collected</span>
        <span class="status-sep">·</span>
        <span id="last-update">Updated in real-time</span>
      </div>
    </div>

    <!-- Agent Grid -->
    <div class="intel-grid animate-on-scroll stagger-children">
      <div class="intel-card agent-card">
        <div class="agent-icon">🔍</div>
        <div class="agent-info">
          <h3>AML Detection Engine</h3>
          <p>22 rules · 94.9% detection rate · Monitoring Ethereum, BSC, Polygon</p>
          <div class="agent-stats">
            <span class="agent-stat"><strong>v11</strong> version</span>
            <span class="agent-stat"><strong>24/7</strong> monitoring</span>
          </div>
        </div>
        <a href="https://aml-detection-engine-ewxnmkbekcg8scjjes7caa.streamlit.app/" target="_blank" class="agent-action">Live Demo ↗</a>
      </div>

      <div class="intel-card agent-card">
        <div class="agent-icon">📊</div>
        <div class="agent-info">
          <h3>DeFi Scout</h3>
          <p>Yield scanning across protocols. Aave, Compound, Uniswap. Free API data, zero cost.</p>
          <div class="agent-stats">
            <span class="agent-stat"><strong>50+</strong> pools tracked</span>
            <span class="agent-stat"><strong>6h</strong> refresh cycle</span>
          </div>
        </div>
        <span class="agent-badge active">Active</span>
      </div>

      <div class="intel-card agent-card">
        <div class="agent-icon">🧠</div>
        <div class="agent-info">
          <h3>SYOS Reasoning Engine</h3>
          <p>Symbolic Yielded Operating System. Cross-LLM symbolic auditing, hallucination detection.</p>
          <div class="agent-stats">
            <span class="agent-stat"><strong>v3</strong> ~70% deployable</span>
            <span class="agent-stat"><strong>4</strong> falsification rounds</span>
          </div>
        </div>
        <span class="agent-badge research">Research</span>
      </div>

      <div class="intel-card agent-card">
        <div class="agent-icon">🛡️</div>
        <div class="agent-info">
          <h3>KALA Security Monitor</h3>
          <p>Continuous security awareness. Prompt injection defense, file integrity, cron health.</p>
          <div class="agent-stats">
            <span class="agent-stat"><strong>Every 5min</strong> health check</span>
            <span class="agent-stat"><strong>0</strong> breaches</span>
          </div>
        </div>
        <span class="agent-badge active">Active</span>
      </div>

      <div class="intel-card agent-card">
        <div class="agent-icon">📈</div>
        <div class="agent-info">
          <h3>Paper Trading Engine</h3>
          <p>Signal generation with zero real money. Building track record through simulated positions.</p>
          <div class="agent-stats">
            <span class="agent-stat"><strong>27</strong> trades logged</span>
            <span class="agent-stat"><strong>BTC/ETH</strong> pairs</span>
          </div>
        </div>
        <span class="agent-badge active">Active</span>
      </div>

      <div class="intel-card agent-card">
        <div class="agent-icon">🔗</div>
        <div class="agent-info">
          <h3>NEXUS Investigation Agent</h3>
          <p>AI-powered blockchain investigation. Split-brain architecture — Reasoner + Synthesizer.</p>
          <div class="agent-stats">
            <span class="agent-stat"><strong>v3</strong> split-brain</span>
            <span class="agent-stat"><strong>3</strong> evolution cycles</span>
          </div>
        </div>
        <span class="agent-badge research">Research</span>
      </div>
    </div>

    <!-- Data Visualization -->
    <div class="intel-viz animate-on-scroll">
      <div class="viz-card">
        <h3>System Health</h3>
        <div class="health-grid">
          <div class="health-item">
            <div class="health-bar" style="--progress: 94.9%">
              <div class="health-fill green"></div>
            </div>
            <span class="health-label">AML Detection Rate</span>
            <span class="health-value">94.9%</span>
          </div>
          <div class="health-item">
            <div class="health-bar" style="--progress: 100%">
              <div class="health-fill green"></div>
            </div>
            <span class="health-label">System Uptime</span>
            <span class="health-value">99.9%</span>
          </div>
          <div class="health-item">
            <div class="health-bar" style="--progress: 70%">
              <div class="health-fill amber"></div>
            </div>
            <span class="health-label">SYOS Deployment</span>
            <span class="health-value">~70%</span>
          </div>
          <div class="health-item">
            <div class="health-bar" style="--progress: 85%">
              <div class="health-fill green"></div>
            </div>
            <span class="health-label">Data Pipeline</span>
            <span class="health-value">936 reports</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Architecture Diagram -->
    <div class="intel-arch animate-on-scroll">
      <h3>System Architecture</h3>
      <p class="arch-desc">Three-brain decentralized architecture. No single point of failure. MAYA designs, Kaya executes, Wukong interfaces.</p>
      <div class="arch-nodes">
        <div class="arch-node node-maya">
          <div class="node-label">Strategy</div>
          <div class="node-name">Mind</div>
          <div class="node-desc">Analysis · Content · Design</div>
        </div>
        <div class="arch-connector">
          <svg width="60" height="20" viewBox="0 0 60 20">
            <line x1="0" y1="10" x2="60" y2="10" stroke="rgba(31,160,104,0.3)" stroke-width="1" stroke-dasharray="4,4">
              <animate attributeName="stroke-dashoffset" from="0" to="-8" dur="1s" repeatCount="indefinite"/>
            </line>
          </svg>
        </div>
        <div class="arch-node node-kaya">
          <div class="node-label">Execution</div>
          <div class="node-name">Body</div>
          <div class="node-desc">Git · Python · Cron · Agents</div>
        </div>
        <div class="arch-connector">
          <svg width="60" height="20" viewBox="0 0 60 20">
            <line x1="0" y1="10" x2="60" y2="10" stroke="rgba(31,160,104,0.3)" stroke-width="1" stroke-dasharray="4,4">
              <animate attributeName="stroke-dashoffset" from="0" to="-8" dur="1s" repeatCount="indefinite"/>
            </line>
          </svg>
        </div>
        <div class="arch-node node-wukong">
          <div class="node-label">Interface</div>
          <div class="node-name">Face</div>
          <div class="node-desc">Telegram · Learning · Gamification</div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .intel-dashboard {
      max-width: var(--max);
      margin: 0 auto;
      padding: 2rem;
    }
    .intel-status-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--bg2);
      border: 1px solid var(--b1);
      border-radius: var(--radius);
      padding: 1rem 1.5rem;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    .status-indicator {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .status-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--accent);
    }
    .status-dot.live {
      animation: statusPulse 2s ease-in-out infinite;
    }
    @keyframes statusPulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(31,160,104,0.4); }
      50% { box-shadow: 0 0 0 6px rgba(31,160,104,0); }
    }
    .status-text {
      font-family: var(--mono);
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .status-meta {
      display: flex;
      gap: 0.5rem;
      font-family: var(--mono);
      font-size: 0.68rem;
      color: var(--text-3);
    }
    .status-sep { opacity: 0.3; }

    .intel-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }
    .intel-card {
      background: var(--bg2);
      border: 1px solid var(--b1);
      border-radius: var(--radius);
      padding: 1.5rem;
      position: relative;
      transition: border-color 0.25s, box-shadow 0.25s;
      box-shadow: var(--shadow-card);
    }
    .intel-card:hover {
      border-color: var(--b3);
      box-shadow: var(--shadow-card-hover);
    }
    .agent-card {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .agent-icon {
      font-size: 1.5rem;
    }
    .agent-info h3 {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 0.35rem;
    }
    .agent-info p {
      font-size: 0.8rem;
      color: var(--text-2);
      line-height: 1.55;
    }
    .agent-stats {
      display: flex;
      gap: 1rem;
      margin-top: 0.5rem;
    }
    .agent-stat {
      font-family: var(--mono);
      font-size: 0.65rem;
      color: var(--text-3);
    }
    .agent-stat strong {
      color: var(--accent);
    }
    .agent-action {
      display: inline-block;
      font-family: var(--mono);
      font-size: 0.72rem;
      font-weight: 500;
      color: var(--accent);
      border: 1px solid var(--accent-border);
      padding: 0.35rem 0.85rem;
      border-radius: 4px;
      width: fit-content;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .agent-action:hover {
      border-color: var(--accent);
      box-shadow: 0 0 12px rgba(31,160,104,0.15);
    }
    .agent-badge {
      font-family: var(--mono);
      font-size: 0.6rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.2rem 0.6rem;
      border-radius: 4px;
      width: fit-content;
    }
    .agent-badge.active {
      color: var(--accent);
      background: var(--accent-glow);
      border: 1px solid var(--accent-border);
    }
    .agent-badge.research {
      color: #a98cff;
      background: rgba(139,108,247,0.08);
      border: 1px solid rgba(139,108,247,0.25);
    }

    .intel-viz {
      margin-bottom: 1.5rem;
    }
    .viz-card {
      background: var(--bg2);
      border: 1px solid var(--b1);
      border-radius: var(--radius);
      padding: 1.5rem;
      box-shadow: var(--shadow-card);
    }
    .viz-card h3 {
      font-size: 0.95rem;
      font-weight: 700;
      margin-bottom: 1.25rem;
    }
    .health-grid {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .health-item {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
      gap: 0.25rem 1rem;
      align-items: center;
    }
    .health-bar {
      grid-column: 1 / -1;
      height: 6px;
      background: var(--bg4);
      border-radius: 3px;
      overflow: hidden;
    }
    .health-fill {
      height: 100%;
      width: var(--progress);
      border-radius: 3px;
      transition: width 1.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .health-fill.green { background: var(--accent); }
    .health-fill.amber { background: #f5a623; }
    .health-label {
      font-size: 0.78rem;
      color: var(--text-2);
    }
    .health-value {
      font-family: var(--mono);
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--accent);
      text-align: right;
    }

    .intel-arch {
      background: var(--bg2);
      border: 1px solid var(--b1);
      border-radius: var(--radius);
      padding: 1.5rem;
      box-shadow: var(--shadow-card);
    }
    .intel-arch h3 {
      font-size: 0.95rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
    }
    .arch-desc {
      font-size: 0.82rem;
      color: var(--text-2);
      margin-bottom: 1.5rem;
    }
    .arch-nodes {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .arch-node {
      background: var(--bg3);
      border: 1px solid var(--b2);
      border-radius: var(--radius);
      padding: 1.25rem;
      text-align: center;
      min-width: 160px;
      transition: border-color 0.25s, box-shadow 0.25s;
    }
    .arch-node:hover {
      border-color: var(--accent-border);
      box-shadow: 0 0 20px rgba(31,160,104,0.08);
    }
    .node-label {
      font-family: var(--mono);
      font-size: 0.58rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 0.35rem;
    }
    .node-name {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 0.35rem;
    }
    .node-desc {
      font-size: 0.72rem;
      color: var(--text-3);
    }
    .arch-connector {
      flex-shrink: 0;
    }

    @media (max-width: 640px) {
      .intel-dashboard { padding: 1.25rem; }
      .intel-grid { grid-template-columns: 1fr; }
      .arch-nodes { flex-direction: column; }
      .arch-connector { transform: rotate(90deg); }
    }
  </style>
</BaseLayout>
