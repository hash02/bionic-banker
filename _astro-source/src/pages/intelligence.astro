---
import BaseLayout from '../layouts/BaseLayout.astro';

const signalCatalog = await import('../../public/dashboard-data/intelligence-signal-catalog.json');
const heartbeatSnapshot = await import('../../public/dashboard-data/heartbeat.json');

const lanes = signalCatalog.default.signal_lanes;
const tickets = signalCatalog.default.ticket_rows;
const feeds = signalCatalog.default.external_feeds;
const heartbeat = heartbeatSnapshot.default;
const status = heartbeat.status || {};
const lastPrediction = status.last_prediction || {};
const predictionValue = lastPrediction.value || {};
const recentRows = (heartbeat.recent || []).slice(-8).reverse();
const generatedAt = heartbeat.generated_at || signalCatalog.default.generated_at;
const accuracy = typeof status.accuracy_last_100 === 'number'
  ? `${Math.round(status.accuracy_last_100 * 100)}%`
  : 'n/a';
const confidence = typeof predictionValue.confidence === 'number'
  ? `${(predictionValue.confidence * 100).toFixed(1)}%`
  : 'n/a';
---
<BaseLayout title="AI Intelligence" description="A visible signal board for Bionic Banker heartbeat rows, market context, proof tickets, and reader-facing AI questions.">
  <div class="page-header">
    <div class="page-label">Signal Board</div>
    <h1 class="page-title">AI Intelligence</h1>
    <p class="page-sub">A visible board of heartbeat rows, market context, proof tickets, and reader-facing AI questions. Enough motion to learn from the page, with clear limits around what each row means.</p>
  </div>

  <main class="intel-shell">
    <section class="alive-console">
      <div class="console-copy">
        <span class="section-label">Public Snapshot</span>
        <h2>Website as a living proof board</h2>
        <p>This page shows enough motion to make the website useful. Market rows refresh from public sources. Snapshot rows keep the proof readable and attach limits to the signal.</p>
        <div class="console-actions">
          <a href="/proof-tour/" class="action-btn primary">Open Proof Tour</a>
          <a href="/gaps/" class="action-btn secondary">Open Questions</a>
        </div>
      </div>
      <div class="heartbeat-card">
        <div class="heartbeat-top">
          <span class="pulse-dot" aria-hidden="true"></span>
          <strong>{status.mode || 'Snapshot'}</strong>
          <small>{generatedAt}</small>
        </div>
        <div class="heartbeat-metrics">
          <div>
            <span>Rows</span>
            <strong>{status.predictions_made || 'n/a'}</strong>
          </div>
          <div>
            <span>Last 100</span>
            <strong>{accuracy}</strong>
          </div>
          <div>
            <span>Signal</span>
            <strong>{predictionValue.direction || 'n/a'}</strong>
          </div>
          <div>
            <span>Confidence</span>
            <strong>{confidence}</strong>
          </div>
        </div>
        <p class="snapshot-note">Research signal only. Not investment advice, not live trading performance, and not a recommendation.</p>
      </div>
    </section>

    <section class="market-strip" data-feeds={JSON.stringify(feeds)}>
      <div class="strip-head">
        <span class="section-label">Public Market Feed</span>
        <button class="refresh-btn" type="button" data-refresh-market>Refresh</button>
      </div>
      <div class="market-grid" data-market-grid>
        {feeds.map((feed) => (
          <article class="market-card" data-asset-card={feed.coingecko_id}>
            <span>{feed.symbol}</span>
            <strong data-price>Loading</strong>
            <small data-change>Public API</small>
          </article>
        ))}
      </div>
      <p class="feed-note" data-feed-note>Market data loads in the browser from a public API when available. If the API is unavailable, the rest of the intelligence board still works from public snapshots.</p>
    </section>

    <section class="lane-grid">
      {lanes.map((lane) => (
        <article class="lane-card" id={lane.id}>
          <span>{lane.label}</span>
          <h3>{lane.question}</h3>
          <p><strong>Source:</strong> {lane.public_source}</p>
          <p><strong>Mode:</strong> {lane.display_mode}</p>
        </article>
      ))}
    </section>

    <section class="ticket-panel">
      <div class="panel-head">
        <div>
          <span class="section-label">Signal Tickets</span>
          <h2>Visible signal rows</h2>
        </div>
        <a href="/reports/">Reports -></a>
      </div>
      <div class="ticket-list">
        {tickets.map((ticket) => (
          <article class="ticket-row">
            <div>
              <span class={`ticket-status status-${ticket.status}`}>{ticket.status}</span>
              <strong>{ticket.lane}</strong>
            </div>
            <p>{ticket.question}</p>
            <small>{ticket.public_note}</small>
            <a href={ticket.link}>Open -></a>
          </article>
        ))}
      </div>
    </section>

    <section class="recent-panel">
      <div class="panel-head">
        <div>
          <span class="section-label">Heartbeat Rows</span>
          <h2>Recent prediction rows</h2>
        </div>
        <a href="/dashboard-data/heartbeat.json" target="_blank" rel="noopener">JSON -></a>
      </div>
      <div class="recent-table">
        <div class="recent-row recent-head">
          <span>Time</span>
          <span>Signal</span>
          <span>Price</span>
          <span>Scored</span>
        </div>
        {recentRows.map((row) => (
          <div class="recent-row">
            <span>{row.iso}</span>
            <span>{row.prediction?.direction || 'n/a'} ({typeof row.prediction?.confidence === 'number' ? `${(row.prediction.confidence * 100).toFixed(1)}%` : 'n/a'})</span>
            <span>{typeof row.price_now === 'number' ? `$${Math.round(row.price_now).toLocaleString('en-US')}` : 'n/a'}</span>
            <span>{row.scored_prior?.correct === true ? 'hit' : row.scored_prior?.correct === false ? 'miss' : 'pending'}</span>
          </div>
        ))}
      </div>
    </section>
  </main>

  <script>
    const strip = document.querySelector('.market-strip');
    const feedNote = document.querySelector('[data-feed-note]');
    const refreshButton = document.querySelector('[data-refresh-market]');

    function formatPrice(value) {
      if (typeof value !== 'number') return 'n/a';
      return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: value > 100 ? 0 : 2 }).format(value);
    }

    function formatChange(value) {
      if (typeof value !== 'number') return '24h change n/a';
      const sign = value > 0 ? '+' : '';
      return `${sign}${value.toFixed(2)}% 24h`;
    }

    async function refreshMarket() {
      if (!strip) return;
      const feeds = JSON.parse(strip.dataset.feeds || '[]');
      const ids = feeds.map((feed) => feed.coingecko_id).join(',');
      if (!ids) return;

      if (feedNote) feedNote.textContent = 'Refreshing public market data...';

      try {
        const response = await fetch(`https://api.coingecko.com/api/v3/simple/price?ids=${ids}&vs_currencies=usd&include_24hr_change=true`, {
          headers: { accept: 'application/json' }
        });
        if (!response.ok) throw new Error('market fetch failed');
        const data = await response.json();

        feeds.forEach((feed) => {
          const card = document.querySelector(`[data-asset-card="${feed.coingecko_id}"]`);
          if (!card) return;
          const price = card.querySelector('[data-price]');
          const change = card.querySelector('[data-change]');
          const row = data[feed.coingecko_id] || {};
          if (price) price.textContent = formatPrice(row.usd);
          if (change) change.textContent = formatChange(row.usd_24h_change);
        });

        if (feedNote) feedNote.textContent = `Public market data refreshed ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}.`;
      } catch (error) {
        if (feedNote) feedNote.textContent = 'Public market refresh is unavailable right now. Snapshot rows remain visible.';
      }
    }

    refreshButton?.addEventListener('click', refreshMarket);
    refreshMarket();
    window.setInterval(refreshMarket, 120000);
  </script>

  <style>
    .intel-shell {
      max-width: var(--max);
      margin: 0 auto;
      padding: 0 2rem 3rem;
      display: grid;
      gap: 1.25rem;
    }

    .alive-console,
    .market-strip,
    .ticket-panel,
    .recent-panel {
      border: 1px solid rgba(31, 160, 104, 0.22);
      background: rgba(255, 255, 255, 0.035);
      border-radius: 8px;
      padding: 1.35rem;
    }

    .alive-console {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
      gap: 1.25rem;
      align-items: stretch;
    }

    .console-copy h2,
    .panel-head h2 {
      margin: 0.25rem 0 0.75rem;
      font-size: clamp(1.4rem, 2.5vw, 2.25rem);
      letter-spacing: 0;
    }

    .console-copy p,
    .snapshot-note,
    .feed-note,
    .lane-card p,
    .ticket-row p,
    .ticket-row small {
      color: var(--text-2);
      line-height: 1.65;
      margin: 0;
    }

    .console-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
      margin-top: 1rem;
    }

    .action-btn,
    .refresh-btn,
    .panel-head a,
    .ticket-row a {
      font-family: var(--mono);
      font-size: 0.76rem;
      font-weight: 600;
      border-radius: 6px;
      text-decoration: none;
    }

    .action-btn {
      padding: 0.55rem 1rem;
    }

    .action-btn.primary,
    .refresh-btn {
      background: var(--accent);
      color: #fff;
      border: 1px solid var(--accent);
    }

    .action-btn.secondary {
      color: var(--accent);
      border: 1px solid var(--accent-border);
    }

    .heartbeat-card {
      background: rgba(2, 2, 4, 0.55);
      border: 1px solid rgba(228, 228, 236, 0.12);
      border-radius: 8px;
      padding: 1rem;
      display: grid;
      gap: 1rem;
    }

    .heartbeat-top {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      flex-wrap: wrap;
      font-family: var(--mono);
      color: var(--text);
    }

    .heartbeat-top small {
      color: var(--text-3);
      margin-left: auto;
    }

    .pulse-dot {
      width: 0.72rem;
      height: 0.72rem;
      border-radius: 999px;
      background: var(--accent);
      box-shadow: 0 0 18px rgba(31, 160, 104, 0.45);
    }

    .heartbeat-metrics,
    .market-grid,
    .lane-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 0.85rem;
    }

    .heartbeat-metrics div,
    .market-card,
    .lane-card {
      border: 1px solid rgba(228, 228, 236, 0.12);
      background: rgba(2, 2, 4, 0.42);
      border-radius: 8px;
      padding: 0.9rem;
      min-width: 0;
    }

    .heartbeat-metrics span,
    .market-card span,
    .lane-card span {
      display: block;
      color: var(--text-3);
      font-family: var(--mono);
      font-size: 0.68rem;
      text-transform: uppercase;
      margin-bottom: 0.35rem;
    }

    .heartbeat-metrics strong,
    .market-card strong {
      color: var(--accent);
      font-size: 1.35rem;
      line-height: 1.1;
    }

    .strip-head,
    .panel-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .refresh-btn {
      padding: 0.45rem 0.8rem;
      cursor: pointer;
    }

    .market-card small {
      display: block;
      color: var(--text-2);
      margin-top: 0.4rem;
      font-family: var(--mono);
      font-size: 0.7rem;
    }

    .feed-note {
      margin-top: 0.9rem;
      font-size: 0.82rem;
    }

    .lane-card {
      display: grid;
      gap: 0.6rem;
    }

    .lane-card h3 {
      margin: 0;
      font-size: 1.05rem;
      line-height: 1.35;
    }

    .panel-head a,
    .ticket-row a {
      color: var(--accent);
      white-space: nowrap;
    }

    .ticket-list {
      display: grid;
      gap: 0.75rem;
    }

    .ticket-row {
      display: grid;
      grid-template-columns: 180px minmax(0, 1.2fr) minmax(180px, 0.8fr) auto;
      gap: 0.9rem;
      align-items: center;
      border: 1px solid rgba(228, 228, 236, 0.12);
      background: rgba(2, 2, 4, 0.42);
      border-radius: 8px;
      padding: 0.9rem;
    }

    .ticket-row div {
      display: grid;
      gap: 0.35rem;
    }

    .ticket-status {
      width: max-content;
      border: 1px solid rgba(31, 160, 104, 0.38);
      color: var(--accent);
      border-radius: 999px;
      padding: 0.15rem 0.45rem;
      font-family: var(--mono);
      font-size: 0.66rem;
      text-transform: uppercase;
    }

    .recent-table {
      display: grid;
      gap: 0.45rem;
    }

    .recent-row {
      display: grid;
      grid-template-columns: minmax(180px, 1.4fr) minmax(120px, 0.8fr) minmax(110px, 0.7fr) minmax(80px, 0.5fr);
      gap: 0.8rem;
      border: 1px solid rgba(228, 228, 236, 0.1);
      border-radius: 8px;
      padding: 0.75rem;
      color: var(--text-2);
      font-size: 0.82rem;
    }

    .recent-head {
      color: var(--accent);
      font-family: var(--mono);
      font-size: 0.68rem;
      text-transform: uppercase;
    }

    @media (max-width: 860px) {
      .alive-console,
      .ticket-row,
      .recent-row {
        grid-template-columns: 1fr;
      }

      .heartbeat-top small {
        margin-left: 0;
      }
    }

    @media (max-width: 640px) {
      .intel-shell {
        padding: 0 1.25rem 2rem;
      }

      .strip-head,
      .panel-head {
        flex-direction: column;
      }
    }
  </style>
</BaseLayout>
