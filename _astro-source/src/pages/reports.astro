---
import BaseLayout from '../layouts/BaseLayout.astro';

const labCatalog = await import('../../public/dashboard-data/public-proof-catalog.json');
const learningCatalog = await import('../../public/dashboard-data/ai-learning-catalog.json');
const reportCatalog = await import('../../public/dashboard-data/engineering-report-catalog.json');

const labProjects = labCatalog.default.projects;
const concepts = learningCatalog.default.concepts;
const guides = learningCatalog.default.guides;
const summaryMetrics = reportCatalog.default.summary_metrics;
const benchmarkMetrics = reportCatalog.default.benchmark_metrics;
const coverageBars = reportCatalog.default.coverage_bars;
const notes = reportCatalog.default.report_notes;
const reportVerifiedDate = new Date(reportCatalog.default.generated_at).toISOString().slice(0, 10);
const getSources = (project) => project.sources || [];
const getNumbers = (project) => project.numbers || [];
const getLimits = (project) => project.limits || [];
const getTags = (project) => project.tags || [];

const displayNames = {
  'aml-engine-roaster': 'Wallet Risk Engine + Assessment Notes',
  'agent-framework-proof-v2': 'Agent Workflow System',
  'agent-chess': 'Agent Chess',
  'agent-heartbeat-lab': 'Monitoring Heartbeat',
  'governance-starter-kit': 'Agent Notes Kit',
};

const totalSources = labProjects.reduce((sum, project) => sum + getSources(project).length, 0);
const totalMetrics = labProjects.reduce((sum, project) => sum + getNumbers(project).length, 0);
const totalLimitations = labProjects.reduce((sum, project) => sum + getLimits(project).length, 0);
const totalTags = labProjects.reduce((sum, project) => sum + getTags(project).length, 0);
const guideSteps = guides.reduce((sum, guide) => sum + guide.items.length, 0);

const sourceRows = labProjects.map((project) => ({
  name: displayNames[project.id] || project.name,
  sources: getSources(project).length,
  metrics: getNumbers(project).length,
  limits: getLimits(project).length,
  tags: getTags(project).length,
}));

const maxSources = Math.max(...sourceRows.map((row) => row.sources));
---
<BaseLayout title="Field Notes" description="Numbers, charts, and notes from Bionic Banker: wallet-risk measured values, agent observability, learning concepts, and visible limits.">
  <div class="page-header">
    <div class="page-label">Field Notes</div>
    <h1 class="page-title">Numbers with context</h1>
    <p class="page-sub">Some ideas only make sense when you watch them run. This page collects the signals, counts, charts, and limits from the systems already moving.</p>
  </div>

  <div class="articles-wrap">
    <div class="lab-strip">
      <div>
        <h2>A field notebook with charts</h2>
        <p>Numbers are useful when they explain what is happening. These charts keep the work readable without turning it into a pitch deck.</p>
      </div>
      <div class="lab-strip-links">
        <span>Signals</span>
        <span>Charts</span>
        <span>Limits</span>
        <a href="/projects">Systems</a>
        <a href="/gaps">Questions</a>
      </div>
    </div>
    <p class="verified-note">Notebook snapshot: {reportVerifiedDate}.</p>

    <section class="route-rail" aria-label="Bionic Banker learning route">
      <div>
        <span class="section-label">Route</span>
        <h2>Follow the evidence workflow</h2>
        <p>Start with a question, learn the term, open the risk and evidence overview, then come here for the numbers. The notes make more sense in motion.</p>
      </div>
      <div class="route-links">
        <a href="/gaps">Questions</a>
        <a href="/learn">Knowledge Base</a>
        <a href="/risk-evidence-overview">Risk & Evidence Overview</a>
        <a href="/reports">Field notes</a>
        <a href="/intelligence">Risk signals</a>
      </div>
    </section>

    <section class="report-hero-grid">
      <article class="article-card report-card">
        <div class="article-tags">
          <span class="tag-pill tag-green">Snapshot</span>
        </div>
        <h3>What is moving</h3>
        <p>The current catalog tracks {labProjects.length} systems, {totalSources} source entries, {totalMetrics} number notes, and {totalLimitations} visible limits.</p>
        <p>The learning layer adds {concepts.length} concepts and {guideSteps} guide steps, so the numbers do not float without language around them.</p>
        <div class="card-footer">
          <a class="read-more" href="/projects">Open systems -></a>
          <a class="read-more" href="/learn">Open learning layer -></a>
          <a class="read-more" href="/gaps">Open questions -></a>
        </div>
      </article>

      <article class="article-card report-card">
        <div class="article-tags">
          <span class="tag-pill tag-green">Boundary</span>
        </div>
        <h3>What this is not</h3>
        <p>This is not employer data, client data, live trading performance, or a compliance certification.</p>
        <p>It is a field note: visible artifacts, numbers that can be explained, and limits that keep the story honest.</p>
        <div class="card-footer">
          <a class="read-more" href="/dashboard-data/engineering-report-catalog.json">Open notebook data -></a>
        </div>
      </article>
    </section>

    <section class="metric-grid">
      {summaryMetrics.map((metric) => (
        <article class="metric-card">
          <span>{metric.label}</span>
          <strong>{metric.value}</strong>
          <small>{metric.unit}</small>
        </article>
      ))}
    </section>

    <section class="report-panel">
      <div class="section-label">Map</div>
      <h2>What sits behind each lane</h2>
      <p>Each lane shows how many links, numbers, limits, and tags sit behind it. This is a quick notebook map, not a ranking.</p>
      <div class="bar-list">
        {sourceRows.map((row) => (
          <div class="bar-row">
            <div class="bar-label">
              <strong>{row.name}</strong>
              <span>{row.sources} links / {row.metrics} numbers / {row.limits} limits / {row.tags} tags</span>
            </div>
            <div class="bar-track" aria-label={`${row.name} notebook bar`}>
              <div class="bar-fill" style={`width: ${(row.sources / maxSources) * 100}%`}></div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="report-panel">
      <div class="section-label">Measured Rows</div>
      <h2>Numbers worth keeping close</h2>
      <p>These values come from existing summaries. Bars use a display scale per metric family, so percentages, function counts, tests, and prediction counts stay readable without pretending they measure the same thing.</p>
      <p class="chart-note">These numbers come from test runs, not live trading. Each metric has a method note that explains what was measured and what the limit is.</p>
      <div id="benchmark-chart-data" data-metrics={JSON.stringify(benchmarkMetrics)} style="display:none"></div>
      <div class="chart-wrap benchmark-chart-wrap">
        <canvas id="benchmark-chart" aria-label="Measured numbers chart"></canvas>
      </div>
      <div class="benchmark-list">
        {benchmarkMetrics.map((metric) => (
          <div>
            <strong>{metric.label}</strong>
            <span>{metric.value} {metric.unit}. From: {metric.source}.</span>
          </div>
        ))}
      </div>
    </section>

    <section class="report-panel">
      <div class="section-label">Shape</div>
      <h2>Where the evidence feels strong or thin</h2>
      <p>This is a practical map. Wallet-risk notes, agent coordination, and observability are already readable. Deployment is the next visible question.</p>
      <div class="coverage-grid">
        {coverageBars.map((item) => (
          <div class="coverage-item">
            <div class="coverage-head">
              <strong>{item.label}</strong>
              <span>{item.value}/{item.max}</span>
            </div>
            <div class="bar-track">
              <div class="bar-fill" style={`width: ${(item.value / item.max) * 100}%`}></div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="report-panel">
      <div class="section-label">How To Read It</div>
      <h2>How to read these numbers</h2>
      <div class="notes-grid">
        {notes.map((note) => (
          <article class="article-card">
            <p>{note}</p>
          </article>
        ))}
      </div>
    </section>
  </div>

  <script>
    (function loadBenchmarkChart() {
      const dataEl = document.getElementById('benchmark-chart-data');
      if (!dataEl) return;
      const metrics = JSON.parse(dataEl.dataset.metrics || '[]');
      if (!metrics.length) return;

      function initChart() {
        const canvas = document.getElementById('benchmark-chart');
        if (!canvas || !window.Chart) return;
        const labels = metrics.map(m => m.unit || m.label);
        const values = metrics.map(m => m.value);
        const maxVal = metrics.map(m => m.scale_max || 100);
        new window.Chart(canvas, {
          type: 'bar',
          data: {
            labels,
            datasets: [{
              data: values,
              backgroundColor: 'rgba(31, 160, 104, 0.72)',
              borderColor: '#1fa068',
              borderWidth: 1,
              borderRadius: 5,
            }]
          },
          options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  label: (c) => {
                    const m = metrics[c.dataIndex];
                    return `${c.parsed.x} ${m.unit}`;
                  }
                }
              }
            },
            scales: {
              x: {
                grid: { color: 'rgba(228,228,236,0.07)' },
                ticks: { color: '#8a8aa0', font: { size: 11 } },
              },
              y: {
                grid: { display: false },
                ticks: { color: '#def8e5', font: { size: 12 } },
              }
            }
          }
        });
      }

      if (window.Chart) {
        initChart();
      } else {
        const s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js';
        s.onload = initChart;
        document.head.appendChild(s);
      }
    })();
  </script>

  <style>
    .report-hero-grid,
    .metric-grid,
    .coverage-grid,
    .notes-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1rem;
      margin-bottom: 1.25rem;
    }

    .report-panel {
      border: 1px solid rgba(31, 160, 104, 0.22);
      background: rgba(255, 255, 255, 0.035);
      border-radius: 8px;
      padding: 1.4rem;
      margin-bottom: 1.25rem;
    }

    .route-rail {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(260px, 0.8fr);
      gap: 1rem;
      align-items: center;
      border: 1px solid rgba(31, 160, 104, 0.22);
      background: rgba(31, 160, 104, 0.055);
      border-radius: 8px;
      padding: 1.1rem;
      margin-bottom: 1.25rem;
    }

    .route-rail h2 {
      margin: 0.2rem 0 0.45rem;
      font-size: clamp(1.25rem, 2.3vw, 1.9rem);
      letter-spacing: 0;
    }

    .route-rail p {
      color: var(--text-2);
      line-height: 1.65;
      margin: 0;
    }

    .route-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.55rem;
      justify-content: flex-end;
    }

    .route-links a {
      border: 1px solid rgba(228, 228, 236, 0.14);
      border-radius: 999px;
      color: var(--text);
      padding: 0.48rem 0.7rem;
      text-decoration: none;
      font-size: 0.88rem;
      background: rgba(2, 2, 4, 0.35);
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .lab-strip-links span,
    .lab-strip-links a {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .report-card .read-more {
      min-height: 44px;
      align-items: center;
    }

    .report-panel h2 {
      margin: 0.25rem 0 0.65rem;
      font-size: clamp(1.4rem, 2vw, 2rem);
    }

    .metric-card {
      border: 1px solid rgba(31, 160, 104, 0.26);
      border-radius: 8px;
      padding: 1rem;
      background: rgba(31, 160, 104, 0.08);
      min-height: 118px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .metric-card span,
    .metric-card small,
    .bar-label span,
    .coverage-head span,
    .benchmark-list span {
      color: var(--text-2);
    }

    .metric-card strong {
      color: var(--text);
      font-size: clamp(2rem, 4vw, 3.3rem);
      line-height: 1;
    }

    .bar-list {
      display: grid;
      gap: 1rem;
    }

    .bar-row,
    .coverage-item {
      display: grid;
      gap: 0.55rem;
    }

    .bar-label,
    .coverage-head {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .bar-track {
      height: 12px;
      background: rgba(228, 228, 236, 0.12);
      border-radius: 999px;
      overflow: hidden;
    }

    .bar-fill {
      height: 100%;
      background: #1fa068;
      border-radius: 999px;
    }

    .chart-wrap {
      border: 1px solid rgba(228, 228, 236, 0.12);
      border-radius: 8px;
      background: rgba(2, 2, 4, 0.6);
      margin: 1rem 0;
      padding: 1rem;
    }

    .benchmark-chart-wrap {
      height: 220px;
    }

    .benchmark-chart-wrap canvas {
      display: block;
      width: 100%;
      height: 100%;
    }

    .chart-note {
      color: var(--text-2);
      font-size: 0.83rem;
      margin: 0.35rem 0 0.75rem;
      line-height: 1.55;
    }

    .benchmark-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 0.85rem;
    }

    .benchmark-list div {
      border: 1px solid rgba(228, 228, 236, 0.12);
      border-radius: 8px;
      padding: 0.85rem;
      display: grid;
      gap: 0.35rem;
    }

    @media (max-width: 640px) {
      .report-panel {
        padding: 1rem;
      }

      .bar-label,
      .coverage-head {
        display: grid;
      }

      .route-rail {
        grid-template-columns: 1fr;
      }

      .route-links {
        justify-content: flex-start;
      }
    }
  </style>
</BaseLayout>
