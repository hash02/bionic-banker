---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Risk Signals Dashboard" description="A live signal board for market rows, DeFi yields, and wallet-risk notes from the Bionic Banker research system.">

<div class="dashboard">

    <div class="dash-header">
        <h1>Risk Signals Dashboard</h1>
        <div class="meta">
            <span><span class="live-dot"></span> Live</span>
            <span id="lastUpdate">Loading...</span>
            <a href="/" style="color:var(--accent-blue);text-decoration:none;font-size:0.8rem;">&#8592; bionicbanker.tech</a>
        </div>
    </div>

    <div class="dashboard-boundary">
        Public signal dashboard for market rows, yield context, and wallet-risk notes. This is a research and monitoring view only: no wallet power, no trading power, and no compliance filing power.
    </div>

    <div class="kpi-row" id="kpiRow"></div>

    <div class="grid-2">
        <div class="card">
            <div class="section-title"><span class="icon">&#128200;</span> Market Pulse</div>
            <div class="market-grid" id="marketGrid"></div>
        </div>
        <div class="card">
            <div class="section-title"><span class="icon">&#128311;</span> ETH Staking Yields</div>
            <div class="eth-yields" id="ethYields"></div>
        </div>
    </div>

    <div class="card" style="margin-bottom:24px;">
        <div class="section-title"><span class="icon">&#127806;</span> Top DeFi Yields (Risk-Adjusted)</div>
        <div class="table-scroll">
            <table class="yields-table" id="yieldsTable">
                <thead><tr><th>Protocol</th><th>Chain</th><th>Pool</th><th>APY</th><th>Base / Reward</th><th>TVL</th><th>Risk</th></tr></thead>
                <tbody id="yieldsBody"></tbody>
            </table>
        </div>
    </div>

    <div class="card" style="margin-bottom:24px;">
        <div class="section-title"><span class="icon">&#128293;</span> Wallet Risk Notes</div>
        <div class="aml-stats-bar" id="amlStatsBar"></div>
        <div id="riskNoteCards"></div>
    </div>

    <div class="grid-2">
        <div class="card">
            <div class="section-title"><span class="icon">&#128200;</span> Yield Distribution by Protocol</div>
            <div class="chart-wrap"><canvas id="yieldChart"></canvas></div>
        </div>
        <div class="card">
            <div class="section-title"><span class="icon">&#128737;</span> Wallet-Risk Split</div>
            <div class="chart-wrap"><canvas id="amlChart"></canvas></div>
        </div>
    </div>

    <div class="dash-footer">
        Powered by <a href="https://bionicbanker.tech">Bionic Banker</a> live notes &#8212; markets &#183; yields &#183; wallet risk &#183; reports<br>
        Data refreshes every 5 minutes &#183; Built by Himanshu
    </div>
</div>

<script>
const DEFI_URL = '/dashboard-data/defi-scout-latest.json';
const RISK_NOTES_URL = 'https://raw.githubusercontent.com/hash02/aml-roaster/main/reports/data.json';

const FALLBACK = {
    scan_time: new Date().toISOString(), status: "fallback",
    market: [
        {symbol:"BTC",price:86542.18,change_24h:1.24},{symbol:"ETH",price:2187.45,change_24h:-0.38},
        {symbol:"SOL",price:138.92,change_24h:3.15},{symbol:"AVAX",price:22.47,change_24h:-1.82},
        {symbol:"MATIC",price:0.372,change_24h:0.95},{symbol:"ARB",price:0.891,change_24h:2.44},
        {symbol:"OP",price:1.23,change_24h:-0.67},{symbol:"LINK",price:14.58,change_24h:1.89}
    ],
    top_yields: [
        {protocol:"Aave V3",chain:"Ethereum",pool:"USDC",apy:4.21,apyBase:3.82,apyReward:0.39,tvlUsd:2180000000,risk_score:4.0,flags:[]},
        {protocol:"Compound V3",chain:"Ethereum",pool:"USDC",apy:3.94,apyBase:3.94,apyReward:0,tvlUsd:1450000000,risk_score:3.9,flags:[]},
        {protocol:"Aave V3",chain:"Arbitrum",pool:"USDC",apy:5.12,apyBase:4.15,apyReward:0.97,tvlUsd:340000000,risk_score:4.5,flags:[]},
        {protocol:"Spark",chain:"Ethereum",pool:"DAI",apy:6.50,apyBase:6.50,apyReward:0,tvlUsd:890000000,risk_score:6.5,flags:[]},
        {protocol:"Morpho",chain:"Ethereum",pool:"USDC",apy:7.83,apyBase:3.21,apyReward:4.62,tvlUsd:210000000,risk_score:5.1,flags:["reward-heavy"]},
        {protocol:"Fluid",chain:"Ethereum",pool:"USDC-USDT",apy:12.45,apyBase:4.80,apyReward:7.65,tvlUsd:85000000,risk_score:6.6,flags:["reward-heavy"]},
        {protocol:"Pendle",chain:"Ethereum",pool:"sUSDe PT",apy:18.20,apyBase:18.20,apyReward:0,tvlUsd:450000000,risk_score:18.2,flags:["too-high"]},
        {protocol:"Venus",chain:"BSC",pool:"USDT",apy:5.67,apyBase:3.90,apyReward:1.77,tvlUsd:520000000,risk_score:4.5,flags:[]}
    ],
    eth_yields: [
        {protocol:"Lido",pool:"stETH",apy:3.2,tvlUsd:14500000000},
        {protocol:"Rocket Pool",pool:"rETH",apy:2.9,tvlUsd:3200000000},
        {protocol:"Aave V3",pool:"WETH",apy:1.8,tvlUsd:1800000000}
    ],
    aml_stats: {detection_rate:94.9,rules_active:28,transactions_scanned:12847,flagged:3,clean:12844}
};

const FALLBACK_ROASTS = {
    stats:{total_scans:24,total_findings:2,highest_score:530,attention_count:2},
    findings:[
        {timestamp:"2026-03-08T06:32:00Z",risk_score:530,
         what_happened:"Sample row matched several routing and mixer-style signals in the same transaction window.",
         public_note:"This row is worth slowing down on. The transaction path matters more than the amount.",
         boundary_note:"A score is a sorting tool. Review the surrounding context before drawing conclusions.",
         rules:["mixer_touch","ofac_hit","mixer_contract_call","structuring","peel_chain_linear","exchange_avoidance"],
         pattern:"Mixer-style routing + structuring"},
        {timestamp:"2026-03-07T18:15:00Z",risk_score:400,
         what_happened:"Sample row matched multiple routing signals at once.",
         public_note:"One signal is a note. Several signals at the same time become a pattern to inspect.",
         boundary_note:"The note explains why the system paused. It does not claim intent.",
         rules:["mixer_touch","ofac_hit","mixer_contract_call","exchange_avoidance"],
         pattern:"Mixer-style routing"}
    ]
};

function fmt(n){if(n>=1e9)return'$'+(n/1e9).toFixed(1)+'B';if(n>=1e6)return'$'+(n/1e6).toFixed(0)+'M';if(n>=1e3)return'$'+(n/1e3).toFixed(0)+'K';return'$'+n.toFixed(2)}
function fmtP(n){if(n>=1000)return'$'+n.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});return n>=1?'$'+n.toFixed(2):'$'+n.toFixed(3)}
function ago(ts){const d=Date.now()-new Date(ts).getTime(),h=Math.floor(d/36e5),m=Math.floor((d%36e5)/6e4);if(h>24)return Math.floor(h/24)+'d ago';return h>0?h+'h '+m+'m ago':m+'m ago'}
function riskCls(s){return s<=5?'low':s<=10?'med':'high'}
function sevCls(s){return s>=400?'attention':s>=200?'high':'medium'}

function renderKPIs(d,r){
    const btc=d.market.find(m=>m.symbol==='BTC')||{price:0,change_24h:0};
    const eth=d.market.find(m=>m.symbol==='ETH')||{price:0,change_24h:0};
    const best=d.top_yields.reduce((a,b)=>a.apy>b.apy?a:b,{apy:0,protocol:''});
    const kpis=[
        {l:'BTC',v:fmtP(btc.price),c:btc.change_24h},
        {l:'ETH',v:fmtP(eth.price),c:eth.change_24h},
        {l:'Best Yield',v:best.apy.toFixed(1)+'%',s:best.protocol},
        {l:'Detection Rate',v:d.aml_stats.detection_rate+'%',s:d.aml_stats.rules_active+' rules'},
        {l:'Rows Read',v:(r.stats?r.stats.total_scans:0).toLocaleString(),s:(r.stats?r.stats.total_findings:0)+' attention rows'}
    ];
    document.getElementById('kpiRow').innerHTML=kpis.map(k=>`<div class="kpi-card"><div class="kpi-label">${k.l}</div><div class="kpi-value">${k.v}</div>${k.c!==undefined?`<div class="kpi-change ${k.c>=0?'up':'down'}">${k.c>=0?'\u25B2':'\u25BC'} ${Math.abs(k.c).toFixed(2)}%</div>`:''}${k.s?`<div style="font-size:0.7rem;color:var(--text-muted);margin-top:2px">${k.s}</div>`:''}</div>`).join('');
}

function renderMarket(m){
    document.getElementById('marketGrid').innerHTML=m.map(c=>`<div class="market-item"><div><div class="sym">${c.symbol}</div><div class="price">${fmtP(c.price)}</div></div><div class="chg ${c.change_24h>=0?'up':'down'}">${c.change_24h>=0?'\u25B2':'\u25BC'} ${Math.abs(c.change_24h).toFixed(2)}%</div></div>`).join('');
}

function renderEth(y){
    document.getElementById('ethYields').innerHTML=y.map(e=>`<div class="eth-item"><div class="proto">${e.protocol}</div><div class="pool-name">${e.pool}</div><div class="eth-apy">${e.apy.toFixed(1)}%</div><div class="tvl">TVL: ${fmt(e.tvlUsd)}</div></div>`).join('');
}

function renderYields(y){
    document.getElementById('yieldsBody').innerHTML=y.sort((a,b)=>a.risk_score-b.risk_score).map(y=>`<tr><td style="color:var(--text-primary);font-weight:500">${y.protocol}</td><td>${y.chain}</td><td>${y.pool}</td><td class="apy">${y.apy.toFixed(2)}%</td><td><span style="color:var(--text-secondary)">${y.apyBase.toFixed(1)}%</span>${y.apyReward>0?`<span style="color:var(--accent-purple)"> + ${y.apyReward.toFixed(1)}%</span>`:''}</td><td>${fmt(y.tvlUsd)}</td><td><span class="risk-badge risk-${riskCls(y.risk_score)}">${y.risk_score.toFixed(1)}</span>${y.flags.map(f=>`<span class="flag-badge">${f}</span>`).join('')}</td></tr>`).join('');
}

function renderAMLStats(d,r){
    const s=[
        {v:d.aml_stats.detection_rate+'%',l:'Detection Rate',c:'var(--green)'},
        {v:d.aml_stats.rules_active,l:'Active Rules',c:'var(--accent-blue)'},
        {v:r.stats?r.stats.total_scans:'\u2014',l:'Scans (24h)',c:'var(--text-primary)'},
        {v:r.stats?r.stats.total_findings:'\u2014',l:'Attention Rows',c:'var(--red)'},
        {v:r.stats?r.stats.highest_score:'\u2014',l:'Highest Score',c:'var(--orange)'}
    ];
    document.getElementById('amlStatsBar').innerHTML=s.map(x=>`<div class="aml-stat"><div class="val" style="color:${x.c}">${x.v}</div><div class="lbl">${x.l}</div></div>`).join('');
}

function renderRiskNotes(f){
    if(!f||!f.length){document.getElementById('riskNoteCards').innerHTML='<div style="text-align:center;padding:20px;color:var(--text-muted)">No attention rows in the current scan window.</div>';return}
    document.getElementById('riskNoteCards').innerHTML=f.map(r=>{
        const sv=sevCls(r.risk_score),ru=r.rules||[];
        const what=safeWhatFor(r,ru);
        const note=r.public_note||publicNoteFor(r,ru);
        const boundary=r.boundary_note||'A score is a sorting tool. The next step is context.';
        return`<div class="risk-note-card ${sv}"><div class="risk-note-header"><div><span class="risk-note-score ${sv}">Score: ${r.risk_score}</span><span style="margin-left:10px;font-size:0.75rem;color:var(--text-muted)">${r.pattern||'Wallet-risk pattern'}</span></div><div class="risk-note-meta"><span>${ago(r.timestamp)}</span></div></div><div style="font-size:0.75rem;color:var(--text-muted);margin-bottom:8px">${what}</div><div class="risk-note-text">\u201C${note}\u201D</div>${ru.length?`<div class="risk-note-rules">${ru.map(x=>`<span class="rule-tag">${x}</span>`).join('')}</div>`:''}<div class="boundary-box"><div class="boundary-label">What it cannot do</div><div style="color:var(--text-secondary);font-size:0.78rem;margin-top:3px">${boundary}</div></div></div>`}).join('');
}

function publicNoteFor(r,ru){
    const pattern=(r.pattern||'').toLowerCase();
    if(pattern.includes('mixer'))return'This row is worth slowing down on. The transaction path matters more than the amount.';
    if(pattern.includes('bridge'))return'The tempo is the signal: move, hop, move again.';
    if(ru.length>=4)return'One rule is a note. Several rules together become a pattern to inspect.';
    return'The system paused here because the row has enough shape to deserve another look.';
}

function safeWhatFor(r,ru){
    if(r.public_note||r.boundary_note)return r.what_happened||`Sample row matched ${ru.length||'several'} wallet-risk signal${ru.length===1?'':'s'}.`;
    return`Sample row matched ${ru.length||'several'} wallet-risk signal${ru.length===1?'':'s'}.`;
}

let yieldChartInst=null, amlChartInst=null;

function renderYieldChart(y){
    if(!window.Chart)return;
    if(yieldChartInst)yieldChartInst.destroy();
    const ctx=document.getElementById('yieldChart').getContext('2d');
    const s=[...y].sort((a,b)=>b.apy-a.apy).slice(0,8);
    yieldChartInst=new Chart(ctx,{type:'bar',data:{labels:s.map(x=>x.protocol+' ('+x.pool+')'),datasets:[{label:'Base APY',data:s.map(x=>x.apyBase),backgroundColor:'rgba(31,160,104,0.7)',borderRadius:4},{label:'Reward APY',data:s.map(x=>x.apyReward),backgroundColor:'rgba(158,230,181,0.45)',borderRadius:4}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'top',labels:{color:'#9ee6b5',font:{size:10}}}},scales:{x:{stacked:true,ticks:{color:'#2f6540',font:{size:9}},grid:{display:false}},y:{stacked:true,ticks:{color:'#55556a',callback:v=>v+'%'},grid:{color:'rgba(26,26,46,0.5)'}}}}});
}

function renderAMLChart(st){
    if(!window.Chart)return;
    if(amlChartInst)amlChartInst.destroy();
    const ctx=document.getElementById('amlChart').getContext('2d');
    amlChartInst=new Chart(ctx,{type:'doughnut',data:{labels:['Quiet','Attention'],datasets:[{data:[st.clean||12844,st.flagged||3],backgroundColor:['rgba(31,160,104,0.8)','rgba(31,160,104,0.35)'],borderWidth:0,hoverOffset:8}]},options:{responsive:true,maintainAspectRatio:false,cutout:'65%',plugins:{legend:{position:'bottom',labels:{color:'#8888a0',font:{size:11},padding:16}},tooltip:{callbacks:{label:function(c){const t=c.dataset.data.reduce((a,b)=>a+b,0);return c.label+': '+c.parsed.toLocaleString()+' ('+(c.parsed/t*100).toFixed(1)+'%)'}}}}}});
}

async function init(){
    let d=FALLBACK, r=FALLBACK_ROASTS;
    try{const res=await fetch(DEFI_URL+'?t='+Date.now());if(res.ok)d=await res.json()}catch(e){}
    try{const res=await fetch(RISK_NOTES_URL+'?t='+Date.now());if(res.ok){const raw=await res.json();if(raw.stats&&raw.findings)r=raw}}catch(e){}
    document.getElementById('lastUpdate').textContent='Updated: '+ago(d.scan_time||new Date().toISOString());
    renderKPIs(d,r);renderMarket(d.market||[]);renderEth(d.eth_yields||[]);
    renderYields(d.top_yields||[]);renderAMLStats(d,r);renderRiskNotes(r.findings||d.aml_risk_notes||[]);
    renderYieldChart(d.top_yields||[]);renderAMLChart(d.aml_stats||{});
}

init();
setInterval(init,300000);
</script>

<style>


        :root {
            --bg-deep: #010302;
            --bg-main: #080810;
            --bg-card: #0c0c14;
            --bg-card-hover: #101018;
            --border: rgba(31,160,104,0.13);
            --text-primary: var(--text);
            --text-secondary: #8888a0;
            --text-muted: #55556a;
            --accent-blue: #1fa068;
            --accent-purple: #1fa068;
            --green: #1fa068;
            --green-dim: rgba(31, 160, 104, 0.15);
            --red: #1fa068;
            --red-dim: rgba(31, 160, 104, 0.12);
            --orange: #1fa068;
            --orange-dim: rgba(31, 160, 104, 0.12);
            --gradient: linear-gradient(135deg, #1fa068, #34d399);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg-deep);
            color: var(--text-primary);
            line-height: 1.6;
            min-height: 100vh;
        }

        .dashboard { max-width: 1400px; margin: 0 auto; padding: 24px 20px; }

        /* Header */
        .dash-header {
            display: flex; justify-content: space-between; align-items: center;
            gap: 16px;
            margin-bottom: 16px; padding-bottom: 20px; border-bottom: 1px solid var(--border);
        }
        .dash-header h1 {
            font-size: 1.5rem; font-weight: 700;
            background: var(--gradient); -webkit-background-clip: text;
            -webkit-text-fill-color: transparent; background-clip: text;
        }
        .dashboard-boundary {
            background: rgba(31,160,104,0.07);
            border: 1px solid var(--border);
            border-left: 3px solid var(--green);
            border-radius: 10px;
            color: var(--text-secondary);
            font-size: 0.84rem;
            line-height: 1.6;
            margin-bottom: 24px;
            padding: 14px 16px;
        }
        .dash-header .meta {
            display: flex; align-items: center; flex-wrap: wrap; gap: 12px 16px;
            font-size: 0.8rem; color: var(--text-muted);
        }
        .live-dot {
            width: 8px; height: 8px; background: var(--green);
            border-radius: 50%; display: inline-block; animation: pulse 2s infinite;
        }
        @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }

        /* KPI Cards */
        .kpi-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 14px; margin-bottom: 24px; }
        .kpi-card {
            background: var(--bg-card); border: 1px solid var(--border);
            border-radius: 12px; padding: 18px; transition: border-color 0.2s;
        }
        .kpi-card:hover { border-color: var(--accent-blue); }
        .kpi-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 6px; }
        .kpi-value { font-size: 1.5rem; font-weight: 700; color: var(--text-primary); }
        .kpi-change { font-size: 0.75rem; margin-top: 4px; }
        .kpi-change.up { color: var(--green); }
        .kpi-change.down { color: var(--red); }

        .section-title { font-size: 1.05rem; font-weight: 600; margin-bottom: 14px; display: flex; align-items: center; gap: 8px; }
        .section-title .icon { font-size: 1.1rem; }

        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-bottom: 24px; }
        @media (max-width: 900px) { .grid-2 { grid-template-columns: 1fr; } }

        .card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 20px; min-width: 0; overflow: hidden; }

        /* Market Grid */
        .market-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(145px, 1fr)); gap: 10px; }
        .market-item {
            background: var(--bg-deep); border: 1px solid var(--border); border-radius: 8px;
            padding: 12px; display: flex; justify-content: space-between; align-items: center;
        }
        .market-item .sym { font-weight: 600; font-size: 0.85rem; }
        .market-item .price { font-size: 0.85rem; color: var(--text-secondary); }
        .market-item .chg { font-size: 0.72rem; font-weight: 600; }
        .market-item .chg.up { color: var(--green); }
        .market-item .chg.down { color: var(--red); }

        /* Yields Table */
        .table-scroll { max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
        .yields-table { width: 100%; min-width: 620px; border-collapse: collapse; font-size: 0.82rem; }
        .yields-table th {
            text-align: left; font-size: 0.68rem; text-transform: uppercase;
            letter-spacing: 0.06em; color: var(--text-muted); padding: 8px 10px;
            border-bottom: 1px solid var(--border);
        }
        .yields-table td { padding: 10px; border-bottom: 1px solid rgba(26,26,46,0.5); color: var(--text-secondary); }
        .yields-table tr:hover td { background: rgba(31,160,104,0.055); }
        .yields-table .apy { font-weight: 700; color: var(--green); }
        .risk-badge { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 0.68rem; font-weight: 600; }
        .risk-low { background: var(--green-dim); color: var(--green); }
        .risk-med { background: var(--orange-dim); color: var(--orange); }
        .risk-high { background: var(--red-dim); color: var(--red); }
        .flag-badge { display: inline-block; padding: 2px 6px; border-radius: 6px; font-size: 0.62rem; background: rgba(31,160,104,0.12); color: var(--accent); margin-left: 4px; }

        /* Assessment note cards */
        .risk-note-card {
            background: var(--bg-deep); border: 1px solid var(--border); border-radius: 10px;
            padding: 16px; margin-bottom: 12px; position: relative; overflow: hidden;
        }
        .risk-note-card::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; }
        .risk-note-card.attention::before { background: var(--red); }
        .risk-note-card.high::before { background: var(--orange); }
        .risk-note-card.medium::before { background: var(--accent-blue); }
        .risk-note-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
        .risk-note-score { font-size: 1.1rem; font-weight: 700; }
        .risk-note-score.attention { color: var(--red); }
        .risk-note-score.high { color: var(--orange); }
        .risk-note-meta { font-size: 0.7rem; color: var(--text-muted); }
        .risk-note-text { font-size: 0.82rem; color: var(--text-secondary); line-height: 1.6; font-style: italic; margin-bottom: 10px; }
        .risk-note-rules { display: flex; flex-wrap: wrap; gap: 5px; }
        .rule-tag { display: inline-block; padding: 2px 8px; border-radius: 6px; font-size: 0.62rem; font-weight: 500; background: var(--red-dim); color: var(--red); }
        .boundary-box { margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--border); font-size: 0.75rem; }
        .boundary-label { font-weight: 600; color: var(--text-muted); text-transform: uppercase; font-size: 0.65rem; letter-spacing: 0.05em; }

        /* ETH Staking */
        .eth-yields { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
        @media (max-width: 600px) { .eth-yields { grid-template-columns: 1fr; } }
        .eth-item { background: var(--bg-deep); border: 1px solid var(--border); border-radius: 8px; padding: 14px; text-align: center; }
        .eth-item .proto { font-size: 0.78rem; font-weight: 600; margin-bottom: 4px; }
        .eth-item .pool-name { font-size: 0.68rem; color: var(--text-muted); margin-bottom: 8px; }
