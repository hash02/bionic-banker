---
import BaseLayout from './BaseLayout.astro';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description: string;
  date: string;
  tags: string[];
  readTime: string;
  image?: string;
  category?: string;
}

const { title, description, date, tags, readTime, image, category = 'Tech' } = Astro.props;

const allPosts = await getCollection('blog');
const currentPath = Astro.url.pathname;
const currentSlug = currentPath.replace(/^\/blog\//, '').replace(/\/$/, '');
const getPostSlug = (post: typeof allPosts[number]) => post.data.slug || post.id;

const related = allPosts
  .filter(p => getPostSlug(p) !== currentSlug)
  .filter(p => {
    const pt = (p.data.tags || []).map((t: string) => t.toLowerCase());
    const ct = (tags || []).map((t: string) => t.toLowerCase());
    return ct.some(c => pt.some(t => t.includes(c) || c.includes(t)));
  })
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
const isoDate = new Date(date).toISOString();
const articleURL = new URL(Astro.url.pathname, Astro.site).href;
const imageURL = image ? new URL(image, Astro.site).href : undefined;
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "datePublished": isoDate,
  "dateModified": isoDate,
  "author": {
    "@type": "Person",
    "name": "Himanshu",
    "url": "https://linkedin.com/in/himanshu-h-a357684a"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Bionic Banker",
    "url": "https://bionicbanker.tech"
  },
  "mainEntityOfPage": articleURL,
  ...(imageURL ? { "image": imageURL } : {}),
  "keywords": tags.join(", ")
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://bionicbanker.tech" },
    { "@type": "ListItem", "position": 2, "name": "Articles", "item": "https://bionicbanker.tech/articles" },
    { "@type": "ListItem", "position": 3, "name": title, "item": articleURL }
  ]
};
---
<BaseLayout title={title} description={description} ogImage={image}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div id="reading-progress" aria-hidden="true"></div>
  <script is:inline>
  (function() {
    var bar = document.getElementById('reading-progress');
    if (!bar) return;
    function update() {
      var doc = document.documentElement;
      var scrolled = doc.scrollTop || document.body.scrollTop;
      var total = doc.scrollHeight - doc.clientHeight;
      bar.style.width = (total > 0 ? (scrolled / total) * 100 : 0) + '%';
    }
    window.addEventListener('scroll', update, { passive: true });
    update();
  })();
  </script>
  <style>
    #reading-progress {
      position: fixed; top: 56px; left: 0; z-index: 99;
      height: 2px; width: 0%;
      background: #1fa068;
      box-shadow: 0 0 8px rgba(31,160,104,0.5);
      transition: width 80ms linear;
      pointer-events: none;
    }
  </style>

  <article class="article-page">
    <div class="article-hero">
      <div class="article-meta-top">
        <span class="article-category">{category}</span>
        <span class="article-date">{formattedDate}</span>
        <span class="article-read-time">{readTime} read</span>
      </div>
      <h1 class="article-title">{title}</h1>
      <p class="article-desc">{description}</p>
      <div class="article-tags">
        {tags.map((tag: string) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </div>

    <nav id="article-toc" class="article-toc" aria-label="In this article"></nav>

    <div class="article-body">
      <slot />
    </div>

    {related.length > 0 && (
      <section class="related-articles">
        <h2 class="related-heading">Keep reading</h2>
        <div class="related-grid">
          {related.map(post => (
            <a href={`/blog/${getPostSlug(post)}/`} class="related-card">
              <span class="related-cat">{post.data.category || 'Article'}</span>
              <strong class="related-title">{post.data.title}</strong>
              <span class="related-meta">{post.data.readTime} read</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <div class="article-footer">
      <div class="article-share">
        <span>Share this:</span>
        <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(`https://bionicbanker.tech${Astro.url.pathname}`)}`} target="_blank" rel="noopener" class="share-btn">X / Twitter</a>
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`https://bionicbanker.tech${Astro.url.pathname}`)}`} target="_blank" rel="noopener" class="share-btn">LinkedIn</a>
        <button class="share-btn copy-link-btn" data-url={`https://bionicbanker.tech${Astro.url.pathname}`}>Copy link</button>
      </div>
      <a href="/articles" class="back-to-articles">&larr; All Articles</a>
    </div>
  </article>

  <button id="back-to-top" aria-label="Back to top" title="Back to top">&#8593;</button>

  <script is:inline>
  (function() {
    // Copy link
    var copyBtn = document.querySelector('.copy-link-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', function() {
        var url = this.dataset.url;
        if (navigator.clipboard) {
          navigator.clipboard.writeText(url).then(function() {
            copyBtn.textContent = 'Copied!';
            setTimeout(function() { copyBtn.textContent = 'Copy link'; }, 1800);
          });
        } else {
          copyBtn.textContent = 'Copied!';
          setTimeout(function() { copyBtn.textContent = 'Copy link'; }, 1800);
        }
      });
    }

    // Back to top
    var btt = document.getElementById('back-to-top');
    if (btt) {
      window.addEventListener('scroll', function() {
        btt.classList.toggle('btt-visible', window.scrollY > 500);
      }, { passive: true });
      btt.addEventListener('click', function() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // Table of contents
    var body = document.querySelector('.article-body');
    var toc = document.getElementById('article-toc');
    if (!body || !toc) return;
    var headings = Array.from(body.querySelectorAll('h2, h3'));
    if (headings.length < 2) { toc.style.display = 'none'; return; }
    var items = headings.map(function(h, i) {
      if (!h.id) h.id = 'h-' + i;
      var level = h.tagName === 'H2' ? 'toc-h2' : 'toc-h3';
      return '<li class="' + level + '"><a href="#' + h.id + '">' + h.textContent + '</a></li>';
    });
    toc.innerHTML = '<span class="toc-label">In this article</span><ul>' + items.join('') + '</ul>';

    // Highlight active TOC item on scroll
    var links = Array.from(toc.querySelectorAll('a'));
    var hs = headings;
    window.addEventListener('scroll', function() {
      var scrollY = window.scrollY + 90;
      var active = hs.reduce(function(acc, h) {
        return h.offsetTop <= scrollY ? h : acc;
      }, hs[0]);
      if (!active) return;
      links.forEach(function(l) { l.classList.remove('toc-active'); });
      var al = toc.querySelector('a[href="#' + active.id + '"]');
      if (al) al.classList.add('toc-active');
    }, { passive: true });
  })();
  </script>

  <style>
    #back-to-top {
      position: fixed; bottom: 2rem; right: 1.5rem; z-index: 90;
      width: 40px; height: 40px; border-radius: 50%;
      background: #1fa068; color: #010302; border: none;
      font-size: 1.1rem; font-weight: 700; cursor: pointer;
      display: none; align-items: center; justify-content: center;
      box-shadow: 0 2px 12px rgba(31,160,104,0.35);
      transition: opacity 0.2s, transform 0.2s;
    }
    #back-to-top.btt-visible { display: flex; }
    #back-to-top:hover { transform: translateY(-2px); }

    .article-toc {
      display: block;
      position: relative;
      z-index: 2;
      background: #031008;
      border: 1px solid rgba(31,160,104,0.20);
      border-radius: 8px;
      padding: 1rem 1.25rem 1rem;
      margin: 0 0 2rem;
      width: 100%;
      max-width: 540px;
      box-sizing: border-box;
    }
    .article-toc:has(ul) {
      min-height: 11rem;
      overflow: hidden;
    }
    .article-toc:empty { display: none; }
    .article-toc :global(.toc-label) {
      display: block; font-size: 0.72rem; font-family: var(--mono);
      color: #1fa068; text-transform: uppercase; letter-spacing: 0.08em;
      margin-bottom: 0.6rem;
    }
    .article-toc :global(ul) { list-style: none; margin: 0; padding: 0; }
    .article-toc :global(li) { margin: 0.25rem 0; }
    .article-toc :global(.toc-h3) { padding-left: 1rem; }
    .article-toc :global(a) {
      display: block;
      color: var(--text-2); font-size: 0.85rem; text-decoration: none;
      line-height: 1.4; transition: color 0.15s;
    }
    .article-toc :global(a:hover), .article-toc :global(a.toc-active) { color: #1fa068; }

    .related-articles {
      margin: 3rem 0 0;
      padding-top: 2rem;
      border-top: 1px solid rgba(31,160,104,0.1);
    }
    .related-heading {
      font-size: 1rem; font-family: var(--mono); color: var(--text-3);
      text-transform: uppercase; letter-spacing: 0.06em;
      margin: 0 0 1rem; font-weight: 400;
    }
    .related-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 0.75rem;
    }
    .related-card {
      display: flex; flex-direction: column; gap: 0.3rem;
      padding: 1rem; border-radius: 8px;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.06);
      text-decoration: none; transition: border-color 0.18s, box-shadow 0.18s;
    }
    .related-card:hover {
      border-color: rgba(31,160,104,0.3);
      box-shadow: 0 0 16px rgba(31,160,104,0.08);
    }
    .related-cat { font-size: 0.68rem; font-family: var(--mono); color: #1fa068; text-transform: uppercase; letter-spacing: 0.06em; }
    .related-title { font-size: 0.88rem; color: var(--text-1); line-height: 1.4; }
    .related-meta { font-size: 0.72rem; color: var(--text-3); font-family: var(--mono); }

    .copy-link-btn {
      background: transparent;
      border: 1px solid rgba(255,255,255,0.12);
      color: var(--text-2);
      cursor: pointer;
      font-family: var(--mono);
      font-size: 0.78rem;
      padding: 0.35rem 0.8rem;
      border-radius: 4px;
      transition: border-color 0.15s, color 0.15s;
    }
    .copy-link-btn:hover { border-color: #1fa068; color: #1fa068; }

    .article-share .share-btn {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
    }

    @media (max-width: 640px) {
      .article-toc {
        max-width: none;
        padding: 0.9rem 1rem;
      }
      .article-toc :global(li) {
        margin: 0.35rem 0;
      }
      .article-share {
        align-items: stretch;
      }
      .article-share .share-btn {
        justify-content: center;
      }
    }
  </style>
</BaseLayout>
