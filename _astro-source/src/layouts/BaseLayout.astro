---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const { title, description = "Inside finance. Mapping AI systems, risk signals, source trails, and reports.", ogImage, canonical } = Astro.props;
const fullTitle = title === 'Home' ? 'Bionic Banker - AI Finance System Map' : `${title} - Bionic Banker`;
const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = ogImage ? new URL(ogImage, Astro.site).href : undefined;
const isHome = title === 'Home';
const routeDepth = Astro.url.pathname === '/' ? 0 : Astro.url.pathname.split('/').filter(Boolean).length;
const relativeAssetRoot = routeDepth === 0 ? './' : '../'.repeat(routeDepth);
const globalCssVersion = 'green-theme-consistent-053955d';
---
<!DOCTYPE html>
<html lang="en">
<head><style>body,html{background:#010302}canvas{background:transparent}</style>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Himanshu" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-YS428H3H44"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-YS428H3H44');
  </script>

  <!-- Open Graph -->
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={isHome ? "website" : "article"} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="Bionic Banker" />
  {ogImageURL && <meta property="og:image" content={ogImageURL} />}
  <meta name="twitter:card" content={ogImageURL ? "summary_large_image" : "summary"} />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}
  <meta name="twitter:site" content="@BionicBanker" />
  <meta name="twitter:creator" content="@BionicBanker" />
  <link rel="canonical" href={canonicalURL} />
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

  <!-- JSON-LD Structured Data -->
  {isHome ? (
    <>
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Bionic Banker",
        "url": "https://bionicbanker.tech",
        "description": description,
        "author": {
          "@type": "Person",
          "name": "Himanshu",
          "url": "https://bionicbanker.tech"
        }
      })} />
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Himanshu",
        "url": "https://bionicbanker.tech",
        "jobTitle": "Computer Engineer and Financial Advisor",
        "description": "Computer engineer and financial advisor building AI systems for finance, blockchain AML detection, and agent infrastructure.",
        "sameAs": [
          "https://linkedin.com/in/himanshu-h-a357684a",
          "https://github.com/hash02",
          "https://t.me/BionicBanker"
        ],
        "knowsAbout": ["Blockchain", "AML Detection", "AI Agents", "DeFi", "Fintech", "Compliance"]
      })} />
    </>
  ) : null}

  <!-- Styles -->
  <link rel="stylesheet" href={`/styles/global.css?v=${globalCssVersion}`} />
  <link rel="stylesheet" href={`${relativeAssetRoot}styles/global.css?v=${globalCssVersion}`} />

  <!-- Lottie player (custom element, defer safe) -->
  <script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js" defer></script>
</head>
<body>
  <!-- NAV -->
  <nav>
    <a href="/" class="nav-logo">Bionic <span>Banker</span></a>
    <div class="nav-right">
      <ul class="nav-links">
        <li><a href="/articles">Articles</a></li>
        <li><a href="/ai-models">AI Intelligence</a></li>
        <li><a href="/risk-evidence/">Risk Profiles</a></li>
        <li><a href="/signals">Signals</a></li>
        <li><a href="/about">About</a></li>
      </ul>
      <a href="https://t.me/BionicBanker" class="nav-cta" target="_blank" rel="noopener">Join Telegram</a>
    </div>
    <button id="bb-hamburger" aria-label="Menu">&#9776;</button>
  </nav>

  <!-- MAIN CONTENT -->
  <slot />

  <!-- NEWSLETTER -->
  <section id="newsletter" class="newsletter-section">
    <div class="newsletter-wrap">
      <h2>Stay in the Loop</h2>
      <p>Get source notes and system records when Bionic Banker publishes a finance and AI source report. No trading calls, no hype.</p>
      <form action="https://formspree.io/f/xdaljypn" method="POST" class="newsletter-form">
        <input type="hidden" name="_form_type" value="newsletter">
        <input type="hidden" name="_subject" value="New Bionic Banker newsletter subscriber">
        <input type="text" name="_gotcha" style="display:none !important" tabindex="-1" autocomplete="off" aria-hidden="true">
        <input type="email" name="email" placeholder="you@domain.com" required class="newsletter-input" aria-label="Email address">
        <button type="submit" class="nl-btn primary">Subscribe</button>
      </form>
      <div class="newsletter-actions newsletter-secondary-row">
        <a href="/updates" class="nl-btn secondary">Read the update promise</a>
        <a href="https://t.me/BionicBanker" class="nl-btn secondary" target="_blank" rel="noopener">Or join the Telegram</a>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="site-footer">
    <div class="footer-wrap">
      <div class="footer-brand">
        <a href="/" class="footer-logo">Bionic <span>Banker</span></a>
        <p class="footer-tagline">AI finance research on models, crypto, risk, and source-backed systems.</p>
      </div>
      <div class="footer-links">
        <div class="footer-col">
          <h4>Explore</h4>
          <a href="/articles">Articles</a>
          <a href="/ai-models">AI Intelligence</a>
          <a href="/risk-evidence/">Risk Profiles</a>
          <a href="/signals">Signals</a>
          <a href="/about">About</a>
          <a href="/updates">Updates</a>
        </div>
        <div class="footer-col">
          <h4>Connect</h4>
          <a href="https://t.me/BionicBanker" target="_blank" rel="noopener">Telegram</a>
          <a href="https://linkedin.com/in/himanshu-h-a357684a" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://github.com/hash02" target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} Bionic Banker. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <!-- Mobile Menu -->
  <script is:inline>
  (function() {
    var hamburger = document.getElementById('bb-hamburger');
    if (!hamburger) return;

    var overlay = document.createElement('div');
    overlay.id = 'bb-overlay';
    document.body.appendChild(overlay);

    var panel = document.createElement('div');
    panel.id = 'bb-panel';
    panel.innerHTML =
      '<button id="bb-panel-close" aria-label="Close menu">&times;</button>' +
      '<a href="/articles" class="bb-panel-primary">Articles</a>' +
      '<a href="/ai-models" class="bb-panel-primary">AI Intelligence</a>' +
      '<a href="/risk-evidence/" class="bb-panel-primary">Risk Profiles</a>' +
      '<a href="/signals" class="bb-panel-primary">Signals</a>' +
      '<a href="/about" class="bb-panel-primary">About</a>' +
      '<a href="https://t.me/BionicBanker" class="bb-panel-cta" target="_blank" rel="noopener">Join Telegram</a>';
    document.body.appendChild(panel);

    function openMenu() { panel.classList.add('open'); overlay.classList.add('open'); document.body.style.overflow = 'hidden'; }
    function closeMenu() { panel.classList.remove('open'); overlay.classList.remove('open'); document.body.style.overflow = ''; }

    hamburger.addEventListener('click', openMenu);
    document.getElementById('bb-panel-close').addEventListener('click', closeMenu);
    overlay.addEventListener('click', closeMenu);
    panel.querySelectorAll('a').forEach(function(a) { a.addEventListener('click', closeMenu); });
  })();
  </script>


  <!-- 3D background handled by ParticleHero component on homepage -->
  <!-- Scroll Animations - GSAP ScrollTrigger with IO fallback -->
  <script is:inline>
  (function() {
    function initGSAP() {
      if (!window.gsap || !window.ScrollTrigger) return;
      window.gsap.registerPlugin(window.ScrollTrigger);

      window.gsap.utils.toArray('.animate-on-scroll').forEach(function(el) {
        window.gsap.fromTo(el,
          { opacity: 0, y: 28 },
          { opacity: 1, y: 0, duration: 0.55, ease: 'power2.out',
            scrollTrigger: { trigger: el, start: 'top 88%', once: true }
          }
        );
      });

      window.gsap.utils.toArray('.proof-route-grid, .mag-grid').forEach(function(grid) {
        var cards = grid.querySelectorAll('.article-card, .moving-now-card');
        if (!cards.length) return;
        window.gsap.fromTo(cards,
          { opacity: 0, y: 20 },
          { opacity: 1, y: 0, duration: 0.4, stagger: 0.08, ease: 'power2.out',
            scrollTrigger: { trigger: grid, start: 'top 85%', once: true }
          }
        );
      });
    }

    function revealElement(el) {
      el.classList.add('animate-in');
      el.style.opacity = '1';
      el.style.transform = 'translateY(0)';
      if (el.matches && el.matches('.proof-route-grid, .mag-grid')) {
        Array.prototype.slice.call(el.querySelectorAll('.article-card, .article-card-featured, .moving-now-card')).forEach(function(card) {
          card.dataset.revealed = '1';
          card.classList.add('animate-in');
          card.style.opacity = '1';
          card.style.transform = 'translateY(0)';
        });
      }
    }

    function initRevealFallback() {
      var targets = Array.prototype.slice.call(document.querySelectorAll('.animate-on-scroll'));
      var cardTargets = Array.prototype.slice.call(document.querySelectorAll('.proof-route-grid .article-card, .mag-grid .article-card, .mag-grid .article-card-featured'));
      targets = targets.concat(cardTargets);
      if (!targets.length) return;

      // Public pages must never look empty when a browser screenshot,
      // crawler, or slow third-party animation script misses scroll events.
      // Reveal immediately; CSS transitions still keep the page calm.
      targets.forEach(revealElement);

      function revealVisible() {
        targets.forEach(function(el) {
          if (el.dataset.revealed === '1') return;
          var rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight * 0.96 && rect.bottom > -80) {
            el.dataset.revealed = '1';
            revealElement(el);
          }
        });
      }

      if (!('IntersectionObserver' in window)) {
        targets.forEach(revealElement);
        return;
      }
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (!entry.isIntersecting) return;
          entry.target.dataset.revealed = '1';
          revealElement(entry.target);
          observer.unobserve(entry.target);
        });
      }, { rootMargin: '0px 0px -4% 0px', threshold: 0 });
      targets.forEach(function(el) { observer.observe(el); });
      revealVisible();
      window.addEventListener('scroll', revealVisible, { passive: true });
      window.addEventListener('resize', revealVisible);
      var fallbackTicks = 0;
      var fallbackTimer = window.setInterval(function() {
        revealVisible();
        fallbackTicks += 1;
        if (fallbackTicks > 16) window.clearInterval(fallbackTimer);
      }, 500);
    }

    function loadScript(src, onload) {
      var s = document.createElement('script');
      s.src = src;
      s.onload = onload;
      s.onerror = initRevealFallback;
      document.head.appendChild(s);
    }

    initRevealFallback();
    window.setTimeout(initRevealFallback, 500);
  })();
  </script>
  <style is:global>
    .nav-right { display: flex !important; align-items: center; gap: 1rem; min-width: 0; }
    @media (max-width: 1400px) {
      nav { gap: 1rem; }
      .nav-links { gap: 1rem; }
      .nav-cta { display: none; }
    }
    @media (max-width: 900px) {
      .nav-right { display: none !important; }
      #bb-hamburger { display: inline-flex !important; }
    }
  </style>
</body>
</html>
