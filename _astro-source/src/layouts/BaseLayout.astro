---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const { title, description = "Inside finance. Building its future. Blockchain, AI, DeFi, and raw thoughts from someone who works inside financial systems and builds on top of them.", ogImage, canonical } = Astro.props;
const fullTitle = title === 'Home' ? 'Bionic Banker - Where Finance Meets the Future' : `${title} - Bionic Banker`;
const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = ogImage ? new URL(ogImage, Astro.site).href : undefined;
const isHome = title === 'Home';
const routeDepth = Astro.url.pathname === '/' ? 0 : Astro.url.pathname.split('/').filter(Boolean).length;
const relativeAssetRoot = routeDepth === 0 ? './' : '../'.repeat(routeDepth);
---
<!DOCTYPE html>
<html lang="en">
<head><style>body,html{background:#08080e!important}canvas{background:#08080e!important}</style>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Himanshu" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-YS428H3H44"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-YS428H3H44');
  </script>

  <!-- Open Graph -->
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={isHome ? "website" : "article"} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="Bionic Banker" />
  {ogImageURL && <meta property="og:image" content={ogImageURL} />}
  <meta name="twitter:card" content={ogImageURL ? "summary_large_image" : "summary"} />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}
  <meta name="twitter:site" content="@BionicBanker" />
  <meta name="twitter:creator" content="@BionicBanker" />
  <link rel="canonical" href={canonicalURL} />

  <!-- JSON-LD Structured Data -->
  {isHome ? (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Bionic Banker",
      "url": "https://bionicbanker.tech",
      "description": description,
      "author": {
        "@type": "Person",
        "name": "Himanshu",
        "url": "https://linkedin.com/in/himanshu-h-a357684a"
      }
    })} />
  ) : null}

  <!-- Styles -->
  <link rel="stylesheet" href="/styles/global.css" />
  <link rel="stylesheet" href={`${relativeAssetRoot}styles/global.css`} />
</head>
<body>
  <!-- NAV -->
  <nav>
    <a href="/" class="nav-logo">Bionic <span>Banker</span></a>
    <div class="nav-right">
      <ul class="nav-links">
        <li><a href="/articles">All Articles</a></li>
        <li><a href="/intelligence">AI Intelligence</a></li>
        <li><a href="/learn">Learn</a></li>
        <li><a href="/proof-tour">Lab Tour</a></li>
        <li><a href="/reports">Field Notes</a></li>
        <li><a href="/gaps">Questions</a></li>
        <li><a href="/site-agent">Ask Lab</a></li>
        <li><a href="/#about">About</a></li>
      </ul>
      <a href="https://t.me/BionicBanker" class="nav-cta" target="_blank" rel="noopener">Join Telegram</a>
    </div>
    <button id="bb-hamburger" aria-label="Menu">&#9776;</button>
  </nav>

  <!-- MAIN CONTENT -->
  <slot />

  <!-- NEWSLETTER -->
  <section id="newsletter" class="newsletter-section">
    <div class="newsletter-wrap">
      <h2>Stay in the Loop</h2>
      <p>Finance meets the future. One piece at a time. No fluff, just signal.</p>
      <form action="https://formspree.io/f/xdaljypn" method="POST" class="newsletter-form">
        <input type="hidden" name="_form_type" value="newsletter">
        <input type="hidden" name="_subject" value="New Bionic Banker newsletter subscriber">
        <input type="text" name="_gotcha" style="display:none !important" tabindex="-1" autocomplete="off" aria-hidden="true">
        <input type="email" name="email" placeholder="you@domain.com" required class="newsletter-input" aria-label="Email address">
        <button type="submit" class="nl-btn primary">Subscribe</button>
      </form>
      <div class="newsletter-actions newsletter-secondary-row">
        <a href="https://t.me/BionicBanker" class="nl-btn secondary" target="_blank" rel="noopener">Or join the Telegram</a>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="site-footer">
    <div class="footer-wrap">
      <div class="footer-brand">
        <a href="/" class="footer-logo">Bionic <span>Banker</span></a>
        <p class="footer-tagline">Inside finance. Building its future.</p>
      </div>
      <div class="footer-links">
        <div class="footer-col">
          <h4>Explore</h4>
          <a href="/articles">All Articles</a>
          <a href="/intelligence">AI Intelligence</a>
          <a href="/learn">Learn</a>
          <a href="/proof-tour">Lab Tour</a>
          <a href="/reports">Field Notes</a>
          <a href="/gaps">Questions</a>
          <a href="/site-agent">Ask Lab</a>
        </div>
        <div class="footer-col">
          <h4>Connect</h4>
          <a href="https://t.me/BionicBanker" target="_blank" rel="noopener">Telegram</a>
          <a href="https://linkedin.com/in/himanshu-h-a357684a" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://github.com/hash02" target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} Bionic Banker. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <!-- Mobile Menu -->
  <script is:inline>
  (function() {
    var hamburger = document.getElementById('bb-hamburger');
    if (!hamburger) return;

    var overlay = document.createElement('div');
    overlay.id = 'bb-overlay';
    document.body.appendChild(overlay);

    var panel = document.createElement('div');
    panel.id = 'bb-panel';
    panel.innerHTML =
      '<button id="bb-panel-close" aria-label="Close menu">&times;</button>' +
      '<a href="/articles">All Articles</a>' +
      '<a href="/intelligence">AI Intelligence</a>' +
      '<a href="/learn">Learn</a>' +
      '<a href="/proof-tour">Lab Tour</a>' +
      '<a href="/reports">Field Notes</a>' +
      '<a href="/gaps">Questions</a>' +
      '<a href="/site-agent">Ask Lab</a>' +
      '<a href="/#about">About</a>' +
      '<a href="https://t.me/BionicBanker" class="bb-panel-cta" target="_blank" rel="noopener">Join Telegram</a>';
    document.body.appendChild(panel);

    function openMenu() { panel.classList.add('open'); overlay.classList.add('open'); document.body.style.overflow = 'hidden'; }
    function closeMenu() { panel.classList.remove('open'); overlay.classList.remove('open'); document.body.style.overflow = ''; }

    hamburger.addEventListener('click', openMenu);
    document.getElementById('bb-panel-close').addEventListener('click', closeMenu);
    overlay.addEventListener('click', closeMenu);
    panel.querySelectorAll('a').forEach(function(a) { a.addEventListener('click', closeMenu); });
  })();
  </script>


  <!-- 3D background handled by ParticleHero component on homepage -->
  <!-- Scroll Animations -->
  <script is:inline>
  (function() {
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-in');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

    document.querySelectorAll('.animate-on-scroll').forEach(function(el) {
      observer.observe(el);
    });
  })();
  </script>
  <style is:global>
    .nav-right { display: flex !important; align-items: center; gap: 1rem; min-width: 0; }
    @media (max-width: 1400px) {
      nav { gap: 1rem; }
      .nav-links { gap: 1rem; }
      .nav-cta { display: none; }
    }
  </style>
</body>
</html>
